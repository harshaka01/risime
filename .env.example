# Copy to .env (never commit .env)
POSTGRES_PASSWORD=change_me
SECRET_KEY_BASE=change_me_with_openssl_rand_base64_48
OTP_DEV_LOG=true
# SMTP (Release 0.2)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="RisiMe <no-reply@example.com>"

# Voice calls (decision 046): coturn REST shared secret; generate with `openssl rand -hex 32`. Empty = calls off (503 calls_unavailable).
TURN_SECRET=

# Group calls (LiveKit, infra/docker-compose.livekit.yml): API key/secret the server mints tokens with
# and LiveKit verifies them with. Key: "API" + 12 letters/digits; secret: 48 letters/digits.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
