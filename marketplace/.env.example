# Copy to marketplace/.env (gitignored). Never commit real values.
REGISTRY_DB_USER=risi_registry
REGISTRY_DB_PASSWORD=change_me
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=
# Keycloak realm aoa issuer, for example https://<keycloak-host>/realms/aoa
OIDC_ISSUER=
OIDC_CLIENT_ID=risi-marketplace
OIDC_REDIRECT_URI=https://risicloud.ai/marketplace/auth/callback
# The first allow-listed account (the one Harsha signs in with). Inserted into the DB once by the seeds.
ALLOW_LIST_SEED=
PORT=4600
