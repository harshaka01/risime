#!/usr/bin/env bash
# Run scripts/nightly-release from a clean worktree at origin/main (~/risime-release-wt), so other
# sessions' uncommitted edits in the shared checkout can't enter or break a release.
#   scripts/release-from-worktree [nightly-release args...]
# Env passes through (e.g. UPGRADE_GATE_OVERRIDE=docs/decisions/0NN-....md for an owner override).
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"; M="$HOME/.local/bin/mise exec --"
WT="${RELEASE_WORKTREE:-$HOME/risime-release-wt}"
REF="origin/main"; [ -n "${HOTFIX:-}" ] && { git -C "$REPO" fetch -q origin "$HOTFIX"; REF="origin/$HOTFIX"; }
git -C "$REPO" fetch -q origin main
if [ -e "$WT/.git" ]; then git -C "$WT" checkout -q --force --detach "$REF"; git -C "$WT" clean -qfd -e server/deps -e server/_build -e crypto/target
else git -C "$REPO" worktree add -q --detach "$WT" "$REF"; fi
ln -sfn "$REPO/.env" "$WT/.env"
echo "==> release worktree $WT at $(git -C "$WT" log -1 --format='%h %s' | cut -c1-80)"
(cd "$WT/server" && $M mix deps.get >/dev/null)
cd "$WT" && exec scripts/nightly-release "$@"
