#!/usr/bin/env bash
# Two-device call test with the REAL app and real libwebrtc (decision 054), on spark2 in two redroid
# containers (native arm64 Android 14, decision 045) on the docker network:
#   scripts/call-device-test [--apk app-debug.apk] [--keep]
#
#  1. A temp server from THIS checkout on 127.0.0.1:$CALLTEST_PORT (default 4400; own DB/keyspace
#     risime_calltest$CALLTEST_INSTANCE, E2EE on with a per-run attestation key, dev OTP login).
#  2. Two redroid containers (REDROID_INSTANCE -cf1/-cf2, ports 5720/5721 unless set), the debug APK,
#     notifications + microphone granted, `adb reverse` to the server; A and B sign in through the
#     real login UI, become friends, and A's chat with B upgrades to e2ee.
#  3. A taps "Voice call"; B rings; B answers through the app's real Answer path (the activity
#     intent the CallStyle notification's Answer button sends); media connects host/host with the
#     §16.10 check (debug stats in logcat); A hangs up ("End call").
#  4. A second call at once (no stuck state), answered, connected, hung up.
#  5. A third call: the caller's process is killed mid-call (am force-stop); B ends by itself; the
#     restarted app places the next call without "You're already in a call", and B rings.
#  6. Calls 5, 7, 8 (background answer, Home + screen off, Back); call 6 relay-only with CALLTEST_TURN=1.
#  7. Call 9, video (§19): CAMERA granted, "Video call", B's "Incoming video call" answered in the
#     call screen, VP8 frames rising both ways, B's camera off/on and Home (A shows B's avatar), hang
#     up → "Video call · m:ss" on both; call 10 voice right after; call 11 video relay-only (TURN=1).
#     P0-3: every video call checks audio alone (audio_ok: the debug stats' audio_sent/audio_recv, kind
#     audio, growing on both phones) and Telecom's route line (`calls: route`, the speaker on redroid);
#     call 12 is a video call B → A answered in the call screen, call 13 one answered from the notification.
#  8. Call 14 (v1.23 §23, the one call screen): a voice call; A taps Video ("Switch to video") → B sees
#     "Switch to video call?" → Accept → VP8 frames both ways, exactly one renegotiate re-offer (from A,
#     the caller), audio both ways, the speaker; "Switch to voice call" → no new frames on either side,
#     the voice UI, audio; A shares the screen (MediaProjection consent through the PROJECT_MEDIA appop
#     or the system dialog) → B "Watch" → "… is sharing their screen" and frames on B, src=screen on A;
#     Stop → the label goes; back to voice from B's More; hang up → "Video call · m:ss" on both.
#     CALLTEST_SWITCH_ONLY=1 runs only call 14 (iteration). Debug builds keep the call controls on
#     screen for uiautomator (files/debug_keep_call_controls; the auto-hide is unit-tested).
# Prints "CALLTEST PASS|FAIL <step>" lines and "CALLTEST OK" at the end. Never touches :4000.
set -euo pipefail
cd "$(dirname "$0")/.."
REPO="$PWD"; M="$HOME/.local/bin/mise exec --"
PKG=lk.codegen.risime.debug   # the debug build's application id
CLS=lk.codegen.risime
SUF="${CALLTEST_INSTANCE:-}"; PORT="${CALLTEST_PORT:-4400}"
APK=""; KEEP=0
while [ $# -gt 0 ]; do case "$1" in --apk) APK="$2"; shift 2;; --keep) KEEP=1; shift;; *) echo "unknown arg $1"; exit 2;; esac; done
APK="${APK:-$REPO/android/app/build/outputs/apk/debug/app-debug.apk}"
[ -f "$APK" ] || { echo "no APK at $APK (cd android && ./gradlew assembleDebug)"; exit 2; }
PATH="$("$REPO/scripts/android-target" adb):$PATH"
I1="${CALLTEST_REDROID_A:--cf1}"; P1="${CALLTEST_REDROID_A_PORT:-5720}"
I2="${CALLTEST_REDROID_B:--cf2}"; P2="${CALLTEST_REDROID_B_PORT:-5721}"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/risime-calltest.XXXXXX")"
LOGS="$HOME/risime-logs/calltest$SUF"; mkdir -p "$LOGS"
export RISIME_DEV_DB="risime_calltest$SUF" RISIME_DEV_KEYSPACE="risime_calltest$SUF" ERL_EPMD_ADDRESS=127.0.0.1
export MIX_BUILD_PATH="$REPO/server/_build/calltest$SUF" RISIME_CODE_RELOADER=false
FAILED=0
pass() { echo "CALLTEST PASS $*"; }
fail() { echo "CALLTEST FAIL $*"; FAILED=1; diag; exit 1; }
diag() {
  for d in A B; do
    local s; s="$(ser $d)"
    adb -s "$s" exec-out screencap -p > "$LOGS/$d-screen.png" 2>/dev/null || true
    adb -s "$s" logcat -d > "$LOGS/$d-logcat.txt" 2>/dev/null || true
  done
  cp "$WORK/server.log" "$LOGS/server.log" 2>/dev/null || true
  echo "    diagnostics in $LOGS"
}
cleanup() {
  [ "$FAILED" = 0 ] || true
  cp "$WORK/server.log" "$LOGS/server.log" 2>/dev/null || true
  tmux kill-session -t "risime-calltest$SUF" 2>/dev/null || true
  if [ "$KEEP" = 0 ]; then
    REDROID_INSTANCE="$I1" REDROID_PORT="$P1" "$REPO/scripts/android-target" stop >/dev/null 2>&1 || true
    REDROID_INSTANCE="$I2" REDROID_PORT="$P2" "$REPO/scripts/android-target" stop >/dev/null 2>&1 || true
  fi
  rm -rf -- "${WORK:?}"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# ---------------------------------------------------------------- server
ss -ltnH "sport = :$PORT" | grep -q . && { echo "port $PORT busy"; exit 1; }
# CALLTEST_TURN=1: the temp server hands out credentials for the LIVE coturn (decision 046), and a
# last call runs relay-only through it (the phones' only path is turn:203.115.26.139:3478).
TURN_ENV=""
if [ "${CALLTEST_TURN:-0}" = 1 ]; then
  ts="$(grep '^TURN_SECRET=' .env | cut -d= -f2-)"; [ -n "$ts" ] || { echo "CALLTEST_TURN=1 needs TURN_SECRET in .env"; exit 2; }
  TURN_ENV="TURN_SECRET='$ts' TURN_URLS='turn:203.115.26.139:3478?transport=udp,turn:203.115.26.139:3478?transport=tcp'"
fi
cat > "$WORK/fixtures.exs" <<'EXS'
alias RisiMe.{Accounts, Repo}
alias RisiMe.Accounts.User
[mode | _] = System.argv()
a_phone = "+94770000971"; b_phone = "+94770000972"
case mode do
  "setup" ->
    {:ok, _} = Accounts.allow(%{phone: a_phone, email: "calltest71@example.com", display_name: "ZZ Call A", company: "CodeGen"})
    {:ok, _} = Accounts.allow(%{phone: b_phone, email: "calltest72@example.com", display_name: "ZZ Call B", company: "CodeGen"})
    IO.puts("calltest: setup ok")
  "friends" ->
    a = Repo.get_by!(User, phone: a_phone); b = Repo.get_by!(User, phone: b_phone)
    RisiMe.Social.make_friends!(a.id, b.id)
    IO.puts("calltest: friends ok")
  "ready" ->
    a = Repo.get_by!(User, phone: a_phone); b = Repo.get_by!(User, phone: b_phone)
    conv = RisiMe.Messaging.conversation_id(a.id, b.id)
    v = RisiMe.MLS.Images.put_readiness(%{e2ee: RisiMe.MLS.group(conv) != nil}, conv)
    IO.puts("calltest: calls_ready=#{v[:calls_ready]} missing_calls=#{inspect(v[:missing_calls])}")
  "e2ee" ->
    a = Repo.get_by!(User, phone: a_phone); b = Repo.get_by!(User, phone: b_phone)
    conv = RisiMe.Messaging.conversation_id(a.id, b.id)
    IO.puts("calltest: e2ee=#{RisiMe.MLS.group(conv) != nil}")
end
EXS
fx() { (cd server && $M mix run "$WORK/fixtures.exs" "$@" 2>/dev/null | grep '^calltest:' || true); }
echo "==> temp server on 127.0.0.1:$PORT ($RISIME_DEV_DB, E2EE on)"
(cd server && { $M mix ecto.drop --quiet --force >/dev/null 2>&1 || true; } && $M mix ecto.create --quiet >/dev/null && $M mix ecto.migrate --quiet >/dev/null && $M mix risime.cql.migrate --quiet >/dev/null) \
  || { echo "could not create/migrate the calltest store"; exit 1; }
(cd server && $M mix risime.attestation.gen "$WORK/attest.jwk" >/dev/null 2>&1) || true
[ -f "$WORK/attest.jwk" ] || { echo "no attestation key"; exit 1; }
(cd server && $M mix compile >/dev/null 2>&1) || { echo "server compile failed"; exit 1; }
tmux new -d -s "risime-calltest$SUF" "cd '$REPO/server' && MIX_BUILD_PATH='$MIX_BUILD_PATH' RISIME_CODE_RELOADER=false RISIME_DEV_DB=$RISIME_DEV_DB RISIME_DEV_KEYSPACE=$RISIME_DEV_KEYSPACE ERL_EPMD_ADDRESS=127.0.0.1 \
  PORT=$PORT DEV_LOCAL_AUTH=true OIDC_ENABLED=false OTP_DEV_LOG=true PHONE_VERIFICATION=off FCM_ENABLED=false LOG_FORMAT=text \
  ATTESTATION_KEY_FILE='$WORK/attest.jwk' RISIME_AUTH_LOG='$WORK/auth.log' $TURN_ENV $M mix phx.server > '$WORK/server.log' 2>&1"
for _ in $(seq 1 120); do curl -sf -o /dev/null "http://127.0.0.1:$PORT/health" && break; sleep 1; done
curl -sf -o /dev/null "http://127.0.0.1:$PORT/health" || { echo "server didn't start"; tail -20 "$WORK/server.log"; exit 1; }
fx setup
otp() { grep -a "\[DEV OTP\] $1:" "$WORK/server.log" | tail -1 | grep -oE '[0-9]{6}' | tail -1 || true; }

# ---------------------------------------------------------------- devices
echo "==> two redroid containers ($I1:$P1, $I2:$P2)"
SA="$(REDROID_INSTANCE="$I1" REDROID_PORT="$P1" "$REPO/scripts/android-target" start)"
SB="$(REDROID_INSTANCE="$I2" REDROID_PORT="$P2" "$REPO/scripts/android-target" start)"
ser() { if [ "$1" = A ]; then echo "$SA"; else echo "$SB"; fi; }
DEV=""
A() { adb -s "$(ser "$DEV")" "$@"; }
for DEV in A B; do
  A uninstall "$PKG" >/dev/null 2>&1 || true
  A install "$APK" >/dev/null
  A shell pm grant "$PKG" android.permission.POST_NOTIFICATIONS 2>/dev/null || true
  A shell pm grant "$PKG" android.permission.RECORD_AUDIO 2>/dev/null || true
  A shell appops set "$PKG" USE_FULL_SCREEN_INTENT allow 2>/dev/null || true
  A shell appops set "$PKG" PROJECT_MEDIA allow 2>/dev/null || true
  A reverse "tcp:$PORT" "tcp:$PORT" >/dev/null
  A logcat -c || true
done

# ---- UI helpers (uiautomator dump + taps by text or content-desc)
# A failed dump (e.g. a ticking call notification keeps the UI from going idle) must never leave the
# previous screen's XML behind: taps would hit stale coordinates.
dump() { A shell rm -f /sdcard/ui.xml >/dev/null 2>&1; A shell uiautomator dump /sdcard/ui.xml >/dev/null 2>&1; A exec-out cat /sdcard/ui.xml > "$WORK/ui-$DEV.xml" 2>/dev/null || : > "$WORK/ui-$DEV.xml"; }
has() { dump; grep -qF -- "$1" "$WORK/ui-$DEV.xml"; }
wait_for() { for _ in $(seq 1 "${2:-30}"); do has "$1" && return 0; sleep 1; done; echo "    [$DEV] timeout waiting for: $1"; return 1; }
tap() {
  dump
  local b; b="$(python3 -I - "$WORK/ui-$DEV.xml" "$1" <<'PY'
import re, sys, xml.etree.ElementTree as ET
want = sys.argv[2]
for n in ET.parse(sys.argv[1]).iter('node'):
    if n.get('text') == want or n.get('content-desc') == want or (want.endswith('*') and (n.get('text') or '').startswith(want[:-1])):
        x1, y1, x2, y2 = map(int, re.findall(r'\d+', n.get('bounds')))
        print((x1 + x2) // 2, (y1 + y2) // 2); break
PY
)"
  [ -n "$b" ] || { echo "    [$DEV] no UI node: $1"; return 1; }
  A shell input tap $b
}
clear_field() { A shell "for i in \$(seq 1 80); do input keyevent KEYCODE_DEL KEYCODE_FORWARD_DEL; done" >/dev/null 2>&1 || true; }
hide_keyboard() { local st; st="$(A shell dumpsys input_method 2>/dev/null || true)"; [[ "$st" == *"mInputShown=true"* ]] && A shell input keyevent KEYCODE_BACK; sleep 0.5; }
type_into() { hide_keyboard; tap "$1" || return 1; sleep 0.5; clear_field; A shell input text "$(printf '%s' "$2" | sed 's/ /%s/g')"; }
dismiss_prompts() { has "Not now" && { tap "Not now" || true; }; has "Later" && { tap "Later" || true; }; true; }

sign_in() {  # $1 phone, $2 email
  A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null
  wait_for "Server:" 40 || return 1
  tap "Server:*" || return 1; sleep 1
  tap "Server URL" || tap "http://*" || tap "https://*" || return 1; sleep 0.5
  clear_field; A shell input text "http://127.0.0.1:$PORT"; sleep 0.5; hide_keyboard
  if ! tap "Use this server"; then tap "Server URL" || true; A shell input keyevent KEYCODE_ENTER; fi
  sleep 2
  wait_for "Phone number" 30 || return 1
  type_into "Phone number" "$1"; type_into "Work email" "$2"; hide_keyboard; tap "Send code" || return 1
  wait_for "6-digit code" 30 || return 1
  local code=""; for _ in $(seq 1 20); do code="$(otp "$1")"; [ -n "$code" ] && break; sleep 1; done
  [ -n "$code" ] || return 1
  type_into "6-digit code" "$code"; sleep 1; has "Verify" && tap "Verify" || true
  wait_for "Add friend" 40 || return 1
  dismiss_prompts
}
# The chat list shows its top bar's "Refresh friends" icon. Since GO UX (nightly.27) tapping the
# name inside an open chat opens Chat info, so press Back to the list first (at most 3 times).
on_list() { dump; grep -qF -e 'content-desc="Refresh friends"' -e 'text="Add friend"' "$WORK/ui-$DEV.xml"; }
open_chat() {
  A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null; sleep 1; dismiss_prompts
  for _ in 1 2 3; do on_list && break; A shell input keyevent KEYCODE_BACK; sleep 1; done
  on_list || { A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null; sleep 2; dismiss_prompts; }
  wait_for "$1" 40 || return 1; tap "$1"; sleep 2
}
# The real answer path: open the notification shade and tap the CallStyle notification's Answer
# action (its PendingIntent starts CallActivity with ACTION_ANSWER; the activity isn't exported).
answer_intent() {
  A shell cmd statusbar expand-notifications >/dev/null 2>&1 || true
  wait_for "Answer" 10 || return 1
  tap "Answer" || return 1
  sleep 1
  A shell cmd statusbar collapse >/dev/null 2>&1 || true
}
# §16.10 verified media: the debug stats line "pair=host/host … dtls=connected srtp=…" since $1 lines.
MEDIA_PAIR="(host|prflx)/(host|prflx)"
media_ok() { local out; out="$(A logcat -d 2>/dev/null || true)"; grep -E "call stats: pair=$MEDIA_PAIR .*dtls=connected srtp=[A-Z_0-9]+" <<<"$out" | tail -1 || true; }
# Ringing = the incoming CallStyle notification on the `calls` channel is posted (a heads-up while the app is open).
ringing() { local out; out="$(A shell dumpsys notification --noredact 2>/dev/null || true)"; grep -q "pkg=$PKG .*channel=calls " <<<"$out"; }
wait_ring() { for _ in $(seq 1 "${1:-30}"); do ringing && return 0; sleep 1; done; return 1; }

# No crash and no main-thread Room/MLS work (StrictMode, debug builds) on either phone since the last check.
logcat_ok() {  # $1 label
  local d out
  for d in A B; do
    DEV=$d; out="$(A logcat -d 2>/dev/null || true)"
    printf '%s\n' "$out" | "$REPO/scripts/logcat-gate" "$1 $d" || fail "$1: $d crashed or touched the database on the main thread"
  done
}

for DEV in A B; do
  if [ "$DEV" = A ]; then sign_in "+94770000971" "calltest71@example.com" || fail "sign-in A"; else sign_in "+94770000972" "calltest72@example.com" || fail "sign-in B"; fi
done
pass "both signed in through the real login UI"
# Debug builds: keep the call controls on screen for uiautomator (the app data dir exists now).
for DEV in A B; do A shell run-as "$PKG" touch files/debug_keep_call_controls || fail "$DEV: debug_keep_call_controls"; done
[ "$(fx friends)" = "calltest: friends ok" ] || fail "fixture: friends"
# The friend list is fetched at start: restart both apps.
for DEV in A B; do A shell am force-stop "$PKG"; done
# The P0 scenario (nightly.17/18 crashed opening chats): the DM is activated to MLS while it is open.
DEV=B; open_chat "ZZ Call A" || fail "B: chat with A not listed"
DEV=A; open_chat "ZZ Call B" || fail "A: chat with B not listed"
for _ in $(seq 1 60); do [ "$(fx e2ee)" = "calltest: e2ee=true" ] && break; sleep 2; done
[ "$(fx e2ee)" = "calltest: e2ee=true" ] || fail "the DM never became e2ee"
DEV=A; sleep 3; has "ZZ Call B" || fail "A: the DM with B closed (crash?) while it was activated to MLS"
logcat_ok "A opens the DM with B while it is activated to MLS"
pass "A opened the DM with B while it was activated to MLS: no crash"

# ---------------------------------------------------------------- call records (WhatsApp style)
# Root-delegated script addition (android role): a voice call and a video call that the caller
# cancels while B rings. Both phones must show the right rows in the chat (A "Cancelled voice call" /
# "Cancelled video call", B "Missed voice call" / "Missed video call") and in the Calls tab (B: "ZZ Call
# A (2)" with a red ↙, A: "ZZ Call B (2)" with ↗); B has a missed-call notification of the right type
# with "Call back"/"Message"; "Call back" from B's Calls tab rings A with the same (video) type.
#   CALLTEST_RECORDS_ONLY=1 runs only this section (after the DM is e2ee) and exits.
notif_dump() { A shell dumpsys notification --noredact 2>/dev/null || true; }
missed_notification() {  # $1 voice|video: B's missed_calls notification of that type, named, with both actions
  local out; out="$(notif_dump)"
  grep -q "channel=missed_calls" <<<"$out" || return 1
  grep -qF "Missed $1 call" <<<"$out" || return 1
  grep -qF "ZZ Call A" <<<"$out" || return 1
  grep -qF "Call back" <<<"$out" && grep -qF "Message" <<<"$out"
}
back_to_list() { for _ in 1 2 3 4; do on_list && return 0; A shell input keyevent KEYCODE_BACK; sleep 1; done; on_list; }
call_records() {
  for DEV in A B; do
    A shell pm grant "$PKG" android.permission.CAMERA 2>/dev/null || true
    A shell cmd notification cancel_all >/dev/null 2>&1 || true
    A logcat -c
  done
  local kind btn
  for kind in voice video; do
    if [ "$kind" = voice ]; then btn="Voice call"; else btn="Video call"; fi
    DEV=B; open_chat "ZZ Call A" || fail "records ($kind): B can't open the DM"
    DEV=A; open_chat "ZZ Call B" || fail "records ($kind): A can't open the DM"
    local ok=""; for _ in $(seq 1 20); do tap "$btn" && { ok=1; break; }; sleep 2; done
    [ -n "$ok" ] || fail "records ($kind): A has no \"$btn\" button"
    DEV=B; back_to_list || fail "records ($kind): B can't reach the chat list"
    wait_ring 30 || fail "records ($kind): B never rang"
    sleep 2
    DEV=A; tap "End call" || fail "records ($kind): A can't cancel while B rings"
    # (dumpsys also lists archived notifications, so "still ringing" can't be read from it: the missed-call
    # notification below only appears once the ring is over.)
    DEV=B
    local got=""; for _ in $(seq 1 20); do missed_notification "$kind" && { got=1; break; }; sleep 1; done
    [ -n "$got" ] || { notif_dump | grep -i "missed\|channel=" | head -10; fail "records ($kind): B has no \"Missed $kind call\" notification from ZZ Call A with Call back + Message"; }
    pass "records ($kind): B has a \"Missed $kind call\" notification naming ZZ Call A with Call back and Message"
    DEV=B; A shell cmd statusbar collapse >/dev/null 2>&1 || true
    open_chat "ZZ Call A" || fail "records ($kind): B can't open the DM"
    wait_for "Missed $kind call" 20 || fail "records ($kind): B's chat has no \"Missed $kind call\" row"
    pass "records ($kind): B's chat shows \"Missed $kind call\""
    DEV=A; sleep 2
    wait_for "Cancelled $kind call" 20 || fail "records ($kind): A's chat has no \"Cancelled $kind call\" row"
    pass "records ($kind): A's chat shows \"Cancelled $kind call\""
  done
  # The Calls tab: both missed calls from A are one row on B, both cancelled calls one row on A.
  DEV=B; back_to_list || fail "records: B can't reach the chat list"
  tap "Calls" || fail "records: B has no Calls tab"; sleep 2
  wait_for "ZZ Call A (2)" 15 || fail "records: B's Calls tab has no grouped \"ZZ Call A (2)\" row"
  has "↙ Today" || fail "records: B's missed row has no ↙ Today stamp"
  pass "records: B's Calls tab shows \"ZZ Call A (2)\" with ↙ Today"
  DEV=A; back_to_list || fail "records: A can't reach the chat list"
  tap "Calls" || fail "records: A has no Calls tab"; sleep 2
  wait_for "ZZ Call B (2)" 15 || fail "records: A's Calls tab has no grouped \"ZZ Call B (2)\" row"
  has "↗ Today" || fail "records: A's outgoing row has no ↗ Today stamp"
  pass "records: A's Calls tab shows \"ZZ Call B (2)\" with ↗ Today"
  # Tap the row: call info lists both calls.
  DEV=B; tap "ZZ Call A (2)" || fail "records: B can't open call info"
  wait_for "Incoming voice call" 10 && has "Incoming video call" || fail "records: B's call info doesn't list the voice and the video call"
  pass "records: B's call info lists both calls"
  tap "Close" || true; sleep 1
  # Call back from the row's icon: the newest call was video, so A rings with an incoming VIDEO call.
  tap "Video call ZZ Call A" || fail "records: B's row has no video call-back icon"
  DEV=A; wait_ring 30 || fail "records: A never rang for B's call back"
  A shell dumpsys notification --noredact 2>/dev/null | grep -qF "Incoming video call" || fail "records: B's call back from a video row was not a video call"
  pass "records: call back from the Calls tab rings the other phone with the same (video) type"
  DEV=B; tap "End call" || fail "records: B can't end the call back"
  sleep 3
  DEV=A; logcat_ok "call records"
}
if [ "${CALLTEST_RECORDS_ONLY:-0}" = 1 ]; then call_records; echo "CALLTEST OK"; exit 0; fi

# Encrypted messages flow both ways, also after each phone updates in place (UPGRADE_APK, e.g. the
# next nightly; nightly.19 left senders "pending" after an update).
msg_check() {  # $1 label
  local t1="m-$1-from-A" t2="m-$1-from-B"; t1="${t1// /-}"; t2="${t2// /-}"
  DEV=A; A shell am force-stop "$PKG"; open_chat "ZZ Call B" || fail "$1: A can't open the DM"
  { type_into "Encrypted message" "$t1" || type_into "Message" "$t1"; } && tap "Send" || fail "$1: A can't type"
  DEV=B; A shell am force-stop "$PKG"; open_chat "ZZ Call A" || fail "$1: B can't open the DM"
  wait_for "$t1" 45 || fail "$1: B never received A's encrypted message"
  { type_into "Encrypted message" "$t2" || type_into "Message" "$t2"; } && tap "Send" || fail "$1: B can't type"
  DEV=A; wait_for "$t2" 45 || fail "$1: A never received B's encrypted message"
  logcat_ok "$1"
  pass "$1: encrypted messages delivered both ways"
}
[ "${CALLTEST_FAST:-0}" = 1 ] || { msg_check "before"; }
[ "${CALLTEST_FAST:-0}" = 1 ] || { DEV=B; A install -r "${UPGRADE_APK:-$APK}" >/dev/null || fail "B: update in place"; }
[ "${CALLTEST_FAST:-0}" = 1 ] || { msg_check "after B updated"; }
[ "${CALLTEST_FAST:-0}" = 1 ] || { DEV=A; A install -r "${UPGRADE_APK:-$APK}" >/dev/null || fail "A: update in place"; }
[ "${CALLTEST_FAST:-0}" = 1 ] || { msg_check "after both updated"; }
# A message stuck in the outbox (sent offline), then fresh starts straight into chats while MLS is
# active: the chat screen flushes the outbox (nightly.17/18 did that on the main thread and crashed).
DEV=A; open_chat "ZZ Call B" || fail "A: DM"
A reverse --remove "tcp:$PORT" >/dev/null 2>&1 || true; sleep 2
{ type_into "Encrypted message" "stuck-while-offline" || type_into "Message" "stuck-while-offline"; } && tap "Send" || fail "A: could not type"
sleep 2
for _ in 1 2 3; do
  A shell am force-stop "$PKG"
  open_chat "ZZ Call B" || fail "A: opening the DM with a stuck message (crash?)"
  sleep 6; has "ZZ Call B" || fail "A: the DM crashed on opening with a message stuck in the outbox"
done
logcat_ok "A opens the DM with a message stuck in the outbox"
DEV=A; A reverse "tcp:$PORT" "tcp:$PORT" >/dev/null   # (logcat_ok leaves DEV=B)
DEV=B; A shell am force-stop "$PKG"; open_chat "ZZ Call A" || fail "B: DM"
wait_for "stuck-while-offline" 60 || fail "the stuck message was never delivered once A was back online"
pass "A opened the DM 3 times with a stuck message (offline, MLS active): no crash; delivered once online"
DEV=A; A shell am force-stop "$PKG"; open_chat "ZZ Call B" || fail "A: DM"
sleep 3

# One call: A calls, B answers through the activity intent, media host/host, A hangs up.
call_once() {  # $1 label
  logcat_ok "before $1"
  DEV=A; A logcat -c; DEV=B; A logcat -c
  DEV=A; local ok=""; for _ in $(seq 1 20); do tap "Voice call" && { ok=1; break; }; sleep 2; done
  if [ -z "$ok" ]; then
    echo "    server: $(fx ready)"
    tap "Voice call (unavailable)" && sleep 0.5 && dump && grep -o 'text="[^"]*"' "$WORK/ui-$DEV.xml" | grep -v 'text="m-\|text=""' | head -8 | sed 's/^/    A shows: /'
    fail "$1: no call button"
  fi
  sleep 1
  has "already in a call" && fail "$1: A says \"You're already in a call\""
  DEV=B; wait_ring 30 || fail "$1: B never rang"
  pass "$1: B rings"
  if [ "${CALL_BG:-0}" = 1 ]; then A shell input keyevent KEYCODE_HOME; sleep 2; fi
  answer_intent || fail "$1: no Answer action on the incoming-call notification"
  local m=""; for _ in $(seq 1 30); do DEV=A; m="$(media_ok)"; [ -n "$m" ] && { DEV=B; [ -n "$(media_ok)" ] && break; }; m=""; sleep 1; done
  [ -n "$m" ] || fail "$1: media never connected directly (host/prflx pair) with DTLS-SRTP on both"
  pass "$1: answered via the Answer intent; media on the expected path, DTLS connected, SRTP on both (${m##*call stats: })"
  # Audio must flow BOTH ways (nightly.21: only the caller was heard): outbound-rtp bytesSent and
  # inbound-rtp bytesReceived of kind audio (P0-3: not summed with video) grow on both phones.
  sleep 6
  local d sent recv
  for d in A B; do
    DEV=$d; sent="$(audio_of sent)"; recv="$(audio_of recv)"
    [ "${sent:-0}" -gt 0 ] && [ "${recv:-0}" -gt 0 ] || fail "$1: one-way audio: $d audio_sent=${sent:-?} audio_recv=${recv:-?} bytes"
  done
  pass "$1: audio flows both ways (audio bytesSent and bytesReceived > 0 on caller and callee)"
}
# P0-3: the latest audio-only counter (kind == audio) from the debug stats line on $DEV; $1 sent|recv.
audio_of() { A logcat -d 2>/dev/null | grep -E 'call stats: .*audio_sent=[0-9]+ audio_recv=[0-9]+' | tail -1 | sed -nE "s/.*audio_$1=([0-9]+).*/\1/p"; }
# audio_ok <label>: on BOTH phones audio_sent and audio_recv are > 0 and grow over ~5 s (two stats lines).
audio_ok() {
  local d s1A s1B r1A r1B s1 r1 s2 r2
  DEV=A; s1A="$(audio_of sent)"; r1A="$(audio_of recv)"; DEV=B; s1B="$(audio_of sent)"; r1B="$(audio_of recv)"
  sleep 5
  for d in A B; do
    DEV=$d; s2="$(audio_of sent)"; r2="$(audio_of recv)"
    if [ "$d" = A ]; then s1="$s1A"; r1="$r1A"; else s1="$s1B"; r1="$r1B"; fi
    [ "${s1:-0}" -gt 0 ] && [ "${r1:-0}" -gt 0 ] && [ "${s2:-0}" -gt "${s1:-0}" ] && [ "${r2:-0}" -gt "${r1:-0}" ] \
      || fail "$1: no audio on $d (audio_sent ${s1:-none}→${s2:-none}, audio_recv ${r1:-none}→${r2:-none})"
    echo "    [$d] audio_sent $s1→$s2 audio_recv $r1→$r2"
  done
  pass "$1: audio_ok: audio_sent and audio_recv > 0 and growing on both phones"
}
# route_ok <label>: Telecom's route line (`calls: route current=<T> available=<T,…>`) on both phones lists
# routes, and a video call without a headset is on the speaker (redroid lists only SPEAKER).
route_ok() {
  local d line cur av
  for d in A B; do
    DEV=$d; line=""; cur=""; av=""
    for _ in $(seq 1 10); do
      line="$(A logcat -d 2>/dev/null | grep -E 'calls: route current=' | tail -1 || true)"
      av="$(sed -nE 's/.*available=([A-Z_,]*).*/\1/p' <<<"$line")"; cur="$(sed -nE 's/.*current=([A-Z_]+).*/\1/p' <<<"$line")"
      [ -n "$av" ] && { [[ "$av" == *BLUETOOTH* || "$av" == *WIRED* || "$cur" == SPEAKER ]]; } && break
      sleep 1
    done
    [ -n "$av" ] || fail "$1: $d has no Telecom route list (${line:-no route line})"
    [[ "$av" == *BLUETOOTH* || "$av" == *WIRED* || "$cur" == SPEAKER ]] || fail "$1: $d's video call is not on the speaker (current=$cur available=$av)"
    echo "    [$d] route current=$cur available=$av"
  done
  pass "$1: Telecom lists the routes and the video call is on the speaker on both phones"
}
# Decision 054: no call left behind: no RisiMe call in Telecom (a ghost self-managed call held
# MODE_IN_COMMUNICATION in nightly.16 and made every later call "busy") and no communication mode.
no_leftovers() {  # $1 label
  local d t a ok
  for d in A B; do
    DEV=$d; ok=""
    for _ in $(seq 1 10); do
      t="$(A shell dumpsys telecom 2>/dev/null || true)"; a="$(A shell dumpsys audio 2>/dev/null || true)"
      if ! grep -qE "state=(ACTIVE|RINGING|DIALING|CONNECTING|ON_HOLD|NEW|ANSWERED).*tpac=ComponentInfo\{$PKG" <<<"$t" \
         && ! grep -A1 -- "- Mode owner:" <<<"$a" | grep -q MODE_IN_COMMUNICATION; then ok=1; break; fi
      sleep 1
    done
    [ -n "$ok" ] || fail "$1: $d still has a RisiMe Telecom call or MODE_IN_COMMUNICATION after the call ended"
  done
  pass "$1: no Telecom call and no communication mode left on either phone"
}
hang_up_a() {  # $1 label
  DEV=A; tap "End call" || fail "$1: no End call button"
  DEV=B; for _ in $(seq 1 20); do has "End call" || break; sleep 1; done
  has "End call" && fail "$1: B still in the call after A hung up"
  DEV=A; sleep 4; has "End call" && fail "$1: A still shows the call"
  pass "$1: A hung up; both ended"
  no_leftovers "$1"
}

if [ "${CALLTEST_SWITCH_ONLY:-0}" != 1 ]; then
[ "${CALLTEST_FAST:-0}" = 1 ] || { call_once "call 1"; hang_up_a "call 1"; }
[ "${CALLTEST_FAST:-0}" = 1 ] || { call_once "call 2 (right after)"; hang_up_a "call 2"; }
[ "${CALLTEST_FAST:-0}" = 1 ] || { call_once "call 3"; }
DEV=A; A shell am force-stop "$PKG"
pass "call 3: the caller's process killed mid-call"
DEV=B; for _ in $(seq 1 40); do has "End call" || break; sleep 1; done
has "End call" && fail "call 3: B still in the call 40 s after the caller died"
pass "call 3: B ended by itself"
DEV=B; no_leftovers "call 3 (B, the survivor)"
DEV=A; open_chat "ZZ Call B" || fail "A: chat after the restart"
sleep 3
[ "${CALLTEST_FAST:-0}" = 1 ] || { call_once "call 4 (after the kill)"; hang_up_a "call 4"; }
# Answering from the background: B goes to the home screen while it rings and answers from the
# notification shade (redroid has no FCM, so a fully backgrounded app can't be woken here).
[ "${CALLTEST_FAST:-0}" = 1 ] || { CALL_BG=1 call_once "call 5 (answered from the background)"; hang_up_a "call 5"; }
fi
# Call 7 (the nightly.23 report: the call screen vanished after Home and the mic stayed held): A
# calls, then goes Home and switches the screen off for a minute. The call must live on in the
# foreground service (microphone type) with its ongoing notification and audio both ways; the
# notification reopens the call screen; "Hang up" from the shade ends it everywhere and releases
# the microphone.
bytes_of() {  # $1 sent|recv: the latest debug stats AUDIO value on $DEV (P0-3: video not counted)
  audio_of "$1"
}
uid_of() { A shell pm list packages -U "$PKG" 2>/dev/null | sed -nE "s/.*package:$PKG uid:([0-9]+).*/\1/p" | head -1; }
if [ "${CALLTEST_SWITCH_ONLY:-0}" != 1 ]; then
DEV=B; open_chat "ZZ Call A" || fail "B: DM"; DEV=A; open_chat "ZZ Call B" || fail "A: DM"
call_once "call 7 (Home, screen off for a minute)"
DEV=A; A shell input keyevent KEYCODE_HOME; sleep 1; A shell input keyevent KEYCODE_SLEEP
sleep 60
A shell input keyevent KEYCODE_WAKEUP; A shell wm dismiss-keyguard >/dev/null 2>&1 || true; sleep 2
svc="$(A shell dumpsys activity services "$PKG" 2>/dev/null || true)"
grep -q "CallService" <<<"$svc" && grep -q "isForeground=true" <<<"$svc" || fail "call 7: A's call service is not in the foreground after Home + screen off"
nt="$(A shell dumpsys notification --noredact 2>/dev/null || true)"
grep -q "pkg=$PKG .*channel=call_ongoing" <<<"$nt" || fail "call 7: A has no ongoing-call notification"
for d in A B; do DEV=$d; s1="$(bytes_of sent)"; r1="$(bytes_of recv)"; sleep 5; s2="$(bytes_of sent)"; r2="$(bytes_of recv)"
  [ "${s2:-0}" -gt "${s1:-0}" ] && [ "${r2:-0}" -gt "${r1:-0}" ] || fail "call 7: $d audio stopped after a minute in the background (sent $s1→$s2, recv $r1→$r2)"; done
pass "call 7: after Home + a minute with the screen off the call lives on (foreground service, ongoing notification, audio both ways)"
DEV=A; A shell cmd statusbar expand-notifications >/dev/null 2>&1; sleep 1
# The ongoing CallStyle notification runs a chronometer, so uiautomator never sees the shade idle:
# fall back to the notification's place on the 720x1280 redroid screen (its title / HANG UP button).
tap "ZZ Call B" 2>/dev/null || A shell input tap 255 495
sleep 2; A shell cmd statusbar collapse >/dev/null 2>&1 || true
wait_for "End call" 10 || fail "call 7: tapping the notification didn't reopen the call screen"
pass "call 7: the ongoing notification reopens the call screen"
A shell input keyevent KEYCODE_HOME; sleep 1
A shell cmd statusbar expand-notifications >/dev/null 2>&1; sleep 1
tap "Hang up" 2>/dev/null || tap "HANG UP" 2>/dev/null || A shell input tap 310 644
sleep 1; A shell cmd statusbar collapse >/dev/null 2>&1 || true
DEV=B; for _ in $(seq 1 20); do has "End call" || break; sleep 1; done
has "End call" && fail "call 7: B still in the call after A hung up from the notification"
no_leftovers "call 7"
DEV=A; uid="$(uid_of)"; rec=""
for _ in $(seq 1 10); do rec="$(A shell dumpsys audio 2>/dev/null | sed -n '/RecordActivityMonitor/,/^$/p' | grep -E "uid:? ?$uid\b" || true)"; [ -z "$rec" ] && break; sleep 1; done
[ -z "$rec" ] || fail "call 7: A still records (microphone held) after hanging up: $rec"
nt="$(A shell dumpsys notification --noredact 2>/dev/null || true)"
grep -q "pkg=$PKG .*channel=call_ongoing" <<<"$nt" && fail "call 7: the ongoing notification stayed after hang-up"
pass "call 7: Hang up from the notification ended the call on both phones, released the microphone, removed the notification"
fi
DEV=A; open_chat "ZZ Call B" || fail "A: DM"
# Call 8 (the nightly.24 report: Back twice after a call left a dark screen): Back from the call
# screen goes to the chat while the call goes on; when the call ends no call screen, task or Recents
# card is left; a hang-up on the call screen returns to the chat.
top_act() { A shell dumpsys activity activities 2>/dev/null | grep -m1 -E 'topResumedActivity|mResumedActivity' || true; }
no_call_screen() {  # $1 label
  local acts rec; acts="$(A shell dumpsys activity activities 2>/dev/null || true)"; rec="$(A shell dumpsys activity recents 2>/dev/null || true)"
  grep -q "calls.CallActivity" <<<"$acts" && fail "$1: $DEV still has a call screen ($(top_act))"
  grep -q "lk.codegen.risime.calls" <<<"$rec" && fail "$1: $DEV's Recents still list the call task"
  return 0
}
if [ "${CALLTEST_SWITCH_ONLY:-0}" != 1 ]; then
DEV=B; open_chat "ZZ Call A" || fail "B: DM"; DEV=A; open_chat "ZZ Call B" || fail "A: DM"
call_once "call 8 (Back from the call screen)"
DEV=A; A shell input keyevent KEYCODE_BACK; sleep 2
[[ "$(top_act)" == *MainActivity* ]] || fail "call 8: Back from the call screen didn't show the chat ($(top_act))"
has "Call in progress" || fail "call 8: no 'Call in progress — tap to return' bar after Back"
A shell input keyevent KEYCODE_BACK; sleep 2
[[ "$(top_act)" != *CallActivity* ]] || fail "call 8: a second Back landed on the call screen"
DEV=B; tap "End call" || fail "call 8: B can't hang up"; sleep 5
DEV=A; no_call_screen "call 8 (ended from B while A was in the chats)"
for _ in 1 2; do A shell input keyevent KEYCODE_BACK; sleep 1; done
[[ "$(top_act)" != *CallActivity* ]] || fail "call 8: Back after the call reached a call screen"
pass "call 8: Back goes to the chat during the call; after the end no call screen, task or Recents card is left"
DEV=B; no_call_screen "call 8 (B hung up)"
[[ "$(top_act)" == *MainActivity* ]] || fail "call 8: B's hang-up didn't return to the chat ($(top_act))"
pass "call 8: hanging up on the call screen returns to the chat"
no_leftovers "call 8"
fi
DEV=A; open_chat "ZZ Call B" || fail "A: DM"; DEV=B; open_chat "ZZ Call A" || fail "B: DM"
# (A call to a phone whose screen is off can't be tested here: redroid has no FCM, and a backgrounded
# app has no socket. The locked-phone full-screen ring stays on the real-phone manual test.)
DEV=A; open_chat "ZZ Call B" || fail "A: DM"; DEV=B; open_chat "ZZ Call A" || fail "B: DM"
if [ "${CALLTEST_TURN:-0}" = 1 ]; then
  for DEV in A B; do A shell run-as "$PKG" touch files/debug_relay_only || fail "debug relay switch"; done
  DEV=B; open_chat "ZZ Call A" || fail "B: DM"   # back in the foreground (no FCM in redroid)
  DEV=A; open_chat "ZZ Call B" || fail "A: DM"
  MEDIA_PAIR="relay/relay"
  call_once "call 6 (relay only, through the live TURN server)"; hang_up_a "call 6"
  for DEV in A B; do A shell run-as "$PKG" rm -f files/debug_relay_only; done
  MEDIA_PAIR="(host|prflx)/(host|prflx)"
fi

# ---------------------------------------------------------------- video (§19, v1.18)
# Call 9: a 1:1 video call. Redroid has no camera sensor, so debug builds feed a moving test pattern
# (never in release builds). Frames are counted from the debug stats line (every 2 s)
#   "call video video/VP8 in 640x480@14.0 decoded=305 out 640x480@15.0 sent=123456".
# The receiver shows "<name>'s camera is off" (the avatar) on `camera: false` and after 3 s without
# a frame (§19.5).
vline() { A logcat -d 2>/dev/null | grep -E 'call video .*VP8 in .* decoded=' | tail -1 || true; }
vdecoded() { vline | sed -nE 's/.* decoded=([0-9]+) .*/\1/p'; }
vsent() { vline | sed -nE 's/.* out .* sent=([0-9]+).*/\1/p'; }
# frames_rise <label> <A|B>: the decoded count on that phone grows over 5 s.
frames_rise() {
  local d1 d2; DEV=$2; d1="$(vdecoded)"; sleep 5; d2="$(vdecoded)"
  [ "${d2:-0}" -gt "${d1:-0}" ] || fail "$1: no video frames decoded on $2 (decoded ${d1:-none}→${d2:-none}; $(vline | sed 's/.*call video //'))"
  echo "    [$2] decoded ${d1:-0}→$d2 ($(vline | sed -E 's/.*call video ([^ ]+ in [^ ]+).*/\1/'))"
}
# frames_stop <label>: A decodes nothing new over 5 s (B's camera off), after 3 s to drain.
frames_stop() {
  local d1 d2; DEV=A; sleep 3; d1="$(vdecoded)"; sleep 5; d2="$(vdecoded)"
  [ "${d2:-0}" = "${d1:-0}" ] || fail "$1: A still decodes B's video (decoded $d1→$d2)"
  echo "    [A] decoded stays at ${d2:-0}"
}
peer_avatar() { grep -qF "camera is off" "$WORK/ui-$DEV.xml"; }   # after a dump (has/wait_for)
video_call() {  # $1 label
  logcat_ok "before $1"
  for DEV in A B; do
    A shell pm grant "$PKG" android.permission.CAMERA 2>/dev/null || true
    A shell dumpsys package "$PKG" 2>/dev/null | grep -q "android.permission.CAMERA: granted=true" || fail "$1: CAMERA not granted on $DEV"
    A logcat -c
  done
  DEV=A; local ok=""; for _ in $(seq 1 20); do tap "Video call" && { ok=1; break; }; sleep 2; done
  if [ -z "$ok" ]; then
    tap "Video call (unavailable)" && sleep 0.5 && dump && grep -o 'text="[^"]*"' "$WORK/ui-$DEV.xml" | grep -v 'text="m-\|text=""' | head -8 | sed 's/^/    A shows: /'
    fail "$1: the Video call button never became enabled (video_ready)"
  fi
  sleep 1
  has "already in a call" && fail "$1: A says \"You're already in a call\""
  DEV=B; wait_ring 30 || fail "$1: B never rang"
  # The in-app answer path (not the notification's Answer, which answers with the camera off):
  # B is in the chat, so the green "Incoming call — tap to answer" bar opens the incoming screen.
  tap "Incoming call — tap to answer" || fail "$1: B has no incoming-call bar"
  wait_for "Incoming video call" 10 || fail "$1: B's call screen doesn't say \"Incoming video call\""
  has "Answer without video" || fail "$1: B's incoming screen has no \"Answer without video\""
  pass "$1: B rings and shows \"Incoming video call\" with \"Answer without video\""
  tap "Answer" || fail "$1: no in-screen Answer"
  local m=""; for _ in $(seq 1 30); do DEV=A; m="$(media_ok)"; [ -n "$m" ] && { DEV=B; [ -n "$(media_ok)" ] && break; }; m=""; sleep 1; done
  [ -n "$m" ] || fail "$1: media never connected ($MEDIA_PAIR) with DTLS-SRTP on both"
  local d; for _ in $(seq 1 15); do DEV=A; d="$(vdecoded)"; [ "${d:-0}" -gt 0 ] && { DEV=B; d="$(vdecoded)"; [ "${d:-0}" -gt 0 ] && break; }; sleep 1; done
  frames_rise "$1" A; frames_rise "$1" B
  DEV=A; has "End call" || fail "$1: A has no call screen"
  peer_avatar && fail "$1: A shows B's avatar although B's video flows"
  pass "$1: answered in the call screen with the camera on; VP8 frames decoded and rising on both phones (${m##*call stats: })"
  audio_ok "$1"
  route_ok "$1"
  if [ "${VIDEO_RATE:-0}" = 1 ]; then  # relay-only: the video bitrate each way through TURN
    local s1 s2
    for d in A B; do DEV=$d; s1="$(vsent)"; sleep 5; s2="$(vsent)"
      local kbps=$(( (${s2:-0} - ${s1:-0}) * 8 / 5000 ))
      [ "$kbps" -gt 100 ] || fail "$1: $d sends only $kbps kbit/s of video"
      echo "    [$d] video out ~$kbps kbit/s"; done
    pass "$1: video flows through the relay"
  fi
  # Camera off on B: A shows B's avatar and decodes nothing; on again: frames resume.
  # v1.23: with a v1.23 peer the Video button goes back to voice; the camera alone goes off from More.
  DEV=B; { tap "More options" && sleep 1 && tap "Turn camera off"; } || fail "$1: B has no \"Turn camera off\" in More"
  DEV=A; wait_for "camera is off" 10 || fail "$1: A doesn't show B's avatar after B turned the camera off"
  frames_stop "$1 (B's camera off)"
  pass "$1: B turned the camera off: A shows B's avatar, no frames decoded"
  DEV=B; wait_for "Turn camera on" 5 && tap "Turn camera on" || fail "$1: B has no \"Turn camera on\""
  frames_rise "$1 (B's camera on again)" A
  DEV=A; for _ in $(seq 1 10); do has "End call" && ! peer_avatar && break; sleep 1; done
  peer_avatar && fail "$1: A still shows B's avatar after B turned the camera on"
  pass "$1: B turned the camera on: frames resume on A, the avatar is gone"
  # Home on B (§19.5, android A1): B's camera stops (no video sent), A falls back to the avatar; the
  # call and audio go on. Back on the call screen, the camera restarts.
  DEV=B; A shell input keyevent KEYCODE_HOME; sleep 4
  local o1 o2 a1 a2; o1="$(vsent)"; a1="$(bytes_of sent)"; sleep 5; o2="$(vsent)"; a2="$(bytes_of sent)"
  [ "${o2:-0}" = "${o1:-0}" ] || fail "$1: B still sends video after Home (video bytes $o1→$o2)"
  [ "${a2:-0}" -gt "${a1:-0}" ] || fail "$1: B's audio stopped after Home (sent $a1→$a2)"
  DEV=A; wait_for "camera is off" 10 || fail "$1: A doesn't show B's avatar after B went Home"
  frames_stop "$1 (B at Home)"
  pass "$1: B pressed Home: B's camera stopped (no video sent, audio goes on), A shows B's avatar"
  audio_ok "$1 (B at Home)"
  DEV=B; A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null; sleep 2
  tap "Call in progress — tap to return" || fail "$1: B has no return-to-call bar"
  wait_for "End call" 10 || fail "$1: B's call screen didn't reopen"
  frames_rise "$1 (B back on the call screen)" A
  pass "$1: B back on the call screen: its camera restarted, frames resume on A"
  hang_up_a "$1"
  for d in A B; do DEV=$d; wait_for "Video call · " 15 || fail "$1: $d has no \"Video call · m:ss\" line"
    echo "    [$d] $(grep -oE 'Video call · [0-9:]+' "$WORK/ui-$DEV.xml" | tail -1)"; done
  pass "$1: \"Video call · m:ss\" in the chat on both phones"
}
DEV=A; open_chat "ZZ Call B" || fail "A: DM"; DEV=B; open_chat "ZZ Call A" || fail "B: DM"
[ "${CALLTEST_SWITCH_ONLY:-0}" = 1 ] || video_call "call 9 (video)"
# P0-3: video calls the other way round and answered from the notification (Harsha's phones: no sound,
# the speaker button inactive). video_simple <label> <caller> <callee> <screen|notification>.
video_simple() {
  local label="$1" caller="$2" callee="$3" how="$4" ok="" m="" d
  logcat_ok "before $label"
  for DEV in A B; do A shell pm grant "$PKG" android.permission.CAMERA 2>/dev/null || true; A logcat -c; done
  DEV=$caller; for _ in $(seq 1 20); do tap "Video call" && { ok=1; break; }; sleep 2; done
  [ -n "$ok" ] || fail "$label: $caller's Video call button never became enabled"
  sleep 1
  has "already in a call" && fail "$label: $caller says \"You're already in a call\""
  DEV=$callee; wait_ring 30 || fail "$label: $callee never rang"
  if [ "$how" = screen ]; then
    tap "Incoming call — tap to answer" || fail "$label: $callee has no incoming-call bar"
    wait_for "Incoming video call" 10 || fail "$label: $callee's call screen doesn't say \"Incoming video call\""
    tap "Answer" || fail "$label: no in-screen Answer"
  else
    answer_intent || fail "$label: no Answer action on the incoming-call notification"
  fi
  for _ in $(seq 1 30); do DEV=A; m="$(media_ok)"; [ -n "$m" ] && { DEV=B; [ -n "$(media_ok)" ] && break; }; m=""; sleep 1; done
  [ -n "$m" ] || fail "$label: media never connected ($MEDIA_PAIR) with DTLS-SRTP on both"
  # The notification's Answer answers with the camera off (android A3): only the callee decodes video.
  local watch="$caller $callee"; [ "$how" = screen ] || watch="$callee"
  for d in $watch; do for _ in $(seq 1 15); do DEV=$d; [ "$(vdecoded)" -gt 0 ] 2>/dev/null && break; sleep 1; done; frames_rise "$label" "$d"; done
  pass "$label: answered ($how); VP8 frames decoded and rising on $watch"
  audio_ok "$label"
  route_ok "$label"
  DEV=$caller; tap "End call" || fail "$label: $caller has no End call button"
  DEV=$callee; for _ in $(seq 1 20); do has "End call" || break; sleep 1; done
  has "End call" && fail "$label: $callee still in the call after $caller hung up"
  DEV=$caller; sleep 4; has "End call" && fail "$label: $caller still shows the call"
  pass "$label: $caller hung up; both ended"
  no_leftovers "$label"
}
if [ "${CALLTEST_SWITCH_ONLY:-0}" != 1 ]; then
DEV=B; open_chat "ZZ Call A" || fail "B: DM"; DEV=A; open_chat "ZZ Call B" || fail "A: DM"
video_simple "call 12 (video, B calls A, answered in the call screen)" B A screen
DEV=A; open_chat "ZZ Call B" || fail "A: DM"; DEV=B; open_chat "ZZ Call A" || fail "B: DM"
video_simple "call 13 (video, answered from the notification)" A B notification
# Call 10: a voice call right after the video call still works (no camera or video state left).
DEV=A; open_chat "ZZ Call B" || fail "A: DM"; DEV=B; open_chat "ZZ Call A" || fail "B: DM"
call_once "call 10 (voice after video)"; hang_up_a "call 10"
fi
if [ "${CALLTEST_TURN:-0}" = 1 ]; then
  # Call 11: video relay-only through the live TURN server (~1–2 Mbit/s each way, §19.8).
  for DEV in A B; do A shell run-as "$PKG" touch files/debug_relay_only || fail "debug relay switch"; done
  DEV=A; open_chat "ZZ Call B" || fail "A: DM"; DEV=B; open_chat "ZZ Call A" || fail "B: DM"
  MEDIA_PAIR="relay/relay"
  VIDEO_RATE=1 video_call "call 11 (video, relay only)"
  for DEV in A B; do A shell run-as "$PKG" rm -f files/debug_relay_only; done
  MEDIA_PAIR="(host|prflx)/(host|prflx)"
fi

# ---------------------------------------------------------------- v1.23 §23: switching and screen sharing
# Call 14 on the one call screen. Exactly one renegotiation per call, from the caller; audio at every
# phase boundary (audio_ok: audio_sent and audio_recv growing on both phones).
vsrc() { vline | sed -nE 's/.* src=([a-z]+).*/\1/p'; }
renegs() { A logcat -d 2>/dev/null | grep -c "calls: renegotiate: re-offer out" || true; }
# frames_still <label> <A|B>: no new decoded frames over 5 s (after 3 s to drain).
frames_still() {
  local d1 d2; DEV=$2; sleep 3; d1="$(vdecoded)"; sleep 5; d2="$(vdecoded)"
  [ "${d2:-0}" = "${d1:-0}" ] || fail "$1: $2 still decodes video in voice mode (decoded $d1→$d2)"
  echo "    [$2] decoded stays at ${d2:-0}"
}
# A's share: the Android ≤ 14 notifications warning, then the system consent (skipped by the appop).
consent() {
  wait_for "Share your screen?" 10 && { tap "Continue" || fail "$1: no Continue on the share warning"; }
  # The PROJECT_MEDIA appop grants at once; otherwise the system dialog is in front: "Start now".
  local i; for i in $(seq 1 8); do
    sleep 1
    [[ "$(top_act)" == *MediaProjectionPermissionActivity* ]] || break
    tap "Start now" || tap "START NOW" || true
  done
  return 0
}
switch_call() {
  local l="call 14 (§23 switch and share)" n d
  logcat_ok "before $l"
  for DEV in A B; do A shell pm grant "$PKG" android.permission.CAMERA 2>/dev/null || true; A logcat -c; done
  call_once "$l: voice"
  DEV=A; wait_for "Switch to video" 15 || fail "$l: A has no Video (switch) button: $(grep -o 'content-desc="Switch to video[^"]*"' "$WORK/ui-$DEV.xml" | head -1)"
  tap "Switch to video" || fail "$l: A can't tap Video"
  DEV=B; wait_for "Switch to video call?" 15 || fail "$l: B has no \"Switch to video call?\" prompt"
  pass "$l: A asked to switch; B shows \"Switch to video call?\""
  tap "Accept" || fail "$l: no Accept on B's prompt"
  for d in A B; do for _ in $(seq 1 20); do DEV=$d; [ "$(vdecoded)" -gt 0 ] 2>/dev/null && break; sleep 1; done; frames_rise "$l (video)" "$d"; done
  DEV=A; n="$(renegs)"; [ "$n" = 1 ] || fail "$l: A sent $n re-offers (want exactly 1)"
  DEV=B; [ "$(renegs)" = 0 ] || fail "$l: B (the callee) sent a re-offer"
  A logcat -d 2>/dev/null | grep -q "renegotiated: m=video added (callee)" || fail "$l: B never applied the re-offer"
  pass "$l: both in video: VP8 frames decoded and rising on both phones; exactly one re-offer, from A (the caller)"
  audio_ok "$l (video)"
  route_ok "$l (video)"
  DEV=A; tap "Switch to voice call" || fail "$l: A has no \"Switch to voice call\""
  frames_still "$l (back to voice)" A; frames_still "$l (back to voice)" B
  DEV=B; wait_for "Switch to video" 10 || fail "$l: B shows no voice UI after the switch back"
  audio_ok "$l (back to voice)"
  pass "$l: back to voice: no new frames on either phone, the voice UI, audio both ways"
  DEV=A; tap "Share screen" || fail "$l: A has no Share button"
  consent "$l"
  DEV=B; sleep 3; A exec-out screencap -p > "$LOGS/B-screen-prompt.png" 2>/dev/null || true
  wait_for "Watch ZZ Call A" 20 || fail "$l: B has no screen prompt"
  tap "Watch" || fail "$l: no Watch"
  DEV=B; wait_for "is sharing their screen" 20 || fail "$l: B shows no \"is sharing their screen\""
  for _ in $(seq 1 20); do DEV=B; [ "$(vdecoded)" -gt 0 ] 2>/dev/null && break; sleep 1; done
  frames_rise "$l (screen)" B
  DEV=A; has "sharing your screen" || fail "$l: A has no \"You're sharing your screen\" bar"
  [ "$(vsrc)" = screen ] || fail "$l: A's sender isn't the screen ($(vline | sed 's/.*call video //'))"
  DEV=A; n="$(renegs)"; [ "$n" = 1 ] || fail "$l: the share renegotiated again ($n re-offers)"
  audio_ok "$l (sharing)"
  pass "$l: A shares its screen: B shows the label and decodes frames, src=screen on A, still one re-offer"
  DEV=A; tap "Stop" || fail "$l: no Stop on A's bar"
  DEV=B; for _ in $(seq 1 15); do has "is sharing their screen" || break; sleep 1; done
  has "is sharing their screen" && fail "$l: B still shows the screen label after Stop"
  DEV=A; A logcat -d 2>/dev/null | grep -q "screen share off" || fail "$l: A's share didn't stop"
  pass "$l: Stop ended the share; B's label went"
  DEV=B; { tap "More options" && sleep 1 && tap "Switch to voice call"; } || fail "$l: B has no \"Switch to voice call\" in More"
  DEV=A; wait_for "Switch to video" 10 || fail "$l: A shows no voice UI after B's switch back"
  audio_ok "$l (voice again)"
  hang_up_a "$l"
  for d in A B; do DEV=$d; wait_for "Video call · " 15 || fail "$l: $d has no \"Video call · m:ss\" line"; done
  pass "$l: \"Video call · m:ss\" in the chat on both phones (the call was in video mode)"
}
# The call records (the call-records step) count the calls before call 14, so call 14 runs after them.
call_records
DEV=A; open_chat "ZZ Call B" || fail "A: DM"; DEV=B; open_chat "ZZ Call A" || fail "B: DM"
switch_call
logcat_ok "the end"
# CALLTEST_EXTRA=<file>: more steps sourced here with every helper available (debugging scenarios).
if [ -n "${CALLTEST_EXTRA:-}" ]; then source "$CALLTEST_EXTRA"; fi
echo "CALLTEST OK"
