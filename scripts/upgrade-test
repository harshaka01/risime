#!/usr/bin/env bash
# Upgrade test (release gate since the nightly.10 data loss): the PREVIOUS published APK, signed in
# and holding chats, is upgraded in place (`adb install -r`) to the NEW APK; every message must
# survive and the app must not ask to sign in again.
#
#   scripts/upgrade-test --new <apk> [--version X] [--commit SHA] [--old <apk|vX.Y.Z...>] [--serial S] [--serial-b S2]
#                        [--target auto|redroid|emulator|device] [--no-group] [--via-updater]
#     --via-updater (the release gate, scripts/nightly-release): the update goes through the app's own
#       in-app updater, as on a tester's phone, not `adb install -r`. A throwaway CA + a cert for
#       risicloud.ai; an HTTPS static server on 127.0.0.1 (random port) serving app/risime/version.json
#       (written by `scripts/publish-release --stage`, exactly as published) and the candidate APK; on
#       device A (root: redroid) the CA goes into the system and conscrypt-APEX cacerts, risicloud.ai ->
#       127.0.0.1 in /system/etc/hosts, and `adb reverse tcp:443` reaches the host server. The old app
#       then sees "RisiMe <new> is available", the script taps Update (and a package-installer confirm,
#       if one shows), waits for the new versionName and checks logcat ("Retain data and using new",
#       "Marking session N as applied"). Without the flag: `adb install -r` (emergency path).
#     UPDATER_BACK_SAFE_FROM=<versionCode>: when the OLD app's versionCode is at least this, the update
#       is started, Back is pressed within 1 s (download throttled so it is still running), the app is
#       reopened and the update must still complete. Unset (default) or an older OLD: skipped (logged);
#       nightly.30 and older cancel the update when the app is left (bug A).
#     Reinstall phase (§12.12, decision 060; after every other check, needs C's device and root):
#       REINSTALL_CHECK_FROM=<versionCode>: when the NEW app's versionCode is at least this (v1.21+:
#       reinstalls rejoin without reset), A (the group's only admin) is uninstalled (`adb uninstall`,
#       its data gone, as a tester's reinstall), the NEW APK installed with adb and A signed in again
#       through the login UI while C's app is stopped. A's group must show "Setting up encryption on
#       this phone…", C (started again) re-adds A's new device, the group's MLS generation stays the
#       same (server), nobody gets an "Encryption was reset" line, A->C and C->A go through (A's send
#       while waiting stays pending and arrives), and C's per-conversation counts don't drop.
#       Unset (default) or an older NEW: skipped (logged). scripts/nightly-release sets it.
#       Before that phase C is updated in place to the NEW app (`adb install -r`, its counts must not
#       drop), so the re-add runs on the app being released; UPGRADE_C_STAYS_OLD=1 keeps C old.
#       RESTORE_CHECK_FROM=<versionCode> (§22, decision 059; v1.22+): before the uninstall, A turns on
#       server backup in Settings → Manage backups (recovery key read from the screen, groups 2 and 7
#       typed back, no passphrase), waits for "Backed up" + "Last server backup: <date> · <size>",
#       exports a backup file (/sdcard/Download/risime-backup-<date>.risimebk) and records its
#       per-conversation Room counts. After the uninstall A's inbox replay is purged on the TEMP server
#       (its own keyspace), so the restore alone must bring the messages back. The sign-in then lands on
#       "Restore your chats": Restore → recovery key → the chat list; every conversation/kind count is
#       >= before (the 1:1 chats equal) and logcat has "restore <backup_id>: N imported". Then the
#       rejoin checks. Unset (default) or an older NEW: skipped (logged). scripts/nightly-release sets it.
#     --restore-from-file: the restore goes through the exported file instead: Skip at the gate, then
#       Settings → Manage backups → Restore from file → the file in the system picker → recovery key →
#       "Restored N messages." → OK.
#     --no-reinstall: skip that phase (emergency only; the result says reinstall=off).
#     Per chat (§24.14, decision 065): besides per conversation, the Room counts are compared per
#       chat_id (Room v11 `chat_tabs`; a conversation without a row is its own chat) after the update
#       and after the re-sign-in, and every pre-update conversation must then be Private with
#       chat_id = conversation_id: a chat_tabs row saying exactly that, or no row (the app's rule:
#       no row = Private, its own chat). Skipped, logged, for an app without chat_tabs.
#     Locked chat (LOCKED_CHAT_CHECK_FROM=<versionCode>, default 20037 = the first app with Locked
#       chats): when the OLD app is at least this, user D writes to A, A gets a screen-lock PIN
#       (`locksettings set-pin`) and locks D's chat on the old app through the real UI (long-press ->
#       Lock chat -> the system credential prompt). After the update D's chat must stay out of the
#       chat list, sit in the Locked chats folder (pull-down -> PIN), keep its messages in Room, and
#       stay hidden after the re-sign-in. The PIN is cleared after the folder check (and on exit).
#       UPGRADE_NO_LOCKED_CHAT=1 skips it (emergency only; the result says locked=off).
#     UPGRADE_OUTDIR=<dir>: write the result there instead of ~/risime-logs/upgrade-test (a trial run).
#     --reinstall-dm-offline: also a DM A-C (set up first): C stays stopped REINSTALL_DM_WAIT s (180)
#       after A's sign-in; A's DM shows "Waiting for ZZ Upgrade C to open RisiMe", the DM's generation
#       is unchanged (no reset, which apps up to v1.20 did after 2 min), and A's pending DM arrives once
#       C opens the app. About 3 min longer.
#     auto (default): an attached adb device if there is one, else redroid on spark2.
#     redroid: spark2 starts throwaway Android containers (scripts/android-target) and removes them after:
#       A's, and C's (REDROID_INSTANCE + "-b", REDROID_PORT + 1) for the group checks. --no-group runs
#       A alone (about 2 GB less RAM; the group, photo and group-delete checks are then skipped).
#   scripts/upgrade-test --fetch-candidate      # laptop: pull spark2's staged release candidate, test it, send the result back
#   scripts/upgrade-test --fetch-candidate --manual-signin   # you sign in on the emulator; the script shows the code
# On a failure the script saves a screenshot, a UI dump and the app's logcat next to the result
# (~/risime-logs/upgrade-test/v<version>-<time>/), and copies them to spark2 with the result.
#
# Needs one adb device (an emulator, a test phone, or redroid; never a tester's own phone: the app is
# uninstalled first). spark2 has no Android emulator (no linux-aarch64 build exists); it runs the test
# unattended in redroid (native arm64 Android in Docker, decision 045). The laptop emulator still works.
#
# What it does:
#  1. A temporary server from this checkout on 127.0.0.1:4110 (own DB/keyspace risime_upgrade,
#     dropped and recreated each run; dev OTP login, codes only in its own log; E2EE on with a
#     per-run attestation key, as on the pilot). On the laptop it runs on spark2 over ssh and is
#     reached through an ssh -L tunnel. Never :4000.
#  2. Device: uninstall, install OLD, adb reverse tcp:4110, sign user A in through the real login
#     UI (dev OTP), befriend B (server fixture), B sends DMs to A (server fixture: B has no device,
#     so the DM stays plaintext), A replies via UI.
#     With a second device (redroid's second container, or --serial-b), user C signs in on the old
#     app there, and A creates the group "Upgrade group" with C (MLS) and sends one message.
#  3. Snapshot: the messages A sees (UI dump; plus Room rows when `adb root` works, i.e. a
#     google_apis emulator image).
#  4. `adb install -r NEW` (or, --via-updater, the in-app updater installs it), start it, then verify: no sign-in screen, the chat list shows B (and the
#     group), every seeded message is still in the chat, and (with root) the Room row counts and
#     the session/owner keys in the DataStore are unchanged. With root, also after the upgrade:
#     a new message is delivered; a reaction to a seeded message is stored and confirmed (Room
#     `reactions`). With the group: the group row (name) and MLS state are kept and A sends in the
#     group (C receives it); a photo uploads (the server holds a blob); "Delete for everyone" of
#     the seeded group message leaves a tombstone at A (Room) and at C (UI).
#  5. Writes ~/risime-logs/upgrade-test/v<version>.result (PASS|FAIL, versions, commit, sha256, host,
#     time). scripts/nightly-release refuses to release without a fresh PASS for its version+commit.
set -euo pipefail
cd "$(dirname "$0")/.."
REPO="$PWD"
M="$HOME/.local/bin/mise exec --"
# UPGRADE_INSTANCE (e.g. _rel) isolates a run: its own temp-server port, tmux session, DB/keyspace,
# worktree and redroid container (REDROID_INSTANCE/REDROID_PORT are derived unless already set).
USUF="${UPGRADE_INSTANCE:-}"; PORT="${UPGRADE_PORT:-4110}"
if [ -n "$USUF" ]; then export REDROID_INSTANCE="${REDROID_INSTANCE:-${USUF//_/-}}" REDROID_PORT="${REDROID_PORT:-$((5655 + PORT - 4110))}"; fi
PKG=lk.codegen.risime
SPARK="${SPARK_HOST:-spark2}"
# UPGRADE_OUTDIR: where the result goes (a trial run elsewhere never counts as a release PASS).
OUTDIR="${UPGRADE_OUTDIR:-$HOME/risime-logs/upgrade-test}"
on_spark2() { [ -d /srv/git/locks ]; }
# No `cmd | head` / `cmd | grep -q` under pipefail: the writer dies of SIGPIPE (exit 141) when the
# reader stops early. Capture output into a variable, then parse it.
has_text() { [[ "$1" == *"$2"* ]]; }
field() { [[ "$1" =~ $2=([0-9]+) ]] && echo "${BASH_REMATCH[1]}" || echo ""; }  # "k=v k2=v2" -> v

# ---------------------------------------------------------------- server half (runs on spark2) --
if [ "${1:-}" = _server ]; then
  shift; cmd="$1"; RUN="$HOME/risime-logs/upgrade-test/server$USUF"; mkdir -p "$RUN"
  export RISIME_DEV_DB=risime_upgrade$USUF RISIME_DEV_KEYSPACE=risime_upgrade$USUF ERL_EPMD_ADDRESS=127.0.0.1
  # The temp server runs from a clean worktree at the commit under test (UPGRADE_SERVER_REV, default
  # HEAD), never from the shared checkout: other sessions' uncommitted edits or compiles can't break
  # or stall it. Its own build dir, deps shared read-only, and no code reloading.
  WT="$HOME/.cache/risime-upgrade-wt$USUF"; REV="${UPGRADE_SERVER_REV:-$(git -C "$REPO" rev-parse HEAD)}"
  if [ "$cmd" = start ]; then
    if [ -e "$WT/.git" ]; then git -C "$WT" checkout -q --force --detach "$REV"
    else mkdir -p "$(dirname "$WT")"; git -C "$REPO" worktree add -q --force --detach "$WT" "$REV"; fi
    ln -sfn "$REPO/.env" "$WT/.env"
    [ -e "$WT/server/deps" ] || ln -s "$REPO/server/deps" "$WT/server/deps"
    echo "    temp server source: $(git -C "$WT" log -1 --format='%h %s' | cut -c1-70)"
  fi
  SRV="$WT/server"
  export MIX_BUILD_PATH="$SRV/_build/upgrade-test" RISIME_CODE_RELOADER=false
  fx() { (cd "$SRV" && $M mix run "$RUN/fixtures.exs" "$@" 2>/dev/null | grep '^upgrade:' || true); }
  case "$cmd" in
    start)
      tmux kill-session -t "risime-upgrade$USUF" 2>/dev/null || true; sleep 1
      busy="$(ss -ltnH "sport = :$PORT" || true)"; [ -z "$busy" ] || { echo "port $PORT busy"; exit 1; }
      cat > "$RUN/fixtures.exs" <<'EXS'
alias RisiMe.{Accounts, Repo}
alias RisiMe.Accounts.User
[mode | rest] = System.argv()
a_phone = "+94770000961"; b_phone = "+94770000962"; c_phone = "+94770000963"; d_phone = "+94770000964"
user! = fn phone ->
  Repo.get_by(User, phone: phone) ||
    (e = Accounts.get_allowlist_entry(phone)
     Repo.insert!(%User{phone: e.phone, email: e.email, display_name: e.display_name, company: e.company}))
end
case mode do
  "setup" ->
    {:ok, _} = Accounts.allow(%{phone: a_phone, email: "upgrade61@example.com", display_name: "ZZ Upgrade A", company: "CodeGen"})
    {:ok, _} = Accounts.allow(%{phone: b_phone, email: "upgrade62@example.com", display_name: "ZZ Upgrade B", company: "CodeGen"})
    {:ok, _} = Accounts.allow(%{phone: c_phone, email: "upgrade63@example.com", display_name: "ZZ Upgrade C", company: "CodeGen"})
    {:ok, _} = Accounts.allow(%{phone: d_phone, email: "upgrade64@example.com", display_name: "ZZ Upgrade D", company: "CodeGen"})
    IO.puts("upgrade: setup ok")
  "friends" ->
    RisiMe.Social.make_friends!(user!.(a_phone).id, user!.(b_phone).id)
    IO.puts("upgrade: friends ok")
  "friends_c" ->
    RisiMe.Social.make_friends!(user!.(a_phone).id, user!.(c_phone).id)
    IO.puts("upgrade: friends_c ok")
  "friends_d" ->
    RisiMe.Social.make_friends!(user!.(a_phone).id, user!.(d_phone).id)
    IO.puts("upgrade: friends_d ok")
  "send_d" ->
    # The locked-chat step: D (no device, so plaintext) writes to A.
    [n] = rest
    a = user!.(a_phone); d = user!.(d_phone)
    ok = for i <- 1..String.to_integer(n), reduce: 0 do
      acc ->
        case RisiMe.Messaging.send(d.id, %{"to" => a.id, "client_msg_id" => Ecto.UUID.generate(), "body" => "upgrade-test D#{i}"}) do
          {:ok, _} -> acc + 1
          _ -> acc
        end
    end
    IO.puts("upgrade: sent_d #{ok}")
  "blobs" ->
    IO.puts("upgrade: blobs=#{Repo.aggregate("blobs", :count)}")
  "purge_inbox" ->
    # The restore check: A's whole inbox partition goes, so nothing can come back from the replay.
    # The temp server's own keyspace only (RISIME_DEV_KEYSPACE=risime_upgrade<instance>).
    a = user!.(a_phone)
    cl = RisiMe.Messaging.Store.Cassandra.Cluster
    q = fn stmt ->
      Enum.reduce_while(1..20, :error, fn _, _ ->
        r = try do
          Xandra.Cluster.run(cl, fn conn ->
            with {:ok, p} <- Xandra.prepare(conn, stmt), do: Xandra.execute(conn, p, [a.id], timeout: 30_000)
          end)
        rescue
          e -> {:error, e}
        end
        case r do
          {:ok, page} -> {:halt, {:ok, page}}
          _ -> Process.sleep(1000); {:cont, r}
        end
      end)
    end
    n = fn -> case q.("SELECT event_id FROM inbox_events WHERE user_id = ?") do {:ok, p} -> Enum.count(p); _ -> -1 end end
    before = n.()
    {:ok, _} = q.("DELETE FROM inbox_events WHERE user_id = ?")
    IO.puts("upgrade: purged=#{before} left=#{n.()}")
  "send" ->
    [n] = rest
    a = user!.(a_phone); b = user!.(b_phone)
    ok = for i <- 1..String.to_integer(n), reduce: 0 do
      acc ->
        case RisiMe.Messaging.send(b.id, %{"to" => a.id, "client_msg_id" => Ecto.UUID.generate(), "body" => "upgrade-test B#{i}"}) do
          {:ok, _} -> acc + 1
          _ -> acc
        end
    end
    IO.puts("upgrade: sent #{ok}")
  "mls" ->
    # The reinstall phase: A's group (creator, admins), its MLS generation/epoch, A's leaves and the
    # pending ops; the DM A-C likewise. "null" = no row (or a reset DM awaiting its rebuild).
    a = user!.(a_phone); c = user!.(c_phone); au = Ecto.UUID.dump!(a.id)
    one = fn sql, args -> case Repo.query!(sql, args).rows do [[v | _] | _] -> v; _ -> nil end end
    s = fn nil -> "null"; v -> to_string(v) end
    grp = one.("SELECT g.id FROM groups g JOIN group_members m ON m.group_id = g.id WHERE m.user_id = $1 ORDER BY g.created_at LIMIT 1", [au])
    dm = RisiMe.Messaging.conversation_id(a.id, c.id)
    g = grp && RisiMe.MLS.group(grp)
    d = RisiMe.MLS.group(dm)
    q = fn sql -> grp && one.(sql, [grp]) end
    qa = fn sql -> grp && one.(sql, [grp, au]) end
    IO.puts("upgrade: grp=#{s.(grp)} creatora=#{s.(qa.("SELECT (created_by = $2)::int FROM groups WHERE id = $1"))}" <>
      " admins=#{s.(q.("SELECT count(*) FROM group_members WHERE group_id = $1 AND role = 'admin' AND state = 'active'"))}" <>
      " aadmin=#{s.(qa.("SELECT count(*) FROM group_members WHERE group_id = $1 AND user_id = $2 AND role = 'admin'"))}" <>
      " grpgen=#{s.(g && g.generation)} grpepoch=#{s.(g && g.epoch)}" <>
      " aleaves=#{s.(qa.("SELECT count(*) FROM mls_group_devices WHERE conversation_id = $1 AND user_id = $2"))}" <>
      " grpops=#{s.(q.("SELECT count(*) FROM group_ops WHERE group_id = $1"))}" <>
      " dmgen=#{s.(d && d.generation)} dmepoch=#{s.(d && d.epoch)}" <>
      " dmops=#{s.(one.("SELECT count(*) FROM mls_dm_ops WHERE conversation_id = $1", [dm]))}")
end
EXS
      (cd "$SRV" && $M mix ecto.drop --quiet --force >/dev/null 2>&1 || true
       $M mix ecto.create --quiet >/dev/null && $M mix ecto.migrate --quiet >/dev/null && $M mix risime.cql.migrate --quiet >/dev/null) \
        || { echo "could not create/migrate the upgrade store"; exit 1; }
      (cd "$SRV" && $M mix compile >/dev/null 2>&1) || { echo "temp server: compile failed"; exit 1; }
      # A per-run E2EE attestation key (never the pilot's): groups, photos and deletes need MLS.
      rm -f "$RUN/attest.jwk"
      (cd "$SRV" && $M mix risime.attestation.gen "$RUN/attest.jwk" >/dev/null 2>&1) || true
      [ -f "$RUN/attest.jwk" ] || { echo "could not create a temp attestation key"; exit 1; }
      tmux new -d -s "risime-upgrade$USUF" "cd '$SRV' && MIX_BUILD_PATH='$MIX_BUILD_PATH' RISIME_CODE_RELOADER=false RISIME_DEV_DB=risime_upgrade$USUF RISIME_DEV_KEYSPACE=risime_upgrade$USUF ERL_EPMD_ADDRESS=127.0.0.1 \
        PORT=$PORT DEV_LOCAL_AUTH=true OIDC_ENABLED=false OTP_DEV_LOG=true PHONE_VERIFICATION=off FCM_ENABLED=false LOG_FORMAT=text \
        RISIME_AUTH_LOG='$RUN/auth.log' ATTESTATION_KEY_FILE='$RUN/attest.jwk' $M mix phx.server > '$RUN/server.log' 2>&1"
      for _ in $(seq 1 120); do curl -sf -o /dev/null "http://127.0.0.1:$PORT/health" && break; sleep 1; done
      curl -sf -o /dev/null "http://127.0.0.1:$PORT/health" || { echo "upgrade server didn't start"; tail -20 "$RUN/server.log"; exit 1; }
      fx setup ;;
    friends) fx friends ;;
    friends_c) fx friends_c ;;
    friends_d) fx friends_d ;;
    send_d) fx send_d "${2:?count}" ;;
    blobs) fx blobs ;;
    mls) fx mls ;;
    purge_inbox) fx purge_inbox ;;
    send) fx send "${2:?count}" ;;
    # The newest dev OTP for a phone (the code is printed to the caller only, never logged here).
    otp) grep -a "\[DEV OTP\] ${2:?phone}:" "$RUN/server.log" | tail -1 | grep -oE '[0-9]{6}' | tail -1 || true ;;
    stop) tmux kill-session -t "risime-upgrade$USUF" 2>/dev/null || true ;;
    *) echo "unknown _server $cmd"; exit 2 ;;
  esac
  exit 0
fi

# ---------------------------------------------------------------- driver half ------------------
NEW=""; OLD=""; VERSION=""; COMMIT=""; SERIAL="${ANDROID_SERIAL:-}"; SERIAL_B=""; FETCH=0; MANUAL=0; DEV=""; TARGET=auto; GROUP=1; VIA=adb; REINSTALL=1; DM_OFFLINE=0; RESTORE_FILE=0
while [ $# -gt 0 ]; do case "$1" in
  --new) NEW="$2"; shift 2;; --old) OLD="$2"; shift 2;; --version) VERSION="$2"; shift 2;;
  --commit) COMMIT="$2"; shift 2;; --serial) SERIAL="$2"; shift 2;; --serial-b) SERIAL_B="$2"; shift 2;;
  --fetch-candidate) FETCH=1; shift;;
  --target) TARGET="$2"; shift 2;;
  --manual-signin) MANUAL=1; shift;;
  --no-group) GROUP=0; shift;;
  --via-updater) VIA=updater; shift;;
  --via-adb) VIA=adb; shift;;
  --no-reinstall) REINSTALL=0; shift;;
  --reinstall-dm-offline) DM_OFFLINE=1; shift;;
  --restore-from-file) RESTORE_FILE=1; shift;;
  *) echo "unknown arg $1"; exit 2;; esac; done

case "$TARGET" in auto|redroid|emulator|device) ;; *) echo "--target auto|redroid|emulator|device"; exit 2;; esac
# spark2's SDK adb is x86-64: use the arm64 adb (user space, scripts/android-target adb).
if [ "$(uname -m)" = aarch64 ]; then PATH="$("$REPO/scripts/android-target" adb):$PATH"; fi
WORK="$(mktemp -d "${TMPDIR:-/tmp}/risime-upgrade.XXXXXX")"
TUNNEL_PID=""; STARTED_TARGET=""; STARTED_B=""; CHECKS=""; UPD_PID=""; UPD_PORT=""; BACK_STEP=no; RI_STEP=no; RS_STEP=no; LK_STEP=no; PIN_SET=""; LK_PIN=1357
STEP="start"; RESULT=FAIL; REASON=""; RESULT_WRITTEN=0; VERSION_FOR_RESULT=""
step() { STEP="$*"; echo "==> $*"; }
fail() { REASON="$1"; echo "UPGRADE TEST FAILED: $1"; write_result; exit 1; }
write_result() {
  mkdir -p "$OUTDIR"
  local f="$OUTDIR/v$VERSION.result"
  RESULT_WRITTEN=1
  { echo "result=$RESULT"; echo "version=$VERSION"; echo "commit=$COMMIT"; echo "old=${OLD_VN:-}"; echo "new=${NEW_VN:-}"
    echo "new_sha256=$(sha256sum "$NEW" | cut -d' ' -f1)"; echo "host=$(hostname)"; echo "device=$(adb -s "$SERIAL" shell getprop ro.product.model 2>/dev/null | tr -d '\r')"
    echo "group=${SERIAL_B:+yes}"; echo "via=$VIA"; echo "back_step=$BACK_STEP"; echo "reinstall=$RI_STEP"; echo "restore=$RS_STEP"; echo "locked=$LK_STEP"; echo "checks=${CHECKS# }"; echo "reason=$REASON"; echo "time=$(date -u +%s)"; echo "date=$(date -u -Iseconds)"; } > "$f"
  echo "==> result: $f"
  local diag=""
  [ "$RESULT" = PASS ] || diag="$(save_diagnostics || true)"
  if [ "$FETCH" = 1 ]; then
    scp -q "$f" "$SPARK:risime-logs/upgrade-test/" && echo "==> result copied to $SPARK" || echo "WARN: could not copy the result to $SPARK"
    [ -n "$diag" ] && scp -qr "$diag" "$SPARK:risime-logs/upgrade-test/" && echo "==> diagnostics copied to $SPARK:risime-logs/upgrade-test/$(basename "$diag")" || true
  fi
}
# Screenshot + UI dump + the app's own logcat lines (never the whole device log) of the device that failed.
save_diagnostics() {
  local d="$OUTDIR/v${VERSION:-unknown}-$(date -u +%Y%m%dT%H%M%SZ)" dev="${DEV:-$SERIAL}"
  [ -n "$dev" ] || return 1
  mkdir -p "$d"
  adb -s "$dev" exec-out screencap -p > "$d/screen.png" 2>/dev/null || rm -f "$d/screen.png"
  adb -s "$dev" shell uiautomator dump /sdcard/ui.xml >/dev/null 2>&1 && adb -s "$dev" exec-out cat /sdcard/ui.xml > "$d/ui.xml" 2>/dev/null || true
  local pid; pid="$(adb -s "$dev" shell pidof "$PKG" 2>/dev/null | tr -d '\r' || true)"
  if [ -n "$pid" ]; then adb -s "$dev" logcat -d --pid="$pid" -t 400 > "$d/logcat.txt" 2>/dev/null || true; fi
  { echo "step=$STEP"; echo "reason=$REASON"; echo "device=$dev"; } > "$d/INFO"
  echo "==> diagnostics: $d (screen.png, ui.xml, logcat.txt)" >&2
  echo "$d"
}
# C's container: the same instance name + "-b", the next port.
redroid_b() { REDROID_INSTANCE="${REDROID_INSTANCE:-}-b" REDROID_PORT="$(( ${REDROID_PORT:-5655} + 1 ))" "$REPO/scripts/android-target" "$@"; }
srv() { if on_spark2; then "$REPO/scripts/upgrade-test" _server "$@"; else ssh "$SPARK" "cd ~/development/risime && scripts/upgrade-test _server $*"; fi; }
cleanup() {
  local rc=$?
  if [ "$RESULT_WRITTEN" = 0 ]; then   # every exit path ends in PASS or FAIL
    REASON="aborted during: $STEP (exit $rc)"
    echo "UPGRADE TEST FAILED: $REASON"
    [ -n "$VERSION" ] && [ -n "$NEW" ] && [ -f "$NEW" ] && write_result || true
  fi
  # UPGRADE_KEEP=1 (debugging the script): leave the server and containers up after a failure.
  if [ "${UPGRADE_KEEP:-0}" = 1 ] && [ "$RESULT" != PASS ]; then echo "==> UPGRADE_KEEP=1: server and devices left running ($SERIAL ${SERIAL_B:-})"; return; fi
  # The locked-chat step's screen-lock PIN never outlives the run (a reused device or emulator).
  [ -n "$PIN_SET" ] && { timeout 30 adb -s "$PIN_SET" shell locksettings clear --old "$LK_PIN" >/dev/null 2>&1 || true; }
  srv stop >/dev/null 2>&1 || true
  [ -n "$STARTED_TARGET" ] && "$REPO/scripts/android-target" stop >/dev/null 2>&1 || true
  [ -n "$STARTED_B" ] && redroid_b stop >/dev/null 2>&1 || true
  [ -n "$TUNNEL_PID" ] && kill "$TUNNEL_PID" 2>/dev/null || true
  [ -n "$UPD_PID" ] && kill "$UPD_PID" 2>/dev/null || true
  rm -rf -- "${WORK:?}"
}
trap cleanup EXIT
trap 'exit 130' INT TERM
trap 'STEP="$STEP; failed: line $LINENO: $BASH_COMMAND"' ERR

if [ "$FETCH" = 1 ]; then
  # Laptop: spark2's nightly-release staged the candidate in ~/risime-releases/candidate/.
  step "fetch the release candidate from $SPARK"
  scp -q "$SPARK:risime-releases/candidate/app-release.apk" "$WORK/new.apk"
  scp -q "$SPARK:risime-releases/candidate/CANDIDATE" "$WORK/CANDIDATE"
  NEW="$WORK/new.apk"
  VERSION="$(sed -n 's/^version=//p' "$WORK/CANDIDATE")"; COMMIT="$(sed -n 's/^commit=//p' "$WORK/CANDIDATE")"
fi
[ -n "$NEW" ] && [ -f "$NEW" ] || { echo "--new <apk> is required"; exit 2; }
command -v adb >/dev/null || { echo "adb not found (Android platform-tools on PATH)"; exit 1; }
BT="$(ls -d "${ANDROID_HOME:-$HOME/Android/Sdk}"/build-tools/* 2>/dev/null | sort -V | tail -1)"
# The "package:" line of `aapt2 dump badging`, captured whole (never piped into head).
badging() { local out; out="$("$BT/aapt2" dump badging "$1" 2>/dev/null || true)"; printf '%s' "${out%%$'\n'*}"; }
vc_of() { local b; b="$(badging "$1")"; [[ "$b" =~ versionCode=\'([0-9]+)\' ]] && echo "${BASH_REMATCH[1]}" || echo ""; }
vn_of() { local b; b="$(badging "$1")"; [[ "$b" =~ versionName=\'([^\']+)\' ]] && echo "${BASH_REMATCH[1]}" || echo ""; }
step "read the candidate's version (aapt2 in $BT)"
NEW_VC="$(vc_of "$NEW")"; NEW_VN="$(vn_of "$NEW")"
[ -n "$NEW_VC" ] && [ -n "$NEW_VN" ] || { echo "could not read the candidate's version with $BT/aapt2"; exit 1; }
echo "    candidate $NEW_VN ($NEW_VC), commit ${COMMIT:-HEAD}"
VERSION="${VERSION:-$NEW_VN}"; COMMIT="${COMMIT:-$(git rev-parse HEAD)}"

# The previous published APK: version.json (what testers have), else the newest local release.
if [ -z "$OLD" ]; then
  step "download the previous published APK (version.json)"
  if curl -fsSL https://risicloud.ai/app/risime/version.json -o "$WORK/version.json"; then
    url="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["url"])' "$WORK/version.json")"
    sha="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["sha256"])' "$WORK/version.json")"
    curl -fsSL "$url" -o "$WORK/old.apk"
    echo "$sha  $WORK/old.apk" | sha256sum -c --quiet || { echo "published APK sha256 mismatch"; exit 1; }
    OLD="$WORK/old.apk"
  else
    OLD="$HOME/risime-releases/$(cat "$HOME/risime-releases/LATEST")"
  fi
fi
case "$OLD" in v*) OLD="$(ls "$HOME/risime-releases/$OLD"/risime-*.apk)";; esac
[ -d "$OLD" ] && OLD="$(ls "$OLD"/risime-*.apk)"
OLD_VC="$(vc_of "$OLD")"; OLD_VN="$(vn_of "$OLD")"
[ -n "$OLD_VC" ] || { echo "could not read the old APK's version"; exit 1; }
[ "${NEW_VC:-0}" -gt "${OLD_VC:-0}" ] || { echo "new versionCode ($NEW_VC) must be above the old one ($OLD_VC)"; exit 1; }
echo "==> upgrade $OLD_VN ($OLD_VC) -> $NEW_VN ($NEW_VC)"

step "find the adb device (target: $TARGET)"
adb start-server >/dev/null 2>&1 || true
devs_now() { local out; out="$(adb devices 2>/dev/null || true)"; awk 'NR>1 && $2=="device"{print $1}' <<<"$out"; }
mapfile -t DEVS < <(devs_now)
if [ "$TARGET" = redroid ] || { [ "$TARGET" = auto ] && [ ${#DEVS[@]} -eq 0 ] && on_spark2; }; then
  [ -z "$SERIAL_B" ] || { echo "--serial-b is not used with redroid (it starts C's container itself; --no-group skips it)"; exit 2; }
  step "start redroid (scripts/android-target start; C's container too unless --no-group)"
  STARTED_TARGET=redroid
  [ "$GROUP" = 1 ] && { STARTED_B=1; redroid_b start > "$WORK/serial-b" 2> "$WORK/redroid-b.log" & RB_PID=$!; }
  SERIAL="$("$REPO/scripts/android-target" start)" || { STARTED_TARGET=""; echo "could not start redroid"; exit 1; }
  echo "    redroid up: $SERIAL ($(adb -s "$SERIAL" shell getprop ro.build.version.release | tr -d '\r'), $(adb -s "$SERIAL" shell getprop ro.product.cpu.abi | tr -d '\r'))"
  if [ "$GROUP" = 1 ]; then
    wait "$RB_PID" || { cat "$WORK/redroid-b.log" >&2; echo "could not start C's redroid (--no-group runs without it)"; exit 1; }
    SERIAL_B="$(tail -1 "$WORK/serial-b")"; echo "    C's redroid up: $SERIAL_B"
  fi
else
  [ ${#DEVS[@]} -gt 0 ] || { echo "no adb device. Start an emulator (laptop: emulator -avd risime_a) or attach a TEST phone (spark2: --target redroid)."; exit 1; }
  SERIAL="${SERIAL:-${DEVS[0]}}"
  for s in "$SERIAL" ${SERIAL_B:+"$SERIAL_B"}; do
    case "$s" in emulator-*) ;; *) [ "${UPGRADE_TEST_WIPE_DEVICE:-0}" = 1 ] || { echo "$s is not an emulator: set UPGRADE_TEST_WIPE_DEVICE=1 to allow uninstalling RisiMe on it"; exit 1; };; esac
  done
fi

# ---- server
step "temp server on 127.0.0.1:$PORT ($(on_spark2 && echo local || echo "on $SPARK via ssh tunnel"))"
srv start
if ! on_spark2; then
  ssh -N -o ExitOnForwardFailure=yes -L "$PORT:127.0.0.1:$PORT" "$SPARK" & TUNNEL_PID=$!
  for _ in $(seq 1 20); do curl -sf -o /dev/null "http://127.0.0.1:$PORT/health" && break; sleep 1; done
fi
curl -sf -o /dev/null "http://127.0.0.1:$PORT/health" || { echo "server not reachable on :$PORT"; exit 1; }

# ---- UI helpers (uiautomator dump + taps by visible text)
A() { adb -s "$DEV" "$@"; }
# A fresh dump every time (a failed dump must not leave the previous screen's file behind).
dump() {
  local out
  for _ in 1 2 3; do
    A shell rm -f /sdcard/ui.xml >/dev/null 2>&1 || true
    out="$(A shell uiautomator dump /sdcard/ui.xml 2>&1 || true)"
    has_text "$out" "dumped to" && break
    sleep 1
  done
  A exec-out cat /sdcard/ui.xml > "$WORK/ui.xml" 2>/dev/null || : > "$WORK/ui.xml"
}
has() { dump; grep -qF -- "$1" "$WORK/ui.xml"; }
wait_for() { for _ in $(seq 1 "${2:-30}"); do has "$1" && return 0; sleep 1; done; echo "timeout waiting for a UI element: $1"; return 1; }
# The chat list, signed in: its top bar's "Refresh friends" icon (any list), or the empty list's
# "Add friend" button. Never the FAB's label: uiautomator shows extended FABs without text, so a
# list with chats has no "Add friend" node (the nightly.26 re-sign-in failure).
on_chat_list() { dump; grep -qF -e 'content-desc="Refresh friends"' -e 'text="Add friend"' "$WORK/ui.xml"; }
wait_chat_list() { for _ in $(seq 1 "${1:-40}"); do on_chat_list && return 0; sleep 1; done; echo "timeout waiting for the chat list"; return 1; }
# The centre of the node whose text or content-desc equals $1 ("x*": text starts with x; "~x":
# text or content-desc contains x, e.g. a message bubble's merged description; "^x": text equals x,
# never a content-desc, e.g. a sheet's "Send" button rather than the composer's Send icon; "@x":
# content-desc equals x, never a text, e.g. the photo preview's round Send button, not its title;
# "!x": text equals x, the LAST such node, e.g. a dialog's "Restore" over the screen's own "Restore").
node_xy() {
  dump
  python3 -I - "$WORK/ui.xml" "$1" <<'PY'
import re, sys, xml.etree.ElementTree as ET
want = sys.argv[2]
def hit(n):
    t, d = n.get('text') or '', n.get('content-desc') or ''
    if want.startswith('~'):
        return want[1:] in t or want[1:] in d
    if want.startswith('^'):
        return t == want[1:]
    if want.startswith('@'):
        return d == want[1:]
    if want.startswith('!'):
        return t == want[1:]
    return t == want or d == want or (want.endswith('*') and t.startswith(want[:-1]))
hits = [n for n in ET.parse(sys.argv[1]).iter('node') if hit(n)]
if hits:
    n = hits[-1] if want.startswith('!') else hits[0]
    x1, y1, x2, y2 = map(int, re.findall(r'\d+', n.get('bounds')))
    print((x1 + x2) // 2, (y1 + y2) // 2)
PY
}
tap() {  # tap the node whose text or content-desc equals $1 (see node_xy)
  local b; b="$(node_xy "$1")"
  [ -n "$b" ] || { echo "no UI node: $1"; return 1; }
  A shell input tap $b
}
# The chat list's "New group" FAB: uiautomator shows the extended FABs as text-less Buttons at the
# bottom right ("New group" above "Add friend", only while groups are available).
tap_new_group() {
  dump
  local b; b="$(python3 -I - "$WORK/ui.xml" <<'PY'
import re, sys, xml.etree.ElementTree as ET
nodes = list(ET.parse(sys.argv[1]).iter('node'))
if any((n.get('text') == 'New group' or n.get('content-desc') == 'New group') for n in nodes):
    n = next(n for n in nodes if n.get('text') == 'New group' or n.get('content-desc') == 'New group')
    x1, y1, x2, y2 = map(int, re.findall(r'\d+', n.get('bounds'))); print((x1 + x2) // 2, (y1 + y2) // 2); sys.exit()
h = max(int(re.findall(r'\d+', n.get('bounds'))[3]) for n in nodes)
fabs = []
for n in nodes:
    if n.get('class') == 'android.widget.Button' and not n.get('text') and not n.get('content-desc'):
        x1, y1, x2, y2 = map(int, re.findall(r'\d+', n.get('bounds')))
        if y1 > h * 0.6: fabs.append((y1, (x1 + x2) // 2, (y1 + y2) // 2))
if len(fabs) >= 2:
    fabs.sort(); print(fabs[0][1], fabs[0][2])
PY
)"
  [ -n "$b" ] || return 1
  A shell input tap $b
}
long_press() {  # a long-press (900 ms) on the node $1 (see node_xy)
  local b; b="$(node_xy "$1")"
  [ -n "$b" ] || { echo "no UI node: $1"; return 1; }
  A shell input swipe $b $b 900
}
# Empty the focused field wherever the cursor landed (Compose ignores MOVE_END): delete backwards
# and forwards, in one batched shell call.
clear_field() { A shell "for i in \$(seq 1 80); do input keyevent KEYCODE_DEL KEYCODE_FORWARD_DEL; done" >/dev/null 2>&1 || true; }
type_into() { hide_keyboard; tap "$1" || return 1; sleep 0.5; clear_field; A shell input text "$(printf '%s' "$2" | sed 's/ /%s/g')"; }
hide_keyboard() { local st; st="$(A shell dumpsys input_method 2>/dev/null || true)"; has_text "$st" "mInputShown=true" && A shell input keyevent KEYCODE_BACK; sleep 0.5; }
dismiss_prompts() {   # notification prompt, the old app's "update available" banner, the post-update health screen
  has "Not now" && { tap "Not now" || true; }
  has "Later" && { tap "Later" || true; sleep 1; }
  # nightly.35+: "Notifications health" opens once after an update when a row fails (redroid has no
  # Google Play services, so "Push registered" always does). A user backs out of it; so does the gate.
  if has 'text="Notifications health"'; then
    echo "    post-update \"Notifications health\" screen shown ($(grep -oE 'text="[✓✗]"' "$WORK/ui.xml" | tr -d '\n')); Back"
    A shell input keyevent KEYCODE_BACK; sleep 1; dump
  fi
  true
}

sign_in() {  # $1 phone, $2 email
  A shell am start -W -n "$PKG/.MainActivity" >/dev/null
  if [ "$MANUAL" = 1 ]; then manual_sign_in "$1" "$2"; return; fi
  # The old app's "update available" banner takes a third of the screen: dismiss it.
  wait_for "Server:" 30 || return 1
  has "Later" && { tap "Later" || true; sleep 1; }
  echo "    point the app at http://127.0.0.1:$PORT"
  wait_for "Server:" 30 || return 1
  tap "Server:*" || return 1; sleep 1
  # Focus the field (its label, or its current value as a fallback).
  tap "Server URL" || tap "https://*" || tap "http://*" || { echo "    the Server URL field didn't appear"; return 1; }; sleep 0.5
  clear_field
  A shell input text "http://127.0.0.1:$PORT"; sleep 0.5
  # The keyboard hides "Use this server": close it first; the field's Done action is the fallback.
  hide_keyboard
  if ! tap "Use this server"; then tap "Server URL" || true; A shell input keyevent KEYCODE_ENTER; fi
  sleep 2
  has "Server: http://127.0.0.1:$PORT" || { echo "    the server change didn't take (the app still shows another server)"; return 1; }
  if ! wait_for "Phone number" 30; then
    has "Sign in with RisiCloud" && echo "    the server offers only RisiCloud sign-in (dev login missing)"
    return 1
  fi
  echo "    request a code"
  type_into "Phone number" "$1"; type_into "Work email" "$2"; hide_keyboard; tap "Send code" || return 1
  wait_for "6-digit code" 30 || { echo "    no code screen after Send code"; return 1; }
  local code=""; for _ in $(seq 1 20); do code="$(srv otp "$1")"; [ -n "$code" ] && break; sleep 1; done
  [ -n "$code" ] || { echo "    the temp server never issued a code for the test user"; return 1; }
  echo "    enter the code"
  type_into "6-digit code" "$code"; sleep 1
  # The keyboard plus an "update available" banner (it can come back after the server change) hide
  # Verify: close both first.
  hide_keyboard; has "Later" && { tap "Later" || true; sleep 1; }
  has "Verify" && tap "Verify" || true
  # v1.22+: a reinstall with a server backup lands on the restore gate, not the chat list.
  for _ in $(seq 1 40); do
    on_chat_list && break
    grep -qF 'text="Restore your chats"' "$WORK/ui.xml" && { echo "    the restore gate shows (\"Restore your chats\")"; return 0; }
    sleep 1
  done
  on_chat_list || { echo "timeout waiting for the chat list"; return 1; }
  dismiss_prompts
}

# --manual-signin: you do the taps on the emulator; the script shows the code and waits.
manual_sign_in() {
  echo
  echo "    MANUAL SIGN-IN on $DEV:"
  echo "      1. Tap 'Server: … · Change', enter  http://127.0.0.1:$PORT  and tap 'Use this server'."
  echo "      2. Phone number: $1   Work email: $2   then 'Send code'."
  echo "      3. The code will appear here. Enter it and tap Verify. Dismiss any prompts."
  local code="" shown=""
  for _ in $(seq 1 600); do
    code="$(srv otp "$1")"
    if [ -n "$code" ] && [ "$code" != "$shown" ]; then echo "    >>> CODE: $code"; shown="$code"; fi
    on_chat_list && { echo "    signed in"; dismiss_prompts; return 0; }
    sleep 1
  done
  echo "    timed out after 10 minutes waiting for the chat list"; return 1
}

# adb reverse: the temp server, and (--via-updater, device A) device 443 -> the local update server.
reverses() {
  A reverse "tcp:$PORT" "tcp:$PORT" >/dev/null
  if [ -n "$UPD_PORT" ] && [ "$DEV" = "$SERIAL" ]; then A reverse tcp:443 "tcp:$UPD_PORT" >/dev/null; fi
}
install_old() {
  A uninstall "$PKG" >/dev/null 2>&1 || true
  A install "$OLD" >/dev/null
  A shell pm grant "$PKG" android.permission.POST_NOTIFICATIONS 2>/dev/null || true
  # Redroid: showing the soft keyboard hung system_server (watchdog restart) twice; without the IME
  # `input text` still types into Compose fields.
  [ -n "$STARTED_TARGET" ] && { A shell pm disable-user --user 0 com.android.inputmethod.latin >/dev/null 2>&1 || true; }
  reverses
}

open_chat() { A shell am force-stop "$PKG"; A shell am start -W -n "$PKG/.MainActivity" >/dev/null; wait_for "$1" 40; dismiss_prompts; tap "$1"; sleep 2; }
# $2: the composer's placeholder ("Encrypted message" in an e2ee chat).
send_ui() { type_into "${2:-Message}" "$1"; tap "Send"; sleep 1; }
visible_msgs() { hide_keyboard; dismiss_prompts; sleep 1; dump; grep -oE 'upgrade-test [AB][0-9]+' "$WORK/ui.xml" | sort -u; }

# Room rows and DataStore keys need root (google_apis emulator images allow `adb root`).
db_snapshot() {
  local who; who="$(A shell id 2>/dev/null || true)"
  if ! has_text "$who" "uid=0"; then
    A root >/dev/null 2>&1 || true; sleep 2
    case "$DEV" in *:*) adb connect "$DEV" >/dev/null 2>&1 || true;; esac   # adbd restarted: a TCP device reconnects
    A wait-for-device >/dev/null 2>&1 || true
    reverses 2>/dev/null || true                                           # the restart drops adb reverse
    who="$(A shell id 2>/dev/null || true)"
  fi
  has_text "$who" "uid=0" || { echo "no-root"; return 0; }
  rm -f "$WORK"/risime.db*
  for f in risime.db risime.db-wal risime.db-shm; do A exec-out cat "/data/data/$PKG/databases/$f" > "$WORK/$f" 2>/dev/null || rm -f "$WORK/$f"; done
  python3 -I - "$WORK/risime.db" "$WORK/counts-last.json" "$WORK/counts-chat-last.json" "$WORK/tabs-last.json" <<'PY'
import sqlite3, sys, json
c = sqlite3.connect(sys.argv[1])
# HARD RULE (CLAUDE.md, decision 055): per conversation and kind (text, image, call, ...), never fewer after an update.
try:
    rows = c.execute("SELECT conversation_id, COALESCE(kind, 'text'), COUNT(*) FROM messages WHERE kind IS NULL OR kind != 'system' GROUP BY 1, 2").fetchall()
    json.dump({f"{a}|{b}": n for a, b, n in rows}, open(sys.argv[2], "w"))
except sqlite3.Error:
    json.dump({}, open(sys.argv[2], "w"))
q = lambda s: c.execute(s).fetchone()[0]
# §24.14 (decision 065): the same per chat (both tabs of a chat summed: chat_id from Room v11's
# chat_tabs; a conversation without a row is its own chat), and the chat_tabs rows themselves
# (null = this app has no chat_tabs table).
has_tabs = q("SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name='chat_tabs'")
try:
    rows = c.execute("SELECT COALESCE(t.chat_id, m.conversation_id), COALESCE(m.kind, 'text'), COUNT(*) FROM messages m "
                     "LEFT JOIN chat_tabs t ON t.conversation_id = m.conversation_id WHERE m.kind IS NULL OR m.kind != 'system' GROUP BY 1, 2"
                     if has_tabs else
                     "SELECT conversation_id, COALESCE(kind, 'text'), COUNT(*) FROM messages WHERE kind IS NULL OR kind != 'system' GROUP BY 1, 2").fetchall()
    json.dump({f"{a}|{b}": n for a, b, n in rows}, open(sys.argv[3], "w"))
except sqlite3.Error:
    json.dump({}, open(sys.argv[3], "w"))
try:
    tabs = {r[0]: [r[1], r[2]] for r in c.execute("SELECT conversation_id, chat_id, tab FROM chat_tabs")} if has_tabs else None
except sqlite3.Error:
    tabs = None
json.dump(tabs, open(sys.argv[4], "w"))
groups = q("SELECT COUNT(*) FROM sqlite_master WHERE name='groups'") and q("SELECT COUNT(*) FROM `groups`") or 0
def n(sql):
    try: return q(sql) or 0
    except sqlite3.Error: return 0
extra = {
    "group_named": n("SELECT COUNT(*) FROM `groups` WHERE name = 'Upgrade group'"),
    "mls": n("SELECT COUNT(*) FROM mls_kv"),
    "reactions": n("SELECT COUNT(*) FROM reactions WHERE op = 'add' AND pending = 0"),
    "deleted": n("SELECT COUNT(*) FROM messages WHERE kind = 'deleted'"),
    "images_sent": n("SELECT COUNT(*) FROM messages WHERE kind = 'image' AND outgoing = 1 AND message_id IS NOT NULL"),
    "resets": n("SELECT COUNT(*) FROM messages WHERE kind = 'system' AND body LIKE 'Encryption was reset%'"),
    "locked_msgs": n("SELECT COUNT(*) FROM messages WHERE body LIKE 'upgrade-test D%'"),
    "chat_tabs": n("SELECT COUNT(*) FROM chat_tabs") if has_tabs else "none",
}
print(f"messages={q('SELECT COUNT(*) FROM messages')} contacts={q('SELECT COUNT(*) FROM contacts')} groups={groups} cursor={'set' if q('SELECT COUNT(*) FROM sync_state') else 'none'} "
      + " ".join(f"{k}={v}" for k, v in extra.items()))
PY
  local ds; ds="$(A exec-out cat "/data/data/$PKG/files/datastore/risime.preferences_pb" 2>/dev/null | strings | grep -cE '^(last_user_id|token|user)$' || true)"
  echo "datastore_keys=$ds"
  # The device id must survive an update (a new id = a new device: dead rows, groups to rejoin).
  local did; did="$(A exec-out cat "/data/data/$PKG/files/datastore/risime.preferences_pb" 2>/dev/null | python3 -I -c 'import re,sys; m=re.search(rb"device_id.{0,8}?([0-9a-f]{8})-[0-9a-f]{4}-", sys.stdin.buffer.read(), re.S); print(m.group(1).decode() if m else "")' || true)"
  echo "device_id=${did:-none}"
}

# "key:before->after" for every key of the counts file $1 whose count dropped in $2 (empty: none).
pairs_lost() { python3 -I - "$1" "$2" <<'PY'
import json, sys
b = json.load(open(sys.argv[1])); a = json.load(open(sys.argv[2]))
print(" ".join(f"{k}:{v}->{a.get(k, 0)}" for k, v in b.items() if a.get(k, 0) < v))
PY
}
# §24.14 after the migration: every conversation of the pre-update snapshot ($1, per-conversation
# counts) is Private with chat_id = its conversation id ($2, the rows): its chat_tabs row says
# tab 'private' and chat_id = conversation_id, or it has no row (= Private, its own chat).
# Prints "OK n", "NONE" (the app has no chat_tabs table) or "BAD <conv>=<chat_id>/<tab> ...".
tabs_private() { python3 -I - "$1" "$2" <<'PY'
import json, sys
b = json.load(open(sys.argv[1])); t = json.load(open(sys.argv[2]))
if t is None:
    print("NONE"); sys.exit()
convs = sorted({k.rsplit("|", 1)[0] for k in b})
# No row = Private, its own chat (the app's rule, docs/status/android.md A1): a v11 app writes rows
# only from decrypted group_meta, so a plaintext DM created on it has none. A row must say exactly that.
bad = [f"{c}={t[c][0]}/{t[c][1]}" for c in convs if c in t and t[c] != [c, "private"]]
rows = sum(1 for c in convs if c in t)
print("BAD " + " ".join(bad) if bad else f"OK {len(convs)} ({rows} with a chat_tabs row, {len(convs) - rows} without = Private)")
PY
}
# The per-chat and chat_tabs checks of a snapshot just taken ($1: when, for the messages).
chat_checks() {
  local lost t
  lost="$(pairs_lost "$WORK/counts-chat-before.json" "$WORK/counts-chat-last.json")"
  [ -z "$lost" ] || fail "messages lost per chat_id/kind $1: $lost"
  echo "    per-chat counts kept $1 ($(python3 -I -c 'import json,sys;print(len(json.load(open(sys.argv[1]))))' "$WORK/counts-chat-before.json") chat/kind pairs)"
  t="$(tabs_private "$WORK/counts-before.json" "$WORK/tabs-last.json")"
  case "$t" in
    NONE) echo "    note: this app has no chat_tabs table (pre-v1.24): the tab check is skipped";;
    OK*) echo "    chat_tabs $1: all ${t#OK } pre-update conversations are Private with chat_id = conversation_id";;
    *) fail "chat_tabs $1: not every pre-update conversation is Private with chat_id = conversation_id: ${t#BAD }";;
  esac
}

# ---- locked chat across an update (old app >= LOCKED_CHAT_CHECK_FROM): a screen-lock PIN on A,
# D's chat locked through the real UI (long-press -> Lock chat -> the system credential prompt).

pin_set() { A shell locksettings set-pin "$LK_PIN" >/dev/null && PIN_SET="$DEV"; }
pin_clear() { [ -n "$PIN_SET" ] || return 0; adb -s "$PIN_SET" shell locksettings clear --old "$LK_PIN" >/dev/null 2>&1 && PIN_SET=""; }
# The system's credential prompt (BiometricPrompt in SystemUI, PIN pad for a device without a
# fingerprint) titled $1: type the PIN.
enter_pin_prompt() {
  local i
  for i in $(seq 1 25); do
    dump
    grep -qF 'package="com.android.systemui"' "$WORK/ui.xml" && grep -qF "text=\"$1\"" "$WORK/ui.xml" && break
    sleep 1
  done
  grep -qF 'package="com.android.systemui"' "$WORK/ui.xml" || { echo "    no system credential prompt \"$1\""; return 1; }
  A shell input text "$LK_PIN"; sleep 0.3; A shell input keyevent KEYCODE_ENTER; sleep 2
}
to_chat_list() { A shell am force-stop "$PKG"; A shell am start -W -n "$PKG/.MainActivity" >/dev/null; wait_chat_list 40 || return 1; dismiss_prompts; }
# The chat list shows D's row ($WORK/ui.xml from a fresh dump).
d_listed() { dump; grep -qF 'text="ZZ Upgrade D"' "$WORK/ui.xml"; }
# Pull down at the top of the chat list: the "Locked chats, N" row appears; confirm, the folder lists D.
locked_folder_has_d() {
  local sz w h i
  sz="$(A shell wm size 2>/dev/null || true)"; [[ "$sz" =~ ([0-9]+)x([0-9]+) ]] && { w="${BASH_REMATCH[1]}"; h="${BASH_REMATCH[2]}"; } || { w=720; h=1280; }
  for i in 1 2 3; do
    A shell input swipe $((w / 2)) $((h * 35 / 100)) $((w / 2)) $((h * 80 / 100)) 600; sleep 1
    has 'content-desc="Locked chats, ' && break
  done
  has 'content-desc="Locked chats, ' || { echo "    the pull-down shows no \"Locked chats\" row"; return 1; }
  echo "    pull-down: \"$(grep -oE 'content-desc="Locked chats, [0-9]+"' "$WORK/ui.xml" | sed -n 1p | cut -d'"' -f2)\""
  tap "~Locked chats, " || return 1
  enter_pin_prompt "Locked chats" || return 1
  wait_for 'text="ZZ Upgrade D"' 20 || { echo "    the Locked chats folder doesn't list D"; return 1; }
  A shell input keyevent KEYCODE_BACK; sleep 1
}

ENC="Encrypted message"   # the composer's placeholder in an e2ee chat
# C (second device) sees $1 in the group, reopening the chat once if the socket went quiet.
c_sees() { local d="$DEV"; DEV="$SERIAL_B"; local r=0; wait_for "$1" 45 || { open_chat "Upgrade group" >/dev/null || true; wait_for "$1" 45; } || r=1; DEV="$d"; return $r; }
# A small PNG (stdlib only) in A's Pictures, indexed so the Photo Picker shows it.
push_photo() {
  python3 -I - "$WORK/upgrade-test.png" <<'PY'
import struct, sys, zlib
w, h = 160, 120
rows = b"".join(b"\x00" + b"".join(bytes((20, 90, 200) if 40 <= x < 120 and 30 <= y < 90 else (230, 120, 40)) for x in range(w)) for y in range(h))
chunk = lambda t, d: struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff)
open(sys.argv[1], "wb").write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)) + chunk(b"IDAT", zlib.compress(rows)) + chunk(b"IEND", b""))
PY
  A push "$WORK/upgrade-test.png" /sdcard/Pictures/upgrade-test.png >/dev/null
  A shell am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d file:///sdcard/Pictures/upgrade-test.png >/dev/null
}
# Poll A's Room snapshot (DB_AFTER) until field $1 >= $2, up to $3 x 5 s.
await_field() {
  for _ in $(seq 1 "${3:-12}"); do
    DB_AFTER="$(db_snapshot)"
    [ "$(field "$DB_AFTER" "$1")" -ge "$2" ] 2>/dev/null && return 0
    sleep 5
  done
  return 1
}

# ---- --via-updater: a local https://risicloud.ai/app/risime/ for device A (decision 016's updater, unmodified)
UPD="$WORK/updater"
# Root adbd on A (adb reverse to device port 443 and writes under /system need it). Redroid allows it.
root_a() {
  local who; who="$(A shell id 2>/dev/null || true)"
  if ! has_text "$who" "uid=0"; then
    A root >/dev/null 2>&1 || true; sleep 2
    case "$DEV" in *:*) adb connect "$DEV" >/dev/null 2>&1 || true;; esac
    A wait-for-device >/dev/null 2>&1 || true
    who="$(A shell id 2>/dev/null || true)"
  fi
  has_text "$who" "uid=0"
}
updater_setup() {
  mkdir -p "$UPD/www/app/risime"
  # 1. A throwaway CA (2 days, key only in $WORK) and a server cert for risicloud.ai signed by it.
  ( cd "$UPD" && openssl req -x509 -newkey rsa:2048 -nodes -keyout ca.key -out ca.pem -days 2 \
      -subj "/CN=RisiMe upgrade-test throwaway CA $(date -u +%Y%m%dT%H%M%S)" \
      -addext "basicConstraints=critical,CA:TRUE" -addext "keyUsage=critical,keyCertSign,cRLSign" \
    && openssl req -newkey rsa:2048 -nodes -keyout srv.key -out srv.csr -subj "/CN=risicloud.ai" \
    && printf 'basicConstraints=CA:FALSE\nkeyUsage=critical,digitalSignature,keyEncipherment\nextendedKeyUsage=serverAuth\nsubjectAltName=DNS:risicloud.ai\n' > srv.ext \
    && openssl x509 -req -in srv.csr -CA ca.pem -CAkey ca.key -CAcreateserial -out srv.pem -days 2 -extfile srv.ext \
    && cat srv.pem ca.pem > chain.pem ) >/dev/null 2>&1 || { echo "    openssl: could not make the throwaway CA/cert"; return 1; }
  # 2. version.json + the APK exactly as a publish writes them (same code: publish-release --stage).
  "$REPO/scripts/publish-release" --stage "$NEW" "$UPD/www/app/risime" > "$UPD/stage.log" 2>&1 \
    || { cat "$UPD/stage.log"; echo "    publish-release --stage failed"; return 1; }
  echo "    version.json: $(python3 -I -c 'import json,sys;d=json.load(open(sys.argv[1]));print(d["versionName"], d["versionCode"], d["url"], "sha256", d["sha256"][:12], "cert", d["certSha256"][:12])' "$UPD/www/app/risime/version.json")"
  # 3. HTTPS static server, 127.0.0.1 only (CLAUDE.md rule 6), a free port. UPD_RATE (bytes/s, 0 = full
  #    speed) throttles APK downloads so "Back during the download" really lands during it.
  cat > "$UPD/serve.py" <<'PY'
import functools, http.server, os, ssl, sys, time
root, cert, key, portfile, logfile = sys.argv[1:6]
rate = int(os.environ.get("UPD_RATE", "0") or 0)
log = open(logfile, "a", buffering=1)
class H(http.server.SimpleHTTPRequestHandler):
    def log_message(self, fmt, *a):
        log.write("%s %s\n" % (self.log_date_time_string(), fmt % a))
    def copyfile(self, src, dst):
        if not rate or not self.path.endswith(".apk"):
            return super().copyfile(src, dst)
        chunk = max(rate // 10, 16384)
        while True:
            b = src.read(chunk)
            if not b:
                break
            dst.write(b); time.sleep(len(b) / rate)
srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), functools.partial(H, directory=root))
ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER); ctx.load_cert_chain(cert, key)
srv.socket = ctx.wrap_socket(srv.socket, server_side=True)
open(portfile + ".tmp", "w").write(str(srv.server_address[1])); os.rename(portfile + ".tmp", portfile)
srv.serve_forever()
PY
  UPD_RATE="${UPD_RATE:-0}" python3 -I "$UPD/serve.py" "$UPD/www" "$UPD/chain.pem" "$UPD/srv.key" "$UPD/port" "$UPD/http.log" 2>> "$UPD/serve.err" &
  UPD_PID=$!
  for _ in $(seq 1 50); do [ -s "$UPD/port" ] && break; sleep 0.2; done
  UPD_PORT="$(cat "$UPD/port" 2>/dev/null || true)"
  [ -n "$UPD_PORT" ] || { cat "$UPD/serve.err" 2>/dev/null; echo "    the local update server didn't start"; return 1; }
  curl -sf --cacert "$UPD/ca.pem" --resolve "risicloud.ai:$UPD_PORT:127.0.0.1" -o /dev/null "https://risicloud.ai:$UPD_PORT/app/risime/version.json" \
    || { echo "    the local update server doesn't answer over TLS"; return 1; }
  echo "    update server: https://127.0.0.1:$UPD_PORT (pid $UPD_PID)"
  # 4. Device A: root, trust the CA, risicloud.ai -> 127.0.0.1, device :443 -> the host server.
  root_a || { echo "    --via-updater needs a rooted device (adb root): redroid, or a userdebug emulator"; return 1; }
  local h; h="$(openssl x509 -in "$UPD/ca.pem" -noout -subject_hash_old)"
  A push "$UPD/ca.pem" "/data/local/tmp/$h.0" >/dev/null
  # Android 14 reads CAs from the conscrypt APEX (/apex/com.android.conscrypt/cacerts); redroid's
  # APEXes are flattened, so /apex/com.android.conscrypt is a bind mount of
  # /system/apex/com.android.conscrypt on the container's writable overlay root: a file written there
  # shows up in every mount namespace (zygote and apps included), no per-process bind mounts needed.
  # /system/etc/security/cacerts too, for anything still reading the legacy store.
  A shell "for d in /system/apex/com.android.conscrypt/cacerts /system/etc/security/cacerts; do cp /data/local/tmp/$h.0 \$d/$h.0 && chmod 644 \$d/$h.0 || exit 1; done
           grep -q ' risicloud.ai\$' /system/etc/hosts || echo '127.0.0.1 risicloud.ai' >> /system/etc/hosts" \
    || { echo "    could not write the CA / hosts entry under /system (read-only system? use redroid)"; return 1; }
  local seen; seen="$(A shell "ls /apex/com.android.conscrypt/cacerts/$h.0; ping -c1 -W1 risicloud.ai" 2>&1 || true)"
  has_text "$seen" "cacerts/$h.0" || { echo "    the CA is not visible under /apex/com.android.conscrypt/cacerts: $seen"; return 1; }
  has_text "$seen" "(127.0.0.1)" || { echo "    risicloud.ai does not resolve to 127.0.0.1 on the device: $seen"; return 1; }
  reverses
  echo "    device: CA $h.0 trusted (conscrypt APEX + system), risicloud.ai -> 127.0.0.1, adb reverse tcp:443 -> :$UPD_PORT"
}
# The installed versionName of the app on A ("" if none).
installed_vn() { local out; out="$(A shell dumpsys package "$PKG" 2>/dev/null || true)"; [[ "$out" =~ versionName=([^[:space:]]+) ]] && echo "${BASH_REMATCH[1]}" || echo ""; }
# A package-installer confirmation on screen: tap its positive button.
confirm_installer() {
  grep -qE 'package="com\.(google\.)?android\.packageinstaller"' "$WORK/ui.xml" || return 1
  echo "    package installer asks to confirm: tapping it"
  local b; for b in "UPDATE ANYWAY" "Update anyway" "^Update" "^UPDATE" "^Install" "^INSTALL"; do tap "$b" >/dev/null 2>&1 && return 0; done
  return 0
}
update_via_updater() {
  local t0 vn="" err=""
  A shell appops set "$PKG" REQUEST_INSTALL_PACKAGES allow
  t0="$(A shell date +%s | tr -d '\r').000"   # logcat -T epoch form: no spaces through adb shell
  A shell am force-stop "$PKG"; A shell am start -W -n "$PKG/.MainActivity" >/dev/null
  wait_for "RisiMe $NEW_VN is available" 60 || { echo "    (update server log: $(tail -3 "$UPD/http.log" 2>/dev/null | tr '\n' ' '))"; fail "the old app shows no \"RisiMe $NEW_VN is available\" banner"; }
  grep -q 'GET /app/risime/version.json' "$UPD/http.log" || fail "the banner didn't come from the local update server"
  echo "    banner: \"RisiMe $NEW_VN is available\"; tapping Update"
  # Only here, before the download starts: "^" = the text equals "Update" (never "Updating to X").
  tap "^Update" || fail "no Update button on the banner"
  if [ "$BACK_STEP" = yes ]; then
    sleep 0.5; A shell input keyevent KEYCODE_BACK
    echo "    Back pressed during the download; reopening the app in 1 s"
    sleep 1; A shell am start -W -n "$PKG/.MainActivity" >/dev/null 2>&1 || true
  fi
  for _ in $(seq 1 90); do
    vn="$(installed_vn)"; [ "$vn" = "$NEW_VN" ] && break
    dump
    confirm_installer || true
    err="$(grep -oE 'Update interrupted[^"]*|Install failed[^"]*|Install cancelled[^"]*|failed its security check[^"]*|Couldn.t download the update[^"]*|Update failed[^"]*|App not installed[^"]*|wasn.t installed[^"]*' "$WORK/ui.xml" | sed -n 1p || true)"
    [ -z "$err" ] || fail "the in-app update failed: $err"
    sleep 2
  done
  [ "$vn" = "$NEW_VN" ] || fail "the in-app update didn't install within 3 min (installed: ${vn:-?}; $(dump; grep -oE 'text="(Updating|Confirm|Downloading|Verifying|Installing)[^"]*"' "$WORK/ui.xml" | tr '\n' ' '))"
  grep -q "GET /app/risime/risime-$NEW_VN.apk HTTP/1.1\" 200" "$UPD/http.log" || fail "the APK was not downloaded from the local update server"
  sleep 2
  local lc; lc="$(A logcat -d -T "$t0" 2>/dev/null || true)"
  grep -qE "Update package $PKG code path .*Retain data and using new" <<<"$lc" || fail "logcat: no \"Update package $PKG ... Retain data and using new\" (not an in-place update?)"
  grep -qE "Marking session [0-9]+ as applied" <<<"$lc" || fail "logcat: the install session was not applied"
  if grep -qE "RisiMe *: update failed|Update interrupted|RisiMe update: status=[1-9]" <<<"$lc"; then fail "logcat: the updater reported a failure"; fi
  echo "    installed $NEW_VN through the in-app updater: logcat \"$(grep -oE 'Retain data and using new' <<<"$lc" | sed -n 1p)\", \"$(grep -oE 'Marking session [0-9]+ as applied' <<<"$lc" | sed -n 1p)\""
  CHECKS+=" in_app_updater"; [ "$BACK_STEP" = yes ] && CHECKS+=" updater_back"
  return 0
}

if [ "$VIA" = updater ]; then
  if [ -n "${UPDATER_BACK_SAFE_FROM:-}" ] && [ "$OLD_VC" -ge "$UPDATER_BACK_SAFE_FROM" ] 2>/dev/null; then BACK_STEP=yes
  else BACK_STEP=skipped; echo "==> Back-during-download step skipped: old app $OLD_VN ($OLD_VC) is below UPDATER_BACK_SAFE_FROM=${UPDATER_BACK_SAFE_FROM:-unset} (bug A: leaving cancels the update)"; fi
  # Throttle the APK (about 10 s for 40 MB) only for the Back step, so Back lands mid-download.
  [ "$BACK_STEP" = yes ] && export UPD_RATE="${UPD_RATE:-4000000}"
  step "local update server for the in-app updater (https://risicloud.ai/app/risime/ -> 127.0.0.1, device A)"
  DEV="$SERIAL"; updater_setup || fail "in-app updater setup"
fi
# Locked chat across the update (Locked chats shipped in 0.2.0-nightly.37): LOCKED_CHAT_CHECK_FROM
# (default 20037) is the first OLD versionCode that can lock a chat. UPGRADE_NO_LOCKED_CHAT=1 skips
# it (emergency only; the result says locked=off).
LOCKED_CHAT_CHECK_FROM="${LOCKED_CHAT_CHECK_FROM:-20037}"
if [ -n "${UPGRADE_NO_LOCKED_CHAT:-}" ]; then LK_STEP=off; echo "==> locked-chat step OFF (UPGRADE_NO_LOCKED_CHAT)"
elif [ "$MANUAL" = 1 ]; then LK_STEP=skipped; echo "==> locked-chat step skipped (--manual-signin)"
elif [ "$OLD_VC" -ge "$LOCKED_CHAT_CHECK_FROM" ] 2>/dev/null; then LK_STEP=yes
else LK_STEP=skipped; echo "==> locked-chat step skipped: old app $OLD_VN ($OLD_VC) is below LOCKED_CHAT_CHECK_FROM=$LOCKED_CHAT_CHECK_FROM (no Lock chat)"; fi
# ---- 1. old app, signed in, with chats
step "install the old app ($OLD_VN) on $SERIAL${SERIAL_B:+ and $SERIAL_B}"
DEV="$SERIAL"; install_old
[ -n "$SERIAL_B" ] && { DEV="$SERIAL_B"; install_old; }
step "sign in on the old app"
DEV="$SERIAL"; sign_in "+94770000961" "upgrade61@example.com" || fail "old app sign-in (A)"
if [ -n "$SERIAL_B" ]; then DEV="$SERIAL_B"; sign_in "+94770000963" "upgrade63@example.com" || fail "old app sign-in (C, second device)"; fi
step "seed: friends, 3 messages from B, 3 replies from A"
srv friends; srv send 3
[ -n "$SERIAL_B" ] && srv friends_c
DEV="$SERIAL"; open_chat "ZZ Upgrade B" || fail "chat with B not listed on the old app"
for i in 1 2 3; do send_ui "upgrade-test A$i"; done
sleep 3
BEFORE="$(visible_msgs || true)"; n_before="$(grep -c . <<<"$BEFORE" || true)"
echo "    before: $n_before messages visible"
[ "${n_before:-0}" -ge 6 ] || fail "seeding: expected 6 messages on the old app, saw ${n_before:-0}"
if [ -n "$SERIAL_B" ]; then
  step "seed the group: A creates \"Upgrade group\" with C (MLS) and sends one message; C receives it"
  hide_keyboard; A shell input keyevent KEYCODE_BACK; sleep 1
  tap "Refresh friends" || true; sleep 3
  for _ in $(seq 1 30); do tap_new_group && break; sleep 2; done
  wait_for "Add members" 10 || fail "no New group button on the old app (MLS core not loaded?)"
  sleep 2; tap "ZZ Upgrade C" && tap "Next" && sleep 1 && type_into "Group name" "Upgrade group" && hide_keyboard && tap "Create" \
    || fail "group creation on the old app"
  wait_for "Upgrade group" 60 || fail "group not created"
  # Create opens the new group; if the app went back to the list instead, open it.
  wait_for "$ENC" 30 || { tap "Upgrade group" || true; wait_for "$ENC" 90; } || fail "the group's MLS setup didn't finish on the old app"
  send_ui "upgrade-test A9" "$ENC"
  DEV="$SERIAL_B"; open_chat "Upgrade group" || fail "C: the group isn't listed (Welcome not processed)"
  wait_for "upgrade-test A9" 60 || fail "C did not receive the group message on the old app"
  DEV="$SERIAL"
fi
if [ "$LK_STEP" = yes ]; then
  step "locked chat: D writes to A; a screen-lock PIN; A locks D's chat (long-press -> Lock chat -> PIN) on the old app"
  DEV="$SERIAL"
  srv friends_d; sd="$(srv send_d 2)"; [ "$sd" = "upgrade: sent_d 2" ] || fail "locked chat: D's messages weren't sent ($sd)"
  to_chat_list || fail "locked chat: no chat list"
  tap "Refresh friends" || true
  for _ in $(seq 1 30); do d_listed && break; sleep 2; done
  open_chat "ZZ Upgrade D" || fail "locked chat: D's chat isn't listed on the old app"
  wait_for "upgrade-test D2" 30 || fail "locked chat: D's messages didn't arrive on the old app"
  to_chat_list || fail "locked chat: no chat list"
  pin_set || fail "locked chat: locksettings set-pin"
  # Redroid never sleeps, but a PIN would turn a screen-off into a keyguard: keep the screen on.
  A shell svc power stayon true >/dev/null 2>&1 || true
  # n37–n40: long-press opens a menu with "Lock chat". n41+: WhatsApp's selection bar, Lock chat under ⋮.
  lock_via_long_press() {
    long_press "ZZ Upgrade D" || return 1
    if wait_for 'text="Lock chat"' 5; then tap "^Lock chat"; return; fi
    tap "More options" >/dev/null 2>&1 || tap "More" >/dev/null 2>&1 || return 1
    wait_for 'text="Lock chat"' 10 && tap "^Lock chat"
  }
  lock_via_long_press || fail "locked chat: neither the long-press menu nor the selection bar's ⋮ has \"Lock chat\""
  enter_pin_prompt "Lock chat" || fail "locked chat: the device-credential prompt for \"Lock chat\" didn't show"
  hidden=""; for _ in $(seq 1 15); do on_chat_list && ! grep -qF 'text="ZZ Upgrade D"' "$WORK/ui.xml" && { hidden=1; break; }; sleep 1; done
  [ -n "$hidden" ] || fail "locked chat: D's chat is still in the list after locking it"
  has "ZZ Upgrade B" || fail "locked chat: B's chat left the list too"
  echo "    D's chat locked on $OLD_VN: out of the chat list"
fi
step "snapshot before the upgrade"
DB_BEFORE="$(db_snapshot)"; echo "    before (Room): $DB_BEFORE"
cp "$WORK/counts-last.json" "$WORK/counts-before.json" 2>/dev/null || true
cp "$WORK/counts-chat-last.json" "$WORK/counts-chat-before.json" 2>/dev/null || true
if [ "$LK_STEP" = yes ] && [ "$DB_BEFORE" != no-root ]; then
  [ "$(field "$DB_BEFORE" locked_msgs)" -ge 2 ] 2>/dev/null || fail "locked chat: D's 2 messages aren't in Room before the update ($DB_BEFORE)"
fi

# ---- 2. upgrade in place
if [ "$VIA" = updater ]; then
  step "update in place through the in-app updater: $OLD_VN -> $NEW_VN$([ "$BACK_STEP" = yes ] && echo " (Back during the download)")"
  DEV="$SERIAL"; update_via_updater
else
  step "adb install -r the candidate ($NEW_VN)"
  A install -r "$NEW" >/dev/null || fail "adb install -r rejected the new APK"
fi
A shell am start -W -n "$PKG/.MainActivity" >/dev/null; sleep 6; dismiss_prompts

# ---- 3. verify
step "verify: no sign-in, chats and messages kept"
dump
for t in "Phone number" "Send code" "Sign in with RisiCloud" "RisiMe is locked"; do
  grep -qF "$t" "$WORK/ui.xml" && fail "the new app asks to sign in again ($t)"
done
# Decision 064: the fingerprint lock is optional and off by default: an update opens straight to the
# chats (no lock screen, no migration prompt for a dev session).
for t in "Unlock with fingerprint" "Confirm to finish updating"; do
  grep -qF "$t" "$WORK/ui.xml" && fail "the new app opens to a lock after the update ($t; decision 064: off by default)"
done
# The post-update health screen can open up to ~60 s after start (it waits for the push registration
# to settle): keep dismissing it while waiting for the chat list.
ok_b=""
for _ in $(seq 1 45); do dismiss_prompts; has "ZZ Upgrade B" && { ok_b=1; break; }; sleep 2; done
[ -n "$ok_b" ] || fail "chat with B missing after the upgrade"
sleep 5; dismiss_prompts
for t in "Unlock with fingerprint" "Confirm to finish updating"; do
  grep -qF "$t" "$WORK/ui.xml" && fail "the new app shows a lock after the update ($t; decision 064: off by default)"
done
echo "    no lock screen and no sign-in after the update (decision 064)"
[ -n "$SERIAL_B" ] && { has "Upgrade group" || fail "group missing after the upgrade"; }
if [ "$LK_STEP" = yes ]; then
  step "locked chat after the update: still out of the list, still in the Locked chats folder"
  d_listed && fail "locked chat: D's chat is back in the chat list after the update"
  locked_folder_has_d || fail "locked chat: D's chat isn't in the Locked chats folder after the update"
  to_chat_list || fail "locked chat: no chat list after leaving the folder"
  d_listed && fail "locked chat: D's chat shows in the chat list after leaving the folder"
  echo "    D's chat stays locked across $OLD_VN -> $NEW_VN (hidden; in the folder behind the PIN)"
  pin_clear || echo "    WARN: could not clear the screen-lock PIN (cleanup retries)"
  CHECKS+=" locked_chat"
fi
open_chat "ZZ Upgrade B" || fail "cannot open the chat after the upgrade"
AFTER="$(visible_msgs || true)"
missing="$(comm -23 <(echo "$BEFORE") <(echo "$AFTER") | grep -c . || true)"
[ "$missing" = 0 ] || fail "$missing messages missing after the upgrade"
DB_AFTER="$(db_snapshot)"; echo "    after (Room): $DB_AFTER"
if [ "$DB_BEFORE" != no-root ]; then
  b_msgs="$(field "$DB_BEFORE" messages)"; a_msgs="$(field "$DB_AFTER" messages)"
  [ "${a_msgs:-0}" -ge "${b_msgs:-1}" ] || fail "Room messages dropped (${b_msgs:-?} -> ${a_msgs:-?})"
  # Per conversation and kind (1:1, groups, photos, call records): equal or more, never fewer.
  lost="$(python3 -I - "$WORK/counts-before.json" "$WORK/counts-last.json" <<'PY'
import json, sys
b = json.load(open(sys.argv[1])); a = json.load(open(sys.argv[2]))
print(" ".join(f"{k}:{v}->{a.get(k, 0)}" for k, v in b.items() if a.get(k, 0) < v))
PY
)"
  [ -z "$lost" ] || fail "messages lost per conversation/kind after the upgrade: $lost"
  echo "    per-conversation counts kept ($(python3 -I -c 'import json,sys;print(len(json.load(open(sys.argv[1]))))' "$WORK/counts-before.json") conversation/kind pairs)"
  chat_checks "after the update"
  if [ "$LK_STEP" = yes ]; then
    [ "$(field "$DB_AFTER" locked_msgs)" -ge "$(field "$DB_BEFORE" locked_msgs)" ] 2>/dev/null \
      || fail "locked chat: D's messages dropped across the update ($(field "$DB_BEFORE" locked_msgs) -> $(field "$DB_AFTER" locked_msgs))"
    echo "    locked chat: D's $(field "$DB_AFTER" locked_msgs) messages kept in Room"
  fi
  CHECKS+=" per_chat"
  # Delivery still works after the upgrade: one new message from B must arrive and be stored, and
  # the sync cursor must be stored again (nightly.11+ replays the inbox once after an upgrade).
  step "deliver one new message after the upgrade"
  srv send 1
  # redroid has no Google Play services (no FCM wake-up): bring the app to the foreground so it syncs.
  A shell am start -W -n "$PKG/.MainActivity" >/dev/null 2>&1 || true; sleep 3; dismiss_prompts
  open_chat "ZZ Upgrade B" || true
  for _ in $(seq 1 12); do
    a_msgs="$(field "$DB_AFTER" messages)"
    [ "${a_msgs:-0}" -gt "${b_msgs:-0}" ] && has_text "$DB_AFTER" "cursor=set" && break
    sleep 5; DB_AFTER="$(db_snapshot)"
  done
  echo "    after a new message (Room): $DB_AFTER"
  [ "$(field "$DB_AFTER" messages)" -gt "${b_msgs:-0}" ] 2>/dev/null || fail "a new message after the upgrade was not stored within 60 s"
  has_text "$DB_AFTER" "cursor=set" || fail "sync cursor not stored after the upgrade"
  [ "$(field "$DB_AFTER" datastore_keys)" -ge 2 ] 2>/dev/null || fail "DataStore session/owner keys lost"
  [ -z "$SERIAL_B" ] || [ "$(field "$DB_AFTER" groups)" -ge 1 ] 2>/dev/null || fail "group row lost"
  did_b="$(sed -n 's/.*device_id=\([^ ]*\).*/\1/p' <<<"$DB_BEFORE" | tail -1)"; did_a="$(sed -n 's/.*device_id=\([^ ]*\).*/\1/p' <<<"$DB_AFTER" | tail -1)"
  echo "    device id: before ${did_b:-?} after ${did_a:-?}"
  [ -n "$did_b" ] && [ "$did_b" != none ] && [ "$did_b" = "$did_a" ] || fail "device id changed or missing across the upgrade (${did_b:-?} -> ${did_a:-?})"
  CHECKS+=" messages session device_id cursor new_message"

  # (c) a reaction after the upgrade: stored and confirmed by the server (Room `reactions`).
  step "react to a seeded message after the upgrade"
  open_chat "ZZ Upgrade B" || fail "cannot open the chat with B"
  r_before="$(field "$DB_AFTER" reactions)"
  { long_press "~upgrade-test B1" && wait_for "More reactions" 10 && tap "React 👍"; } || fail "the long-press reaction sheet didn't open on a seeded message"
  await_field reactions "$(( ${r_before:-0} + 1 ))" || fail "the reaction after the upgrade was not stored and confirmed (Room reactions: $DB_AFTER)"
  has "Reactions: " || echo "    note: the reaction chip isn't in the UI dump (Room has it)"
  CHECKS+=" reaction"

  if [ -n "$SERIAL_B" ]; then
    # (a) the group survives: listed (checked above), its Room row with the name, MLS state, and
    # A still sends in it with the same MLS group (no rejoin): C receives.
    step "group after the upgrade: Room row, MLS state, A sends and C receives"
    [ "$(field "$DB_AFTER" group_named)" -ge 1 ] 2>/dev/null || fail "the group's Room row (name \"Upgrade group\") was lost: $DB_AFTER"
    [ "$(field "$DB_BEFORE" mls)" -ge 1 ] 2>/dev/null && [ "$(field "$DB_AFTER" mls)" -ge 1 ] 2>/dev/null || fail "MLS state lost (mls_kv rows ${DB_BEFORE##*mls=} -> ${DB_AFTER##*mls=})"
    open_chat "Upgrade group" || fail "cannot open the group after the upgrade"
    wait_for "$ENC" 60 || fail "the group isn't end-to-end encrypted after the upgrade (MLS state lost; rejoining?)"
    send_ui "upgrade-test A10" "$ENC"
    c_sees "upgrade-test A10" || fail "C did not receive A's group message sent after the upgrade"
    CHECKS+=" group"

    # (b) a photo after the upgrade: picked with the system Photo Picker, uploaded (a server blob).
    step "send a photo in the group after the upgrade"
    push_photo
    blobs_before="$(field "$(srv blobs)" blobs)"
    # nightly.27+: the "+" button ("Attach") opens the attach sheet, then "Gallery" opens the
    # multi-select Photo Picker (its "Add" button confirms). An old app had one "Attach photo".
    hide_keyboard
    if has "Attach photo"; then tap "Attach photo"
    else tap "Attach" || fail "no Attach button in the group"; wait_for "Gallery" 10 && tap "Gallery" || fail "the attach sheet has no Gallery"; fi
    wait_for "Photo taken on" 20 || fail "the Photo Picker didn't show the pushed photo"
    tap "~Photo taken on" || fail "could not pick the photo"
    if ! wait_for "Send photo" 5; then dump; tap "~Add" >/dev/null || tap "Done" >/dev/null || true; fi
    wait_for "Send photo" 20 || fail "the attach sheet didn't open"
    # GO UX preview (nightly.27+): the round button's content-desc "Send photo" (the title has the same text).
    for _ in $(seq 1 10); do tap "@Send photo" >/dev/null || tap "^Send" >/dev/null || true; sleep 2; has "Send photo" || break; done
    has "Send photo" && fail "the attach sheet's Send didn't go through"
    blobs_after=""
    for _ in $(seq 1 24); do blobs_after="$(field "$(srv blobs)" blobs)"; [ "${blobs_after:-0}" -gt "${blobs_before:-0}" ] && break; sleep 5; done
    [ "${blobs_after:-0}" -gt "${blobs_before:-0}" ] || fail "the photo was not uploaded (server blobs ${blobs_before:-?} -> ${blobs_after:-?})"
    await_field images_sent 1 || fail "the photo message was not sent (Room: $DB_AFTER)"
    c_sees "Photo," || fail "C did not receive the photo"
    CHECKS+=" photo"

    # (d) Delete for everyone of the seeded group message: a tombstone at A (Room) and at C (UI).
    step "delete the seeded group message for everyone"
    d_before="$(field "$DB_AFTER" deleted)"
    { long_press "~upgrade-test A9" && wait_for "Select" 10 && tap "Delete" && wait_for "Delete for everyone" 10 && tap "Delete for everyone"; } \
      || fail "the delete UI didn't offer Delete for everyone on A's own message"
    wait_for "You deleted this message" 30 || fail "A shows no tombstone"
    await_field deleted "$(( ${d_before:-0} + 1 ))" || fail "A's Room row is not a tombstone ($DB_AFTER)"
    c_sees "This message was deleted" || fail "C shows no tombstone for the deleted message"
    DEV="$SERIAL_B"; dump; grep -qF "upgrade-test A9" "$WORK/ui.xml" && { DEV="$SERIAL"; fail "C still shows the deleted message"; }
    DEV="$SERIAL"
    CHECKS+=" delete_for_everyone"
  fi
else
  echo "==> no root on this device: verified through the UI only (use a google_apis emulator image for Room checks)"
fi
# Re-sign-in after the update (decision 055): plain "Log out" (keeps chats), sign in as the same
# user again: every conversation keeps at least its messages.
if [ "$DB_BEFORE" != no-root ] && [ "$MANUAL" = 0 ]; then
  step "log out (keep chats) and sign in again after the upgrade"
  DEV="$SERIAL"; A shell am start -W -n "$PKG/.MainActivity" >/dev/null 2>&1 || true; sleep 2; dismiss_prompts
  # Back to the chat list: a chat screen has its own "More options" (Clear/Delete chat), so press
  # Back until the list's own top bar shows (never past it: Back there leaves the app).
  for _ in 1 2 3 4 5; do
    hide_keyboard
    on_chat_list && break
    A shell input keyevent KEYCODE_BACK; sleep 1
  done
  on_chat_list || fail "re-sign-in: the chat list didn't show"
  # Plain "Log out" (decision 050): the menu item, then the dialog's confirm button (the menu's
  # other entry, "Log out and delete chats from this phone", never matches the exact text).
  tap "More options" && sleep 1 && tap "^Log out" && sleep 1 && wait_for "Log out?" 10 && tap "^Log out" \
    || fail "re-sign-in: could not log out"
  # The login screen must appear, with no automatic sign-in back into the chats.
  wait_for "Server:" 30 || fail "re-sign-in: no login screen after Log out"
  sleep 3; has "Server:" && ! on_chat_list || fail "re-sign-in: the app left the login screen by itself after Log out"
  echo "    logged out: the login screen shows"
  sign_in "+94770000961" "upgrade61@example.com" || fail "re-sign-in after the upgrade"
  # The chats are back in the list (the Room counts below compare every conversation).
  wait_for "ZZ Upgrade B" 30 || fail "re-sign-in: the chat with B is not in the list"
  [ -z "$SERIAL_B" ] || wait_for "Upgrade group" 30 || fail "re-sign-in: the group is not in the list"
  sleep 8; DB_RE="$(db_snapshot)"; echo "    after re-sign-in (Room): $DB_RE"
  lost="$(python3 -I - "$WORK/counts-before.json" "$WORK/counts-last.json" <<'PY'
import json, sys
b = json.load(open(sys.argv[1])); a = json.load(open(sys.argv[2]))
print(" ".join(f"{k}:{v}->{a.get(k, 0)}" for k, v in b.items() if a.get(k, 0) < v))
PY
)"
  [ -z "$lost" ] || fail "messages lost after re-sign-in: $lost"
  echo "    re-sign-in kept every conversation"
  chat_checks "after re-sign-in"
  if [ "$LK_STEP" = yes ]; then
    # Plain "Log out" keeps the locked list (only "Log out and delete chats" wipes it).
    d_listed && fail "locked chat: D's chat is back in the chat list after the re-sign-in"
    [ "$(field "$DB_RE" locked_msgs)" -ge "$(field "$DB_BEFORE" locked_msgs)" ] 2>/dev/null \
      || fail "locked chat: D's messages dropped after the re-sign-in ($(field "$DB_BEFORE" locked_msgs) -> $(field "$DB_RE" locked_msgs))"
    echo "    locked chat: still hidden after the re-sign-in, its $(field "$DB_RE" locked_msgs) messages kept"
  fi
fi
# ---- 4. reinstall without reset (§12.12, decision 060): A, the group's only admin, loses its app data
# and signs in again as a new device; C re-adds it, the group keeps its generation, C loses nothing.
if [ "$REINSTALL" = 0 ]; then RI_STEP=off; echo "==> reinstall phase OFF (--no-reinstall)"
elif [ -z "${REINSTALL_CHECK_FROM:-}" ] || ! [ "$NEW_VC" -ge "$REINSTALL_CHECK_FROM" ] 2>/dev/null; then
  RI_STEP=skipped; echo "==> reinstall phase skipped: new app $NEW_VN ($NEW_VC) is below REINSTALL_CHECK_FROM=${REINSTALL_CHECK_FROM:-unset} (apps up to v1.20 reset on reinstall)"
elif [ -z "$SERIAL_B" ] || [ "$DB_BEFORE" = no-root ] || [ "$MANUAL" = 1 ]; then
  RI_STEP=skipped; echo "==> reinstall phase skipped: it needs C's device (no --no-group), root (Room) and the scripted sign-in"
else
  RI_STEP=yes
fi
# The §22 backup restore inside the reinstall phase (v1.22+).
if [ "$RI_STEP" != yes ]; then RS_STEP="$RI_STEP"
elif [ -z "${RESTORE_CHECK_FROM:-}" ] || ! [ "$NEW_VC" -ge "$RESTORE_CHECK_FROM" ] 2>/dev/null; then
  RS_STEP=skipped; echo "==> backup restore skipped: new app $NEW_VN ($NEW_VC) is below RESTORE_CHECK_FROM=${RESTORE_CHECK_FROM:-unset} (backups are v1.22+)"
else
  RS_STEP=yes
fi
if [ "$RI_STEP" = yes ]; then
  # Server view: "upgrade: grp=… creatora=1 admins=1 aadmin=1 grpgen=G grpepoch=E aleaves=N grpops=K dmgen=… dmepoch=… dmops=…"
  mls_state() { local out; out="$(srv mls)"; echo "${out#upgrade: }"; }
  # C's Room snapshot (and its per-conversation counts into $1).
  c_snapshot() { local d="$DEV" r; DEV="$SERIAL_B"; r="$(db_snapshot)"; DEV="$d"; cp "$WORK/counts-last.json" "$1" 2>/dev/null || true; echo "$r"; }
  counts_lost() { python3 -I - "$1" "$2" <<'PY'
import json, sys
b = json.load(open(sys.argv[1])); a = json.load(open(sys.argv[2]))
print(" ".join(f"{k}:{v}->{a.get(k, 0)}" for k, v in b.items() if a.get(k, 0) < v))
PY
  }
  # Type $1 into whichever composer the chat shows ("Encrypted message" once e2ee, else "Message").
  send_any() {
    local ph=""; hide_keyboard
    if [ -n "$(node_xy "$ENC")" ]; then ph="$ENC"; elif [ -n "$(node_xy Message)" ]; then ph=Message; fi
    [ -n "$ph" ] || { echo "    no composer on screen"; return 1; }
    send_ui "$1" "$ph"
  }
  # A's group row: "Upgrade group", or "Rejoining group…" until the Welcome names it.
  open_group_a() {
    A shell am force-stop "$PKG"; A shell am start -W -n "$PKG/.MainActivity" >/dev/null
    local n
    for _ in $(seq 1 40); do
      dump
      for n in "Upgrade group" "Rejoining group…"; do grep -qF "text=\"$n\"" "$WORK/ui.xml" && { dismiss_prompts; tap "$n"; sleep 2; return 0; }; done
      sleep 1
    done
    echo "    A's chat list shows no group row"; return 1
  }
  # The chat screen's e2ee strip / composer state, from a fresh dump.
  strip_now() { dump; grep -oE 'Setting up encryption on this phone[^"]*' "$WORK/ui.xml" | sed -n 1p || true; }
  # ---- §22 encrypted backups (decision 059): A backs up before the uninstall and restores after it.
  BK_KEY=""; BK_FILE=""; PURGED=0
  swipe_up() { local sz w h; sz="$(A shell wm size 2>/dev/null || true)"; [[ "$sz" =~ ([0-9]+)x([0-9]+) ]] && { w="${BASH_REMATCH[1]}"; h="${BASH_REMATCH[2]}"; } || { w=720; h=1280; }
    A shell input swipe $((w / 2)) $((h * 3 / 4)) $((w / 2)) $((h / 4)) 300; sleep 1; }
  # Chat list → More options → Settings → (scroll) Manage backups → the Backups screen.
  open_backups() {
    A shell am force-stop "$PKG"; A shell am start -W -n "$PKG/.MainActivity" >/dev/null
    wait_chat_list 40 || return 1; dismiss_prompts
    tap "More options" && sleep 1 && tap "Settings" || { echo "    no Settings in the chat list's menu"; return 1; }
    wait_for 'text="Settings"' 15 || return 1
    for _ in $(seq 1 8); do has 'text="Manage backups"' && break; swipe_up; done
    # Found in the tree can still mean behind the navigation bar (nightly.35 added Settings rows): scroll once more.
    swipe_up
    tap "Manage backups" || { echo "    no \"Manage backups\" in Settings"; return 1; }
    wait_for 'text="Back up now"' 20
  }
  # $1: the device's file name; the counts file of A at backup time is $WORK/a-counts-backup.json.
  backup_before_uninstall() {
    local t i xy
    open_backups || return 1
    for i in $(seq 1 60); do has "Backups are available once it's ready" || break; sleep 2; done
    wait_for 'text="Back up to the RisiMe server"' 30 || { has "This server doesn't offer backups" && echo "    the temp server offers no backups"; return 1; }
    echo "    Settings → Manage backups: turning on \"Back up to the RisiMe server\""
    tap "Back up to the RisiMe server" || return 1
    wait_for 'text="Your recovery key"' 60 || { echo "    no \"Your recovery key\" dialog"; return 1; }
    BK_KEY="$(grep -oE '[0-9A-Z]{4}(-[0-9A-Z]{4}){6}' "$WORK/ui.xml" | sed -n 1p || true)"
    [ -n "$BK_KEY" ] || { echo "    no recovery key (XXXX-…, 7 groups) on the screen"; return 1; }
    echo "    recovery key read from the screen (${BK_KEY:0:4}-…)"
    tap "I saved it" || return 1
    wait_for 'text="Type two groups back"' 15 || return 1
    local g; IFS=- read -ra g <<<"$BK_KEY"
    type_into "Group 2" "${g[1]}" || return 1; type_into "Group 7" "${g[6]}" || return 1
    hide_keyboard; tap "!Confirm" || return 1
    wait_for 'text="Add a passphrase?"' 20 || { has "That doesn't match" && echo "    the typed groups didn't match"; return 1; }
    tap "!Not now" || return 1
    echo "    no passphrase; waiting for \"Backed up\" and the server backup's date and size"
    t=""
    for i in $(seq 1 90); do
      dump
      t="$(grep -oE 'Last server backup: [^"]+ · [^"]+' "$WORK/ui.xml" | sed -n 1p || true)"
      grep -qF 'text="Backed up"' "$WORK/ui.xml" && [ -n "$t" ] && break
      sleep 2
    done
    grep -qF 'text="Backed up"' "$WORK/ui.xml" && [ -n "$t" ] || { echo "    no \"Backed up\" + \"Last server backup: <date> · <size>\" within 3 min ($(grep -oE 'text="(Last server backup|Backed up|Backup)[^"]*"' "$WORK/ui.xml" | tr '\n' ' '))"; return 1; }
    echo "    \"Backed up\"; \"$t\""
    tap "Export backup file" || return 1
    wait_for 'Saved to Downloads: risime-backup-' 60 || { echo "    the export didn't report \"Saved to Downloads\""; return 1; }
    BK_FILE="$(grep -oE 'risime-backup-[0-9-]+\.risimebk' "$WORK/ui.xml" | sed -n 1p)"
    local magic; magic="$(A exec-out head -c 8 "/sdcard/Download/$BK_FILE" 2>/dev/null || true)"
    [ "$magic" = RISIMEBK ] || { echo "    /sdcard/Download/$BK_FILE is not a RISIMEBK file ($(A shell ls -l /sdcard/Download/ 2>&1 | tr '\n' ' '))"; return 1; }
    echo "    exported /sdcard/Download/$BK_FILE ($(A shell stat -c %s "/sdcard/Download/$BK_FILE" | tr -d '\r') bytes, RISIMEBK)"
    A_BK="$(db_snapshot)"; cp "$WORK/counts-last.json" "$WORK/a-counts-backup.json"
    echo "    A at backup time (Room): $A_BK"
  }
  # The secret dialog ("Restore your chats" / "Recovery key"): type the key, tap its Restore.
  enter_key_and_restore() {
    wait_for 'text="Recovery key"' 120 || { echo "    no \"Recovery key\" field ($(grep -oE 'text="[^"]+"' "$WORK/ui.xml" | head -8 | tr '\n' ' '))"; return 1; }
    type_into "Recovery key" "$BK_KEY" || return 1
    hide_keyboard; tap "!Restore"
  }
  # The DocumentsUI picker: the exported file (in Recent, else under Downloads).
  pick_backup_file() {
    wait_for "$BK_FILE" 15 || { tap "Show roots" >/dev/null 2>&1 && sleep 1 && tap "Downloads" >/dev/null 2>&1; wait_for "$BK_FILE" 15; } \
      || { echo "    the picker doesn't show $BK_FILE"; return 1; }
    tap "$BK_FILE"
  }
  reinstall_restore_hook() {
    [ "$RS_STEP" = yes ] || return 0
    local t0 lc n line
    t0="$(A shell date +%s | tr -d '\r').000"
    step "restore: \"Restore your chats\" after the reinstall's sign-in$([ "$RESTORE_FILE" = 1 ] && echo " (from the exported file)")"
    wait_for 'text="Restore your chats"' 90 || fail "restore: the reinstalled app shows no \"Restore your chats\" gate after the sign-in (server backup on)"
    echo "    gate: $(grep -oE 'text="[^"]+ · [^"]+ · [^"]+"' "$WORK/ui.xml" | sed -n 1p)"
    if [ "$RESTORE_FILE" = 0 ]; then
      tap "^Restore" || fail "restore: no Restore button on the gate"
      enter_key_and_restore || fail "restore: the recovery key dialog"
    elif has 'text="Restore from file"'; then
      # n32+: the gate offers "Restore from file" itself.
      tap "Restore from file" || fail "restore: the gate's \"Restore from file\""
      pick_backup_file || fail "restore: picking $BK_FILE"
      enter_key_and_restore || fail "restore: the recovery key dialog (file)"
      # From the gate the app may go straight to the chat list (the logcat check below still applies).
      for _ in $(seq 1 90); do dump; grep -q 'Restored [0-9]* messages' "$WORK/ui.xml" && break; on_chat_list && break; sleep 2; done
      if grep -q 'Restored [0-9]* messages' "$WORK/ui.xml"; then
        echo "    \"$(grep -oE 'Restored [0-9]+ messages\.' "$WORK/ui.xml" | sed -n 1p)\""; tap "!OK" || true; sleep 1
      fi
    else
      tap "^Skip" && wait_for 'text="Skip restore?"' 10 && tap "!Skip" || fail "restore: could not skip the gate"
      open_backups || fail "restore: Settings → Manage backups after skipping the gate"
      tap "Restore from file" || fail "restore: no \"Restore from file\""
      pick_backup_file || fail "restore: picking $BK_FILE"
      enter_key_and_restore || fail "restore: the recovery key dialog (file)"
      wait_for "Restored " 180 || fail "restore: no \"Restored N messages.\" ($(grep -oE 'text="[^"]+"' "$WORK/ui.xml" | head -8 | tr '\n' ' '))"
      echo "    \"$(grep -oE 'Restored [0-9]+ messages\.' "$WORK/ui.xml" | sed -n 1p)\""
      tap "!OK" || true; sleep 1
    fi
    for _ in $(seq 1 90); do
      on_chat_list && break
      grep -qE 'text="(Check the recovery key|Wrong|Encryption isn.t ready|Couldn.t|Restore failed)[^"]*"' "$WORK/ui.xml" \
        && fail "restore: $(grep -oE 'text="(Check the recovery key|Wrong|Encryption isn.t ready|Couldn.t|Restore failed)[^"]*"' "$WORK/ui.xml" | sed -n 1p)"
      [ "$RESTORE_FILE" = 1 ] && { A shell input keyevent KEYCODE_BACK; }
      sleep 2
    done
    on_chat_list || fail "restore: the chat list didn't show after the restore ($(grep -oE 'text="[^"]+"' "$WORK/ui.xml" | head -8 | tr '\n' ' '))"
    lc="$(A logcat -d -T "$t0" 2>/dev/null || true)"
    line="$(grep -oE 'restore [^ :]+: [0-9]+ imported[^$]*' <<<"$lc" | tail -1 || true)"
    [ -n "$line" ] || fail "restore: logcat has no \"restore <backup_id>: N imported\""
    n="$(sed -E 's/.*: ([0-9]+) imported.*/\1/' <<<"$line")"
    echo "    logcat: $line"
    sleep 3; A_RS="$(db_snapshot)"; echo "    A after the restore (Room): $A_RS"
    cp "$WORK/counts-last.json" "$WORK/a-counts-restored.json"
    local cmp; cmp="$(python3 -I - "$WORK/a-counts-backup.json" "$WORK/a-counts-restored.json" "$GRP_ID" "$PURGED" <<'PY'
import json, sys
b = json.load(open(sys.argv[1])); a = json.load(open(sys.argv[2])); grp, purged = sys.argv[3], sys.argv[4] == "1"
lost = [f"{k}:{v}->{a.get(k, 0)}" for k, v in b.items() if a.get(k, 0) < v]
# 1:1 chats (not the group): nothing can come from the replay once it is purged, so exactly equal.
diff = [f"{k}:{v}->{a.get(k, 0)}" for k, v in b.items() if purged and grp not in k and a.get(k, 0) != v]
print("LOST " + " ".join(lost) if lost else ("DIFF " + " ".join(diff) if diff else f"OK {len(b)}"))
PY
)"
    case "$cmp" in
      LOST*) fail "restore: A lost messages per conversation/kind (backup -> restored): ${cmp#LOST }";;
      DIFF*) fail "restore: A's 1:1 counts differ from the backup with the replay purged: ${cmp#DIFF }";;
    esac
    [ "${n:-0}" -ge 1 ] || fail "restore: logcat says $n imported"
    echo "    restore: $n imported; A's ${cmp#OK } conversation/kind counts >= the backup's$([ "$PURGED" = 1 ] && echo " (1:1 equal, replay purged)")"
    if [ "$RESTORE_FILE" = 1 ]; then CHECKS+=" restore_file"; else CHECKS+=" restore"; fi
  }
  # C's local group-op outbox (state, attempts, last error): why C didn't commit a re-add.
  c_ops() {
    local d="$DEV"; DEV="$SERIAL_B"; rm -f "$WORK"/cops.db*
    for f in risime.db risime.db-wal risime.db-shm; do A exec-out cat "/data/data/$PKG/databases/$f" > "$WORK/cops.${f#risime.}" 2>/dev/null || true; done
    DEV="$d"
    python3 -I -c 'import sqlite3,sys; c=sqlite3.connect(sys.argv[1]); print("; ".join(f"{r[0]} {r[1]} attempts={r[2]} err={r[3]}" for r in c.execute("SELECT type, state, attempts, last_error FROM group_ops")) or "empty")' "$WORK/cops.db" 2>/dev/null || echo "?"
  }

  # C updates too before A's reinstall (as testers do): the re-add then runs on the NEW app, not on
  # the old one's known bugs (nightly.31's stuck staged commit, fixed in 943993a). C's counts must
  # survive its own in-place update. UPGRADE_C_STAYS_OLD=1 keeps C on the old app (old behaviour).
  if [ "${UPGRADE_C_STAYS_OLD:-0}" != 1 ]; then
    step "reinstall: C updates in place to $NEW_VN (adb install -r) before A's reinstall"
    CU0="$(c_snapshot "$WORK/c-counts-preupdate.json")"; echo "    C before its update (Room): $CU0"
    DEV="$SERIAL_B"
    A install -r "$NEW" >/dev/null || fail "reinstall: adb install -r of the new APK on C failed"
    [ "$(installed_vn)" = "$NEW_VN" ] || fail "reinstall: C runs $(installed_vn), not $NEW_VN, after its update"
    A shell am start -W -n "$PKG/.MainActivity" >/dev/null; sleep 6; dismiss_prompts
    open_chat "Upgrade group" || { sleep 3; open_chat "Upgrade group"; } || fail "reinstall: C can't open the group after its update"
    DEV="$SERIAL"
    CU1="$(c_snapshot "$WORK/c-counts-postupdate.json")"; echo "    C after its update (Room): $CU1"
    lost="$(counts_lost "$WORK/c-counts-preupdate.json" "$WORK/c-counts-postupdate.json")"
    [ -z "$lost" ] || fail "reinstall: C lost messages in its own update: $lost"
    CHECKS+=" c_updated"
  else
    echo "==> UPGRADE_C_STAYS_OLD=1: C stays on $OLD_VN for the reinstall phase"
  fi

  step "reinstall: A (only admin) before the reinstall: server state and C's counts"
  DEV="$SERIAL"
  if [ "$DM_OFFLINE" = 1 ]; then
    # The DM A-C must be an MLS DM before A's reinstall: A opens it and sends; C receives.
    open_chat "ZZ Upgrade C" || fail "reinstall: A has no chat with C in the list"
    wait_for "$ENC" 120 || fail "reinstall: the DM A-C didn't become end-to-end encrypted"
    send_ui "upgrade-test A30" "$ENC"
    DEV="$SERIAL_B"; open_chat "ZZ Upgrade A" || fail "reinstall: C has no chat with A"
    wait_for "upgrade-test A30" 60 || fail "reinstall: C didn't receive A's DM"
    DEV="$SERIAL"
  fi
  MLS0="$(mls_state)"; echo "    server: $MLS0"
  [ "$(field "$MLS0" creatora)" = 1 ] && [ "$(field "$MLS0" admins)" = 1 ] && [ "$(field "$MLS0" aadmin)" = 1 ] \
    || fail "reinstall: A must be the creator and the only admin of the group ($MLS0)"
  GEN0="$(field "$MLS0" grpgen)"; EP0="$(field "$MLS0" grpepoch)"
  [ -n "$GEN0" ] && [ -n "$EP0" ] || fail "reinstall: the group has no MLS state on the server ($MLS0)"
  DMGEN0="$(field "$MLS0" dmgen)"
  if [ "$DM_OFFLINE" = 1 ]; then [ -n "$DMGEN0" ] && [ -n "$(field "$MLS0" dmepoch)" ] || fail "reinstall: the DM A-C has no MLS state ($MLS0)"; fi
  C0="$(c_snapshot "$WORK/c-counts-before.json")"; echo "    C before (Room): $C0"
  GRP_ID="$(sed -nE 's/.*grp=([^ ]+).*/\1/p' <<<"$MLS0")"
  if [ "$RS_STEP" = yes ]; then
    step "backup: A turns on server backup and exports a backup file (before the uninstall)"
    DEV="$SERIAL"; backup_before_uninstall || fail "backup: server backup / export on A before the uninstall"
  fi

  step "reinstall: stop C's app; uninstall A (data gone), install $NEW_VN with adb, sign in as A"
  DEV="$SERIAL_B"; A shell am force-stop "$PKG"
  DEV="$SERIAL"
  A uninstall "$PKG" >/dev/null || fail "reinstall: adb uninstall failed"
  if [ "$RS_STEP" = yes ]; then
    # Only the restore can bring A's messages back: purge A's inbox replay on the TEMP server.
    pg="$(srv purge_inbox)"; echo "    temp server: A's inbox replay ${pg#upgrade: }"
    [ "$(field "$pg" left)" = 0 ] && PURGED=1 || echo "    note: the inbox purge didn't take; counts are checked as >= only"
  fi
  A install "$NEW" >/dev/null || fail "reinstall: adb install of the new APK failed"
  A shell pm grant "$PKG" android.permission.POST_NOTIFICATIONS 2>/dev/null || true
  reverses
  sign_in "+94770000961" "upgrade61@example.com" || fail "reinstall: sign-in on the reinstalled app (A)"
  T_SIGNIN="$(date +%s)"
  reinstall_restore_hook
  echo "    A signed in again (new device; C offline)"

  if [ "$DM_OFFLINE" = 1 ]; then
    step "reinstall: A's DM with C (C offline): waiting strip, a pending send, no reset"
    open_chat "ZZ Upgrade C" || fail "reinstall: A's DM with C isn't listed after the reinstall"
    wait_for "Setting up encryption on this phone" 60 || fail "reinstall: A's DM shows no \"Setting up encryption on this phone…\""
    wait_for "Waiting for ZZ Upgrade C to open RisiMe" 120 || fail "reinstall: A's DM shows no \"Waiting for ZZ Upgrade C to open RisiMe\" (strip: $(strip_now))"
    echo "    DM strip: $(strip_now)"
    send_any "upgrade-test A31" || fail "reinstall: A can't send in the waiting DM"
  fi

  step "reinstall: A's group (C offline): \"Setting up encryption on this phone…\", a pending send"
  open_group_a || fail "reinstall: the group isn't in A's list after the reinstall"
  wait_for "Setting up encryption on this phone" 60 || fail "reinstall: A's group shows no \"Setting up encryption on this phone…\" (reset instead of rejoin?)"
  wait_for "Waiting for a group member to open RisiMe" 100 || echo "    note: no \"Waiting for a group member…\" yet (strip: $(strip_now))"
  echo "    group strip: $(strip_now)"
  send_any "upgrade-test A21" || fail "reinstall: the group composer is off while A waits (v1.21 keeps it on)"
  MLS1="$(mls_state)"; echo "    server while waiting: $MLS1"
  [ "$(field "$MLS1" grpgen)" = "$GEN0" ] || fail "reinstall: the group was RESET while A waited (generation $GEN0 -> $(field "$MLS1" grpgen))"
  [ "$(field "$MLS1" grpops)" -ge 1 ] 2>/dev/null || echo "    note: no pending group op while A waits ($MLS1)"

  if [ "$DM_OFFLINE" = 1 ]; then
    left=$(( T_SIGNIN + ${REINSTALL_DM_WAIT:-180} - $(date +%s) ))
    if [ "$left" -gt 0 ]; then echo "    C stays offline another ${left}s (${REINSTALL_DM_WAIT:-180}s after A's sign-in)"; sleep "$left"; fi
    MLS2="$(mls_state)"; echo "    server after $(( $(date +%s) - T_SIGNIN ))s offline: $MLS2"
    [ "$(field "$MLS2" dmgen)" = "$DMGEN0" ] && [ -n "$(field "$MLS2" dmepoch)" ] || fail "reinstall: the DM A-C was RESET while C was offline (generation $DMGEN0 -> $(field "$MLS2" dmgen), epoch $(field "$MLS2" dmepoch))"
    [ "$(field "$MLS2" grpgen)" = "$GEN0" ] || fail "reinstall: the group was RESET while C was offline (generation $GEN0 -> $(field "$MLS2" grpgen))"
    open_chat "ZZ Upgrade C" || true
    wait_for "Waiting for ZZ Upgrade C to open RisiMe" 30 || fail "reinstall: after ${REINSTALL_DM_WAIT:-180}s A's DM no longer says it waits for C (strip: $(strip_now))"
    has "Not end-to-end encrypted" && fail "reinstall: A's DM fell back to plaintext while waiting"
    CHECKS+=" reinstall_dm_offline"
  fi

  step "reinstall: C opens RisiMe again and re-adds A's new device"
  DEV="$SERIAL_B"; open_chat "Upgrade group" || { sleep 3; open_chat "Upgrade group"; } || fail "reinstall: C can't open the group"
  c_sees "upgrade-test A21" || fail "reinstall: A's send while waiting never reached C (A not re-added? server: $(mls_state); C's op outbox: $(c_ops))"
  DEV="$SERIAL"; open_group_a || fail "reinstall: A can't open the group"
  ok=""
  for i in $(seq 1 60); do
    st="$(strip_now)"
    [ -z "$st" ] && [ -n "$(node_xy "$ENC")" ] && { ok=1; break; }
    [ "$i" = 30 ] && { open_group_a || true; }
    sleep 2
  done
  [ -n "$ok" ] || fail "reinstall: A's group never became usable (strip: ${st:-none}; server: $(mls_state))"
  send_ui "upgrade-test A22" "$ENC"
  c_sees "upgrade-test A22" || fail "reinstall: C didn't receive A's group message after the re-add"
  DEV="$SERIAL_B"; send_ui "upgrade-test C1" "$ENC"; DEV="$SERIAL"
  wait_for "upgrade-test C1" 45 || { open_group_a >/dev/null || true; wait_for "upgrade-test C1" 45; } || fail "reinstall: A didn't receive C's group message after the re-add"
  if [ "$DM_OFFLINE" = 1 ]; then
    DEV="$SERIAL_B"; open_chat "ZZ Upgrade A" || fail "reinstall: C can't open the DM"
    wait_for "upgrade-test A31" 90 || { open_chat "ZZ Upgrade A" >/dev/null || true; wait_for "upgrade-test A31" 60; } \
      || fail "reinstall: A's pending DM never reached C after C opened RisiMe (server: $(mls_state))"
    DEV="$SERIAL"
  fi

  step "reinstall: no reset anywhere, C kept every message"
  MLS3="$(mls_state)"; echo "    server after: $MLS3"
  [ "$(field "$MLS3" grpgen)" = "$GEN0" ] || fail "reinstall: the group's generation changed ($GEN0 -> $(field "$MLS3" grpgen)): it was reset, not rejoined"
  [ "$(field "$MLS3" grpepoch)" -gt "$EP0" ] 2>/dev/null || fail "reinstall: no commit added A's new device (epoch $EP0 -> $(field "$MLS3" grpepoch))"
  if [ "$DM_OFFLINE" = 1 ]; then [ "$(field "$MLS3" dmgen)" = "$DMGEN0" ] || fail "reinstall: the DM's generation changed ($DMGEN0 -> $(field "$MLS3" dmgen))"; fi
  C1="$(c_snapshot "$WORK/c-counts-after.json")"; echo "    C after (Room): $C1"
  [ "$(field "$C1" resets)" = "$(field "$C0" resets)" ] || fail "reinstall: C got an \"Encryption was reset\" line ($(field "$C0" resets) -> $(field "$C1" resets))"
  lost="$(counts_lost "$WORK/c-counts-before.json" "$WORK/c-counts-after.json")"
  [ -z "$lost" ] || fail "reinstall: C lost messages per conversation/kind: $lost"
  DEV="$SERIAL_B"; open_chat "Upgrade group" >/dev/null || true
  has "Encryption was reset" && fail "reinstall: C's group shows \"Encryption was reset\""
  DEV="$SERIAL"; A1="$(db_snapshot)"; echo "    A after (Room): $A1"
  [ "$(field "$A1" resets)" = 0 ] || fail "reinstall: A's group has an \"Encryption was reset\" line"
  echo "    reinstall: generation $GEN0 kept (epoch $EP0 -> $(field "$MLS3" grpepoch)), A re-added by C, both directions work, C's $(python3 -I -c 'import json,sys;print(len(json.load(open(sys.argv[1]))))' "$WORK/c-counts-before.json") conversation/kind counts kept"
  CHECKS+=" reinstall_rejoin"
fi
# No crash of the app during the whole test, and (debug builds log StrictMode) no Room/MLS work on
# the main thread (the nightly.17 DM crash class): scripts/logcat-gate.
gate_out="$(adb -s "$SERIAL" logcat -d 2>/dev/null | "$REPO/scripts/logcat-gate" upgrade || true)"
[ -z "$gate_out" ] || { echo "$gate_out"; fail "the app crashed or touched the database on the main thread (logcat)"; }
RESULT=PASS; REASON="ok"; write_result
echo "UPGRADE TEST PASS ($OLD_VN -> $NEW_VN)"
