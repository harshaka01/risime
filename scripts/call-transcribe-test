#!/usr/bin/env bash
# v1.39 §36 device gate: the quick Official-call transcription path, on two redroid phones with the real app.
# Standalone (own redroid pair, temp server port/DB, fake-llm port): scripts/call-device-test's setup (temp
# server with TABS=on RISI=on, sign-in through the real UI, e2ee DM), then scripts/call-transcribe-scenario.sh,
# which restarts the temp server with RISI_CALL_TRANSCRIBE=on RISI_LEDGER=on RISI_DEV_USERS=<A> and the local
# speech service (127.0.0.1:8200, WHISPER_API_KEY from .env), and checks:
#   - a Private call shows no Transcribe button and uploads nothing;
#   - Official call: A asks, B declines -> nothing uploaded (server log); A asks again, B allows -> both phones
#     show the red "Risi transcribing" bar; Sinhala (B), English and Tamil (A) are injected in place of each
#     phone's microphone (debug-only MIC_INJECT seam; redroid has no microphone); chunks go up; B's Stop stops it
#     for both; the transcript lines appear in the Official chat with the right speaker and language;
#   - a second session ends with "Stop and delete transcript" (the consent line says so);
#   - the after-call summary card (non-blocking: it depends on the fake LLM);
#   - no audio file left on either phone, in the server's temp dirs or in the speech container;
#   - logcat clean (no FATAL / ANR).
# Clips: android/testdata/transcribe (synthetic MMS-TTS en/ta) and the speech service's Sinhala test clip.
#
#   scripts/call-transcribe-test [--apk app-debug.apk] [--keep]
#
# Prints "CALLTEST PASS|FAIL|WARN …" lines and "CALLTEST OK" at the end. Screenshots: docs/status/screens/65-transcribe-*.png.
set -euo pipefail
args=(); while [ $# -gt 0 ]; do
  if [ "$1" = --apk ] && [ $# -gt 1 ]; then args+=(--apk "$(realpath "$2")"); shift 2; else args+=("$1"); shift; fi
done
set -- "${args[@]+"${args[@]}"}"
cd "$(dirname "$0")/.."
curl -sf -o /dev/null --max-time 5 http://127.0.0.1:8200/health || { echo "the speech service (127.0.0.1:8200) is not up"; exit 2; }
command -v gst-launch-1.0 >/dev/null || { echo "gst-launch-1.0 (opus plugins) needed to decode the clips"; exit 2; }
export CALLTEST_BACK_ONLY=1
export CALLTEST_EXTRA="$PWD/scripts/call-transcribe-scenario.sh"
export CALLTEST_INSTANCE="${CALLTEST_INSTANCE:-_tx}"
export CALLTEST_PORT="${CALLTEST_PORT:-4412}"
export CALLTEST_LLM_PORT="${CALLTEST_LLM_PORT:-8199}"
export CALLTEST_REDROID_A="${CALLTEST_REDROID_A:--ct1}" CALLTEST_REDROID_A_PORT="${CALLTEST_REDROID_A_PORT:-5740}"
export CALLTEST_REDROID_B="${CALLTEST_REDROID_B:--ct2}" CALLTEST_REDROID_B_PORT="${CALLTEST_REDROID_B_PORT:-5741}"
export TX_CLIP_PORT="${TX_CLIP_PORT:-8766}"
exec scripts/call-device-test "$@"
