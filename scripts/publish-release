#!/usr/bin/env bash
# Publish a built release to risicloud.ai/app/risime/ (docs/decisions/015, 016, 079).
# Keeps a local mirror of the last five APKs + version.json per app + index.html in
# ~/risime-releases/publish/ and rsyncs it to `spark1:` (rrsync root ~/accounts/releases/risime/,
# upload-only key). Only APKs, version.json and index.html ever cross the link (decision 015).
# Feeds (decision 079): the app ai.risicloud.risime lives in the subdirectory ai.risicloud.risime/
# (its version.json + APKs); the root version.json + APKs stay the old app's feed and are only written by a
# legacy publish (LEGACY_CODEGEN_BUILD=1). index.html (root) always offers the new app first.
#   scripts/publish-release v0.2.0-nightly.2 [--required] [--no-upload]
#   scripts/publish-release --stage <apk> <dir>   # write version.json + index.html + the APK into <dir>
#     exactly as a publish would (version from the APK), nothing uploaded, no pruning: the
#     upgrade gate's local update server (scripts/upgrade-test --via-updater) serves <dir>.
#   scripts/publish-release --legacy v0.2.0-nightly.50 [--required] [--no-upload]
#     the old lk.codegen.risime line (decision 079): its APK (from ~/risime-releases/<tag>/) goes into the mirror ROOT,
#     only the root version.json (the old app's feed, same format) is rewritten, the newest old APKs are kept, and
#     index.html keeps offering the new app first. The ai.risicloud.risime/ subfolder is never touched or deleted.
# Test hooks: RISIME_PUBLISH_DEST (default spark1:), RISIME_PUBLISH_RSH (rsync -e program).
set -euo pipefail
cd "$(dirname "$0")/.."
REL="$HOME/risime-releases"; MIRROR="$REL/publish"; KEEP=5
BASE_ROOT="${RISIME_PUBLISH_BASE_URL:-https://risicloud.ai/app/risime/}"
NEW_PKG=ai.risicloud.risime
DEST="${RISIME_PUBLISH_DEST:-spark1:}"
TAG=""; REQUIRED=false; UPLOAD=1; STAGE=""; LEGACY=0
while [ $# -gt 0 ]; do case "$1" in
  --required) REQUIRED=true; shift;; --no-upload) UPLOAD=0; shift;;
  --legacy) LEGACY=1; TAG="${2:?--legacy <tag>}"; shift 2;;
  --stage) STAGE_APK="${2:?--stage <apk> <dir>}"; STAGE="${3:?--stage <apk> <dir>}"; shift 3;;
  v*) TAG="$1"; shift;; *) echo "usage: $0 v<version> [--required] [--no-upload] | --stage <apk> <dir>"; exit 2;; esac; done
if [ -n "$STAGE" ]; then
  case "$STAGE_APK" in /*) ;; *) STAGE_APK="$OLDPWD/$STAGE_APK";; esac   # relative to the caller (we cd'd)
  case "$STAGE" in /*) ;; *) STAGE="$OLDPWD/$STAGE";; esac
  apk="$STAGE_APK"; [ -f "$apk" ] || { echo "no $apk"; exit 1; }
  src="$STAGE"; MIRROR="$STAGE"; UPLOAD=0
else
  [ -n "$TAG" ] || { echo "usage: $0 v<version> [--required] [--no-upload]"; exit 2; }
  ver="${TAG#v}"; src="$REL/$TAG"; apk="$src/risime-$ver.apk"
  [ -f "$apk" ] || { echo "no $apk (run scripts/nightly-release first)"; exit 1; }
  (cd "$src" && sha256sum -c --quiet SHA256SUMS) || { echo "checksum mismatch in $src"; exit 1; }
fi

BT="$(printf '%s\n' "${ANDROID_HOME:-$HOME/Android/Sdk}"/build-tools/* | sort -V | tail -1)"
# Package + signer gate (decision 079): new app = the Risi key (no "codegen" subject); legacy app only with
# LEGACY_CODEGEN_BUILD=1 and its old key.
# --legacy: the old app's own key and package only (scripts/check-apk-signer's legacy branch).
[ "$LEGACY" = 1 ] && export LEGACY_CODEGEN_BUILD=1
scripts/check-apk-signer "$apk" || exit 1
certs="$("$BT/apksigner" verify --print-certs "$apk")"
cert="$(sed -n 's/.*certificate SHA-256 digest: //p' <<<"$certs" | sed -n 1p)"
badging="$("$BT/aapt2" dump badging "$apk" | sed -n 1p)"   # not head: SIGPIPE under pipefail
code="$(sed -n "s/.*versionCode='\([0-9]*\)'.*/\1/p" <<<"$badging")"
pkg="$(sed -n "s/^package: name='\([^']*\)'.*/\1/p" <<<"$badging")"
[ -z "$STAGE" ] || ver="$(sed -n "s/.*versionName='\([^']*\)'.*/\1/p" <<<"$badging")"
if [ "$LEGACY" = 1 ] && [ "$pkg" != lk.codegen.risime ]; then echo "--legacy needs an lk.codegen.risime APK, not $pkg"; exit 1; fi
if [ "$LEGACY" = 0 ] && [ -z "$STAGE" ] && [ "$pkg" = lk.codegen.risime ]; then echo "an lk.codegen.risime APK is published only with --legacy <tag>"; exit 1; fi
# The feed's subdirectory: the new app's own, or the root (legacy app).
SUB=""; [ "$pkg" = "$NEW_PKG" ] && SUB="$pkg/"
BASE_URL="$BASE_ROOT$SUB"
sha="$(sha256sum "$apk" | cut -d' ' -f1)"
notes_md="$src/RELEASE-NOTES.md"
[ -z "$STAGE" ] || notes_md="$REL/v$ver/RELEASE-NOTES.md"   # a candidate's notes, when already written

# --stage <dir>: <dir> is the feed directory itself (served as $BASE_URL). A publish: the feed is
# $MIRROR/$SUB, and the page index.html sits at the mirror root.
FEED="$MIRROR"; [ -n "$STAGE" ] || FEED="$MIRROR/${SUB%/}"
mkdir -p "$FEED"
if [ -n "$STAGE" ]; then cp "$apk" "$FEED/risime-$ver.apk"; else
cp "$apk" "$FEED/"
# Keep the newest $KEEP APKs by real versionCode (sort -V misorders 0.2.0 vs 0.2.0-nightly.N).
mapfile -t apks < <(for f in "$FEED"/risime-*.apk; do
  printf '%s %s\n' "$("$BT/aapt2" dump badging "$f" | sed -n "1s/.*versionCode='\([0-9]*\)'.*/\1/p")" "$f"
done | sort -n | cut -d' ' -f2-)
if [ "${#apks[@]}" -gt "$KEEP" ]; then
  for old in "${apks[@]:0:${#apks[@]}-KEEP}"; do rm -f "$old"; done
fi
fi

python3 - "$FEED" "$ver" "$code" "$sha" "$cert" "$REQUIRED" "$BASE_URL" "$notes_md" "$MIRROR" "${STAGE:+stage}" "$NEW_PKG" <<'PY'
import json, sys, html, datetime, os, re
feed, ver, code, sha, cert, required, base, notes_md, mirror, stage, new_pkg = sys.argv[1:]
notes = open(notes_md).read() if os.path.exists(notes_md) else ""
# Short plain-text notes for the app: the "New for users" section, else the first lines.
m = re.search(r"## New for users\n(.*?)(\n## |\Z)", notes, re.S) or re.search(r"## New\n(.*?)(\n## |\Z)", notes, re.S)
short = (m.group(1) if m else notes).strip()[:2000]
def plain(md):
    # Markdown -> readable plain text: headings, emphasis, code, links, list markers.
    t = re.sub(r"`([^`]*)`", r"\1", md)
    t = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", t)
    t = re.sub(r"(\*\*|__|\*|_)(\S[^*_]*?)\1", r"\2", t)
    t = re.sub(r"^\s*#+\s*", "", t, flags=re.M)
    t = re.sub(r"^\s*[-*+]\s+", "• ", t, flags=re.M)
    t = re.sub(r"\n[ \t]+(?!• )", " ", t)   # join wrapped continuation lines
    return re.sub(r"\n{3,}", "\n\n", t).strip()
# summary: short plain text the app shows on the update screen (decision 016 amendment).
# An explicit docs/releases/v<ver>.summary.txt wins; otherwise the first lines of "New", made plain.
summary_path = os.path.join(os.getcwd(), "docs", "releases", f"v{ver}.summary.txt")
if os.path.exists(summary_path):
    summary = open(summary_path).read().strip()
else:
    lines = [l for l in plain(short).splitlines() if l.strip()]
    summary = "\n".join(lines[:3])
summary = summary[:400]
apk = f"risime-{ver}.apk"
vj = {"versionCode": int(code), "versionName": ver,
      "date": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
      "summary": summary, "notes": short, "url": base + apk, "sha256": sha, "certSha256": cert.lower(),
      "required": required == "true"}
open(os.path.join(feed, "version.json"), "w").write(json.dumps(vj, indent=2) + "\n")
e = html.escape
# The page (decision 079): the new app first, from its own feed's version.json. A stage writes it next to
# its feed; a publish writes it at the mirror root and reads whichever feeds the mirror holds.
def feed_info(d, prefix):
    try:
        v = json.load(open(os.path.join(d, "version.json")))
    except (OSError, ValueError):
        return None
    return dict(v, href=prefix + os.path.basename(v["url"]))
if stage:
    page_dir, newest = feed, feed_info(feed, "")
else:
    page_dir = mirror
    newest = feed_info(os.path.join(mirror, new_pkg), new_pkg + "/") or feed_info(mirror, "")
is_new = newest is not None and newest["href"].startswith(new_pkg + "/") or (stage and base.rstrip("/").endswith(new_pkg))
# "Old app (lk.codegen.risime)": kept (pointing at the newest old APK) only when the current page already has it.
old_link = ""
try:
    had_old = "Old app (lk.codegen.risime)" in open(os.path.join(page_dir, "index.html")).read()
except OSError:
    had_old = False
old = feed_info(mirror, "") if (had_old and not stage) else None
if old and not old["href"].startswith(new_pkg + "/"):
    old_link = f'<h2>Old app (lk.codegen.risime)</h2><p><a href="{e(old["href"])}">RisiMe {e(old["versionName"])} (old app)</a></p>'
moved = ("<p><strong>Had the previous RisiMe app?</strong> This is a new app: it installs next to the old one and "
         "never touches it. Your account, friends and groups come back when you sign in; old chats stay in the old app "
         "(export them there first if you want to keep them).</p>") if is_new else ""
page = f"""<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>Get RisiMe</title>
<style>body{{font-family:system-ui,sans-serif;max-width:40rem;margin:2rem auto;padding:0 1rem;color:#1b1b1b}}
a.btn{{display:inline-block;background:#0B6E69;color:#fff;padding:.9rem 1.4rem;border-radius:.6rem;text-decoration:none;font-weight:600}}
code{{word-break:break-all;font-size:.8rem}} pre{{white-space:pre-wrap;background:#f4f6f6;padding:1rem;border-radius:.5rem}}
@media (prefers-color-scheme:dark){{body{{background:#111;color:#eee}} pre{{background:#1d2222}}}}</style></head><body>
<h1>RisiMe</h1><p>Talk. Connect. Act.</p>
<p><a class="btn" href="{e(newest["href"])}">Download RisiMe {e(newest["versionName"])} for Android</a></p>
<p>After installing, RisiMe keeps itself up to date.</p>
{moved}
{old_link}
<p><strong>Updates install over the app &mdash; never uninstall it: uninstalling deletes your chats. If Android says 'App not installed', don't uninstall &mdash; contact your RisiMe admin.</strong></p>
<h2>What's new</h2><pre>{e(newest.get("notes", ""))}</pre>
<h2>Install</h2><ol><li>Open the downloaded file and allow "install unknown apps" for your browser when asked.</li>
<li>Sign in with your work email; you'll get a code by email.</li></ol>
<h2>Verify</h2><p>SHA-256: <code>{e(newest["sha256"])}</code><br>Signing certificate SHA-256: <code>{e(newest["certSha256"])}</code></p>
<p>Internal pilot build. &copy; 2026 Risi.</p></body></html>
"""
open(os.path.join(page_dir, "index.html"), "w").write(page)
PY
echo "==> mirror $MIRROR:"; printf '    %s\n' "$MIRROR"/*
[ "$UPLOAD" = 1 ] || { echo "==> --no-upload: done"; exit 0; }

rsh=(); [ -n "${RISIME_PUBLISH_RSH:-}" ] && rsh=(-e "$RISIME_PUBLISH_RSH")
# 1) APKs first, so version.json never points at a missing file; 2) index + version.json;
# 3) prune anything not in the mirror (older APKs).
# Feeds: ai.risicloud.risime/ (new app) and the root (old app); a publish writes only its own feed + index.html.
# The --delete below mirrors the local tree: without the new app's feed locally it would delete it remotely. Refuse.
[ -f "$MIRROR/$NEW_PKG/version.json" ] || { echo "the mirror has no $NEW_PKG/version.json: refusing to upload (would delete the new app's feed)"; exit 1; }
rsync -rt --chmod=F644,D755 "${rsh[@]}" --include='*/' --include='risime-*.apk' --exclude='*' "$MIRROR/" "$DEST"
rsync -rt --chmod=F644,D755 "${rsh[@]}" --delay-updates "$FEED/version.json" "$DEST$SUB"
rsync -rt --chmod=F644,D755 "${rsh[@]}" --delay-updates "$MIRROR/index.html" "$DEST"
rsync -rt --chmod=F644,D755 "${rsh[@]}" --delete "$MIRROR/" "$DEST"
echo "==> published $TAG to $DEST ($BASE_URL)"
