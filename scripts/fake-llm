#!/usr/bin/env python3
"""A fake `risi-l1` for the Risi canary gate (contract v1.24 §24.14; decisions 061, 066).

An OpenAI-compatible stub on LOOPBACK only. It answers
  GET  /health                 -> 200
  GET  /v1/models              -> risi-l1 (root "fake-llm")
  POST /v1/chat/completions    -> a chat completion whose content is JSON that is valid for the
                                  request's `response_format.json_schema.schema` (a minimal
                                  instance: required keys, empty arrays, null where allowed,
                                  numbers in range, strings matching simple patterns), except:
                                  * the commitments schema: one commitment per `"new": true`
                                    chat line that starts "I'll"/"I will" (owner = its sender,
                                    counterparts = the other members, due = the next Friday 17:00
                                    of the owner's "now" when the line says "Friday", else null,
                                    source = that line, confidence 0.9), so a gate sees a card;
                                  * the summary/answer/report schemas: fixed, content-free text
                                    ("fake summary of N lines"), never an echo of the chat
and appends every request body, one JSON object per line, to the record file, so a gate can
check that a canary never reached the model. If LLM_API_KEY is set in the environment, requests
without `Authorization: Bearer <key>` get 401 (the key is never printed).

  scripts/fake-llm [--port 8199] [--record /path/requests.jsonl]

Point the server at it with RISI_LLM_URL=http://127.0.0.1:8199/v1. Stdlib only; synthetic data.
"""
import argparse
import json
import os
import re
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

LOCK = threading.Lock()


def instance(schema):
    """A minimal value valid for the JSON-schema subset Risi uses."""
    if not isinstance(schema, dict):
        return None
    if "enum" in schema:
        return schema["enum"][0]
    if "anyOf" in schema:
        alts = schema["anyOf"]
        for alt in alts:
            if alt.get("type") == "null":
                return None
        return instance(alts[0])
    t = schema.get("type")
    if isinstance(t, list):
        if "null" in t:
            return None
        t = t[0]
    if t == "object":
        props = schema.get("properties", {})
        return {k: instance(props.get(k, {})) for k in schema.get("required", [])}
    if t == "array":
        return []
    if t == "string":
        pattern = schema.get("pattern")
        if pattern:
            # Simple patterns only (refs like ^u[0-9]{1,3}$, dates).
            if re.fullmatch(pattern, "u1"):
                return "u1"
            if re.fullmatch(pattern, "m1"):
                return "m1"
            if re.fullmatch(pattern, "2026-01-01"):
                return "2026-01-01"
        return "fake"[: schema.get("maxLength", 4)]
    if t in ("number", "integer"):
        lo = schema.get("minimum", 0)
        hi = schema.get("maximum", 1)
        v = 1 if lo <= 1 <= hi else lo
        return v if t == "integer" else float(v)
    if t == "boolean":
        return False
    return None


def _json_lines(text):
    """The JSON objects in `text`, one per line."""
    out = []
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("{"):
            try:
                out.append(json.loads(line))
            except ValueError:
                pass
    return out


def _chat(user_text):
    """(members, chat lines) of a Risi prompt (RisiMe.Agent.Prompts.render/4)."""
    head, _, rest = user_text.partition("<chat>")
    return ([m for m in _json_lines(head) if "ref" in m],
            _json_lines(rest.partition("</chat>")[0]) if rest else [])


def _next_friday(now):
    """`now` = "YYYY-MM-DD Ddd HH:MM" (the owner's local time) -> "YYYY-MM-DDT17:00" of the next Friday."""
    import datetime
    try:
        day = datetime.date.fromisoformat(now[:10])
        hhmm = now.split()[-1]
    except (ValueError, IndexError):
        return None
    ahead = (4 - day.weekday()) % 7
    if ahead == 0 and hhmm >= "16:00":
        ahead = 7
    return (day + datetime.timedelta(days=ahead)).isoformat() + "T17:00"


PROMISE = re.compile(r"(?i)\s*(i'll|i’ll|i will)\b")


def commitments(user_text):
    members, lines = _chat(user_text)
    out = []
    for ln in lines:
        text = str(ln.get("text", ""))
        owner = ln.get("from")
        if not ln.get("new") or not PROMISE.match(text) or not isinstance(owner, str) or not owner.startswith("u"):
            continue
        now = next((m.get("now") for m in members if m.get("ref") == owner), "") or ""
        due = _next_friday(now) if re.search(r"(?i)friday", text) else None
        out.append({
            "text": "Send the report" if re.search(r"(?i)report", text) else "Do the promised task",
            "owner": owner,
            "counterparts": [m["ref"] for m in members if m.get("ref") != owner][:20],
            "due_local": due,
            "due_text": "Friday 5pm" if due else None,
            "source": [ln["ref"]],
            "confidence": 0.9,
        })
    return {"commitments": out[:10]}


def answer_for(schema, user_text):
    """A deterministic answer for Risi's schemas (None: fall back to the minimal instance)."""
    props = (schema or {}).get("properties", {})
    n = len(_chat(user_text)[1])
    if "commitments" in props:
        return commitments(user_text)
    if "summary" in props:
        return {"summary": f"fake summary of {n} lines", "decisions": [], "action_items": [],
                "open_questions": []}
    if "answer" in props:
        return {"answer": f"fake answer from {n} lines", "refs": [], "confidence": 0.9}
    if "sections" in props:
        return {"title": "fake report", "sections": [{"heading": "Lines", "body": f"{n} lines"}]}
    return None


class Handler(BaseHTTPRequestHandler):
    server_version = "fake-llm"

    def log_message(self, *args):  # never log request contents
        pass

    def _json(self, code, obj):
        raw = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def _authorised(self):
        key = os.environ.get("LLM_API_KEY")
        return not key or self.headers.get("Authorization") == "Bearer " + key

    def do_GET(self):
        if self.path == "/health":
            return self._json(200, {})
        if not self._authorised():
            return self._json(401, {"error": "unauthorised"})
        if self.path == "/v1/models":
            return self._json(200, {"object": "list", "data": [
                {"id": "risi-l1", "object": "model", "root": "fake-llm"}]})
        return self._json(404, {"error": "not found"})

    def do_POST(self):
        if not self._authorised():
            return self._json(401, {"error": "unauthorised"})
        if self.path != "/v1/chat/completions":
            return self._json(404, {"error": "not found"})
        length = int(self.headers.get("Content-Length", "0"))
        try:
            body = json.loads(self.rfile.read(length) or b"{}")
        except ValueError:
            return self._json(400, {"error": "bad json"})
        with LOCK:
            with open(self.server.record, "a", encoding="utf-8") as f:
                f.write(json.dumps(body, ensure_ascii=False) + "\n")
        schema = (body.get("response_format") or {}).get("json_schema", {}).get("schema")
        user_text = "\n".join(
            m.get("content", "") for m in body.get("messages", [])
            if isinstance(m, dict) and m.get("role") == "user" and isinstance(m.get("content"), str))
        smart = answer_for(schema, user_text) if schema else None
        content = json.dumps(smart if smart is not None else (instance(schema) if schema else {"text": "fake"}))
        return self._json(200, {
            "id": "fake", "object": "chat.completion", "model": "risi-l1",
            "choices": [{"index": 0, "finish_reason": "stop",
                         "message": {"role": "assistant", "content": content}}],
            "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}})


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--port", type=int, default=8199)
    ap.add_argument("--record", default=os.path.join(os.getcwd(), "fake-llm-requests.jsonl"))
    args = ap.parse_args()
    srv = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    srv.record = args.record
    print(f"fake-llm on http://127.0.0.1:{srv.server_address[1]}/v1, recording to {args.record}",
          flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
