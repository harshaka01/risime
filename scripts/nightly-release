#!/usr/bin/env bash
# spark2, root role: bump VERSION to the next nightly, run both gates, commit + tag + push, build the
# release-signed APK, publish it to ~/risime-releases/v<version>/, then switch the test server to the
# new tag's worktree (~/risime-run/v<version>, docs/decisions/006). See docs/NIGHTLY.md.
#   scripts/nightly-release            # next nightly (X.Y+1.0-nightly.1 after a release, else nightly.N+1)
#   scripts/nightly-release 0.2.0      # an explicit version (e.g. a final release)
#   scripts/nightly-release --required # mark this release as a required update (version.json)
#   scripts/nightly-release --no-publish   # tag + build + switch the pilot, publish later
#   scripts/nightly-release --publish-only v0.2.0-nightly.3   # re-run only the spark publish step
# Release gate: a fresh scripts/upgrade-test PASS for this version and HEAD (see the upgrade step).
set -euo pipefail
cd "$(dirname "$0")/.."
M="$HOME/.local/bin/mise exec --"
KEYS="$HOME/risime-keys/keystore.properties"
REL="$HOME/risime-releases"

[ -f "$KEYS" ] || { echo "missing $KEYS (dev release keystore)"; exit 1; }
[ "$(git rev-parse --abbrev-ref HEAD)" = main ] || { echo "not on main"; exit 1; }
git diff --quiet && git diff --cached --quiet || { echo "working tree not clean"; exit 1; }
git pull -q --rebase origin main

REQ=(); EXPLICIT=""; PUBLISH=1
while [ $# -gt 0 ]; do case "$1" in
  --required) REQ=(--required); shift;;
  --no-publish) PUBLISH=0; shift;;
  --publish-only) exec scripts/publish-release "${2:?--publish-only needs v<version>}" "${REQ[@]}";;
  *) EXPLICIT="$1"; shift;; esac; done

cur="$(cat VERSION)"
if [ -n "$EXPLICIT" ]; then next="$EXPLICIT"
elif [[ "$cur" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)-nightly\.([0-9]+)$ ]]; then
  next="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.${BASH_REMATCH[3]}-nightly.$((BASH_REMATCH[4] + 1))"
elif [[ "$cur" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
  next="${BASH_REMATCH[1]}.$((BASH_REMATCH[2] + 1)).0-nightly.1"
else echo "can't parse VERSION '$cur'"; exit 1; fi
[[ "$next" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-nightly\.[0-9]+)?$ ]] || { echo "bad version $next"; exit 1; }
git rev-parse -q --verify "refs/tags/v$next" >/dev/null && { echo "tag v$next exists"; exit 1; }
echo "==> $cur -> $next"
echo "$next" > VERSION
RELEASED=0
# Restore VERSION on ANY failed exit (explicit `exit 1` included), not only on command errors.
trap '[ "$RELEASED" = 1 ] || git checkout -q -- VERSION 2>/dev/null || true' EXIT

echo "==> server gate"
(cd server && $M mix format --check-formatted && $M mix compile --warnings-as-errors && $M mix test)
# Firebase config (decision 026): Harsha's file lives outside git; copy it in when present.
if [ -f "$HOME/risime-keys/google-services.json" ]; then
  install -m 600 "$HOME/risime-keys/google-services.json" android/app/google-services.json
  echo "==> push: google-services.json present (Firebase plugin on)"
else
  rm -f android/app/google-services.json
  echo "==> push: no google-services.json (push off in this build)"
fi
echo "==> android gate + release build"
# E2EE: pin the pilot attestation public key (decision 032; public by design, committed).
PIN_FILE=infra/pilot/attestation-public.jwk
PIN_ARGS=(); [ -f "$PIN_FILE" ] && PIN_ARGS=("-Prisime.mlsPinnedKeys=$(tr -d '\n' < "$PIN_FILE")")
(cd android && $M ./gradlew --no-configuration-cache "${PIN_ARGS[@]}" assembleDebug testDebugUnitTest assembleRelease)

echo "==> live interop (scripts/interop: real Android clients vs a temp server from this checkout)"
RISIME_GRADLE_ARGS="${PIN_ARGS[*]}" scripts/interop

APK=android/app/build/outputs/apk/release/app-release.apk
BT="$(ls -d "${ANDROID_HOME:-$HOME/Android/Sdk}"/build-tools/* | sort -V | tail -1)"
if [ -f "$PIN_FILE" ]; then
  kid="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["kid"])' "$PIN_FILE")"
  # grep -c reads the whole stream: `grep -q` would SIGPIPE unzip and fail the pipeline under pipefail.
  hits="$(unzip -p "$APK" 'classes*.dex' | grep -ac -- "$kid" || true)"
  [ "${hits:-0}" -gt 0 ] || { echo "release APK lacks the pinned attestation key $kid"; exit 1; }
  echo "==> E2EE: release pins attestation key $kid"
fi
[ "$("$BT/apksigner" verify --print-certs "$APK" | grep -c "CN=RisiMe Dev Release" || true)" -gt 0 ] \
  || { echo "release APK is not signed with the dev release key"; exit 1; }

# Upgrade gate (P0 nightly.10 data loss): the previous published APK, signed in with chats, must
# upgrade in place to THIS candidate with every message kept and no new sign-in. Needs an adb
# device; spark2 has no emulator, so without one the candidate is staged and the run stops:
#   laptop: scripts/upgrade-test --fetch-candidate   (tests it, copies the result back to spark2)
#   spark2: scripts/nightly-release ...              (same HEAD: accepts the fresh PASS)
# Escape hatch for a result produced elsewhere: UPGRADE_TEST_RESULT=<file> (still checked: PASS,
# this version, this commit, under 24 h old).
echo "==> upgrade test (previous published APK -> v$next)"
UT_COMMIT="$(git rev-parse HEAD)"
CAND="$REL/candidate"; mkdir -p "$CAND" "$HOME/risime-logs/upgrade-test"
UT_RESULT="${UPGRADE_TEST_RESULT:-$HOME/risime-logs/upgrade-test/v$next.result}"
ut() { sed -n "/^$1=/{s/^$1=//p;q}" "$UT_RESULT" 2>/dev/null || true; }
# A PASS for an earlier commit still counts when everything changed since is release tooling
# (scripts/upgrade-test, scripts/nightly-release) or docs (no app/server/crypto/contract change). Then the EXACT tested binary (the staged
# candidate, sha256 checked against the result) is released, not this rebuild.
REUSED=0
if [ -f "$UT_RESULT" ] && [ "$(ut result)" = PASS ] && [ -n "$(ut commit)" ] && [ "$(ut commit)" != "$UT_COMMIT" ] \
   && [ -f "$CAND/CANDIDATE" ] && [ "$(sed -n 's/^commit=//p' "$CAND/CANDIDATE")" = "$(ut commit)" ] \
   && git cat-file -e "$(ut commit)^{commit}" 2>/dev/null; then
  changed="$(git diff --name-only "$(ut commit)" HEAD)"
  other="$(printf '%s\n' "$changed" | grep -vE '^(scripts/upgrade-test|scripts/nightly-release|docs/)' || true)"
  cand_sha="$(sha256sum "$CAND/app-release.apk" | cut -d' ' -f1)"
  if [ -z "$other" ] && [ "$cand_sha" = "$(ut new_sha256)" ]; then
    [ "$("$BT/apksigner" verify --print-certs "$CAND/app-release.apk" | grep -c "CN=RisiMe Dev Release" || true)" -gt 0 ] \
      || { echo "staged candidate is not signed with the dev release key"; exit 1; }
    echo "==> upgrade test ran on $(ut commit); since then only: $(echo $changed). Releasing the tested candidate (sha256 ${cand_sha:0:12})."
    APK="$CAND/app-release.apk"; UT_COMMIT="$(ut commit)"; REUSED=1
  else
    echo "==> earlier upgrade result not reusable (other changes: $(echo ${other:-none}); sha match: $([ "$cand_sha" = "$(ut new_sha256)" ] && echo yes || echo no))"
  fi
fi
if [ "$REUSED" = 0 ]; then
  cp "$APK" "$CAND/app-release.apk"; printf 'version=%s\ncommit=%s\n' "$next" "$UT_COMMIT" > "$CAND/CANDIDATE"
fi
if [ "$REUSED" = 0 ] && [ -z "${UPGRADE_TEST_RESULT:-}" ] && command -v adb >/dev/null && [ -n "$(adb devices 2>/dev/null | awk 'NR>1 && $2=="device"' || true)" ]; then
  scripts/upgrade-test --new "$APK" --version "$next" --commit "$UT_COMMIT" || { echo "UPGRADE TEST FAILED: not releasing"; exit 1; }
fi
if [ ! -f "$UT_RESULT" ]; then
  echo "NO UPGRADE TEST RESULT for v$next. Candidate staged in $CAND."
  echo "  Laptop: scripts/upgrade-test --fetch-candidate, then re-run scripts/nightly-release here (same HEAD)."
  exit 1
fi
[ "$(ut result)" = PASS ] || { echo "upgrade test did not pass: $(ut reason)"; exit 1; }
[ "$(ut version)" = "$next" ] || { echo "upgrade test result is for v$(ut version), not v$next"; exit 1; }
[ "$(ut commit)" = "$UT_COMMIT" ] || { echo "upgrade test result is for another commit; re-run it on this HEAD"; exit 1; }
age=$(( $(date -u +%s) - $(ut time || echo 0) ))
[ "$age" -ge 0 ] && [ "$age" -lt 86400 ] || { echo "upgrade test result is older than 24 h; re-run it"; exit 1; }
echo "==> upgrade test PASS ($(ut old) -> $(ut new) on $(ut host)/$(ut device), $((age / 60)) min ago)"

last="$(git describe --tags --abbrev=0 2>/dev/null || true)"
notes="docs/releases/v$next.md"
if [ ! -f "$notes" ]; then
  { echo "# RisiMe v$next"; echo; echo "Nightly build from \`main\`. Protocol: \`contract/v1/PROTOCOL.md\` $(grep -m1 -o 'v1\.[0-9]*' contract/v1/PROTOCOL.md)."
    echo; echo "## Changes since ${last:-the start}"; git log --no-merges --format='- %s' ${last:+$last..}HEAD; } > "$notes"
fi
git add VERSION "$notes"
git commit -q -m "chore(root): release v$next

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>"
git tag -a "v$next" -m "RisiMe v$next"
git push -q origin main "v$next"
RELEASED=1
git push -q spark2-backup main "v$next" 2>/dev/null || echo "warn: spark2-backup push failed"

out="$REL/v$next"; mkdir -p "$out"
cp "$APK" "$out/risime-$next.apk"
cp "$notes" "$out/RELEASE-NOTES.md"
"$BT/apksigner" verify --print-certs "$out/risime-$next.apk" | grep -E "SHA-256 digest" > "$out/SIGNER.txt" || true
(cd "$out" && sha256sum "risime-$next.apk" > SHA256SUMS)
echo "v$next" > "$REL/LATEST"
echo "==> published $out"

echo "==> publish to risicloud.ai/app/risime/ (docs/decisions/016)"
published=1
if [ "$PUBLISH" = 1 ]; then
  scripts/publish-release "v$next" "${REQ[@]}" || { published=0; echo "WARN: publish failed; tag and local release are intact. Retry: scripts/nightly-release --publish-only v$next"; }
else
  echo "==> --no-publish: run scripts/nightly-release --publish-only v$next when ready"
fi

echo "==> switch the pilot server to v$next (prod release; docs/decisions/006, 023)"
scripts/run-server "v$next"
[ "$published" = 1 ] || { echo "DONE v$next (NOT published)"; exit 1; }
echo "DONE v$next"
