#!/usr/bin/env bash
# Pilot diagnostics snapshot (P0 incident 2026-10-10): what docs/status/incident-2026-10-10.md captured by hand.
#   scripts/capture-diag [<out dir>]   default ~/risime-logs/diag/<UTC time>; prints the directory.
# Read-only: GET requests, journalctl, ps, docker stats/exec of read-only commands. Every step has a timeout,
# so a hung server or database can't hang this. Keeps the newest 30 snapshots.
set -uo pipefail
cd "$(dirname "$0")/.."
ROOT="$HOME/risime-logs/diag"
OUT="${1:-$ROOT/$(date -u +%Y-%m-%dT%H-%M-%SZ)}"; mkdir -p "$OUT"
t() { local f="$1" s="$2"; shift 2; timeout "$s" "$@" > "$OUT/$f" 2>&1 || echo "(exit $?)" >> "$OUT/$f"; }
probe() {  # url: 5 probes, connect/total times
  local u="$1" i
  for i in 1 2 3 4 5; do
    curl -s -o /dev/null -m 5 -w "%{http_code} connect=%{time_connect}s total=%{time_total}s\n" "$u" || echo "000 (curl exit $?)"
  done
}
{ echo "## local"; probe http://127.0.0.1:4000/health
  echo "## public"; probe https://risime.risicloud.ai/health
  echo "## keycloak"; probe https://risicloud.ai/realms/aoa/protocol/openid-connect/certs
  echo "## control (google)"; probe https://oauth2.googleapis.com/
  echo "## health body"; curl -s -m 5 http://127.0.0.1:4000/health; echo; } > "$OUT/health.txt" 2>&1
t journal-risime.txt 20 journalctl --user -u risime.service --since "-3h" --no-pager -o short-iso
t journal-caddy.txt 20 journalctl -u caddy --since "-3h" --no-pager -o short-iso -p warning
t server-log-tail.txt 10 tail -n 2000 "$HOME/risime-logs/server.log"
t memory.txt 10 bash -c 'free -h; echo; vmstat 1 3; echo; for p in /proc/[0-9]*; do s=$(awk "/^VmSwap/{print \$2}" $p/status 2>/dev/null); [ "${s:-0}" -gt 51200 ] && echo "$s kB swap $(tr "\0" " " < $p/cmdline | cut -c1-100)"; done | sort -rn | head -15'
t beam.txt 10 bash -c 'p=$(systemctl --user show -p MainPID --value risime.service); pp=$(pgrep -P "$p" -f beam | head -1); for x in $p $pp; do [ -n "$x" ] && [ "$x" != 0 ] && { ps -o pid,rss,vsz,pcpu,nlwp,etime,cmd -p "$x" | cut -c1-160; grep -E "VmSwap|Threads" /proc/$x/status; ls /proc/$x/fd 2>/dev/null | wc -l; }; done'
# BEAM internals (run queue, mailboxes, Repo pool) need the release's remote shell: RELEASE_DISTRIBUTION=none on the
# pilot today (incident-2026-10-10 §2); docs/MONITORING.md has the loopback-only setup that adds them.
echo "RELEASE_DISTRIBUTION=$(sed -n 's/^RELEASE_DISTRIBUTION=//p' infra/pilot/pilot.env | tail -1): no BEAM internals" > "$OUT/beam-internals.txt"
t containers.txt 20 docker stats --no-stream --format '{{.Name}} {{.MemUsage}} {{.CPUPerc}}'
t cassandra.txt 40 bash -c 'docker exec risime-dev-cassandra-1 nodetool tpstats | head -40; docker exec risime-dev-cassandra-1 nodetool gcstats'
t postgres.txt 15 docker exec risime-dev-postgres-1 psql -U "$(sed -n 's/^POSTGRES_USER=//p' infra/pilot/pilot.env | tail -1)" -d risime_dev -Atc "select state, wait_event_type, count(*), max(now()-query_start) from pg_stat_activity where datname='risime_dev' group by 1,2"
t network.txt 10 bash -c 'cat /proc/sys/net/netfilter/nf_conntrack_count /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null; ss -s; ss -tn state established "( sport = :4000 )" | wc -l'
ls -1dt "$ROOT"/*/ 2>/dev/null | tail -n +31 | xargs -r rm -rf
echo "$OUT"
