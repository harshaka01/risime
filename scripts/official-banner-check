#!/usr/bin/env bash
# P0 2026-10-12 bug C gate (android), standalone: the 1:1 Official's banner is its own row below the
# "🔒 Private | ● Official" tab row (no overlap with the tabs or the search icon) at 720x1600 @300 dpi, font scale
# 1.0 (light) and 1.3 (dark). Runs scripts/ui-entry-test --official-banner (sign-in, friends, e2ee DM, then step 20)
# on its own redroids/ports so it never collides with another ui-entry-test run.
#   timeout 1800 scripts/official-banner-check [--apk app-debug.apk] [--keep]
# Ends "UI ENTRY OK"; screens docs/status/screens/63-official-banner-1.0.png and -1.3.png.
set -euo pipefail
cd "$(dirname "$0")/.."
export UITEST_INSTANCE="${UITEST_INSTANCE:-_ob}" UITEST_PORT="${UITEST_PORT:-4677}" UITEST_LLM_PORT="${UITEST_LLM_PORT:-8217}"
export UITEST_REDROID_A="${UITEST_REDROID_A:--ob1}" UITEST_REDROID_A_PORT="${UITEST_REDROID_A_PORT:-5877}"
export UITEST_REDROID_B="${UITEST_REDROID_B:--ob2}" UITEST_REDROID_B_PORT="${UITEST_REDROID_B_PORT:-5878}"
exec scripts/ui-entry-test --official-banner "$@"
