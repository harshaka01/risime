#!/usr/bin/env bash
# P0 2026-10-14 BLOCKING gate: the after-call summary of an Official 1:1 call, on two redroid phones with the real app.
# The pilot's configuration (the old call-transcribe gate lacked RISI_ACTION_ITEMS, so it missed that a call with zero
# action items posted nothing): the temp server runs RISI_CALL_TRANSCRIBE=on RISI_LEDGER=on RISI_ACTION_ITEMS=canary
# RISI_DEV_USERS=<A>, the local speech service (127.0.0.1:8200) and a scripted fake LLM. scripts/call-device-test's
# setup (sign-in through the real UI, e2ee DM, Official on), then scripts/call-summary-scenario.sh:
#  1. Private call: no Transcribe button, nothing uploaded (server log), no model call, nothing posted.
#  2. Official call (~60 s, English clips injected on both phones through the debug MIC_INJECT seam, transcription
#     asked by A and allowed by B), End → within CS_SUMMARY_S (30) s the summary card is in the Official chat on BOTH
#     phones; the live transcript lines of both speakers are there. Run 1: the model finds one action item → the
#     action_items card shows it. Run 2: zero items → still a summary card (the P0 regression).
#  3. Official call, A turns transcription off (Stop) while the call goes on, then End → the summary card plus Risi's
#     "Summary of the first … min; transcription was turned off after that." on both phones.
#  No FATAL / ANR / main-thread DB on either phone; no call left behind.
#
#   scripts/call-summary-test [--apk app-debug.apk] [--keep]
#
# Prints "CSTEST PASS|FAIL|WARN …" lines and "CSTEST OK" at the end; exit 1 on a failure. Screenshots:
# docs/status/screens/66-call-summary-*.png; diagnostics in ~/risime-logs/calltest_cs/. Never touches :4000.
# Own instance and ports (never the nightly's CALLTEST_* values): CS_INSTANCE (_cs), CS_PORT (4414), CS_LLM_PORT (8191),
# CS_REDROID_A/B (-cs1/-cs2), CS_REDROID_A/B_PORT (5755/5756), CS_CLIP_PORT (8767), CS_SUMMARY_S (30).
set -euo pipefail
args=(); while [ $# -gt 0 ]; do
  if [ "$1" = --apk ] && [ $# -gt 1 ]; then args+=(--apk "$(realpath "$2")"); shift 2; else args+=("$1"); shift; fi
done
set -- "${args[@]+"${args[@]}"}"
cd "$(dirname "$0")/.."
curl -sf -o /dev/null --max-time 5 http://127.0.0.1:8200/health || { echo "CSTEST FAIL the speech service (127.0.0.1:8200) is not up"; exit 2; }
command -v gst-launch-1.0 >/dev/null || { echo "CSTEST FAIL gst-launch-1.0 (opus plugins) needed to decode the clips"; exit 2; }
for v in CALLTEST_TURN CALLTEST_TABS CALLTEST_FAST CALLTEST_SWITCH_ONLY CALLTEST_TABS_ONLY CALLTEST_RECORDS_ONLY UPGRADE_APK; do unset "$v"; done
export CALLTEST_BACK_ONLY=1
export CALLTEST_EXTRA="$PWD/scripts/call-summary-scenario.sh"
export CALLTEST_INSTANCE="${CS_INSTANCE:-_cs}"
export CALLTEST_PORT="${CS_PORT:-4414}"
export CALLTEST_LLM_PORT="${CS_LLM_PORT:-8191}"
export CALLTEST_REDROID_A="${CS_REDROID_A:--cs1}" CALLTEST_REDROID_A_PORT="${CS_REDROID_A_PORT:-5755}"
export CALLTEST_REDROID_B="${CS_REDROID_B:--cs2}" CALLTEST_REDROID_B_PORT="${CS_REDROID_B_PORT:-5756}"
export CS_CLIP_PORT="${CS_CLIP_PORT:-8767}" CS_SUMMARY_S="${CS_SUMMARY_S:-30}"
for p in "$CALLTEST_PORT" "$CALLTEST_LLM_PORT" "$CS_CLIP_PORT" "$CALLTEST_REDROID_A_PORT" "$CALLTEST_REDROID_B_PORT"; do
  ss -ltnH "sport = :$p" | grep -q . && { echo "CSTEST FAIL port $p is busy (set the CS_* port variables)"; exit 2; }
done
# call-device-test prints CALLTEST lines; this gate's are CSTEST. Its exit status decides.
set +e
scripts/call-device-test "$@" 2>&1 | sed -u -e 's/^CALLTEST OK$/CSTEST SCENARIOS DONE/' -e 's/^CALLTEST /CSTEST /'
rc="${PIPESTATUS[0]}"
set -e
if [ "$rc" = 0 ]; then echo "CSTEST OK"; else echo "CSTEST FAIL call-summary-test exit $rc"; fi
exit "$rc"
