#!/usr/bin/env bash
# Pilot health check (risime-health.timer, every 5 min; docs/decisions/025).
# Checks http://127.0.0.1:4000/health; on two failures 15 s apart, restarts risime.service (unless
# risime-watchdog.timer is active: then scripts/watchdog restarts, with its limits and alerts).
# Skips while a deploy holds ~/risime-run/.deploy.lock. Logs to ~/risime-logs/health.log.
# Then scripts/outage-check --tick: after a network outage, boot-check + recovery checks → docs/status/overnight.md.
set -uo pipefail
LOG="$HOME/risime-logs/health.log"; mkdir -p "$HOME/risime-logs"
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$LOG"; }
ok() { curl -sf --max-time 5 http://127.0.0.1:4000/health | grep -q '"status":"ok"'; }
trap 'exec 9>&-; "$(dirname "$0")/outage-check" --tick || true' EXIT
exec 9>"$HOME/risime-run/.deploy.lock"
flock -n 9 || { log "skip: deploy in progress"; exit 0; }
if ok; then
  public=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 https://risime.risicloud.ai/health || true)
  [ "$public" = 200 ] || log "WARN local ok, public https://risime.risicloud.ai/health -> $public"
  exit 0
fi
sleep 15
ok && { log "recovered on retry"; exit 0; }
# The 30-s watchdog (scripts/watchdog, incident-2026-10-10) owns restarts while its timer is active.
if systemctl --user is-active -q risime-watchdog.timer; then log "FAIL /health twice; the watchdog handles it"; exit 1; fi
log "FAIL /health twice; restarting risime.service"
systemctl --user restart risime.service
for _ in $(seq 1 60); do ok && { log "restart ok"; exit 0; }; sleep 2; done
log "ERROR still unhealthy 2 min after restart"
exit 1
