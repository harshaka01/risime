#!/usr/bin/env bash
# Official start gate (P0 incident 2026-10-13, contract v1.46 §12.12.9, decision 088). BLOCKING in scripts/nightly-release.
# Three redroid phones against a temp server from THIS checkout (TABS + Risi with the MLS NIF, fake-llm), fresh installs:
#   scripts/official-start-test [--apk app-debug.apk] [--keep] [--soft]
#  0. A, B, C sign in through the real login UI; all three are friends (fixture); each 1:1 is opened on both sides
#     until its Private conversation is e2ee (server).
#  1. Race: A and B tap [Start Official] in their 1:1 at the same moment → both phones get a usable Official
#     (composer, no "Starting Official…", no "Waiting for…") within 90 s; the server holds exactly ONE active Official
#     group for that chat; a message each way decrypts in Official.
#  2. Offline: C is offline (app stopped, its adb reverse to the server removed) while A starts Official with C → A's
#     Official works; C comes back, opens it, A's message decrypts there, C's reply reaches A.
#  3. Watchdog + hand-over: a `creating` Official for B↔C is created by C (fixture) and kept young while C never commits
#     (C stopped) → B taps [Start Official]: "Starting Official…", and within ≤ 80 s a reason and [Try again] (never
#     only a spinner). The fixture ages the group (> 60 s); B taps [Try again] → B takes over the creation (server:
#     created_by B) and its Official is usable.
#  4. Reinstall: A's app is force-stopped (A never opens it); B uninstalls, installs and signs in again → B's Official
#     with A is usable within 120 s with no "Waiting for…" because Risi re-adds B's new phone (server: an accepted commit
#     from Risi's device in that group); B's message reaches A's inbox; A opens the app and the message decrypts.
#  5. Private unchanged: a Private message each way A↔B decrypts; Private shows no Risi; Risi's inbox holds nothing of
#     any dm: conversation.
#  6. No FATAL EXCEPTION / ANR / main-thread DB on any phone.
# Prints "OSTEST PASS <check>" per check, then "OSTEST OK", or "OSTEST FAIL <reason>" (exit 1). Writes
# ~/risime-logs/official-start-test/v<version>.result. Never touches :4000, the pilot, risi-l1, other redroids.
# Env: OSTEST_INSTANCE (_os), OSTEST_PORT (4188), OSTEST_LLM_PORT (8188), OSTEST_REDROID_A/B/C (-os1/-os2/-os3),
#      OSTEST_REDROID_A/B/C_PORT (5881/5882/5883), OSTEST_OUTDIR.
set -euo pipefail
CALLER_PWD="$PWD"
cd "$(dirname "$0")/.."
REPO="$PWD"; M="$HOME/.local/bin/mise exec --"
SUF="${OSTEST_INSTANCE:-_os}"; PORT="${OSTEST_PORT:-4188}"; LLM_PORT="${OSTEST_LLM_PORT:-8188}"
APK=""; KEEP=0; SOFT=0; VERSION=""; COMMIT=""
while [ $# -gt 0 ]; do case "$1" in
  --apk) APK="$2"; shift 2;; --version) VERSION="$2"; shift 2;; --commit) COMMIT="$2"; shift 2;;
  --keep) KEEP=1; shift;; --soft) SOFT=1; shift;;
  *) echo "unknown arg $1"; exit 2;; esac; done
APK="${APK:-$REPO/android/app/build/outputs/apk/debug/app-debug.apk}"
case "$APK" in /*) ;; *) APK="$CALLER_PWD/$APK";; esac
[ -f "$APK" ] || { echo "OSTEST FAIL no APK at $APK"; exit 2; }
BT="$(ls -d "${ANDROID_HOME:-$HOME/Android/Sdk}"/build-tools/* 2>/dev/null | sort -V | tail -1)"
badging="$("$BT/aapt2" dump badging "$APK" | sed -n 1p)"
PKG="$(sed -n "s/^package: name='\([^']*\)'.*/\1/p" <<<"$badging")"
VN="$(sed -n "s/.*versionName='\([^']*\)'.*/\1/p" <<<"$badging")"
case "$PKG" in ai.risicloud.risime|ai.risicloud.risime.debug) CLS=ai.risicloud.risime ;;
  *) echo "OSTEST FAIL official-start-test is for ai.risicloud.risime(.debug), not '$PKG'"; exit 2 ;; esac
VERSION="${VERSION:-$VN}"; COMMIT="${COMMIT:-$(git rev-parse HEAD)}"
APK_SHA="$(sha256sum "$APK" | cut -d' ' -f1)"
PATH="$("$REPO/scripts/android-target" adb):$PATH"
I1="${OSTEST_REDROID_A:--os1}"; P1="${OSTEST_REDROID_A_PORT:-5881}"
I2="${OSTEST_REDROID_B:--os2}"; P2="${OSTEST_REDROID_B_PORT:-5882}"
I3="${OSTEST_REDROID_C:--os3}"; P3="${OSTEST_REDROID_C_PORT:-5883}"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/risime-ostest.XXXXXX")"
OUTDIR="${OSTEST_OUTDIR:-$HOME/risime-logs/official-start-test}"; LOGS="$OUTDIR/run$SUF"; SHOTDIR="$LOGS/shots"
rm -rf -- "${SHOTDIR:?}"; mkdir -p "$OUTDIR" "$LOGS" "$SHOTDIR"
export RISIME_DEV_DB="risime_ostest$SUF" RISIME_DEV_KEYSPACE="risime_ostest$SUF" ERL_EPMD_ADDRESS=127.0.0.1
export MIX_BUILD_PATH="$REPO/server/_build/ostest$SUF" RISIME_CODE_RELOADER=false
RESULT=FAIL; REASON="not finished"; CHECKS=""; FAILED=""; TIMINGS=""
write_result() {
  { echo "result=$RESULT"; echo "version=$VERSION"; echo "commit=$COMMIT"; echo "package=$PKG"; echo "apk_sha256=$APK_SHA"
    echo "host=$(hostname)"; echo "device=redroid"; echo "time=$(date -u +%s)"; echo "checks=${CHECKS# }"
    echo "failed=${FAILED# }"; echo "timings=${TIMINGS# }"; echo "reason=$REASON"; } > "$OUTDIR/v$VERSION.result"
  echo "==> result: $OUTDIR/v$VERSION.result ($RESULT)"
}
pass() { echo "OSTEST PASS $1"; CHECKS+=" $1"; }
# A failed check: stops the run, or with --soft is recorded and the run goes on. A failed prerequisite always stops.
bad() { echo "OSTEST CHECK FAILED $1: $2"; FAILED+=" $1"; [ "$SOFT" = 1 ] || { REASON="$1: $2"; diag; write_result; echo "OSTEST FAIL $1: $2"; exit 1; }; }
fail() { REASON="$*"; diag; write_result; echo "OSTEST FAIL $*"; exit 1; }
SA=""; SB=""; SC=""
ser() { case "$1" in A) echo "$SA";; B) echo "$SB";; C) echo "$SC";; esac; }
diag() {
  local d
  for d in A B C; do
    [ -n "$(ser $d)" ] || continue
    adb -s "$(ser $d)" exec-out screencap -p > "$LOGS/$d-screen.png" 2>/dev/null || true
    adb -s "$(ser $d)" logcat -d > "$LOGS/$d-logcat.txt" 2>/dev/null || true
    cp "$WORK/ui-$d.xml" "$LOGS/$d-ui.xml" 2>/dev/null || true
  done
  cp "$WORK/server.log" "$LOGS/server.log" 2>/dev/null || true
  echo "    diagnostics in $LOGS"
}
cleanup() {
  local rc=$?
  if [ "$rc" != 0 ] && [ "$REASON" = "not finished" ]; then REASON="aborted (exit $rc)"; write_result || true; echo "OSTEST FAIL $REASON"; fi
  cp "$WORK/server.log" "$LOGS/server.log" 2>/dev/null || true
  # This run's server, model and fixture loop only: their tmux sessions (never a pattern kill).
  tmux kill-session -t "risime-ostest$SUF" 2>/dev/null || true
  tmux kill-session -t "risime-ostest-llm$SUF" 2>/dev/null || true
  tmux kill-session -t "risime-ostest-young$SUF" 2>/dev/null || true
  if [ "$KEEP" = 0 ]; then
    REDROID_INSTANCE="$I1" REDROID_PORT="$P1" "$REPO/scripts/android-target" stop >/dev/null 2>&1 || true
    REDROID_INSTANCE="$I2" REDROID_PORT="$P2" "$REPO/scripts/android-target" stop >/dev/null 2>&1 || true
    REDROID_INSTANCE="$I3" REDROID_PORT="$P3" "$REPO/scripts/android-target" stop >/dev/null 2>&1 || true
  fi
  rm -rf -- "${WORK:?}"
}
trap cleanup EXIT
trap 'exit 130' INT TERM
echo "==> Official start test: $PKG $VN ($(basename "$APK"), sha256 ${APK_SHA:0:12}), commit ${COMMIT:0:12}"

# ---------------------------------------------------------------- the model (fake-llm; Risi needs one to be available)
for p in "$PORT" "$LLM_PORT"; do ss -ltnH "sport = :$p" | grep -q . && { echo "OSTEST FAIL port $p busy (OSTEST_PORT / OSTEST_LLM_PORT)"; exit 1; }; done
[ -d server/deps ] || { echo "OSTEST FAIL server/deps missing in $REPO (mix deps.get)"; exit 1; }
python3 -I - "$WORK/script.json" <<'PY'
import json, sys
rules = [{"name": "any", "task": "risi_next_action", "actions": [{"tool": "final", "answer": "osax Done.", "sources": [], "next_steps": []}]}]
json.dump({"v": 1, "rules": rules}, open(sys.argv[1], "w"))
PY
tmux new -d -s "risime-ostest-llm$SUF" "python3 -I '$REPO/scripts/fake-llm' --port $LLM_PORT --script '$WORK/script.json' >> '$WORK/fake-llm.out' 2>&1"
for _ in $(seq 1 20); do curl -sf -o /dev/null "http://127.0.0.1:$LLM_PORT/health" && break; sleep 0.5; done
curl -sf -o /dev/null "http://127.0.0.1:$LLM_PORT/health" || fail "fake-llm didn't start"

echo "==> MLS NIF (--prod), throwaway keys"
MLS_NIF_OUT="$WORK/librisime_mls_nif.so" timeout 1200 scripts/build-mls-nif --prod >/dev/null || fail "scripts/build-mls-nif --prod failed"
umask 077
{ echo "TABS=on"; echo "RISI=on"; echo "RISI_TOOLS=on"
  echo "RISI_MLS_NIF=$WORK/librisime_mls_nif"; echo "RISI_LLM_URL=http://127.0.0.1:$LLM_PORT/v1"; echo "RISI_FALLBACK=off"
  echo "RISI_MLS_KEK=$(head -c 32 /dev/urandom | base64 -w0)"; echo "RISI_DATA_KEY=$(head -c 32 /dev/urandom | base64 -w0)"
  echo "RISI_MEMORY_KEY=$(head -c 32 /dev/urandom | base64 -w0)"; } > "$WORK/risi.env"
umask 022
cat > "$WORK/fixtures.exs" <<'EXS'
alias RisiMe.{Accounts, Repo}
alias RisiMe.Accounts.User
alias RisiMe.Groups.Group
import Ecto.Query
[mode | rest] = System.argv()
phones = %{"A" => "+94770000901", "B" => "+94770000902", "C" => "+94770000903"}
user! = fn l -> Repo.get_by!(User, phone: phones[l]) end
dm = fn x, y -> RisiMe.Messaging.conversation_id(user!.(x).id, user!.(y).id) end
officials = fn x, y -> Repo.all(from g in Group, where: g.chat_id == ^dm.(x, y) and g.tab == "official") end
label = fn id -> Enum.find_value(phones, "?", fn {l, _} -> if user!.(l).id == id, do: l end) end
case mode do
  "setup" ->
    for {l, p} <- phones do
      {:ok, _} = Accounts.allow(%{phone: p, email: "ostest#{String.downcase(l)}@example.com", display_name: "ZZ OS #{l}", company: "Risi"})
    end
    IO.puts("ostest: setup ok")
  "friends" ->
    for {x, y} <- [{"A", "B"}, {"A", "C"}, {"B", "C"}], do: RisiMe.Social.make_friends!(user!.(x).id, user!.(y).id)
    IO.puts("ostest: friends ok")
  "risi" ->
    :ok = RisiMe.Risi.seed()
    IO.puts("ostest: risi ok")
  "e2ee" ->
    [x, y] = rest
    IO.puts("ostest: e2ee=#{RisiMe.MLS.e2ee?(dm.(x, y))}")
  "officials" ->
    # "<n> <state of the first> <creator of the first>" of the 1:1's Official groups.
    [x, y] = rest
    gs = officials.(x, y)
    g = List.first(gs)
    IO.puts("ostest: officials=#{length(gs)} #{(g && g.state) || "-"} #{(g && label.(g.created_by)) || "-"}")
  "creating" ->
    # A `creating` Official for the 1:1 made by <creator> (its app never builds epoch 0).
    [creator, other] = rest
    {:ok, chat} = RisiMe.Chats.resolve(user!.(creator).id, dm.(creator, other))
    {:ok, kind, _} = RisiMe.Chats.insert_official(user!.(creator).id, chat)
    IO.puts("ostest: creating #{kind}")
  "keep_young" ->
    # Keeps the `creating` group younger than the 60 s hand-over for <secs> (a creator still building).
    [x, y, secs] = rest
    n = div(String.to_integer(secs), 5)
    for _ <- 1..n do
      ids = Enum.map(officials.(x, y), & &1.id)
      Repo.update_all(from(g in Group, where: g.id in ^ids and g.state == "creating"), set: [created_at: DateTime.utc_now()])
      Process.sleep(5_000)
    end
    IO.puts("ostest: young done")
  "age" ->
    # The `creating` group is now older than the hand-over threshold (60 s), well under the 5 min Health threshold.
    [x, y] = rest
    ids = Enum.map(officials.(x, y), & &1.id)
    {n, _} = Repo.update_all(from(g in Group, where: g.id in ^ids and g.state == "creating"), set: [created_at: DateTime.add(DateTime.utc_now(), -90, :second)])
    IO.puts("ostest: aged=#{n}")
  "risi_commits" ->
    # Accepted commits from Risi's device in the 1:1's Official group (the §12.12.9 re-add).
    [x, y] = rest
    ids = Enum.map(officials.(x, y), & &1.id)
    n = Repo.one(from c in "mls_commits", where: c.conversation_id in ^ids and c.from_device == type(^RisiMe.Risi.device_id(), :binary_id), select: count())
    IO.puts("ostest: risi_commits=#{n}")
  "msgs" ->
    # Message events in <who>'s inbox from <from> in the <x>↔<y> 1:1's <tab> conversation (metadata only).
    [who, from_l, x, y, tab] = rest
    conv = if tab == "private", do: dm.(x, y), else: (List.first(officials.(x, y)) || %{id: "none"}).id
    evs = RisiMe.Messaging.Store.impl().list_events(user!.(who).id, nil, 5000, false)
    n = Enum.count(evs, &(&1.kind == "message" and &1.data["conversation_id"] == conv and &1.data["from"] == user!.(from_l).id))
    IO.puts("ostest: msgs=#{n}")
  "risi_inbox_dm" ->
    evs = RisiMe.Messaging.Store.impl().list_events(RisiMe.Risi.user_id(), nil, 5000, false)
    IO.puts("ostest: risi_inbox_dm=#{Enum.count(evs, &String.starts_with?(to_string(&1.data["conversation_id"]), "dm:"))}")
end
EXS
fx() { (cd server && set -a && . "$WORK/risi.env" && set +a && RISI_MLS_NIF=/nonexistent $M mix run "$WORK/fixtures.exs" "$@" 2>/dev/null | grep '^ostest:' || true); }
fxn() { fx "$@" | sed -n 's/^ostest: [a-z_]*=\([0-9]*\).*/\1/p'; }
echo "==> temp server on 127.0.0.1:$PORT ($RISIME_DEV_DB, TABS + Risi)"
(cd server && { $M mix ecto.drop --quiet --force >/dev/null 2>&1 || true; } && $M mix ecto.create --quiet >/dev/null && $M mix ecto.migrate --quiet >/dev/null && $M mix risime.cql.migrate --quiet >/dev/null) \
  || fail "could not create/migrate the test store"
(cd server && $M mix risime.attestation.gen "$WORK/attest.jwk" >/dev/null 2>&1) || true
[ -f "$WORK/attest.jwk" ] || fail "no attestation key"
(cd server && $M mix compile >/dev/null 2>&1) || fail "server compile failed"
[ "$(fx risi)" = "ostest: risi ok" ] || fail "fixture: risi seed"
: > "$WORK/server.log"
tmux new -d -s "risime-ostest$SUF" "cd '$REPO/server' && set -a && . '$WORK/risi.env' && set +a && MIX_BUILD_PATH='$MIX_BUILD_PATH' RISIME_CODE_RELOADER=false RISIME_DEV_DB=$RISIME_DEV_DB RISIME_DEV_KEYSPACE=$RISIME_DEV_KEYSPACE ERL_EPMD_ADDRESS=127.0.0.1 \
  PORT=$PORT DEV_LOCAL_AUTH=true OIDC_ENABLED=false OTP_DEV_LOG=true PHONE_VERIFICATION=off FCM_ENABLED=false LOG_FORMAT=text \
  ATTESTATION_KEY_FILE='$WORK/attest.jwk' RISIME_AUTH_LOG='$WORK/auth.log' $M mix phx.server >> '$WORK/server.log' 2>&1"
for _ in $(seq 1 180); do curl -sf -o /dev/null "http://127.0.0.1:$PORT/health" && break; sleep 1; done
curl -sf -o /dev/null "http://127.0.0.1:$PORT/health" || { tail -20 "$WORK/server.log"; fail "server didn't start"; }
cfg="$(curl -sf "http://127.0.0.1:$PORT/api/v1/auth/config")"
grep -q '"tabs":"on"' <<<"$cfg" || fail "the temp server's /auth/config doesn't say tabs on"
[ "$(fx setup)" = "ostest: setup ok" ] || fail "fixture: setup"
otp() { grep -a "\[DEV OTP\] $1:" "$WORK/server.log" | tail -1 | grep -oE '[0-9]{6}' | tail -1 || true; }

# ---------------------------------------------------------------- phones: fresh installs
echo "==> three redroid containers ($I1:$P1, $I2:$P2, $I3:$P3)"
SA="$(REDROID_INSTANCE="$I1" REDROID_PORT="$P1" "$REPO/scripts/android-target" start)" || fail "redroid A didn't start"
SB="$(REDROID_INSTANCE="$I2" REDROID_PORT="$P2" "$REPO/scripts/android-target" start)" || fail "redroid B didn't start"
SC="$(REDROID_INSTANCE="$I3" REDROID_PORT="$P3" "$REPO/scripts/android-target" start)" || fail "redroid C didn't start"
DEV=""
A() { adb -s "$(ser "$DEV")" "$@"; }
online() { A reverse "tcp:$PORT" "tcp:$PORT" >/dev/null; }
offline() { A reverse --remove "tcp:$PORT" >/dev/null 2>&1 || true; }
install_fresh() {
  A uninstall "$PKG" >/dev/null 2>&1 || true
  A install "$APK" >/dev/null || fail "$DEV: fresh install of $PKG"
  A shell pm grant "$PKG" android.permission.POST_NOTIFICATIONS 2>/dev/null || true
  A shell pm disable-user com.android.inputmethod.latin >/dev/null 2>&1 || true
  online
  A logcat -G 16M >/dev/null 2>&1 || true
  A logcat -c || true
}
for DEV in A B C; do install_fresh; done

# ---- UI helpers (as scripts/risi-chat-test and scripts/e2ee-clarity-test)
dump() { A shell rm -f /sdcard/ui.xml >/dev/null 2>&1; A shell uiautomator dump /sdcard/ui.xml >/dev/null 2>&1; A exec-out cat /sdcard/ui.xml > "$WORK/ui-$DEV.xml" 2>/dev/null || : > "$WORK/ui-$DEV.xml"; }
has() { dump; grep -qF -- "$1" "$WORK/ui-$DEV.xml"; }
wait_for() { for _ in $(seq 1 "${2:-30}"); do has "$1" && return 0; sleep 1; done; echo "    [$DEV] timeout waiting for: $1"; return 1; }
# A node's centre. '~x' text/desc contains x, '@x' desc is x, '^x' text is x, '#x' test tag x (resource-id, when the
# app exports test tags), otherwise text/desc equals x ('x*': text starts with x). '-' as $2: don't dump again.
node_xy() {
  [ "${2:-}" = - ] || dump
  python3 -I - "$WORK/ui-$DEV.xml" "$1" <<'PY'
import re, sys, xml.etree.ElementTree as ET
want = sys.argv[2]
try:
    nodes = list(ET.parse(sys.argv[1]).iter('node'))
except ET.ParseError:
    nodes = []
def hit(n):
    t, d, r = n.get('text') or '', n.get('content-desc') or '', (n.get('resource-id') or '').rsplit('/', 1)[-1]
    if want.startswith('~'): return want[1:] in t or want[1:] in d
    if want.startswith('@'): return d == want[1:]
    if want.startswith('^'): return t == want[1:]
    if want.startswith('#'): return r == want[1:]
    return t == want or d == want or (want.endswith('*') and t.startswith(want[:-1]))
for n in nodes:
    if hit(n):
        x1, y1, x2, y2 = map(int, re.findall(r'\d+', n.get('bounds')))
        print((x1 + x2) // 2, (y1 + y2) // 2); break
PY
}
wait_text() { for _ in $(seq 1 "${2:-30}"); do [ -n "$(node_xy "$1")" ] && return 0; sleep 1; done; echo "    [$DEV] timeout waiting for text: $1"; return 1; }
tap() { local b; b="$(node_xy "$1")"; [ -n "$b" ] || { echo "    [$DEV] no UI node: $1"; return 1; }; A shell input tap $b; }
clear_field() { A shell "for i in \$(seq 1 80); do input keyevent KEYCODE_DEL KEYCODE_FORWARD_DEL; done" >/dev/null 2>&1 || true; }
hide_keyboard() { local st; st="$(A shell dumpsys input_method 2>/dev/null || true)"; [[ "$st" == *"mInputShown=true"* ]] && A shell input keyevent KEYCODE_BACK; sleep 0.5; }
type_into() { hide_keyboard; tap "$1" || return 1; sleep 0.5; clear_field; A shell input text "$(printf '%s' "$2" | sed 's/ /%s/g')"; }
typ() { A shell input text "$(printf '%s' "$1" | sed 's/ /%s/g')"; }
risi_intro_ok() { grep -qF 'Risi listens in Official' "$WORK/ui-$DEV.xml" 2>/dev/null && grep -qF 'text="OK"' "$WORK/ui-$DEV.xml" && { tap "OK" >/dev/null || true; sleep 1; }; true; }
dismiss_prompts() { has "Not now" && { tap "Not now" || true; }; has "Later" && { tap "Later" || true; }; risi_intro_ok; true; }
skip_restore() { has 'text="Skip restore?"' && tap "^Skip" >/dev/null; has "Restore chats" && { tap "^Skip" >/dev/null && sleep 1 && tap "^Skip" >/dev/null; }; true; }
on_list() { dump; grep -qF -e 'content-desc="Refresh friends"' -e 'text="Add friend"' "$WORK/ui-$DEV.xml"; }
wait_list() { for _ in $(seq 1 "${1:-30}"); do on_list && return 0; sleep 1; done; return 1; }
back_to_list() {
  for _ in 1 2 3 4 5 6; do
    on_list && return 0
    [ -s "$WORK/ui-$DEV.xml" ] || { sleep 1; continue; }
    A shell input keyevent KEYCODE_BACK; sleep 1
  done
  on_list && return 0
  A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null 2>&1 || true
  wait_list 10
}
sign_in() {  # $1 phone, $2 email
  A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null
  wait_for "Server:" 40 || return 1
  tap "Server:*" || return 1; sleep 1
  tap "Server URL" || tap "http://*" || tap "https://*" || return 1; sleep 0.5
  clear_field; A shell input text "http://127.0.0.1:$PORT"; sleep 0.5; hide_keyboard
  if ! tap "Use this server"; then tap "Server URL" || true; A shell input keyevent KEYCODE_ENTER; fi
  sleep 2
  for _ in $(seq 1 30); do has "Phone number" && break; has "Developer sign-in (OTP)" && tap "Developer sign-in (OTP)"; sleep 1; done
  wait_for "Phone number" 5 || return 1
  type_into "Phone number" "$1"; type_into "Work email" "$2"; hide_keyboard; tap "Send code" || return 1
  wait_for "6-digit code" 30 || return 1
  local code=""; for _ in $(seq 1 20); do code="$(otp "$1")"; [ -n "$code" ] && break; sleep 1; done
  [ -n "$code" ] || return 1
  type_into "6-digit code" "$code"; sleep 1; has "Verify" && tap "Verify" || true
  for _ in $(seq 1 40); do on_list && break; skip_restore; sleep 1; done
  wait_list 5 || return 1
  dismiss_prompts
}
start_app() { A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null 2>&1 || true; }
stop_app() { A shell am force-stop "$PKG"; }
open_chat() {
  start_app; sleep 1; dismiss_prompts
  back_to_list || { start_app; sleep 2; dismiss_prompts; }
  wait_for "$1" 40 || return 1; tap "$1"; sleep 2
}
is_official() { grep -qF -e 'Risi is listening' -e 'Search in Official' "$WORK/ui-$DEV.xml"; }
# The Official tab's intro with its [Start Official] (not tapped).
official_intro() {
  local i
  for i in $(seq 1 40); do
    dump; risi_intro_ok
    grep -qF 'text="Start Official"' "$WORK/ui-$DEV.xml" && return 0
    [ $((i % 5)) = 1 ] && { tap "● Official" >/dev/null || tap "#tab_official" >/dev/null || true; }
    sleep 1
  done
  echo "    [$DEV] official_intro: $(grep -o 'text="[^"]*"' "$WORK/ui-$DEV.xml" | grep -v 'text=""' | head -30 | tr '\n' ' ')"
  return 1
}
# A usable Official within $1 s: the Official composer, and no "Starting Official…", no encryption set-up/waiting strip.
# Never taps [Start Official] or [Try again]. Prints the seconds it took.
official_usable() {
  local i
  for i in $(seq 1 "$1"); do
    dump; risi_intro_ok
    if grep -qF 'class="android.widget.EditText"' "$WORK/ui-$DEV.xml" && is_official \
       && ! grep -qF -e 'Starting Official' -e 'Setting up encryption' -e 'Waiting for' "$WORK/ui-$DEV.xml"; then echo "$i"; return 0; fi
    [ $((i % 15)) = 1 ] && ! is_official && ! grep -qF 'Starting Official' "$WORK/ui-$DEV.xml" && { tap "● Official" >/dev/null || true; }
    sleep 1
  done
  echo "    [$DEV] official_usable: $(grep -o 'text="[^"]*"' "$WORK/ui-$DEV.xml" | grep -v 'text=""' | head -30 | tr '\n' ' ')" >&2
  return 1
}
private_tab() {
  for _ in 1 2 3 4 5; do
    dump; risi_intro_ok
    is_official || return 0
    tap "🔒 Private" >/dev/null || tap "#tab_private" >/dev/null || true; sleep 2
  done
  return 1
}
send_official() { tap "Message" >/dev/null || true; sleep 0.5; typ "$1"; sleep 0.5; tap "Send" >/dev/null || { sleep 1; tap "Send"; }; }
send_private() { { tap "Encrypted message" >/dev/null || tap "Message" >/dev/null; } || true; sleep 0.5; typ "$1"; sleep 0.5; tap "Send" >/dev/null || { sleep 1; tap "Send"; }; }
logcat_ok() {
  local d out
  for d in A B C; do
    DEV=$d; out="$(A logcat -d 2>/dev/null || true)"
    printf '%s\n' "$out" | "$REPO/scripts/logcat-gate" "$1 $d" || bad logcat_clean "$1: $d crashed or touched the database on the main thread"
    grep -qE "ANR in $PKG( |\$|:)" <<<"$out" && bad logcat_clean "$1: ANR in $PKG on $d"
  done
  return 0
}
shot() { A exec-out screencap -p > "$SHOTDIR/67-ostest-$1.png" 2>/dev/null || true; echo "    shot 67-ostest-$1.png"; }
wait_e2ee() { for _ in $(seq 1 "${3:-90}"); do [ "$(fx e2ee "$1" "$2")" = "ostest: e2ee=true" ] && return 0; sleep 2; done; return 1; }
name() { echo "ZZ OS $1"; }

# ---------------------------------------------------------------- 0. sign in, friends, e2ee 1:1s
DEV=A; sign_in "+94770000901" "ostesta@example.com" || fail "sign-in A"
DEV=B; sign_in "+94770000902" "ostestb@example.com" || fail "sign-in B"
DEV=C; sign_in "+94770000903" "ostestc@example.com" || fail "sign-in C"
[ "$(fx friends)" = "ostest: friends ok" ] || fail "fixture: friends"
for DEV in A B C; do stop_app; start_app; done
for pair in "A B" "A C" "B C"; do
  set -- $pair
  DEV=$1; open_chat "$(name "$2")" || fail "$1: the 1:1 with $2 isn't listed"
  DEV=$2; open_chat "$(name "$1")" || fail "$2: the 1:1 with $1 isn't listed"
  wait_e2ee "$1" "$2" 90 || fail "the $1↔$2 1:1 never became e2ee"
  for DEV in "$1" "$2"; do back_to_list || true; done
done
pass setup_e2ee_1to1s

# ---------------------------------------------------------------- 1. race: A and B start Official at the same moment
DEV=A; open_chat "$(name B)" || fail "A: the 1:1 with B"; official_intro || fail "A: no [Start Official] in the A↔B Official tab"
DEV=B; open_chat "$(name A)" || fail "B: the 1:1 with A"; official_intro || fail "B: no [Start Official] in the A↔B Official tab"
DEV=A; xa="$(node_xy "Start Official")"; DEV=B; xb="$(node_xy "Start Official")"
[ -n "$xa" ] && [ -n "$xb" ] || fail "race: [Start Official] not on both screens"
# shellcheck disable=SC2086
{ adb -s "$SA" shell input tap $xa & adb -s "$SB" shell input tap $xb & wait; }
DEV=A; ta="$(official_usable 90)" || bad race_both_usable "A's Official isn't usable 90 s after the simultaneous start"
DEV=B; tb="$(official_usable 90)" || bad race_both_usable "B's Official isn't usable 90 s after the simultaneous start"
TIMINGS+=" race_a_s=${ta:-none} race_b_s=${tb:-none}"
DEV=A; shot race-a; DEV=B; shot race-b
pass race_both_usable
o="$(fx officials A B)"
case "$o" in "ostest: officials=1 active "*) pass "race_one_group($o)";; *) bad race_one_group "the A↔B chat should hold exactly one active Official group: $o";; esac
DEV=A; send_official "os-race-a" || bad race_messages "A can't send in Official"
DEV=B; wait_for "os-race-a" 60 || bad race_messages "B never decrypted A's Official message"
send_official "os-race-b" || bad race_messages "B can't send in Official"
DEV=A; wait_for "os-race-b" 60 || bad race_messages "A never decrypted B's Official message"
pass race_messages_both_ways

# ---------------------------------------------------------------- 2. offline: C is away while A starts Official with C
DEV=C; back_to_list || true; stop_app; offline
DEV=A; back_to_list || true
open_chat "$(name C)" || fail "A: the 1:1 with C"; official_intro || fail "A: no [Start Official] in the A↔C Official tab"
tap "Start Official" || fail "A: tap [Start Official] (A↔C)"
t="$(official_usable 90)" || bad offline_creator_usable "A's Official with an offline C isn't usable within 90 s"
TIMINGS+=" offline_a_s=${t:-none}"; shot offline-a
pass offline_creator_usable
send_official "os-offline-a" || bad offline_creator_usable "A can't send in Official (A↔C)"
DEV=C; online; start_app; sleep 2; dismiss_prompts
open_chat "$(name A)" || fail "C: the 1:1 with A after coming back"
t="$(official_usable 120)" || bad offline_peer_back "C's Official isn't usable within 120 s after coming back"
wait_for "os-offline-a" 60 || bad offline_peer_back "C never decrypted A's Official message"
TIMINGS+=" offline_c_back_s=${t:-none}"; shot offline-c-back
send_official "os-offline-c" || bad offline_peer_back "C can't send in Official"
DEV=A; wait_for "os-offline-c" 60 || bad offline_peer_back "A never decrypted C's Official message"
pass offline_peer_back

# ---------------------------------------------------------------- 3. watchdog + hand-over: the creator never builds epoch 0
DEV=C; back_to_list || true; stop_app
case "$(fx creating C B)" in "ostest: creating created") ;; *) fail "fixture: a creating B↔C Official by C";; esac
tmux new -d -s "risime-ostest-young$SUF" "cd '$REPO/server' && set -a && . '$WORK/risi.env' && set +a && RISI_MLS_NIF=/nonexistent $M mix run '$WORK/fixtures.exs' keep_young B C 150 > '$WORK/young.out' 2>&1"
DEV=B; back_to_list || true
open_chat "$(name C)" || fail "B: the 1:1 with C"
# Official exists on the server (creating): the tab may show the intro or already "Starting Official…".
for _ in $(seq 1 30); do dump; risi_intro_ok; grep -qF -e 'text="Start Official"' -e 'Starting Official' "$WORK/ui-$DEV.xml" && break
  tap "● Official" >/dev/null || true; sleep 1; done
grep -qF 'text="Start Official"' "$WORK/ui-$DEV.xml" && { tap "Start Official" || fail "B: tap [Start Official] (B↔C)"; }
t0=$(date +%s)
wait_for "Starting Official" 20 || bad watchdog_starting "B: no 'Starting Official…' after [Start Official] on a chat whose creator is away"
shot watchdog-starting
retry=""; reason=""
for _ in $(seq 1 100); do
  dump
  if [ -n "$(node_xy "Try again" -)" ] || [ -n "$(node_xy "#official_try_again" -)" ]; then
    retry=$(( $(date +%s) - t0 ))
    { [ -n "$(node_xy "#official_starting_reason" -)" ] || [ -n "$(node_xy "~Waiting for" -)" ] || [ -n "$(node_xy "~ready on this phone" -)" ] \
      || [ -n "$(node_xy "~offline" -)" ]; } && reason=1
    break
  fi
  is_official && grep -qF 'class="android.widget.EditText"' "$WORK/ui-$DEV.xml" && ! grep -qF 'Starting Official' "$WORK/ui-$DEV.xml" \
    && bad watchdog_try_again "B's Official became usable while the creator was still building (the fixture didn't hold)"
  sleep 1
done
TIMINGS+=" watchdog_try_again_s=${retry:-none}"
shot watchdog-try-again
[ -n "$retry" ] && [ "$retry" -le 80 ] || bad watchdog_try_again "no [Try again] within 80 s of 'Starting Official…' (only a spinner)"
[ "$retry" -ge 45 ] || echo "    note: [Try again] showed after ${retry} s (< 60 s)"
[ -n "$reason" ] || bad watchdog_reason "[Try again] without a reason line (offline / Waiting for <name> / not ready on this phone)"
pass "watchdog_try_again(${retry}s)"
# Restore: the creator is gone for good; the group ages past the 60 s hand-over and B tries again.
tmux kill-session -t "risime-ostest-young$SUF" 2>/dev/null || true
case "$(fx age B C)" in "ostest: aged=1") ;; *) fail "fixture: age the creating B↔C Official";; esac
tap "Try again" >/dev/null || tap "#official_try_again" || bad watchdog_recovers "B: no tappable [Try again]"
t="$(official_usable 90)" || bad watchdog_recovers "B's Official isn't usable within 90 s after [Try again]"
TIMINGS+=" handover_usable_s=${t:-none}"; shot watchdog-recovered
o="$(fx officials B C)"
case "$o" in "ostest: officials=1 active B") pass "handover_to_b($o)";; *) bad handover_to_b "the B↔C Official should be one active group created by B: $o";; esac
send_official "os-handover-b" || bad watchdog_recovers "B can't send in Official (B↔C)"
pass watchdog_recovers

# ---------------------------------------------------------------- 4. reinstall: Risi re-adds B's new phone, A never opens
DEV=A; back_to_list || true; stop_app
rc0="$(fxn risi_commits A B)"; m0="$(fxn msgs A B A B official)"
DEV=B; install_fresh
sign_in "+94770000902" "ostestb@example.com" || { skip_restore; wait_list 30; } || fail "sign-in B after the reinstall"
skip_restore; dismiss_prompts
open_chat "$(name A)" || fail "B: the 1:1 with A after the reinstall"
t="$(official_usable 120)" || bad reinstall_usable "B's Official isn't usable within 120 s of the reinstall while A's app stays closed"
TIMINGS+=" reinstall_usable_s=${t:-none}"; shot reinstall-b
pass reinstall_usable
rc1="$(fxn risi_commits A B)"
[ "${rc1:-0}" -gt "${rc0:-0}" ] && pass "reinstall_readded_by_risi($rc0→$rc1)" || bad reinstall_readded_by_risi "no accepted commit from Risi's device in the A↔B Official ($rc0→$rc1)"
send_official "os-reinstall-b" || bad reinstall_usable "B can't send in Official after the reinstall"
ok=""; for _ in $(seq 1 60); do [ "$(fxn msgs A B A B official)" -gt "${m0:-0}" ] && { ok=1; break; }; sleep 2; done
[ -n "$ok" ] || bad reinstall_usable "B's Official message after the reinstall never reached A's inbox"
DEV=A; start_app; sleep 2; dismiss_prompts
open_chat "$(name B)" || fail "A: the 1:1 with B after B's reinstall"
official_usable 90 >/dev/null || true
wait_for "os-reinstall-b" 90 || bad reinstall_decrypts "A never decrypted B's message from the new phone"
shot reinstall-a
pass reinstall_decrypts

# ---------------------------------------------------------------- 5. Private unchanged
DEV=A; private_tab || fail "A: the A↔B Private tab"
send_private "os-private-a" || bad private_unchanged "A can't send in Private"
DEV=B; private_tab || fail "B: the A↔B Private tab"
wait_for "os-private-a" 90 || bad private_unchanged "B never decrypted A's Private message"
send_private "os-private-b" || bad private_unchanged "B can't send in Private"
DEV=A; wait_for "os-private-b" 90 || bad private_unchanged "A never decrypted B's Private message"
for DEV in A B; do dump; grep -qF -e 'Risi is listening' -e 'Search in Official' "$WORK/ui-$DEV.xml" && bad private_unchanged "$DEV's Private tab shows Risi"; done
shot private
[ "$(fx risi_inbox_dm)" = "ostest: risi_inbox_dm=0" ] || bad private_unchanged "Risi's inbox holds events of a dm: conversation: $(fx risi_inbox_dm)"
pass private_unchanged

# ---------------------------------------------------------------- 6. crash / ANR
logcat_ok "final"
pass logcat_clean
if [ -n "$FAILED" ]; then RESULT=FAIL; REASON="failed:$FAILED"; write_result; echo "OSTEST FAIL$FAILED"; exit 1; fi
RESULT=PASS; REASON=ok; write_result
echo "OSTEST OK"
