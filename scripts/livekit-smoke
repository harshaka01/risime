#!/usr/bin/env bash
# Smoke test of the LiveKit SFU (infra/livekit, PROTOCOL §16.15).
#
# Default (loopback): starts a THROWAWAY instance of the repo config, rebound to loopback only
# (signalling 127.0.0.1:17880, media UDP 41500-41599 on 127.0.0.1, throwaway API key and TURN
# secret), with the same entrypoint and container hardening as the real one. Checks:
#   - `GET /` returns OK; it listens on 127.0.0.1 only and opens no ICE-TCP port;
#   - a token minted with the API key passes /rtc/validate (and /rtc/v1/validate), one signed with
#     another secret is refused;
#   - `lk load-test`: 1 audio + 1 video publisher and 2 subscribers exchange media for 15 s.
# Then removes the container. Nothing listens on a public address.
#
# `scripts/livekit-smoke --live`: checks the running risime-livekit container instead: up with
# restart=unless-stopped, binds (7880 on 127.0.0.1 only, UDP only 49500-49999 on 10.20.20.15, no
# 7881), health, token validation with .env's key (never printed), and a 10-s load test whose
# media goes through the public 203.115.26.139 (hairpin NAT). Reachability from outside is
# separate (decision 046's method, scripts/udp-echo-probe before LiveKit starts).
set -euo pipefail
cd "$(dirname "$0")/.."
img=livekit/livekit-server:v1.13.9
cli=livekit/livekit-cli:v2.18.8
tmp=$(mktemp -d)
name=risime-livekit-smoke
cleanup() { docker rm -f "$name" >/dev/null 2>&1 || true; rm -rf "$tmp"; }
trap cleanup EXIT

lk() { docker run --rm --network host -e LIVEKIT_API_KEY -e LIVEKIT_API_SECRET "$cli" "$@"; }
fail() { echo "FAIL: $*" >&2; exit 1; }

# Local addresses of the UDP sockets owned by uid 65534 (the LiveKit container's user).
lk_udp() { ss -uaneH | awk '{u=""; for (i = 1; i <= NF; i++) if ($i ~ /^uid:/) u = $i; if (u == "uid:65534") print $4}'; }

validate() {  # $1 base url, $2 path, $3 token -> HTTP status
  curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$1$2?access_token=$3"
}

check_tokens() {  # $1 base url
  local tok bad code
  tok="$(lk token create --join --room smoke-validate --identity smoke-a --valid-for 2m --token-only 2>/dev/null)"
  [ -n "$tok" ] || fail "lk token create gave no token"
  code="$(validate "$1" /rtc/validate "$tok")"; [ "$code" = 200 ] || fail "valid token: /rtc/validate -> $code"
  # /rtc/v1/validate also wants the client's join_request: 400 = route present, token accepted.
  code="$(validate "$1" /rtc/v1/validate "$tok")"; [ "$code" = 400 ] || fail "valid token: /rtc/v1/validate -> $code (want 400 without join_request)"
  echo "ok: a token minted with the API key passes /rtc/validate (200; /rtc/v1/validate: auth ok)"
  bad="$(LIVEKIT_API_SECRET="wrong-$(head -c 24 /dev/urandom | base64 | tr -d '/+=')" \
    lk token create --join --room smoke-validate --identity smoke-b --valid-for 2m --token-only 2>/dev/null)"
  code="$(validate "$1" /rtc/validate "$bad")"
  [ "$code" = 401 ] || fail "token with a wrong secret: /rtc/validate -> $code (want 401)"
  echo "ok: a token signed with another secret is refused (401)"
}

load_test() {  # $1 ws url, $2 seconds
  local out
  out="$(lk load-test --url "$1" --room "smoke-$RANDOM" --audio-publishers 1 --video-publishers 1 \
    --subscribers 2 --video-resolution low --duration "${2}s" 2>&1 || true)"
  echo "$out" | grep -E '│ Total|subscribed to track' | tail -6 || true
  # Pass = both subscribers subscribed to the audio and the video track, and the summary's Total
  # row shows all tracks loaded, a non-zero bitrate and no errors.
  if ! python3 -c '
import re, sys
out = sys.stdin.read()
subs = re.findall(r"subscribed to track (\S+) \S+ (audio|video)", out)
both = [p for p in {p for p, _ in subs} if {k for q, k in subs if q == p} == {"audio", "video"}]
tot = [l for l in out.splitlines() if re.search(r"│\s*Total\s*│", l)]
cells = [c.strip() for c in tot[-1].split("│") if c.strip()] if tot else []
ok = (len(both) >= 2 and len(cells) >= 5 and re.fullmatch(r"(\d+)/\1", cells[1])
      and int(cells[1].split("/")[0]) >= 4 and float(re.match(r"[\d.]+", cells[2]).group()) > 0
      and cells[4] == "0")
sys.exit(0 if ok else 1)' <<<"$out"; then
    echo "$out" | tail -30 >&2
    fail "load test: subscribers did not receive audio + video"
  fi
  echo "ok: 2 subscribers received audio + video from 2 publishers for ${2} s"
}

if [ "${1:-}" = --live ]; then
  live=risime-livekit-livekit-1
  st="$(docker inspect -f '{{.State.Status}} {{.HostConfig.RestartPolicy.Name}}' "$live" 2>/dev/null || true)"
  [ "$st" = "running unless-stopped" ] || fail "$live is '$st' (start: docker compose --env-file .env -f infra/docker-compose.livekit.yml up -d)"
  echo "ok: $live running, restart unless-stopped"
  tcp="$(ss -ltnH | awk '{print $4}' | grep -E ':(7880|7881)$' | sort -u || true)"
  [ "$tcp" = "127.0.0.1:7880" ] || fail "TCP binds for 7880/7881: $(echo $tcp) (want only 127.0.0.1:7880)"
  echo "ok: TCP: 127.0.0.1:7880 only, no ICE-TCP 7881"
  [ "$(curl -s --max-time 5 http://127.0.0.1:7880/)" = OK ] || fail "GET / on 127.0.0.1:7880 is not OK"
  echo "ok: GET / -> OK"
  set -a; eval "$(grep -E '^LIVEKIT_API_(KEY|SECRET)=' .env)"; set +a
  [ -n "${LIVEKIT_API_KEY:-}" ] && [ -n "${LIVEKIT_API_SECRET:-}" ] || fail "LIVEKIT_API_KEY/SECRET missing in .env"
  check_tokens http://127.0.0.1:7880
  # UDP sockets the server holds during a call: sample while the load test runs.
  (sleep 6; lk_udp > "$tmp/udp") &
  load_test ws://127.0.0.1:7880 10
  wait
  # LiveKit's sockets in the media range must be on 10.20.20.15 only (pion binds each candidate
  # address). The lk test clients (root) hold sockets in the same range too; they're ignored.
  bad="$(grep -E ':(49[5-9][0-9]{2})$' "$tmp/udp" | grep -v '^10\.20\.20\.15:' | sort -u || true)"
  [ -z "$bad" ] || fail "media sockets beyond 10.20.20.15: $(echo $bad)"
  n="$(grep -cE '^10\.20\.20\.15:49[5-9][0-9]{2}$' "$tmp/udp" || true)"
  echo "ok: media sockets during the test: $n on 10.20.20.15 in 49500-49999, none elsewhere"
  echo "live smoke OK"
  exit 0
fi

# --- loopback ---------------------------------------------------------------------------------
docker rm -f "$name" >/dev/null 2>&1 || true
port=17880
sed -e "s/^port: 7880/port: $port/" \
    -e 's/^  port_range_start: .*/  port_range_start: 41500/' \
    -e 's/^  port_range_end: .*/  port_range_end: 41599/' \
    -e 's/^  node_ip: .*/  node_ip: 127.0.0.1/' \
    -e 's#^      - 10\.20\.20\.15/32#      - 127.0.0.1/32#' \
    -e 's/^  enable_loopback_candidate: .*/  enable_loopback_candidate: true/' \
    -e 's/^    - host: 203\.115\.26\.139/    - host: 127.0.0.1/' \
    infra/livekit/livekit.yaml > "$tmp/livekit.yaml"
grep -q "^port: $port" "$tmp/livekit.yaml" && grep -q '127.0.0.1/32' "$tmp/livekit.yaml" || fail "could not rebind the config"
! grep -q '10\.20\.20\.15\|203\.115\.26\.139' <(grep -v '^ *#' "$tmp/livekit.yaml") || fail "public address left in the loopback config"
chmod 644 "$tmp/livekit.yaml"

export LIVEKIT_API_KEY="APIsmoke$(head -c 6 /dev/urandom | od -An -tx1 | tr -d ' \n')"
export LIVEKIT_API_SECRET="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
TURN_SECRET="$(head -c 32 /dev/urandom | base64 | tr -d '/+=')"; export TURN_SECRET

docker run --rm --entrypoint /livekit-server "$img" --version
docker run -d --name "$name" --network host --user 65534:65534 \
  -e LIVEKIT_API_KEY -e LIVEKIT_API_SECRET -e TURN_SECRET \
  -v "$tmp/livekit.yaml:/etc/livekit/livekit.yaml:ro" \
  -v "$PWD/infra/livekit/entrypoint.sh:/risime-entrypoint.sh:ro" \
  --read-only --tmpfs /tmp:size=4m,mode=1777 --cap-drop ALL --security-opt no-new-privileges:true \
  --ulimit nofile=65536 --entrypoint /risime-entrypoint.sh "$img" >/dev/null

for _ in $(seq 1 30); do
  [ "$(curl -s --max-time 1 "http://127.0.0.1:$port/" || true)" = OK ] && break
  docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null | grep -q true || { docker logs "$name" 2>&1 | tail -20; fail "container exited"; }
  timeout 0.5 tail -f /dev/null || true
done
[ "$(curl -s --max-time 2 "http://127.0.0.1:$port/")" = OK ] || { docker logs "$name" 2>&1 | tail -20; fail "GET / is not OK"; }
echo "ok: GET / -> OK"

tcp="$(ss -ltnH | awk '{print $4}' | grep -E ":($port|7881)$" | sort -u || true)"
[ "$tcp" = "127.0.0.1:$port" ] || fail "TCP binds: $(echo $tcp) (want only 127.0.0.1:$port)"
echo "ok: listens on 127.0.0.1:$port only, no ICE-TCP"
if docker logs "$name" 2>&1 | grep -qF "$LIVEKIT_API_SECRET"; then fail "API secret appears in the log"; fi
if docker logs "$name" 2>&1 | grep -qF "$TURN_SECRET"; then fail "TURN secret appears in the log"; fi
echo "ok: no secret in the log"

check_tokens "http://127.0.0.1:$port"
(sleep 8; lk_udp > "$tmp/udp") &
load_test "ws://127.0.0.1:$port" 15
wait
bad="$(grep -E ':415[0-9]{2}$' "$tmp/udp" | grep -v '^127\.0\.0\.1:' | sort -u || true)"
[ -z "$bad" ] || fail "media sockets beyond loopback: $(echo $bad)"
echo "ok: media sockets on 127.0.0.1 only ($(grep -cE '^127\.0\.0\.1:415[0-9]{2}$' "$tmp/udp" || true) in 41500-41599)"
docker logs "$name" 2>&1 | grep -iE '"level":"(error|fatal)"' | grep -v 'TURN\|turn' | tail -3 >&2 || true
echo "smoke OK"
