#!/usr/bin/env bash
# spark2: (re)start the dev server Harsha tests against (tmux session `risime-server`) from a
# separate worktree of a RELEASE TAG, ~/risime-run/<tag>, never from the shared checkout that the
# sessions edit (their edits to mix.lock/config/code would break it via the code reloader).
# Only the release step switches tags, after the gates pass (docs/decisions/005).
#   scripts/run-dev-server              # the latest release (~/risime-releases/LATEST, else newest v* tag)
#   scripts/run-dev-server v0.1.0       # a specific tag
set -euo pipefail
cd "$(dirname "$0")/.."
REPO="$PWD"; M="$HOME/.local/bin/mise exec --"

git fetch -q origin --tags
TAG="${1:-$(cat "$HOME/risime-releases/LATEST" 2>/dev/null || git tag -l 'v*' --sort=-creatordate | head -1)}"
git rev-parse -q --verify "refs/tags/$TAG" >/dev/null || { echo "no such tag: $TAG"; exit 1; }
RUN="$HOME/risime-run/$TAG"
mkdir -p "$HOME/risime-run"
[ -e "$RUN/.git" ] || git worktree add -q --detach "$RUN" "$TAG"
[ "$(git -C "$RUN" rev-parse HEAD)" = "$(git rev-parse "$TAG^{commit}")" ] || { echo "$RUN is not at $TAG"; exit 1; }
ln -sfn "$REPO/.env" "$RUN/.env"            # server/config/runtime.exs reads ../../.env
echo "==> $RUN ($(git -C "$RUN" log -1 --format='%h %s'))"

cd "$RUN/server"
$M mix deps.get >/dev/null
$M mix compile >/dev/null 2>&1 || $M mix compile
$M mix ecto.migrate
$M mix risime.cql.migrate

tmux kill-session -t risime-server 2>/dev/null || true
tmux new -d -s risime-server "cd $RUN/server && ~/.local/bin/mise exec -- mix phx.server"
for _ in $(seq 1 90); do
  [ "$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:4000/api/v1/me)" = 401 ] && break; sleep 1
done
code="$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:4000/api/v1/me)"
echo "$TAG" > "$HOME/risime-run/CURRENT"
echo "server: http $code (401 = up), running $TAG from $RUN"
[ "$code" = 401 ]
