#!/usr/bin/env bash
# Risi model evaluation (docs/RISI-MODELS.md). Reruns everything: the eval set, the live risi-l1
# baseline, one candidate at a time, ASR, scoring and the report. NEVER touches live risi-l1
# (risime-llm-vllm-1 on 127.0.0.1:8100): requests to it are read-only, sequential, light.
#
#   scripts/risi-eval build                 # rebuild eval/risi/*.jsonl from eval/risi/build.py
#   scripts/risi-eval dump                  # re-dump Risi's real prompts/schemas -> eval/risi/prompts.json
#   scripts/risi-eval probe                 # live risi-l1 /health + 1-token completion + pilot /health
#   scripts/risi-eval baseline              # the eval set against risi-l1 (label risi-l1)
#   scripts/risi-eval fetch <name>          # download a candidate (eval/risi/candidates.json) to ~/risime-eval-models
#   scripts/risi-eval candidate <name>      # launch on 127.0.0.1:8101, eval, stop + remove (see safety below)
#   scripts/risi-eval asr-data              # FLEURS ta_in + SPEAK-ASR youtube-sinhala test subsets -> ~/risime-eval-data
#   scripts/risi-eval asr <name>|live       # ASR WER/CER (live = the running whisper on :8200, read-only)
#   scripts/risi-eval canary                # scripts/risi-canary on its own instance (_eval, ports 4390/8490: no gate uses them)
#   scripts/risi-eval score|report          # rescore every result / write eval/risi/results/REPORT.md
#   scripts/risi-eval drop <name>           # delete a candidate's downloaded weights
#
# Safety (Harsha's rules, binding):
#  * one candidate at a time, container risi-eval-<name>, 127.0.0.1:8101 only, the same aarch64 image
#    as risi-l1 (nvcr.io/nvidia/vllm:26.09-py3); always stopped and removed afterwards (trap);
#  * refuses while scripts/nightly-release or scripts/ui-entry-test runs (RISI_EVAL_WAIT=1 polls every 5 min instead);
#  * launches only if MemAvailable >= mem_gb + 10 GB; --gpu-memory-utilization = mem_gb / MemTotal,
#    --max-model-len 8192, --max-num-seqs 2; plus OVERHEAD_GB (measured ~7 GB) in the launch check; MemAvailable is sampled every 2 s (peak recorded) and
#    the candidate is killed at once if it falls under 6 GB;
#  * the live probe runs before, every 60 s during, and after; a failed probe kills the candidate.
#    CANARY=1 also runs scripts/risi-canary while the candidate is loaded (if memory allows).
set -euo pipefail
cd "$(dirname "$0")/.."
REPO="$PWD"; EV="$REPO/eval/risi"; PY="python3 -I $EV/risi_eval.py"
IMG=nvcr.io/nvidia/vllm:26.09-py3
MODELS="${RISI_EVAL_MODELS:-$HOME/risime-eval-models}"; DATA="${RISI_EVAL_DATA:-$HOME/risime-eval-data}"
PORT=8101; HEADROOM_GB=10; FLOOR_GB=6
# Measured 2026-10-10: a candidate takes ~5-7 GB beyond its --gpu-memory-utilization share (CUDA
# context, torch, compile workers), so the launch check counts it on top of mem_gb + headroom.
OVERHEAD_GB=${RISI_EVAL_OVERHEAD_GB:-7}
mkdir -p "$MODELS" "$DATA" "$EV/results"
log() { echo "[$(date +%H:%M:%S)] $*"; }
avail_gb() { awk '/MemAvailable/ {printf "%.1f", $2/1048576}' /proc/meminfo; }
total_gb() { awk '/MemTotal/ {printf "%.1f", $2/1048576}' /proc/meminfo; }
cand() { python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); k,n,f=sys.argv[2:5]; v=d[k][n].get(f); print(json.dumps(v) if isinstance(v,(list,dict)) else ("" if v is None else v))' "$EV/candidates.json" "$@"; }
# A gate process itself, not a shell that merely mentions its name (pollers, this script).
release_running() { pgrep -af 'nightly-release|ui-entry-test' | grep -v -e shell-snapshots -e pgrep -e risi-eval | grep -q .; }
wait_release() {
  while release_running; do
    [ -n "${RISI_EVAL_WAIT:-}" ] || { echo "a release gate (scripts/nightly-release or ui-entry-test) is running: not starting a candidate (RISI_EVAL_WAIT=1 to wait)"; exit 2; }
    log "release running; waiting 5 min"; sleep 300
  done
}

CONTAINER=""; WATCH=""
cleanup() {
  [ -n "$WATCH" ] && kill "$WATCH" 2>/dev/null || true
  if [ -n "$CONTAINER" ]; then docker rm -f "$CONTAINER" >/dev/null 2>&1 || true; log "stopped and removed $CONTAINER"; fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM

serve() {  # serve <container> <model dir> <served name> <mem_gb> [extra vllm args...]
  local name=$1 dir=$2 served=$3 mem=$4; shift 4
  local tot util
  tot=$(total_gb); util=$(python3 -I -c "print(round($mem / $tot, 3))")
  log "launch $name: util $util of $tot GB (need $mem GB), MemAvailable $(avail_gb) GB"
  CONTAINER=$name
  docker run -d --name "$name" --gpus all --shm-size 8g --ulimit memlock=-1 --ulimit stack=67108864 \
    -p "127.0.0.1:$PORT:8000" -e HF_HUB_OFFLINE=1 -e TRANSFORMERS_OFFLINE=1 -e VLLM_NO_USAGE_STATS=1 -e DO_NOT_TRACK=1 \
    -v "$dir:/model:ro" "$IMG" vllm serve /model --served-model-name "$served" --host 0.0.0.0 --port 8000 \
    --max-model-len 8192 --max-num-seqs 2 --gpu-memory-utilization "$util" --disable-uvicorn-access-log "$@" >/dev/null
  ss -ltnH "sport = :$PORT" | awk '{print $4}' | grep -qv '^127\.0\.0\.1:' && { echo "port $PORT not loopback-only"; exit 1; } || true
}

watch_mem() {  # background: min MemAvailable to $1; kills the candidate under the floor
  local out=$1; echo "$(avail_gb)" > "$out"
  ( n=0; while docker inspect "$CONTAINER" >/dev/null 2>&1; do
      a=$(avail_gb); m=$(cat "$out"); python3 -I -c "import sys; sys.exit(0 if $a < $m else 1)" && echo "$a" > "$out"
      if python3 -I -c "import sys; sys.exit(0 if $a < $FLOOR_GB else 1)"; then
        echo "MEMORY FLOOR: MemAvailable $a GB < $FLOOR_GB GB, killing $CONTAINER" >&2; docker rm -f "$CONTAINER" >/dev/null 2>&1; fi
      if release_running; then
        echo "A RELEASE GATE STARTED: yielding, killing $CONTAINER" >&2; docker rm -f "$CONTAINER" >/dev/null 2>&1; fi
      n=$((n+1)); if [ $((n % 30)) = 0 ]; then
        $PY probe >/dev/null 2>&1 || { echo "LIVE PROBE FAILED: killing $CONTAINER" >&2; docker rm -f "$CONTAINER" >/dev/null 2>&1; }; fi
      sleep 2
    done ) &
  WATCH=$!
}

wait_health() {
  for _ in $(seq 1 240); do
    curl -sf -o /dev/null "http://127.0.0.1:$PORT/health" && return 0
    docker inspect "$CONTAINER" >/dev/null 2>&1 || { echo "container died"; return 1; }
    [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER")" = true ] || { docker logs --tail 30 "$CONTAINER"; return 1; }
    sleep 5
  done
  return 1
}

cmd=${1:-}; shift || true
case "$cmd" in
  build) python3 -I "$EV/build.py" ;;
  dump)
    ERL_LIBS="$REPO/server/_build/dev/lib" ~/.local/bin/mise exec -C "$REPO/server" -- elixir "$EV/dump_prompts.exs" "$EV/prompts.json" ;;
  probe) $PY probe ;;
  baseline)
    $PY probe
    $PY run --url http://127.0.0.1:8100 --model risi-l1 --key-env LLM_API_KEY --label risi-l1 --sleep 0.5 "$@"
    echo '{"name": "risi-l1 (Qwen3.6-35B-A3B-FP8, live)", "baseline": true, "peak_mem_gb": "47.4 (nvidia-smi, RISI-TECH.md)"}' > "$EV/results/risi-l1.meta.json"
    $PY probe; $PY score risi-l1 ;;
  fetch)
    name=$1; kind=${2:-llm}; repo=$(cand "$kind" "$name" repo)
    [ -n "$repo" ] || { echo "unknown $kind candidate $name"; exit 1; }
    docker run --rm --name "risi-eval-fetch-$name" -v "$MODELS:/out" -v "$EV/hf_fetch.py:/f.py:ro" \
      --entrypoint python3 "$IMG" /f.py "$repo" "$name"
    du -sh "$MODELS/$name" ;;
  drop) name=$1; [ -d "$MODELS/$name" ] && rm -rf -- "${MODELS:?}/$name" && log "deleted $MODELS/$name" ;;
  candidate)
    name=$1; repo=$(cand llm "$name" repo); mem=$(cand llm "$name" mem_gb)
    [ -n "$repo" ] || { echo "unknown candidate $name"; exit 1; }
    python3 -I "$EV/complete.py" "$MODELS/$name" || { echo "not (fully) downloaded: scripts/risi-eval fetch $name"; exit 1; }
    docker ps -a --format '{{.Names}}' | grep -v '^risi-eval-fetch-' | grep -q '^risi-eval-' && { echo "another risi-eval container exists"; exit 1; }
    wait_release
    need=$(python3 -I -c "print($mem + $OVERHEAD_GB + $HEADROOM_GB)")
    for _ in $(seq 1 "${RISI_EVAL_WAIT_MAX:-144}"); do  # RISI_EVAL_WAIT: up to 12 h (default) for the memory (and the gates) to free up
      a=$(avail_gb); python3 -I -c "import sys; sys.exit(0 if $a >= $need else 1)" && ! release_running && break
      [ -n "${RISI_EVAL_WAIT:-}" ] || break
      log "waiting: MemAvailable $a GB < $need GB or a gate is running"; sleep 300
    done
    wait_release
    a=$(avail_gb)
    python3 -I -c "import sys; sys.exit(0 if $a >= $need else 1)" || { echo "MemAvailable $a GB < $need GB (mem $mem + $HEADROOM_GB headroom): not launching $name"; exit 3; }
    $PY probe
    mapfile -t extra < <(python3 -I -c 'import json,sys; [print(x) for x in json.load(open(sys.argv[1]))["llm"][sys.argv[2]]["args"]]' "$EV/candidates.json" "$name")
    before=$a; t0=$(date +%s)
    serve "risi-eval-$name" "$MODELS/$name" cand "$mem" "${extra[@]}"
    MEMF=$(mktemp); watch_mem "$MEMF"
    wait_health || { echo "candidate $name did not become healthy"; docker logs --tail 40 "$CONTAINER" 2>&1 | tail -40; exit 1; }
    load_s=$(( $(date +%s) - t0 )); log "healthy after ${load_s}s, MemAvailable $(avail_gb) GB"
    $PY probe || { echo "LIVE PROBE FAILED with $name loaded"; exit 9; }
    if [ -n "${CANARY:-}" ]; then
      if python3 -I -c "import sys; sys.exit(0 if $(avail_gb) >= ${CANARY_NEED_GB:-18} else 1)"; then
        "$0" canary || { echo "CANARY FAILED with $name loaded: stopping it"; exit 9; }
      else log "canary skipped while loaded: MemAvailable $(avail_gb) GB < ${CANARY_NEED_GB:-18} GB"; fi
    fi
    $PY run --url "http://127.0.0.1:$PORT" --model cand --label "$name" --sleep 0.2 ${RUN_ARGS:-}
    # The same turn items with "tool" first in the schema (see docs/RISI-MODELS.md, schema order).
    $PY run --url "http://127.0.0.1:$PORT" --model cand --label "$name.toolfirst" --tool-first --sleep 0.2 \
      --only='-(T[0-9]+|F[0-9]+|C1|M(0[1-59]|1[0-5]|19|20))$'
    $PY probe || { echo "LIVE PROBE FAILED after the run"; exit 9; }
    minf=$(cat "$MEMF")
    peak=$(python3 -I -c "print(round($before - $minf, 1))")
    python3 -I -c 'import json,sys; json.dump({"name": sys.argv[1], "repo": sys.argv[2], "mem_avail_before_gb": float(sys.argv[3]), "mem_avail_min_gb": float(sys.argv[4]), "peak_mem_gb": float(sys.argv[5]), "load_s": int(sys.argv[6]), "gpu_mem_util_gb": float(sys.argv[7])}, open(sys.argv[8], "w"), indent=1)' \
      "$name" "$repo" "$before" "$minf" "$peak" "$load_s" "$mem" "$EV/results/$name.meta.json"
    docker logs "$CONTAINER" 2>&1 | grep -E "Model loading took|KV cache|Maximum concurrency|memory" | tail -8 > "$EV/results/$name.vllm.txt" || true
    cleanup; CONTAINER=""; WATCH=""
    $PY probe
    $PY score "$name"; $PY score "$name.toolfirst" --partial; log "peak memory $peak GB (MemAvailable $before -> $minf)" ;;
  asr-data) python3 -I "$EV/asr_data.py" "$DATA" ;;
  asr)
    name=$1; man="$DATA/manifest.jsonl"; [ -f "$man" ] || { echo "run scripts/risi-eval asr-data first"; exit 1; }
    if [ "$name" = live ]; then
      $PY asr --url http://127.0.0.1:8200 --model faster-whisper-large-v3 --key-env WHISPER_API_KEY --label whisper-large-v3-live --manifest "$man"; exit 0
    fi
    mem=$(cand asr "$name" mem_gb); ct2=$(cand asr "$name" local_ct2)
    docker ps -a --format '{{.Names}}' | grep -v '^risi-eval-fetch-' | grep -q '^risi-eval-' && { echo "another risi-eval container exists"; exit 1; }
    wait_release
    a=$(avail_gb); python3 -I -c "import sys; sys.exit(0 if $a >= $mem + $HEADROOM_GB else 1)" || { echo "MemAvailable $a GB too low for $name"; exit 3; }
    $PY probe; before=$a
    if [ -n "$ct2" ]; then  # the same CTranslate2 image as the live whisper, another model dir
      CONTAINER="risi-eval-$name"
      docker run -d --name "$CONTAINER" --gpus all -p "127.0.0.1:$PORT:8000" -e WHISPER_API_KEY=eval -e HF_HUB_OFFLINE=1 \
        -e WHISPER_MODEL_PATH=/models/m -e WHISPER_MODEL_ALIAS="$name" -e WHISPER_COMPUTE_TYPE=float16 -e WHISPER_NUM_WORKERS=1 \
        -v "$HOME/risime-models/$ct2:/models/m:ro" risime/whisper:ct2-4.8.2-fw-1.2.1 >/dev/null
      key=eval
    else
      [ -d "$MODELS/$name" ] || { echo "not downloaded: scripts/risi-eval fetch $name asr"; exit 1; }
      mapfile -t extra < <(python3 -I -c 'import json,sys; [print(x) for x in json.load(open(sys.argv[1]))["asr"][sys.argv[2]].get("args", [])]' "$EV/candidates.json" "$name")
      serve "risi-eval-$name" "$MODELS/$name" "$name" "$mem" "${extra[@]}"; key=""
    fi
    MEMF=$(mktemp); watch_mem "$MEMF"
    wait_health || { echo "$name did not become healthy"; docker logs --tail 40 "$CONTAINER" 2>&1 | tail -40; exit 1; }
    $PY probe
    RISI_EVAL_ASR_KEY="$key" $PY asr --url "http://127.0.0.1:$PORT" --model "$name" --key-env RISI_EVAL_ASR_KEY --label "$name" --manifest "$man" \
      $( [ -n "${LANGS:-}" ] && echo "--langs $LANGS" )
    $PY probe
    echo "peak $(python3 -I -c "print(round($before - $(cat "$MEMF"), 1))") GB" | tee "$EV/results/asr-$name.mem.txt" ;;
  canary)
    log "risi-canary (instance _eval, ports 4390/8490), MemAvailable $(avail_gb) GB"
    CANARY_INSTANCE=_eval CANARY_PORT=4390 CANARY_LLM_PORT=8490 scripts/risi-canary ;;
  chain)  # unattended: wait for an idle box, canary, each candidate (CANARY=1), canary
    for _ in $(seq 1 288); do release_running || break; log "gate running; waiting 5 min"; sleep 300; done
    release_running && { echo "still busy after 24 h"; exit 2; }
    [ -n "${SKIP_FIRST_CANARY:-}" ] || "$0" canary
    for n in "$@"; do
      rc=0; CANARY=1 RISI_EVAL_WAIT=1 "$0" candidate "$n" || rc=$?
      log "candidate $n finished rc=$rc"
      [ "$rc" = 9 ] && { echo "SAFETY STOP (canary or live probe failed): chain aborted"; exit 9; }
    done
    "$0" canary ;;
  score) for f in "$EV"/results/*.jsonl; do b=$(basename "$f" .jsonl); case "$b" in asr-*) ;; *) $PY score "$b";; esac; done ;;
  report) $PY report ;;
  *) sed -n '2,30p' "$0"; exit 1 ;;
esac
