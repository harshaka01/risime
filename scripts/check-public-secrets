#!/usr/bin/env python3
"""Fail if anything we publish holds a secret (Harsha 2026-10-13).

  scripts/check-public-secrets <file-or-dir>...   (default: the publish mirror ~/risime-releases/publish)

Scans every page, feed and APK; APKs are unzipped and every entry is scanned as bytes. The needles are:
  - every value in .env that is at least 10 characters (secrets live only there, CLAUDE.md rule 5), except
    plain public URLs and hostnames;
  - the signing keystore's passwords and alias (~/secrets/signing/keystore.properties);
  - patterns: private keys, keystore fields, cookies, bearer/API tokens, the Erlang cookie name, and paths
    from the build machine.
It prints the key NAMES and file names only, never a value. Exits 1 on any hit. Firebase's "AIza…" Android API key
is public by design (it is shipped in every app's google-services config) and is reported as INFO.
"""
import io
import os
import re
import sys
import zipfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
HOME = os.path.expanduser("~")


def kv_file(path):
    out = {}
    try:
        for line in open(path, encoding="utf-8", errors="replace"):
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            v = v.strip().strip('"').strip("'")
            out[k.strip()] = v
    except OSError:
        pass
    return out


def needles():
    n = []
    for k, v in kv_file(os.path.join(REPO, ".env")).items():
        if len(v) < 10:
            continue
        if re.fullmatch(r"https?://[^@\s]+", v) or re.fullmatch(r"[a-z0-9.-]+\.[a-z]{2,}", v):
            continue  # a public URL or hostname, not a secret
        n.append((f".env {k}", v.encode()))
    for k, v in kv_file(os.path.join(HOME, "secrets", "signing", "keystore.properties")).items():
        if "password" in k.lower() and len(v) >= 4:  # the alias and file name aren't secrets
            n.append((f"keystore {k}", v.encode()))
    return n


PATTERNS = [
    (rb"-----BEGIN (RSA |EC |OPENSSH |ENCRYPTED )?PRIVATE KEY-----", "private key"),
    (rb"\b(storePassword|keyPassword|keyAlias|storeFile)\s*[=:]", "keystore field"),
    (rb"RELEASE_COOKIE", "Erlang cookie name"),
    (rb"Set-Cookie:|JSESSIONID=|KEYCLOAK_SESSION", "cookie"),
    (rb"\bBearer\s+[A-Za-z0-9._~+/-]{20,}", "bearer token"),
    (rb"\b(ghp|gho|ghu|ghs)_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}", "GitHub token"),
    (rb"\bsk-[A-Za-z0-9_-]{20,}", "API key (sk-)"),
    (rb"\bxox[abprs]-[A-Za-z0-9-]{10,}", "Slack token"),
    (rb"\bAKIA[0-9A-Z]{16}\b", "AWS key"),
    (rb"/\.env\b|risime-keys/|/secrets/", "secret-store path"),
]
# Not secrets, but worth knowing (e.g. Rust debug paths in native libraries).
WARN = [(rb"/home/harsha/", "build-machine path (username only, no secret)")]
INFO = [(rb"AIza[0-9A-Za-z_-]{35}", "Firebase Android API key (public by design)")]


def blobs(path):
    """(label, bytes) for a file; an APK yields each of its entries."""
    try:
        data = open(path, "rb").read()
    except OSError as e:
        yield path, b"", str(e)
        return
    if path.endswith(".apk"):
        try:
            with zipfile.ZipFile(io.BytesIO(data)) as z:
                for name in z.namelist():
                    yield f"{os.path.basename(path)}!{name}", z.read(name), None
            return
        except zipfile.BadZipFile as e:
            yield path, data, f"bad zip: {e}"
            return
    yield path, data, None


def main(targets):
    files = []
    for t in targets:
        if os.path.isdir(t):
            for root, _, names in os.walk(t):
                files += [os.path.join(root, f) for f in names]
        else:
            files.append(t)
    secret_needles = needles()
    hits, infos, scanned, entries = [], set(), 0, 0
    for f in sorted(files):
        scanned += 1
        for label, data, err in blobs(f):
            entries += 1
            if err:
                hits.append(f"{label}: can't scan ({err})")
                continue
            for name, val in secret_needles:
                if val in data:
                    hits.append(f"{label}: contains the value of {name}")
            for pat, why in PATTERNS:
                if re.search(pat, data):
                    hits.append(f"{label}: {why}")
            for pat, why in INFO:
                if re.search(pat, data):
                    infos.add(f"INFO {os.path.basename(f)}: {why}")
            for pat, why in WARN:
                if re.search(pat, data):
                    infos.add(f"WARN {label}: {why}")
    print(f"check-public-secrets: scanned {scanned} files ({entries} entries incl. APK contents) against "
          f"{len(secret_needles)} secret values (.env + keystore) and {len(PATTERNS)} patterns")
    for i in sorted(infos):
        print(f"  {i}")
    if hits:
        print("check-public-secrets: FAIL")
        for h in hits:
            print(f"  - {h}")
        return 1
    print("check-public-secrets: OK (no secret found)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:] or [os.path.join(HOME, "risime-releases", "publish")]))
