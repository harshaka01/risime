#!/usr/bin/env bash
# UI entry-point gate (root-delegated to android, nightly.39 real-phone report: no way to lock a chat,
# no tab row, "Checking encryption…" for ever). The REAL debug app in two redroid containers (native
# arm64 Android 14, decision 045) against a temp server with TABS=on (RISI off: the tab row, "Start
# Official" and "What Risi knows about me" must work either way). Navigates like a user: taps and
# long-presses by visible text / content description from `uiautomator dump`, no debug hooks.
#   timeout 1800 scripts/ui-entry-test [--apk app-debug.apk] [--keep] [--risi] [--skills] [--ledger] [--calendar] [--offers]
#   --risi: the server also runs Risi (RISI=on, the MLS NIF built --prod, scripts/fake-llm on
#   127.0.0.1:$UITEST_LLM_PORT, default 8197; throwaway keys) and step 9 runs.
#   --skills (implies --risi): RISI_TOOLS=on RISI_SKILLS=on, fake-llm --script (contract/v1/
#   risi_gate_script.json plus this run's skill scenarios, generated in the work dir) and step 10 runs.
#   --ledger (implies --risi, contract v1.27 §27): RISI_TOOLS=on RISI_LEDGER=on, the quiet rule shortened
#   for the test (RISI_QUIET_S=$UITEST_QUIET_S, default 20), fake-llm --script with a scripted
#   `discussion_summarise` answer, and step 11 runs. UITEST_LEDGER_ONLY=1 runs only steps 1 and 11.
#   --calendar (implies --skills; P0 Harsha's phone): step 12 runs. UITEST_CALENDAR_ONLY=1 runs only steps 1 and 12.
#   --offers (server items 8-10): the server runs RISI_TOOLS/SKILLS/LEDGER on with RISI_QUIET_SPACING_S=1 (two
#   summaries in a row) and step 13 runs (steps 10/11 only with --skills/--ledger). UITEST_OFFERS_ONLY=1: steps 1 and 13.
#   --risi-calendar (v1.29 §29, Harsha's GATE) and --risi-notes (v1.30 §30): like --offers (TOOLS/SKILLS/LEDGER on,
#   spacing 1 s); steps 14-16 run. Everything before them runs with RISI_EVENTS/RISI_NOTES off (as the pilot does
#   today); step 14 restarts the temp server with RISI_EVENTS=on RISI_NOTES=on RISI_LEDGER=on (and the apps), step 16
#   restarts it with both off again. UITEST_RISI_ONLY=1: steps 1 and 14-16.
#
#   --google (v1.31 §31, decision 074; standalone, implies --risi --skills): step 17, the Google Calendar link against
#   scripts/fake-gcal on 127.0.0.1:$UITEST_GCAL_PORT (default 8198; adb reverse to the phones). A THIRD redroid (-ui3,
#   5853: UITEST_REDROID_C[_PORT]) is A's second device (A2); A's first (A1, "DEV=A") is the Google device. The server
#   runs RISI_EVENTS=on RISI_LEDGER=on, first without RISI_GCAL (v1.30 answers, no Google section), then RISI_GCAL=on.
#   The debug seam `lk.codegen.risime.debug.GCAL_TEST` stands in for Google Play services (Redroid has none).
#   UITEST_GOOGLE_ONLY=1: only steps 1 and 17 (what scripts/nightly-release runs when UIENTRY_GOOGLE=1).
#
#  1. A and B sign in through the login UI (dev OTP), become friends, both open the DM; it turns e2ee.
#  2. A's chat: the "🔒 Private" | "● Official" row under the header; the Official tab's "Start Official".
#  3. Chat info (tap the name): "Messages are end-to-end encrypted" within 30 s (never stuck on
#     "Checking encryption…"), and the "Lock chat" toggle.
#  4. The chat's ⋮ does NOT have "Lock chat" (Harsha's report: only Chat info and the long-press lock);
#     Chat info's "Lock chat" toggle → the system PIN prompt (`locksettings set-pin`) → the chat leaves the list.
#  5. Pull down on the chat list → the "Locked chats" row → PIN → the folder holds the chat (its window
#     is FLAG_SECURE: the screenshot is black) → unlock it.
#  6. Long-press the chat → the selection bar's ⋮ → "Lock chat".
#  7. Chat list ⋮ → "Chat lock settings" → PIN → "Hide locked chats" and "Secret code".
#  8. Settings → Privacy → "What Risi knows about me" opens without an error.
#  9. (--risi, Official hotfixes) A's DM → Official → Start Official: the 1:1 Official's header is
#     "ZZ UI B · Risi" (never "N members"), its composer placeholder is "Message"; @Risi → ask →
#     Risi's answer → the composer shows "Continuing with Risi ×". (Source quotes need an answer with
#     refs to a real message: covered by RisiCardsTest, not here.)
#  8b. (Calls tab like WhatsApp) A places a voice call to B and cancels: the Calls tab has the row, "New call" (not
#     "Add friend") and the call-back button; the call info screen (Message / Voice call / Video call, ⋮ → Remove
#     from call log); long-press → select → Delete → confirm removes the row from Calls but the chat keeps its call
#     row; ⋮ → Clear call log → confirm → the empty state, the chat still keeps its call rows.
# 10. (--skills, contract v1.26 §26.10) Settings → Risi skills: turn on Alarm and Scheduled messages
#     (SCHEDULE_EXACT_ALARM granted with appops first, as Android's "Alarms & reminders" page would);
#     the Risi chat: "wake me up at 6" → the confirm card with its exact args → Add → a real alarm in
#     Redroid's Clock (`dumpsys alarm`: DeskClock's next alarm clock) and "skill_done" with Open Clock;
#     "send ZZ UI B good morning at <in 2 min>" → the card with the text → Add → the clock-icon bubble
#     in A's DM → sent BY THE PHONE at the time (encrypted, the normal send path) → B sees it; revoke
#     Alarm → "wake me up at 7" → the skill_needed card with "Open Risi skills".
# 11. (--ledger, contract v1.27 §27.12 tests 1-2) A and B start the 1:1 Official and discuss (6 messages,
#     both of them); the quiet rule fires; each phone's Risi chat gets "Summary of your discussion with …"
#     with "You agreed:" (✓ ✗ ✎ on their own item only) and "<Name> agreed:"; the ⓘ shows "Made by:
#     RisiMe model (risi-l1) · hh:mm"; A confirms its item (✓) → "confirmed ✓" on A's card and on B's
#     ("ZZ UI A agreed:"); the Official chat has the short card; Settings → My promises lists A's item.
# 12. (--calendar, P0) Harsha's conversation replayed with the scripted model: a Google-type calendar is
#     seeded on A (redroid has no Google account: `content insert` as the calendar sync adapter, account_type
#     com.google, plus a read-only Google "Holidays" and a local "Phone" calendar); Settings → Risi skills:
#     Calendar on (the runtime READ/WRITE_CALENDAR prompt); the Risi chat: "add my interview with Shenika on
#     Monday 12 Oct at 2pm to my calendar" → ONE action card (title, Mon 12 Oct, 2–3 PM, "Choose calendar",
#     Add / Edit / Cancel) in one turn; chips: no question/confirm chip, a chip tap only fills the composer
#     (no request); [Add] → the picker lists only "uitest.risime@gmail.com · Google" → the event is in that
#     calendar (CalendarContract: title, start, end, calendar id) with no further model call; the card reads
#     "Added to your Google Calendar: …" with Open / Undo; Undo removes it (calendar_remove); never "I don't
#     see any event details". Calendar honesty (P0): "Am I free Tuesday 2pm?" → the answer carries the server's
#     "I checked: Phone calendar …"; Calendar → Details shows what Risi can read; last of all (after 13) with the
#     calendar permission revoked the same question → "I couldn't read your calendar …", no free/clear.
# 13. (--offers, server items 8-10) A and B discuss in the 1:1 Official; the scripted extraction gives A a timed
#     item, two vague ones and B an all-day one. (a) A's Risi chat: "Risi · Add to calendar?" for the timed item →
#     [Add] → the event is read back from A's Google-type calendar (CalendarContract, the server's due) with no model
#     call, and the item is offered once only (risi_item_offers, also after ✓ and the repeat below); (b) the vague
#     item's "Risi · When is it due?" → [New date] → date + time → item_edit → "New date sent" → its calendar offer
#     (10–11 AM on the picked day); (c) Settings → My promises: "I promised (n)" / "Promised to me (n)" equal to
#     the personal digest's totals (LedgerReminders.digest_items, the same query), a "Needs a date" row, a tap opens
#     the source chat; (d) a second discussion repeats the timed promise in other words → merged: no new row, no
#     new summary, one row in My promises.
# 14. (--risi-calendar, before the switch) A and B discuss an "interview panel" in the 1:1 Official; the scripted
#     extraction gives B (Shenika) "ZZ UI B: interview with ZZ UI A" tomorrow 14:00; B ✓ it (tracked). Then the server
#     restarts with RISI_EVENTS/RISI_NOTES/RISI_LEDGER on and both apps restart: the "Calendar" tab appears.
#     (--risi-calendar) A's phone calendar permission revoked; Harsha's request replayed in the Risi chat → ONE
#     "Risi · Add to Risi Calendar" card within 2 model calls (no "Choose calendar"); [Add] → "Risi · Added to your
#     Risi Calendar" with no model call; the event is in A's Risi Calendar (Calendar.list = GET /risi/calendar/events);
#     the Calendar tab: Agenda, Day, Week, Month.
# 15. (--risi-notes) A and B discuss the "interview room" in Official → after the quiet rule a note card ("… · interview
#     planning · …", Agreed with A's item, Meetings) in BOTH Risi chats, no discussion summary below it, "Risi · Notes
#     saved" in Official; A ✓ the item → My promises; tick it on the note screen → done; My promises "Done (last 7
#     days)" → Reopen → unticked on A's note and B's card; Risi chat ⋮ → Notes: search a key-point word → one row;
#     share it into the DM (an ordinary message "— shared from Risi Notes"); delete it (gone from the list, the card
#     stays). (--risi-calendar) the Shenika backfill through the release task, run IN the test server (`elixir
#     --rpc-eval … RisiMe.Release.risi_calendar_backfill(dry_run: false)`): a proposed "Interview" with an invite in
#     BOTH Risi chats; both [Accept] → accepted for both (server) and on both cards; the Official "Risi · Meeting"
#     card with the mini timeline and "Clashes with 1 event" (A's own replayed event at the same time).
# 16. Switch off: the server restarts with RISI_EVENTS/RISI_NOTES off, the apps restart: no "Calendar" tab, no "Notes"
#     in the Risi chat's ⋮, and no /risi/calendar or /risi/notes request reaches the server after the restart.
#     Screens (docs/status/screens/, Harsha's GATE names): risi-calendar-action-card, calendar-agenda, calendar-day,
#     calendar-week, calendar-month, calendar-invite-card, event-card-official, note-card, note-screen, notes-list,
#     notes-saved-official.
# 17. (--google, contract v1.31 §31.11 gate items 1-9) see the block near the end of this file: switch off (no Google
#     section, v1.30 "Checked:" line); connect through the seam (picker: Work + Personal read, Work write); "Am I free
#     Monday 2pm" asked on A2 → not free, "Checked: Risi Calendar · Google Calendar (2 calendars)" (names on A1);
#     A1 stopped → "phone didn't answer", never free; [Add] Shenika's interview → one copy risi<hex> risime=1 sendUpdates=none
#     (an insert that failed with 500 is retried: still one copy); loop guard (one busy time); edit → PATCH; delete →
#     DELETE; revoked → "needs reconnecting", ONE google_reconnect card, Reconnect works; Disconnect on A2 with Remove →
#     copies gone, link none; canaries (CANARY-GTITLE, the token, the account, Work/Personal) in no log or dump.
# 18. (--ui-batch, UI batch 2026-10-10, branch v1.32; docs/status/briefs/ui-batch-2026-10-10.md) at font scale 1.0 and 1.3
#     (`settings put system font_scale`, apps restarted; 1.0 restored): chat-list rows are two lines (name + preview, no
#     "last seen"), names are one line, a long name stays inside its row; the "Requests" tab label is one line and as
#     high as the other tabs'; the chat header shows the peer's name, "Lock chat" is in the chat's ⋮ (no header icon),
#     lock → ⋮ shows "Unlock chat" → unlock; ONE round FAB "New" → a sheet "New chat" / "New group" / "Add friend";
#     Settings → profile photo sheet "Take photo" / "Gallery" / "Remove photo" (when set); the Risi chat shows no
#     next_steps chips. UITEST_UIBATCH_ONLY=1: only steps 1 and 18. Shots 50-uibatch-*-<scale>. With --ui-batch step 4
#     expects "Lock chat" IN the chat's ⋮ (v1.32; the pre-v1.32 app must not have it).
#  No crash, no main-thread database work (scripts/logcat-gate). A screenshot of each step goes to
#  docs/status/screens/<nn>-<name>.png (downscaled). Prints "UIENTRY PASS|FAIL <step>", ends "UI ENTRY OK".
#  Own instances: redroid -ui1/-ui2 on 5851/5852, server 127.0.0.1:4551, store risime_uientry. Never touches :4000.
set -euo pipefail
# A set -e exit outside fail() (no "UIENTRY FAIL" line) still names its line (nightly.48 n48f ended silently).
set -E  # the ERR trap also inside functions (n48g ended silently inside one)
trap 'rc=$?; echo "UIENTRY ERR line $LINENO (exit $rc): $BASH_COMMAND" >&2' ERR
cd "$(dirname "$0")/.."
REPO="$PWD"; M="$HOME/.local/bin/mise exec --"
PKG=lk.codegen.risime.debug
CLS=lk.codegen.risime
SUF="${UITEST_INSTANCE:-}"; PORT="${UITEST_PORT:-4551}"
APK=""; KEEP=0; RISI=0; SKILLS=0; SKILLS_STEP=0; LEDGER=0; CALENDAR=0; OFFERS=0; RCAL=0; RNOTES=0; GCAL=0; UIBATCH=0
while [ $# -gt 0 ]; do case "$1" in --apk) APK="$2"; shift 2;; --keep) KEEP=1; shift;; --risi) RISI=1; shift;;
  --skills) RISI=1; SKILLS=1; SKILLS_STEP=1; shift;; --ledger) RISI=1; LEDGER=1; shift;;
  --calendar) RISI=1; SKILLS=1; SKILLS_STEP=1; CALENDAR=1; shift;; --offers) RISI=1; SKILLS=1; OFFERS=1; shift;;
  --risi-calendar) RISI=1; SKILLS=1; RCAL=1; shift;; --risi-notes) RISI=1; SKILLS=1; RNOTES=1; shift;;
  --google) RISI=1; SKILLS=1; GCAL=1; shift;;
  --ui-batch) RISI=1; SKILLS=1; UIBATCH=1; shift;;
  *) echo "unknown arg $1"; exit 2;; esac; done
# --google alone: UITEST_GOOGLE_ONLY=1 = steps 1 and 17 (steps 2-16 are skipped through UITEST_RISI_ONLY, which only
# the --risi-calendar/--risi-notes blocks and the google block look at).
[ "${UITEST_GOOGLE_ONLY:-0}" = 1 ] && [ "$GCAL" = 1 ] && export UITEST_RISI_ONLY=1
# The ledger's server flags (the quiet rule, the extraction) for --ledger, --offers and steps 14-15.
RISI2=0; { [ "$RCAL" = 1 ] || [ "$RNOTES" = 1 ]; } && RISI2=1
LEDGER_ON=0; { [ "$LEDGER" = 1 ] || [ "$OFFERS" = 1 ] || [ "$RISI2" = 1 ]; } && LEDGER_ON=1
QUIET_S="${UITEST_QUIET_S:-20}"
LLM_PORT="${UITEST_LLM_PORT:-8197}"
APK="${APK:-$REPO/android/app/build/outputs/apk/debug/app-debug.apk}"
[ -f "$APK" ] || { echo "no APK at $APK (cd android && ./gradlew assembleDebug)"; exit 2; }
PATH="$("$REPO/scripts/android-target" adb):$PATH"
I1="${UITEST_REDROID_A:--ui1}"; P1="${UITEST_REDROID_A_PORT:-5851}"
I2="${UITEST_REDROID_B:--ui2}"; P2="${UITEST_REDROID_B_PORT:-5852}"
I3="${UITEST_REDROID_C:--ui3}"; P3="${UITEST_REDROID_C_PORT:-5853}"   # --google: A's second device (A2)
GP="${UITEST_GCAL_PORT:-8198}"
SHOTS="${UITEST_SHOTS:-$REPO/docs/status/screens}"; mkdir -p "$SHOTS"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/risime-uientry.XXXXXX")"
LOGS="$HOME/risime-logs/uientry$SUF"; mkdir -p "$LOGS"; rm -f "$LOGS"/*.txt "$LOGS"/*.png "$LOGS"/*.xml "$LOGS"/*.log 2>/dev/null || true
export RISIME_DEV_DB="risime_uientry$SUF" RISIME_DEV_KEYSPACE="risime_uientry$SUF" ERL_EPMD_ADDRESS=127.0.0.1
export MIX_BUILD_PATH="$REPO/server/_build/uientry$SUF" RISIME_CODE_RELOADER=false
PIN=1234
SA=""; SB=""; SC=""; DEV=A
pass() { echo "UIENTRY PASS $*"; }
fail() { echo "UIENTRY FAIL $*"; diag; exit 1; }
ser() { case "$1" in A) echo "$SA";; C) echo "$SC";; *) echo "$SB";; esac; }
A() { adb -s "$(ser "$DEV")" "$@"; }
diag() {
  local d
  for d in A B C; do
    [ -n "$(ser $d)" ] || continue
    adb -s "$(ser $d)" exec-out screencap -p > "$LOGS/$d-screen.png" 2>/dev/null || true
    adb -s "$(ser $d)" logcat -d > "$LOGS/$d-logcat.txt" 2>/dev/null || true
    cp "$WORK/ui-$d.xml" "$LOGS/$d-ui.xml" 2>/dev/null || true
  done
  cp "$WORK/server.log" "$LOGS/server.log" 2>/dev/null || true
  echo "    diagnostics in $LOGS"
}
cleanup() {
  cp "$WORK/server.log" "$LOGS/server.log" 2>/dev/null || true
  [ "${SERVER_STARTED:-0}" = 1 ] && { stop_server >/dev/null 2>&1 || true; }
  tmux kill-session -t "risime-uientry$SUF" 2>/dev/null || true
  tmux kill-session -t "risime-uientry-llm$SUF" 2>/dev/null || true
  tmux kill-session -t "risime-uientry-gcal$SUF" 2>/dev/null || true
  if [ "${UIB_SCALE_SET:-0}" = 1 ]; then
    for d in A B; do [ -n "$(ser $d)" ] && adb -s "$(ser $d)" shell settings put system font_scale 1.0 >/dev/null 2>&1 || true; done
  fi
  if [ "$KEEP" = 0 ]; then
    REDROID_INSTANCE="$I1" REDROID_PORT="$P1" "$REPO/scripts/android-target" stop >/dev/null 2>&1 || true
    REDROID_INSTANCE="$I2" REDROID_PORT="$P2" "$REPO/scripts/android-target" stop >/dev/null 2>&1 || true
    [ "$GCAL" = 1 ] && { REDROID_INSTANCE="$I3" REDROID_PORT="$P3" "$REPO/scripts/android-target" stop >/dev/null 2>&1 || true; }
  fi
  (cd "$REPO/server" && $M mix ecto.drop --quiet --force >/dev/null 2>&1) || true
  rm -rf -- "${WORK:?}"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# fake-llm (--risi). With --skills it runs `--script`: this run's skill scenarios first (step 10 sets
# the scheduled time), then contract/v1/risi_gate_script.json. Restartable on the same port.
write_script() {  # $1 = the scheduled message's "at" (ISO, UTC), $2 = the DM conversation id
  python3 -I - "$REPO/contract/v1/risi_gate_script.json" "$WORK/llm-script.json" "${1:-2099-01-01T00:00:00.000Z}" "${2:-dm:none}" \
    "${CAL_START:-2099-01-05T08:30:00.000Z}" "${CAL_END:-2099-01-05T09:30:00.000Z}" <<'PY'
import json, os, sys
base = json.load(open(sys.argv[1], encoding="utf-8"))
at, conv = sys.argv[3], sys.argv[4]
cal_start, cal_end = sys.argv[5], sys.argv[6]
final = lambda a: {"tool": "final", "answer": a, "sources": [], "next_steps": []}
rules = [
    # Step 18 (--ui-batch): an answer that carries next_steps; the app must not draw them as chips (UI batch item 7).
    {"name": "uibatch_chips", "task": "risi_next_action", "match": "(?i)uibatch hello",
     "actions": [{"tool": "final", "answer": "UIBATCH answer ready.", "sources": [],
                  "next_steps": ["UIB chip remind me tomorrow", "UIB chip tell me more"]}]},
    {"name": "uibatch_upali_mon", "task": "risi_next_action", "match": "(?i)upali monday",
     "actions": [{"tool": "calendar_add", "args": {"title": "Meeting with Upali", "start": os.environ.get("UIB_MON", "2099-01-05T10:00:00.000Z"), "end": os.environ.get("UIB_MON_END", "2099-01-05T11:00:00.000Z"), "all_day": False}},
                 {"tool": "final", "answer": "Tap Add to put it on your calendar.", "sources": [], "next_steps": []}]},
    {"name": "uibatch_upali_tue", "task": "risi_next_action", "match": "(?i)upali tuesday",
     "actions": [{"tool": "calendar_add", "args": {"title": "Meeting with Upali two", "start": os.environ.get("UIB_TUE", "2099-01-06T10:00:00.000Z"), "end": os.environ.get("UIB_TUE_END", "2099-01-06T11:00:00.000Z"), "all_day": False}},
                 {"tool": "final", "answer": "Tap Add to put it on your calendar.", "sources": [], "next_steps": []}]},
    {"name": "uibatch_upali_wed", "task": "risi_next_action", "match": "(?i)upali wednesday",
     "actions": [{"tool": "calendar_add", "args": {"title": "Meeting with Upali google", "start": os.environ.get("UIB_WED", "2099-01-07T10:00:00.000Z"), "end": os.environ.get("UIB_WED_END", "2099-01-07T11:00:00.000Z"), "all_day": False}},
                 {"tool": "final", "answer": "Tap Add to put it on your calendar.", "sources": [], "next_steps": []}]},
    {"name": "uibatch_actions", "task": "risi_next_action", "match": "(?i)uibatch actions",
     "actions": [{"tool": "final", "answer": "UIBATCH actions ready.", "sources": [],
                  "next_steps": ["Connect your calendar in Settings", "Check if I'm free on Monday"]}]},
    {"name": "uibatch_monday", "task": "risi_next_action", "match": "(?i)free on monday",
     "actions": [{"tool": "final", "answer": "UIBATCH monday answer.", "sources": [], "next_steps": []}]},
    {"name": "uibatch_md", "task": "risi_next_action", "match": "(?i)uibatch markdown",
     "actions": [{"tool": "final", "answer": "Plan: **bold text** and __more bold__ here.\n\n- item one\n- item two", "sources": [], "next_steps": []}]},
    {"name": "uibatch_chip_tap", "task": "risi_next_action", "match": "(?i)uib chip tell me more",
     "actions": [{"tool": "final", "answer": "UIBATCH chip answered.", "sources": [], "next_steps": []}]},
    {"name": "uibatch_week", "task": "risi_next_action", "match": "(?i)what.?s on my calendar this week",
     "actions": [{"tool": "calendar_check", "args": {"from": os.environ.get("UIB_FROM", "2099-01-01") + "T00:00", "to": os.environ.get("UIB_TO", "2099-01-08") + "T00:00"}},
                 {"tool": "final", "answer": "UIBATCH week answer.", "sources": ["c1"], "next_steps": []}]},
    # Step 12 (P0): Harsha's request → one calendar_add proposal (the action card), and the chips the
    # model offered on the phone (a confirm phrase and a question are hidden; the third only fills).
    {"name": "calendar_shenika", "task": "risi_next_action", "match": "(?i)interview with shenika",
     "actions": [{"tool": "calendar_add", "args": {"title": "Interview with Shenika", "start": cal_start, "end": cal_end, "all_day": False}},
                 {"tool": "final", "answer": "Here it is. Tap Add to put it on your Google Calendar.", "sources": [],
                  "next_steps": ["Confirm to add the event", "What else is on Monday?", "Remind me 30 min before"]}]},
    # The P0 failure mode: a chip SENT as a request. The gate fails if this answer ever shows.
    # Calendar honesty, no read: with the permission revoked calendar_check isn't offered; the model claims the
    # asker is free anyway. The server must replace that ("I couldn't read your calendar …").
    {"name": "calendar_free_unchecked", "task": "risi_next_action", "match": "(?i)am i still free",
     "actions": [final("Yes, you're free on Tuesday at 2 pm. Your calendar is clear.")]},
    {"name": "calendar_chip_sent", "task": "risi_next_action", "match": "(?i)(confirm to add|remind me 30)",
     "actions": [final("I don't see any event details.")]},

    # Step 9 with RISI_TOOLS on: the ask goes through the tool loop (no v1.24 answer path).
    {"name": "step9_ask", "task": "risi_next_action", "match": "(?i)what did we agree",
     "actions": [final("You agreed the budget review on Tuesday.")]},
    {"name": "skills_alarm_6", "task": "risi_next_action", "match": "(?i)wake me up at 6",
     "actions": [{"tool": "set_alarm", "args": {"time": "06:00", "label": "Wake up", "days": None}}, final("Tap Add to set the alarm for 06:00.")]},
    {"name": "skills_alarm_7_revoked", "task": "risi_next_action", "match": "(?i)wake me up at 7",
     "actions": [{"tool": "need_skill", "args": {"skill_id": "alarm"}}]},
    {"name": "skills_schedule", "task": "risi_next_action", "match": "(?i)good morning at",
     "actions": [{"tool": "schedule_message", "args": {"to": "ZZ UI B", "text": "Good morning", "at": at, "repeat": None}},
                 final("Tap Add to send it from your phone at that time.")]},
]
# Step 14 (--risi-calendar, RISI_EVENTS on: RC_LIVE=1): Harsha's request replayed for a calendar user → the server
# tool risi_calendar_add (the Risi Calendar card; no phone calendar), then the final answer (2 model calls).
if os.environ.get("RC_LIVE") == "1":
    rules.insert(0, {"name": "rcal_replay", "task": "risi_next_action", "match": "(?i)interview with shenika",
                     "actions": [{"tool": "risi_calendar_add", "args": {"title": "Interview", "start": os.environ["RC_START"], "end": None,
                                                                       "all_day": None, "with": None, "reminder_min": None}},
                                 final("Tap Add on the card.")]})
# Step 17 (--google, GCAL_LIVE=1; RISI_EVENTS on): "Am I free Monday 2pm" / "... Tuesday 10am" -> the server tool
# risi_calendar_check over that whole day (the Google call goes to the Google device in the same step), then a
# "free" claim that the server must rewrite against the busy Google event or the copy (29.7, 31.5); Shenika's
# interview on Tuesday 10:00 -> risi_calendar_add (the Risi Calendar card). GC_MON / GC_TUE are A's local dates.
if os.environ.get("GCAL_LIVE") == "1":
    mon, tue = os.environ["GC_MON"], os.environ["GC_TUE"]
    day = lambda d: {"from": d + "T00:00", "to": d + "T23:59"}
    rules[0:0] = [
        {"name": "gcal_free_mon", "task": "risi_next_action", "match": "(?i)am i free monday",
         "actions": [{"tool": "risi_calendar_check", "args": day(mon)}, final("You're free on Monday at 2 pm.")]},
        {"name": "gcal_free_tue", "task": "risi_next_action", "match": "(?i)am i free tuesday",
         "actions": [{"tool": "risi_calendar_check", "args": day(tue)}, final("You're free on Tuesday at 10 am.")]},
        {"name": "gcal_shenika", "task": "risi_next_action", "match": "(?i)interview with shenika",
         "actions": [{"tool": "risi_calendar_add", "args": {"title": "Interview with Shenika", "start": tue + "T10:00", "end": None,
                                                           "all_day": None, "with": None, "reminder_min": None}},
                     final("Tap Add on the card.")]},
    ]
# Step 13 (--offers): the extraction of two Official discussions (both before step 11's catch-all rule). The
# owner refs follow the members' order (u1/u2), so each rule exists for A = u1 and A = u2, told apart by the
# prompt's member line {"name":"ZZ UI A",…,"ref":"uN",…}. Discussion 1 ("cement delivery"): A's timed item, two
# vague ones, B's all-day one. Discussion 2 ("just a reminder"): A's timed promise again in other words (merged).
t_due, b_due, r_due = (os.environ.get(k, d) for k, d in
                       (("OFF_T_DUE", "2099-01-05T15:00"), ("OFF_B_DUE", "2099-01-05"), ("OFF_R_DUE", "2099-01-05T15:30")))
# Steps 14-15 (--risi-calendar/--risi-notes), first: a later discussion's prompt can quote the earlier ones (the
# offers rules' words), never the other way round. "interview room" (step 15, a notes user is in the chat: the note
# schema with topic/language/meetings): A's item, a meeting B proposed. "interview panel" (step 14, before the
# switch): Shenika's real case, B's "ZZ UI B: interview with ZZ UI A" with a concrete time (the backfill's item).
seed_due, rn_due, rn_meet = (os.environ.get(k, d) for k, d in
                             (("RC_SEED_DUE", "2099-01-05T14:00"), ("RN_ITEM_DUE", "2099-01-08T17:00"), ("RN_MEET", "2099-01-09T11:00")))
for a, b in (("u1", "u2"), ("u2", "u1")):
    who = '(?=[\\s\\S]*"name":"ZZ UI A"[^}]*"ref":"%s")' % a
    rules += [
        {"name": "rnotes_" + a, "task": "discussion_summar(y|ise)", "match": "(?i)^(?=[\\s\\S]*interview room)" + who,
         "actions": [{"key_points": ["The interview needs a quiet room.", "ZZ UI B leads the room walkthrough.", "The panel meets on the day."],
                      "summary": "Interview planning.", "topic": "interview planning", "language": "en",
                      "items": [{"text": "Book the interview room", "owner": a, "counterparts": [b], "due_local": rn_due,
                                 "due_text": None, "source": ["m1"], "confidence": 0.9}],
                      "meetings": [{"title": "Room walkthrough", "start_local": rn_meet, "end_local": None, "proposed_by": b,
                                    "with": [a, b], "source": ["m2"], "confidence": 0.9}]}]},
        {"name": "rcal_seed_" + a, "task": "discussion_summar(y|ise)", "match": "(?i)^(?=[\\s\\S]*interview panel)" + who,
         "actions": [{"key_points": ["The interview panel is set.", "ZZ UI B runs the interview."], "summary": "Planning the interview.",
                      "items": [{"text": "ZZ UI B: interview with ZZ UI A", "owner": b, "counterparts": [a], "due_local": seed_due,
                                 "due_text": None, "source": ["m2"], "confidence": 0.9}]}]},
    ]
for a, b in (("u1", "u2"), ("u2", "u1")):
    who = '(?=[\\s\\S]*"name":"ZZ UI A"[^}]*"ref":"%s")' % a
    item = lambda text, owner, due, due_text, src: {"text": text, "owner": owner, "counterparts": [b if owner == a else a],
                                                    "due_local": due, "due_text": due_text, "source": [src], "confidence": 0.9}
    rules += [
        {"name": "offers_repeat_" + a, "task": "discussion_summar(y|ise)", "match": "(?i)^(?=[\\s\\S]*just a reminder)" + who,
         "actions": [{"key_points": ["The supplier call stays as agreed."], "summary": "A reminder about the supplier call.",
                      "items": [item("Call the cement supplier about the delivery", a, r_due, None, "m2")]}]},
        {"name": "offers_d1_" + a, "task": "discussion_summar(y|ise)", "match": "(?i)^(?=[\\s\\S]*cement delivery)" + who,
         "actions": [{"key_points": ["The cement delivery needs a supplier call.", "The audit report and the crane quote follow."],
                      "summary": "Chat about the cement delivery, the audit report and the crane quote.",
                      "items": [item("Call the supplier about the cement delivery", a, t_due, None, "m1"),
                                item("Send the site photos", b, b_due, None, "m2"),
                                item("Share the safety audit report", a, None, "sometime next week", "m3"),
                                item("Check the crane hire quote", a, None, "soon", "m5")]}]},
    ]
# Step 11 (--ledger): the quiet-rule extraction (§27.2, learning-log task discussion_summarise) over the
# Official discussion: two key points and one item for each member ref (u1, u2: A and B in the server's
# order), so each phone owns exactly one item whichever ref it got.
rules += [
    {"name": "ledger_discussion", "task": "discussion_summar(y|ise)",
     "actions": [{"key_points": ["The quote needs the new transport cost.", "The site visit stays on Thursday."],
                  "summary": "Chat about the revised quote and Thursday's site visit.",
                  "items": [
                      {"text": "Send the revised quote", "owner": "u1", "counterparts": ["u2"], "due_local": None,
                       "due_text": None, "source": ["m1"], "confidence": 0.9},
                      {"text": "Book the site visit transport", "owner": "u2", "counterparts": ["u1"], "due_local": None,
                       "due_text": None, "source": ["m2"], "confidence": 0.9}]}]},
]
rules += base["rules"] if isinstance(base, dict) else base
json.dump({"v": 1, "rules": rules}, open(sys.argv[2], "w", encoding="utf-8"), ensure_ascii=False)
PY
}
