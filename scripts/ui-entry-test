# $WORK/phase.env: the switches of steps 14-16 (RISI_EVENTS/RISI_NOTES), empty before step 14. Steps 14-16 restart
# this server (same store) with other switches, so with --risi-calendar it runs as a named node (loopback epmd, a
# throwaway cookie): the release task `RisiMe.Release.risi_calendar_backfill/1` is run INSIDE it (--rpc-eval).
: > "$WORK/phase.env"
NODE=""; COOKIE=""
if [ "$RCAL" = 1 ]; then NODE="risime_uientry${SUF}_$$"; COOKIE="$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"; fi
start_server() {
  local run="$M mix phx.server"
  [ -n "$NODE" ] && run="$M elixir --sname $NODE --cookie $COOKIE --erl '-kernel inet_dist_use_interface {127,0,0,1}' -S mix phx.server"
  SERVER_STARTED=1
  tmux new -d -s "risime-uientry$SUF" "cd '$REPO/server' && set -a && . '$WORK/risi.env' && . '$WORK/phase.env' && set +a && MIX_BUILD_PATH='$MIX_BUILD_PATH' RISIME_CODE_RELOADER=false RISIME_DEV_DB=$RISIME_DEV_DB RISIME_DEV_KEYSPACE=$RISIME_DEV_KEYSPACE ERL_EPMD_ADDRESS=127.0.0.1 \
    PORT=$PORT DEV_LOCAL_AUTH=true OIDC_ENABLED=false OTP_DEV_LOG=true PHONE_VERIFICATION=off FCM_ENABLED=false LOG_FORMAT=text TABS=on \
    ATTESTATION_KEY_FILE='$WORK/attest.jwk' RISIME_AUTH_LOG='$WORK/auth.log' $run >> '$WORK/server.log' 2>&1"
  for _ in $(seq 1 180); do curl -sf -o /dev/null "http://127.0.0.1:$PORT/health" && break; sleep 1; done
  curl -sf -o /dev/null "http://127.0.0.1:$PORT/health" || { echo "server didn't start"; tail -20 "$WORK/server.log"; exit 1; }
}
# Stops this run's server only: the PID listening on our own port (never a pattern kill).
stop_server() {
  local pid
  pid="$(ss -ltnpH "sport = :$PORT" 2>/dev/null | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2)"
  [ -n "$pid" ] && kill "$pid" 2>/dev/null
  for _ in $(seq 1 40); do ss -ltnH "sport = :$PORT" | grep -q . || break; sleep 1; done
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then kill -9 "$pid" 2>/dev/null || true; sleep 2; fi
  tmux kill-session -t "risime-uientry$SUF" 2>/dev/null || true
  for _ in $(seq 1 20); do ss -ltnH "sport = :$PORT" | grep -q . || return 0; sleep 1; done
  echo "port $PORT still busy after stopping the server"; return 1
}
: > "$WORK/server.log"
start_server
curl -sf "http://127.0.0.1:$PORT/api/v1/auth/config" | grep -q '"tabs":"on"' || { echo "the temp server's /auth/config doesn't say tabs: on"; exit 1; }
if [ "$SKILLS" = 1 ]; then
  curl -sf "http://127.0.0.1:$PORT/api/v1/auth/config" | grep -q '"risi_skills":"on"' || { echo "the temp server's /auth/config doesn't say risi_skills: on"; exit 1; }
fi
if [ "$LEDGER_ON" = 1 ]; then
  curl -sf "http://127.0.0.1:$PORT/api/v1/auth/config" | grep -q '"risi_ledger":"on"' || { echo "the temp server's /auth/config doesn't say risi_ledger: on"; exit 1; }
fi
[ "$(fx setup)" = "uientry: setup ok" ] || { echo "fixture: setup"; exit 1; }
