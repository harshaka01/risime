  shot "12-official-dm-header"
  pass "the 1:1 Official: header 'ZZ UI B · Risi', placeholder 'Message', 'Risi is listening' strip"
  # Something to answer from (an empty Official gets the error "nothing to summarise", which opens no follow-up).
  tap "Message" || true; sleep 0.5
  A shell input text "We%sagreed%sthe%sbudget%sreview%son%sTuesday"; sleep 0.5
  tap "Send" || fail "send a normal Official message"
  sleep 3
  tap "@Risi" || fail "tap the @Risi chip"
  wait_for 'text="Ask Risi…"' 10 || fail "the @Risi chip didn't switch the composer"
  tap "Ask Risi…" || true; sleep 0.5
  A shell input text "what%sdid%swe%sagree"; sleep 0.5
  tap "Send" || fail "send the ask"
  wait_text "Continuing with Risi" 120 || fail "after Risi's answer: no 'Continuing with Risi' chip"
  shot "13-risi-follow-up-chip"
  pass "Risi answered; the composer shows 'Continuing with Risi ×'"
fi

fi  # UITEST_SKILLS_ONLY

# ---------------------------------------------------------------- 10. (--skills) Risi skills: alarm, scheduled message, revoke
if [ "$SKILLS" = 1 ] && [ "${UITEST_LEDGER_ONLY:-0}" != 1 ] && [ "${UITEST_CALENDAR_ONLY:-0}" != 1 ]; then
  DEV=A
  size="$(A shell wm size | grep -oE '[0-9]+x[0-9]+' | tail -1)"; W="${size%x*}"; H="${size#*x}"
  conv="$(fx conv | sed -n 's/^uientry: conv=//p')"; [ -n "$conv" ] || fail "fixture: the DM's conversation id"
  # Android's "Alarms & reminders" page, granted the way a user would (redroid has no Settings UI for it).
  A shell appops set "$PKG" SCHEDULE_EXACT_ALARM allow >/dev/null 2>&1 || true
  A shell pm grant "$PKG" android.permission.POST_NOTIFICATIONS 2>/dev/null || true
  back_to_list || fail "back to the chat list (skills)"
  tap "More options" || fail "the chat list's ⋮ (Settings, skills)"
  wait_for 'text="Settings"' 10 || fail "no Settings item (skills)"
  tap "Settings" || fail "tap Settings (skills)"
  found=0
  for _ in 1 2 3 4 5 6; do
    has 'text="Risi skills"' && { found=1; break; }
    A shell input swipe $((W / 2)) $((H * 75 / 100)) $((W / 2)) $((H * 30 / 100)) 400; sleep 1
  done
  [ "$found" = 1 ] || fail "Settings: no 'Risi skills' (risi_skills on)"
  tap "Risi skills" || fail "tap Risi skills"
  wait_for 'content-desc="Alarm skill"' 30 || fail "Risi skills: no Alarm switch"
  has 'Coming later' || true
  tap "Alarm skill" || fail "turn on Alarm"
  wait_skill "Alarm" "Ask me each time" 20 || fail "Alarm didn't turn on (Ask me each time)"
  pass "Settings → Risi skills: Alarm on (Ask me each time)"
  found=0
  for _ in 1 2 3 4 5 6; do
    has 'content-desc="Scheduled messages skill"' && { found=1; break; }
    A shell input swipe $((W / 2)) $((H * 75 / 100)) $((W / 2)) $((H * 35 / 100)) 400; sleep 1
  done
  [ "$found" = 1 ] || fail "Risi skills: no Scheduled messages switch"
  tap "Scheduled messages skill" || fail "turn on Scheduled messages"
  wait_skill "Scheduled messages" "Ask me each time" 20 || fail "Scheduled messages didn't turn on (exact alarms granted)"
  A shell input swipe $((W / 2)) $((H * 30 / 100)) $((W / 2)) $((H * 80 / 100)) 300; sleep 1
  A shell input swipe $((W / 2)) $((H * 30 / 100)) $((W / 2)) $((H * 80 / 100)) 300; sleep 1
  shot "14-risi-skills"
  pass "Settings → Risi skills: Scheduled messages on"

  # -- "wake me up at 6" in the Risi chat → confirm card → Add → a real alarm in Clock
  back_to_list || fail "back to the chat list (Risi chat)"
  wait_text "Risi" 30 || fail "the chat list has no Risi entry"
  tap "Risi" || fail "open the Risi chat"
  wait_for 'text="Ask Risi…"' 60 || fail "the Risi chat didn't open"
  for _ in $(seq 1 60); do has 'Only you and Risi' && break; sleep 1; done
  tap "Ask Risi…" || true; sleep 0.5
  A shell input text "wake%sme%sup%sat%s6"; sleep 0.5
  tap "Send" || fail "send 'wake me up at 6'"
  wait_text "Add" 120 || fail "no confirm card with Add for the alarm"
  has '06:00' || fail "the alarm card doesn't show its time (args)"
  shot "15-confirm-alarm"
  pass "the alarm confirm card shows its exact args (06:00, Wake up) with Add / Cancel"
  tap "Add" || fail "tap Add (alarm)"
  # DeskClock's AlarmManager alarm-clock entry (an "Alarm clock:" alarm of com.android.deskclock) at 06:00 device time.
  ok_a=""
  for _ in $(seq 1 45); do
    for w in $(A shell dumpsys alarm 2>/dev/null | python3 -I -c '
import re, sys
lines = sys.stdin.read().splitlines()
for i, l in enumerate(lines):
    m = re.search(r"origWhen (\d+) .*com\.android\.deskclock\}", l)
    if m and any("Alarm clock:" in x for x in lines[i + 1:i + 7]):
        print(int(m.group(1)) // 1000)'); do
      [ "$(A shell date -d "@$w" +%H:%M 2>/dev/null | tr -d '\r')" = "06:00" ] && { ok_a=1; break; }
    done
    [ -n "$ok_a" ] && break
    sleep 1
  done
  [ -n "$ok_a" ] || fail "no 06:00 alarm in Redroid's Clock after Add (dumpsys alarm)"
  pass "a real 06:00 alarm is set in Redroid's Clock (DeskClock's alarm clock in dumpsys alarm)"
  A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null; sleep 2
  wait_text "Open Clock" 60 || fail "no skill_done card with 'Open Clock' after the alarm"
  pass "skill_done: 'Open Clock to remove it'"

  # -- "send ZZ UI B good morning at <+2 min>" → card → Add → the phone sends it at the time
  at_epoch=$(( $(date +%s) + 150 )); at_epoch=$(( at_epoch - at_epoch % 60 + 60 ))
  at_iso="$(date -u -d "@$at_epoch" +%Y-%m-%dT%H:%M:00.000Z)"; at_hm="$(date -u -d "@$at_epoch" +%H%M)"
  write_script "$at_iso" "$conv"; start_llm
  tap "Ask Risi…" || true; sleep 0.5
  A shell input text "send%sZZ%sUI%sB%sgood%smorning%sat%s$at_hm"; sleep 0.5
  tap "Send" || fail "send the schedule request"
  wait_for 'Good morning' 120 || fail "no schedule confirm card showing the text"
  for _ in $(seq 1 10); do [ -n "$(node_xy "Add")" ] && break; sleep 1; done
  tap "Add" || fail "tap Add (schedule)"
  for _ in $(seq 1 30); do [ "$(count 'scheduled message .*: armed')" -gt 0 ] && break; sleep 1; done
  [ "$(count 'scheduled message .*: armed')" -gt 0 ] || fail "the phone didn't store and arm the schedule"
  rl 'scheduled message' | tail -2 | sed 's/^/    /'
  pass "the phone stored the schedule and armed it (exact alarm)"
  open_chat "ZZ UI B" || fail "open A's DM (scheduled bubble)"
  tap "🔒 Private" || true
  wait_for 'Scheduled for' 30 || fail "no clock-icon 'Scheduled for …' bubble in A's DM"
  has 'content-desc="Scheduled"' || fail "the scheduled bubble has no clock icon"
  shot "16-scheduled-bubble"
  pass "A's DM shows the scheduled bubble with a clock icon"
  # The phone sends it at the time (A's app in the background: the exact alarm → the worker).
  A shell input keyevent KEYCODE_HOME
  now=$(date +%s); wait_s=$(( at_epoch - now + 90 )); [ "$wait_s" -lt 30 ] && wait_s=30
  for _ in $(seq 1 "$wait_s"); do [ "$(count 'scheduled message .*: queued')" -gt 0 ] && break; sleep 1; done
  [ "$(count 'scheduled message .*: queued')" -gt 0 ] || fail "the phone didn't send the scheduled message at $at_iso"
  pass "the phone queued the scheduled message at the time ($(rl 'scheduled message .*: queued' | tail -1 | grep -oE '\((on time|late)\)'))"
  DEV=B; open_chat "ZZ UI A" || fail "B: open the DM"
  tap "🔒 Private" || true
  wait_for "Good morning" 120 || fail "B didn't receive the scheduled message"
  pass "B received 'Good morning', sent by A's phone, as a normal message"
  DEV=A
  A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null; sleep 1

  # -- revoke Alarm → "wake me up at 7" → skill_needed
  back_to_list || fail "back to the chat list (revoke)"
  tap "More options" || fail "the chat list's ⋮ (revoke)"
  wait_for 'text="Settings"' 10 || fail "no Settings item (revoke)"
  tap "Settings" || fail "tap Settings (revoke)"
  for _ in 1 2 3 4 5 6; do has 'text="Risi skills"' && break; A shell input swipe $((W / 2)) $((H * 75 / 100)) $((W / 2)) $((H * 30 / 100)) 400; sleep 1; done
  tap "Risi skills" || fail "tap Risi skills (revoke)"
  wait_for 'content-desc="Alarm skill"' 30 || fail "Risi skills: no Alarm switch (revoke)"
  tap "Alarm skill" || fail "turn off Alarm"
  wait_for 'text="Turn off"' 10 || fail "no revoke dialog"
  tap "Turn off" || fail "confirm Turn off"
  wait_skill "Alarm" "Off" 20 || fail "Alarm didn't turn off"
  pass "Alarm revoked in Settings → Risi skills"
  back_to_list || fail "back to the chat list (skill_needed)"
  tap "Risi" || fail "open the Risi chat (skill_needed)"
  wait_for 'text="Ask Risi…"' 60 || fail "the Risi chat didn't open (skill_needed)"
  tap "Ask Risi…" || true; sleep 0.5
  A shell input text "wake%sme%sup%sat%s7"; sleep 0.5
  tap "Send" || fail "send 'wake me up at 7'"
  wait_text "Open Risi skills" 120 || fail "no skill_needed card after the revoke"
  has 'no longer have access to your alarms' || fail "the skill_needed card doesn't say Risi lost access"
  shot "17-skill-needed"
  pass "after the revoke Risi says it has no access, with 'Open Risi skills'"
  tap "Open Risi skills" || fail "tap Open Risi skills"
  wait_for 'content-desc="Alarm skill"' 20 || fail "'Open Risi skills' didn't open Settings → Risi skills"
  pass "'Open Risi skills' opens Settings → Risi skills"
fi

# ---------------------------------------------------------------- 11. (--ledger) a discussion → each Risi chat's summary
# The Official tab of the DM, with a usable composer ("Message"); starts Official the first time.
official_tab() {
  open_chat "ZZ UI ${1}" || return 1
  tap "● Official" || return 1
  for _ in $(seq 1 90); do
    has 'text="Start Official"' && { tap "Start Official" || true; sleep 2; }
    has 'text="Message"' && has 'Risi is listening' && return 0
    sleep 1
  done
  return 1
}
say() { tap "Message" || return 1; sleep 0.5; A shell input text "$(printf '%s' "$1" | sed 's/ /%s/g')"; sleep 0.5; tap "Send"; sleep 2; }
# The Risi chat from the chat list ("Risi", pinned first; created by the app at start on a risi_ledger phone).
open_risi_chat() {
  back_to_list || return 1
  wait_text "Risi" 60 || return 1
  tap "Risi" || return 1
  wait_for 'text="Ask Risi…"' 60
}
if [ "$LEDGER" = 1 ]; then
  DEV=A; official_tab B || fail "ledger: A can't open the DM's Official tab"
  DEV=B; official_tab A || fail "ledger: B can't open the DM's Official tab"
  pass "ledger: both phones are in the 1:1 Official ('Risi is listening')"
  DEV=A; say "I will send the revised quote with the transport cost" || fail "ledger: A can't send in Official"
  DEV=B; say "Thanks. I will book the site visit transport" || fail "ledger: B can't send in Official"
  DEV=A; say "The site visit stays on Thursday" || fail "ledger: A message 3"
  DEV=B; say "Agreed, Thursday it is" || fail "ledger: B message 4"
  DEV=A; say "I will add the transport line to the quote" || fail "ledger: A message 5"
  DEV=B; say "Great, talk on Thursday" || fail "ledger: B message 6"
  pass "ledger: A and B discussed in Official (6 messages, both of them)"
  # The quiet rule (RISI_QUIET_S=$QUIET_S for this run) → discussion_summarise → each recipient's Risi chat.
  DEV=A; wait_text "Risi · Discussion summary" $(( QUIET_S + 120 )) || fail "ledger: no short discussion card in Official within $(( QUIET_S + 120 )) s (quiet rule)"
  has "Details in your Risi chat" || fail "ledger: the short card lacks 'N items · Details in your Risi chat'"
  pass "ledger: the Official chat has the short card ('… · Details in your Risi chat')"
  wait_text "Open Risi chat" 30 && tap "Open Risi chat" || fail "ledger: the short card has no [Open Risi chat]"
  wait_for "Summary of your discussion with ZZ UI B" 60 || fail "ledger: A's Risi chat has no 'Summary of your discussion with ZZ UI B'"
  has 'text="You agreed:"' || fail "ledger: A's summary has no 'You agreed:'"
  has 'text="ZZ UI B agreed:"' || fail "ledger: A's summary has no 'ZZ UI B agreed:'"
  n_ok="$(count_text "✓")"
  [ "$n_ok" = 1 ] || fail "ledger: A's summary shows $n_ok ✓ buttons (want exactly 1: only A's own item)"
  shot "27-discussion-summary"
  pass "ledger: A's Risi chat: 'Summary of your discussion with ZZ UI B', You agreed (✓ ✗ ✎ on A's item only), ZZ UI B agreed (read-only)"
  # §27.1: ⓘ → Made by.
  tap "ⓘ" || fail "ledger: no ⓘ on the summary card"
  wait_for "Made by: RisiMe model (risi-l1)" 15 || fail "ledger: the ⓘ sheet doesn't say 'Made by: RisiMe model (risi-l1) · …'"
  shot "26-made-by"
  pass "ledger: ⓘ → 'Made by: RisiMe model (risi-l1) · hh:mm'"
  A shell input keyevent KEYCODE_BACK; sleep 1
  wait_text "You agreed:" 15 || fail "ledger: the summary card is gone after the Made by sheet"
  mine="$(python3 -I - "$WORK/ui-A.xml" <<'PY'
import sys, xml.etree.ElementTree as ET
texts = [n.get('text') for n in ET.parse(sys.argv[1]).iter('node') if n.get('text')]
i = texts.index("You agreed:")
print(texts[i + 1].lstrip("• ").strip())
PY
)"
  [ -n "$mine" ] || fail "ledger: can't read A's own item"
  tap "✓" || fail "ledger: tap ✓ on A's item"
  wait_text "confirmed ✓" 60 || fail "ledger: A's item didn't become 'confirmed ✓' (item_update)"
  pass "ledger: A confirmed '$mine' (✓) → 'confirmed ✓' after Risi's item_update"
  DEV=B; open_risi_chat || fail "ledger: B can't open its Risi chat"
  # (The summary card is taller on B once A confirmed: its header may be scrolled off; the items are what matter.)
  wait_text "ZZ UI A agreed:" 90 || fail "ledger: B's Risi chat has no summary with 'ZZ UI A agreed:'"
  has 'text="You agreed:"' || fail "ledger: B's summary has no 'You agreed:'"
  wait_text "confirmed ✓" 60 || fail "ledger: B doesn't see A's item as 'confirmed ✓'"
  n_ok="$(count_text "✓")"
  [ "$n_ok" = 1 ] || fail "ledger: B's summary shows $n_ok ✓ buttons (want 1: B's own item)"
  pass "ledger: B's Risi chat has the same summary; A's item shows 'confirmed ✓', B confirms only its own"
  DEV=A
  back_to_list || fail "ledger: back to the chat list (My promises)"
  tap "More options" || fail "ledger: the chat list's ⋮ (Settings)"
  wait_for 'text="Settings"' 10 || fail "ledger: no Settings item"
  tap "Settings" || fail "ledger: tap Settings"
  size="$(A shell wm size | grep -oE '[0-9]+x[0-9]+' | tail -1)"; W="${size%x*}"; H="${size#*x}"
  for _ in 1 2 3 4 5 6; do has 'text="My promises"' && break; A shell input swipe $((W / 2)) $((H * 75 / 100)) $((W / 2)) $((H * 30 / 100)) 400; sleep 1; done
  tap "My promises" || fail "ledger: Settings has no 'My promises'"
  wait_for "$mine" 30 || fail "ledger: My promises doesn't list '$mine'"
  shot "28-my-promises"
  pass "ledger: Settings → My promises lists '$mine'"
  back_to_list || true
fi

# ---------------------------------------------------------------- 12. (--calendar, P0) Harsha's calendar conversation
if [ "$CALENDAR" = 1 ] && [ "${UITEST_LEDGER_ONLY:-0}" != 1 ]; then
  DEV=A
  size="$(A shell wm size | grep -oE '[0-9]+x[0-9]+' | tail -1)"; W="${size%x*}"; H="${size#*x}"
  GACC="uitest.risime@gmail.com"
  # Redroid has no Google account (no Play services authenticator): the calendars are inserted the way
  # Google's sync adapter writes them (caller_is_syncadapter, account_type com.google). The app sees exactly
  # what a synced Google calendar looks like in CalendarContract; the sync to Google itself isn't covered.
  cal_insert() {  # $1 account name, $2 account type, $3 display name, $4 access level
    A shell "content insert --uri 'content://com.android.calendar/calendars?caller_is_syncadapter=true&account_name=$1&account_type=$2' --bind account_name:s:$1 --bind account_type:s:$2 --bind name:s:$3 --bind calendar_displayName:s:$3 --bind calendar_access_level:i:$4 --bind visible:i:1 --bind sync_events:i:1 --bind ownerAccount:s:$1 --bind calendar_color:i:-14069085 --bind calendar_timezone:s:UTC" >/dev/null
  }
  cal_insert "$GACC" com.google "$GACC" 700
  cal_insert "$GACC" com.google "Holidays" 200
  cal_insert Phone LOCAL Phone 700
  cal_rows() { A shell "content query --uri content://com.android.calendar/calendars --projection _id:account_name:account_type:calendar_access_level:calendar_displayName" 2>/dev/null | tr -d '\r'; }
  GCAL="$(cal_rows | sed -n "s/^Row: [0-9]* _id=\([0-9]*\), account_name=$GACC, account_type=com.google, calendar_access_level=700,.*/\1/p" | head -1)"
  [ -n "$GCAL" ] || { cal_rows | sed 's/^/    /'; fail "calendar: could not seed the Google-type calendar"; }
  pass "calendar: seeded a com.google calendar ($GACC, id $GCAL), a read-only Google 'Holidays' and a local 'Phone' calendar"
  # Next Monday 14:00–15:00 on A's clock (Harsha's "Monday 12 Oct at 2pm"), and the card's expected texts.
  dtz="$(A shell getprop persist.sys.timezone | tr -d '\r')"; dtz="${dtz:-UTC}"
  read -r CAL_START CAL_END CAL_START_MS CAL_DATE <<<"$(python3 -I - "$dtz" <<'PY'
import sys, datetime as dt
from zoneinfo import ZoneInfo
z = ZoneInfo(sys.argv[1])
now = dt.datetime.now(z)
d = now.date() + dt.timedelta(days=(7 - now.weekday()) % 7 or 7)
s = dt.datetime(d.year, d.month, d.day, 14, 0, tzinfo=z)
e = s + dt.timedelta(hours=1)
iso = lambda t: t.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")
print(iso(s), iso(e), int(s.timestamp() * 1000), s.strftime("%a %-d %b"))
PY
)"
  export CAL_START CAL_END
  conv="$(fx conv | sed -n 's/^uientry: conv=//p')"
  write_script "2099-01-01T00:00:00.000Z" "${conv:-dm:none}"; start_llm
  reqs() { [ -f "$WORK/llm-requests.jsonl" ] && wc -l < "$WORK/llm-requests.jsonl" || echo 0; }

  # -- Settings → Risi skills → Calendar on: the runtime READ/WRITE_CALENDAR prompt, answered Allow
  back_to_list || fail "calendar: back to the chat list"
  tap "More options" || fail "calendar: the chat list's ⋮"
  wait_for 'text="Settings"' 10 || fail "calendar: no Settings item"
  tap "Settings" || fail "calendar: tap Settings"
  for _ in 1 2 3 4 5 6; do has 'text="Risi skills"' && break; A shell input swipe $((W / 2)) $((H * 75 / 100)) $((W / 2)) $((H * 30 / 100)) 400; sleep 1; done
  tap "Risi skills" || fail "calendar: Settings has no 'Risi skills'"
  found=0
  for _ in 1 2 3 4 5 6; do
    has 'content-desc="Calendar skill"' && { found=1; break; }
    A shell input swipe $((W / 2)) $((H * 75 / 100)) $((W / 2)) $((H * 35 / 100)) 400; sleep 1
  done
  [ "$found" = 1 ] || fail "calendar: Risi skills has no Calendar switch"
  tap "Calendar skill" || fail "calendar: turn on Calendar"
  # The system's permission dialog (com.android.permissioncontroller): its Allow button by resource id.
  allow_xy() {
    dump
    python3 -I - "$WORK/ui-$DEV.xml" <<'PY'
import re, sys, xml.etree.ElementTree as ET
try:
    nodes = list(ET.parse(sys.argv[1]).iter('node'))
except ET.ParseError:
    nodes = []
for n in nodes:
    rid, t = n.get('resource-id') or '', (n.get('text') or '').lower()
    if rid.endswith('permission_allow_button') or (rid.startswith('com.android.permissioncontroller') and t == 'allow'):
        x1, y1, x2, y2 = map(int, re.findall(r'\d+', n.get('bounds'))); print((x1 + x2) // 2, (y1 + y2) // 2); break
PY
  }
  asked=0
  for _ in $(seq 1 20); do
    xy="$(allow_xy)"
    if [ -n "$xy" ]; then
      A shell input tap $xy; asked=$((asked + 1)); sleep 1.5; continue
    fi
    [ "$asked" -gt 0 ] && break
    sleep 1
  done
  [ "$asked" -gt 0 ] || { echo "    (no runtime prompt seen: granting READ/WRITE_CALENDAR with pm)"; A shell pm grant "$PKG" android.permission.READ_CALENDAR; A shell pm grant "$PKG" android.permission.WRITE_CALENDAR; }
  wait_skill "Calendar" "Ask me each time" 20 || fail "calendar: Calendar didn't turn on (Ask me each time)"
  pass "calendar: Settings → Risi skills → Calendar on (Ask me each time) after the calendar permission prompt ($asked tap(s) on Allow)"

  # -- Harsha's request in the Risi chat → one action card in one turn
  back_to_list || fail "calendar: back to the chat list (Risi chat)"
  wait_text "Risi" 30 || fail "calendar: the chat list has no Risi entry"
  tap "Risi" || fail "calendar: open the Risi chat"
  wait_for 'text="Ask Risi…"' 60 || fail "calendar: the Risi chat didn't open"
  r0="$(reqs)"
  tap "Ask Risi…" || true; sleep 0.5
  A shell input text "add%smy%sinterview%swith%sShenika%son%sMonday%s12%sOct%sat%s2pm%sto%smy%scalendar"; sleep 0.5
  tap "Send" || fail "calendar: send Harsha's request"
  wait_text "2–3 PM" 120 || fail "calendar: no action card (2–3 PM)"
  wait_text "Add" 30 || fail "calendar: the action card has no [Add]"
  has 'text="Edit"' || fail "calendar: the action card has no [Edit]"
  has 'text="Cancel"' || fail "calendar: the action card has no [Cancel]"
  has 'text="Choose calendar"' || fail "calendar: first use: the card doesn't offer 'Choose calendar'"
  [ "$(count_text "2–3 PM")" = 1 ] || fail "calendar: want exactly one action card ($(count_text "2–3 PM") cards)"
  # (The server may drop the question/confirm chips itself; the app hides them in any case.)
  has 'Confirm to add the event' && fail "calendar: a confirm-phrase chip is shown ('Confirm to add the event')"
  has 'What else is on Monday?' && fail "calendar: a question chip is shown ('What else is on Monday?')"
  # The card's top (title, date) above the fold: scroll it into view for the check and the screenshot.
  for _ in 1 2 3 4; do has 'text="Interview with Shenika"' && break; A shell input swipe $((W / 2)) $((H * 35 / 100)) $((W / 2)) $((H * 55 / 100)) 300; sleep 1; done
  has 'text="Interview with Shenika"' || fail "calendar: the action card has no title"
  has "text=\"$CAL_DATE\"" || fail "calendar: the card doesn't show the date ($CAL_DATE)"
  [ "$(count_text "Interview with Shenika")" = 1 ] || fail "calendar: want exactly one action card title"
  shot "29-calendar-action-card"
  for _ in 1 2 3; do A shell input swipe $((W / 2)) $((H * 70 / 100)) $((W / 2)) $((H * 30 / 100)) 300; sleep 0.5; done
  wait_text "Remind me 30 min before" 30 || fail "calendar: the answer's usable chip is missing"
  pass "calendar: ONE action card (Interview with Shenika · $CAL_DATE · 2–3 PM · Choose calendar · Add/Edit/Cancel); no question/confirm chips"
  # A chip only fills the composer: no request goes out, and no "I don't see any event details".
  r1="$(reqs)"
  tap "Remind me 30 min before" || fail "calendar: tap the chip"
  sleep 8
  [ "$(reqs)" = "$r1" ] || fail "calendar: tapping a chip sent a request to Risi ($(reqs) vs $r1 model calls)"
  dump; [ "$(count_text "Remind me 30 min before")" -ge 2 ] || fail "calendar: the chip didn't fill the composer"
  has "see any event details" && fail "calendar: a chip produced \"I don't see any event details\""
  pass "calendar: the chip filled the composer and sent nothing (model calls unchanged: $r1)"
  # Empty the composer again (the EditText, not the chip).
  xy="$(python3 -I - "$WORK/ui-$DEV.xml" <<'PY'
import re, sys, xml.etree.ElementTree as ET
for n in ET.parse(sys.argv[1]).iter('node'):
    if n.get('class') == 'android.widget.EditText':
        x1, y1, x2, y2 = map(int, re.findall(r'\d+', n.get('bounds'))); print((x1 + x2) // 2, (y1 + y2) // 2); break
PY
)"
  [ -n "$xy" ] && { A shell input tap $xy; sleep 0.5; A shell input keyevent KEYCODE_MOVE_END; clear_field; hide_keyboard; }

  # -- [Add] → first use: the picker (only the writable Google calendar) → the event is on the calendar
  r2="$(reqs)"
  tap "Add" || fail "calendar: tap Add"
  wait_text "Choose a calendar" 15 || fail "calendar: first use: [Add] didn't open the calendar picker"
  has "text=\"$GACC · Google\"" || fail "calendar: the picker doesn't list '$GACC · Google'"
  has 'Holidays' && fail "calendar: the picker lists the read-only Holidays calendar"
  has 'Phone · Phone only' && fail "calendar: the picker lists the local Phone calendar although a Google calendar exists"
  shot "31-calendar-picker"
  pass "calendar: the picker lists only '$GACC · Google' (read-only and local calendars excluded)"
  tap "Use this calendar" || fail "calendar: pick the calendar"
  wait_text "Added to your Google Calendar: Interview with Shenika · $CAL_DATE, 2–3 PM" 90 || fail "calendar: no 'Added to your Google Calendar: …' on the card"
  wait_text "Open" 30 || fail "calendar: the success line has no [Open]"
  wait_text "Undo" 30 || fail "calendar: the success line has no [Undo]"
  shot "30-calendar-added"
  ev="$(A shell "content query --uri content://com.android.calendar/events --projection _id:calendar_id:title:dtstart:dtend:deleted" 2>/dev/null | tr -d '\r' | grep 'title=Interview with Shenika,' | grep 'deleted=0' || true)"
  [ -n "$ev" ] || fail "calendar: no 'Interview with Shenika' event in CalendarContract"
  [ "$(printf '%s\n' "$ev" | wc -l)" = 1 ] || fail "calendar: more than one event added: $ev"
  printf '%s\n' "$ev" | grep -q "calendar_id=$GCAL," || fail "calendar: the event isn't in the Google calendar $GCAL: $ev"
  printf '%s\n' "$ev" | grep -q "dtstart=$CAL_START_MS," || fail "calendar: the event's start isn't $CAL_START: $ev"
  printf '%s\n' "$ev" | grep -q "dtend=$((CAL_START_MS + 3600000))," || fail "calendar: the event's end isn't +1 h: $ev"
  [ "$(reqs)" = "$r2" ] || fail "calendar: [Add] cost a model call ($(reqs) vs $r2): it must run the tool directly"
  turns="$(( r2 - r0 ))"
  [ "$turns" -le 2 ] || fail "calendar: the card took $turns model calls (want one turn: ≤ 2 steps)"
  pass "calendar: on the Google calendar (id $GCAL, $CAL_START, 1 h) after one card and one [Add]; model calls: $turns for the turn, 0 for [Add]"
  # -- Undo: the server's undo → calendar_remove on this phone → the event is gone
  tap "Undo" || fail "calendar: tap Undo"
  gone=""
  for _ in $(seq 1 45); do
    A shell "content query --uri content://com.android.calendar/events --projection _id:title:deleted" 2>/dev/null | tr -d '\r' | grep 'title=Interview with Shenika,' | grep -q 'deleted=0' || { gone=1; break; }
    sleep 1
  done
  [ -n "$gone" ] || fail "calendar: Undo didn't remove the event"
  has 'text="Undo"' && fail "calendar: [Undo] is still offered after the undo"
  pass "calendar: Undo removed the event (calendar_remove of this phone's own add)"
  has "see any event details" && fail "calendar: \"I don't see any event details\" appeared"
  logcat_ok "calendar"
fi

DEV=A; logcat_ok "ui entry"
DEV=B; logcat_ok "ui entry"
echo "UI ENTRY OK"
