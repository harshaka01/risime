    invite_accept "Interview" || fail "risi-calendar: A has no 'Interview' invitation with [Accept]"
    ok=""; for _ in $(seq 1 30); do
      ofx events A | grep -F 'uientry: event Interview|risi|' | grep -q '|accepted|accepted,accepted|active|' \
        && ofx events B | grep -F 'uientry: event Interview|risi|' | grep -q '|accepted|accepted,accepted|active|' && { ok=1; break; }
      sleep 2
    done
    [ -n "$ok" ] || { ofx events A | sed 's/^/    A /'; ofx events B | sed 's/^/    B /'; fail "risi-calendar: both [Accept] didn't make the event accepted in both calendars"; }
    wait_text "Accepted" 30 || fail "risi-calendar: A's invite card doesn't show 'Accepted'"
    pass "risi-calendar: both phones [Accept] the invite → accepted in both Risi Calendars"
    # The Official chat's Meeting card: the mini timeline from A's own calendar, the replayed event clashing.
    official_tab B || fail "risi-calendar: A can't open Official (event card)"
    scroll_to "Risi · Meeting" || fail "risi-calendar: no 'Risi · Meeting' card in Official"
    # (Official also holds step 15's note-meeting card: read the 'Interview' one only.)
    seen="$(card_seen "Risi · Meeting" "Interview" "Your day" "Clashes with 1 event")"
    grep -qx 'Your day' <<<"$seen" || fail "risi-calendar: the Official event card has no mini day timeline"
    grep -qx 'Clashes with 1 event' <<<"$seen" || fail "risi-calendar: the Official event card doesn't show 'Clashes with 1 event' (A's own Interview at the same time)"
    # Bring the timeline back into view for the screenshot.
    for _ in 1 2 3 4; do has 'Your day' && break; A shell input swipe $((W / 2)) $((H * 45 / 100)) $((W / 2)) $((H * 60 / 100)) 1200; sleep 1; done
    shot "event-card-official"
    pass "risi-calendar: Official 'Risi · Meeting' card with the mini timeline and 'Clashes with 1 event'"
    DEV=B; back_to_list || true; tap "Calendar" || fail "risi-calendar: B has no Calendar tab"
    wait_text "Interview" 30 || fail "risi-calendar: B's Calendar tab doesn't show 'Interview'"
    wait_text "Accepted" 15 || fail "risi-calendar: B's Calendar tab doesn't show it accepted"
    pass "risi-calendar: B's Calendar tab shows 'Interview' accepted"
    back_to_list || true; DEV=A
  fi

  # ---- 15. items ↔ My promises, tick ↔ done, the Notes list, share, delete
  if [ "$RNOTES" = 1 ]; then
    DEV=A; open_risi_chat || fail "risi-notes: A can't open its Risi chat (items)"
    scroll_until tap_near_below "$RN_TEXT" "✓" || fail "risi-notes: no ✓ on A's note item"
    wait_item "A|$RN_TEXT|confirmed|" 60 || { ofx state | sed 's/^/    /'; fail "risi-notes: ✓ didn't confirm '$RN_TEXT'"; }
    open_settings_row "My promises" || fail "risi-notes: Settings has no 'My promises'"
    wait_text "$RN_TEXT" 30 || fail "risi-notes: My promises doesn't list '$RN_TEXT'"
    has 'From note:' || fail "risi-notes: My promises has no 'From note: …' on '$RN_TEXT'"
    pass "risi-notes: A ✓ '$RN_TEXT' in the note → My promises lists it 'From note'"
    open_risi_chat || fail "risi-notes: back to A's Risi chat"
    scroll_to "Open note" || fail "risi-notes: the note card has no [Open note]"
    tap "Open note" || fail "risi-notes: tap Open note"
    wait_text "Key points" 30 || fail "risi-notes: [Open note] didn't open the note screen"
    wait_checkbox "$RN_TEXT" false 20 || fail "risi-notes: the note screen has no empty tick-box for '$RN_TEXT'"
    xy="$(checkbox_of "$RN_TEXT")"; A shell input tap ${xy% *}
    wait_item "A|$RN_TEXT|done|" 60 || { ofx state | sed 's/^/    /'; fail "risi-notes: ticking didn't make '$RN_TEXT' done"; }
    wait_checkbox "$RN_TEXT" true 30 || fail "risi-notes: the tick-box didn't stay ticked"
    shot "note-screen"
    pass "risi-notes: ticking '$RN_TEXT' on the note screen → done (server)"
    DEV=B; open_risi_chat || fail "risi-notes: B can't open its Risi chat (tick)"
    scroll_until has_checkbox "$RN_TEXT" || fail "risi-notes: no tick-box for '$RN_TEXT' on B's note card"
    wait_checkbox "$RN_TEXT" true 60 || fail "risi-notes: B's note card doesn't show '$RN_TEXT' ticked"
    pass "risi-notes: B's note card shows it ticked"
    DEV=A; open_settings_row "My promises" || fail "risi-notes: Settings → My promises (reopen)"
    found=0
    for _ in 1 2 3 4 5 6; do has 'text="Done (last 7 days)' && has 'text="Reopen"' && { found=1; break; }; A shell input swipe $((W / 2)) $((H * 70 / 100)) $((W / 2)) $((H * 40 / 100)) 300; sleep 1; done
    [ "$found" = 1 ] || fail "risi-notes: My promises has no 'Done (last 7 days)' with [Reopen]"
    # (Not behind the navigation bar: bring [Reopen] above the bottom fifth first.)
    for _ in 1 2 3 4; do ry="$(node_xy "Reopen" | awk '{print $2}')"; [ -n "$ry" ] && [ "$ry" -lt $((H * 78 / 100)) ] && break; A shell input swipe $((W / 2)) $((H * 70 / 100)) $((W / 2)) $((H * 45 / 100)) 400; sleep 1; done
    tap_near_below "$RN_TEXT" "Reopen" || tap "Reopen" || fail "risi-notes: tap Reopen"
    wait_item "A|$RN_TEXT|confirmed|" 60 || { ofx state | sed 's/^/    /'; fail "risi-notes: Reopen didn't reopen '$RN_TEXT'"; }
    open_risi_chat || fail "risi-notes: A's Risi chat (reopened)"
    scroll_until has_checkbox "$RN_TEXT" || fail "risi-notes: no tick-box for '$RN_TEXT' on A's card (reopened)"
    wait_checkbox "$RN_TEXT" false 60 || fail "risi-notes: A's note card still shows '$RN_TEXT' ticked after Reopen"
    DEV=B; open_risi_chat || fail "risi-notes: B's Risi chat (reopened)"
    scroll_until has_checkbox "$RN_TEXT" || fail "risi-notes: no tick-box for '$RN_TEXT' on B's card (reopened)"
    wait_checkbox "$RN_TEXT" false 60 || fail "risi-notes: B's note card still shows '$RN_TEXT' ticked after Reopen"
    pass "risi-notes: My promises 'Done (last 7 days)' → Reopen → unticked on both phones' note cards"
    # The Notes list: search a key-point word, share into the DM, delete (the card stays).
    DEV=A; open_risi_chat || fail "risi-notes: A's Risi chat (Notes list)"
    tap "More options" || fail "risi-notes: the Risi chat's ⋮"
    wait_text "Notes" 10 || fail "risi-notes: the Risi chat's ⋮ has no 'Notes'"
    tap_exact "Notes" || fail "risi-notes: tap Notes"
    wait_text "Risi Notes" 20 || fail "risi-notes: ⋮ → Notes didn't open 'Risi Notes'"
    type_into "Search notes" "quiet" || fail "risi-notes: no search box"
    hide_keyboard; sleep 3
    wait_text "$NOTE_A*" 20 || fail "risi-notes: searching 'quiet' doesn't find the note"
    dump
    n_rows="$(python3 -I - "$WORK/ui-A.xml" <<'PY'
import sys, xml.etree.ElementTree as ET
print(sum(1 for n in ET.parse(sys.argv[1]).iter('node') if (n.get('text') or '').endswith('· interview planning') or '· interview planning ·' in (n.get('text') or '')))
PY
)"
    [ "$n_rows" = 1 ] || fail "risi-notes: searching 'quiet' gives $n_rows rows (want 1)"
    shot "notes-list"
    pass "risi-notes: Risi chat ⋮ → Notes; search 'quiet' (a key-point word) → one row"
    tap_last_desc "More" || fail "risi-notes: the row's ⋮"
    wait_text "Share into a chat" 10 || fail "risi-notes: the row's ⋮ has no 'Share into a chat'"
    tap_exact "Share into a chat" || fail "risi-notes: tap Share into a chat"
    wait_text "It is sent as your own message." 10 || fail "risi-notes: no chat picker"
    tap "ZZ UI B" || fail "risi-notes: the picker doesn't list ZZ UI B"
    sleep 3
    tap_last_desc "More" || fail "risi-notes: the row's ⋮ (delete)"
    wait_text "Delete" 10 || fail "risi-notes: the row's ⋮ has no Delete"
    tap_exact "Delete" || fail "risi-notes: tap Delete"
    has 'text="Delete this note?"' && { tap_exact "Delete" || true; }
    wait_gone "· interview planning" 20 || fail "risi-notes: the deleted note is still in the list"
    pass "risi-notes: shared the note into a chat; deleted it from the list"
    open_risi_chat || fail "risi-notes: A's Risi chat (after delete)"
    scroll_to "$NOTE_A*" || fail "risi-notes: deleting from the list removed the card from the Risi chat"
    DEV=B; open_chat "ZZ UI A" || fail "risi-notes: B can't open the DM"
    got=""
    for t in "🔒 Private" "● Official"; do tap "$t" || true; sleep 2; wait_for "shared from Risi Notes" 30 && { got="$t"; break; }; done
    [ -n "$got" ] || fail "risi-notes: B didn't receive the shared note ('— shared from Risi Notes')"
    pass "risi-notes: the card stays in A's Risi chat; B received the shared note as an ordinary message ($got)"
    back_to_list || true; DEV=A
  fi
  if [ "$RCAL" = 1 ]; then
    # (grep -c, not -q: -q ends the pipe early and pipefail turns tail's SIGPIPE into a failure.)
    n_cal="$(tail -n +"$RMARK" "$WORK/server.log" | grep -ac '/api/v1/risi/calendar' || true)"
    [ "${n_cal:-0}" -gt 0 ] || fail "risi on: the server log shows no /risi/calendar request (the switch-off check would be blind)"
  fi
  logcat_ok "risi calendar/notes"; DEV=B; logcat_ok "risi calendar/notes"; DEV=A

  # ---- 16. switch off: no Calendar tab, no Notes, no calendar/notes calls
  echo "==> the temp server again with RISI_EVENTS/RISI_NOTES off (step 16)"
  switch_server off
  restart_apps "risi off"
  # The app starts with the switch it saw last (kept across restarts) until /auth/config answers: a first
  # calendar sync may go out and get 503, then the app re-registers without risi_events. After that settles,
  # nothing may reach /risi/calendar or /risi/notes.
  sleep 15
  early="$(tail -n +"$LOGMARK" "$WORK/server.log" | grep -acE '/api/v1/risi/(calendar|notes)' || true)"
  echo "    requests while the apps read the switch at start: ${early:-0} (answered 503)"
  LOGMARK="$(wc -l < "$WORK/server.log")"
  for DEV in A B; do
    back_to_list || fail "risi off: $DEV's chat list"
    has 'content-desc="Calendar"' && fail "risi off: $DEV still shows the Calendar tab"
  done
  DEV=A
  shot "42-risi-off-no-calendar-tab"
  open_risi_chat || fail "risi off: A can't open its Risi chat"
  tap "More options" || fail "risi off: the Risi chat's ⋮"
  sleep 2; dump
  [ "$(count_text "Notes")" = 0 ] || fail "risi off: the Risi chat's ⋮ still has 'Notes'"
  A shell input keyevent KEYCODE_BACK; sleep 1
  back_to_list || true
  calls="$(tail -n +"$LOGMARK" "$WORK/server.log" | grep -acE '/api/v1/risi/(calendar|notes)' || true)"
  [ "${calls:-0}" = 0 ] || { tail -n +"$LOGMARK" "$WORK/server.log" | grep -aE '/api/v1/risi/(calendar|notes)' | head -3 | sed 's/^/    /'; fail "risi off: $calls /risi/calendar or /risi/notes requests after the switch off"; }
  adv="$(ofx advertised)"
  [ "$adv" = "uientry: advertised=0" ] || fail "risi off: devices still advertise risi_events/risi_notes after the switch off ($adv)"
  pass "risi off: no Calendar tab on either phone, no 'Notes' in the Risi chat's ⋮, no /risi/calendar|notes request, no device advertises risi_events/risi_notes"
fi

# nightly.48 (n48f, n48g) died silently between step 16 and "UI ENTRY OK" with "adb: error: more than one device with
# serial " (an empty serial): trace the rest of the run to $LOGS/tail-trace.log.
exec {XT}>>"$LOGS/tail-trace.log"; BASH_XTRACEFD=$XT; set -x
# ---------------------------------------------------------------- 17. (--google) the Google Calendar link (contract v1.31 §31)
# Gate items 1-9 of §31.12 with scripts/fake-gcal (Google's Calendar API on 127.0.0.1:$GP) and the debug seam
# `lk.codegen.risime.debug.GCAL_TEST` (a fake authorizer + the base URL: Redroid has no Play services).
# Devices: A (= "A1", the Google device), C (= "A2", A's second device, signed in with A's phone number), B is only the
# DM peer. UI texts are the ones of §31.2/§31.8/§31.9 and the android brief (docs/status/briefs/v1.31-android.md);
# the strings marked TODO(android) are not fixed by the brief: check docs/status/android.md ("v1.31 UI strings").
if [ "$GCAL" = 1 ] && { [ "$ONLY" = 00000 ] || [ "${UITEST_RISI_ONLY:-0}" = 1 ]; }; then
  DEV=A; screen_wh
  GACC="a@test"; GTOK="uitest-gcal-$(head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  GREC="$WORK/gcal.jsonl"; GCANARY="CANARY-GTITLE"; : > "$GREC"
  # TODO(android): the picker's confirm button (the brief doesn't fix it); the first of these that exists is tapped.
  GPICK_OK="${UITEST_GCAL_PICK_OK:-Save}"
  # TODO(android): the Disconnect sheet's confirm button (the sheet is titled "Disconnect Google Calendar?").
  GDISC_OK="${UITEST_GCAL_DISCONNECT_OK:-Disconnect}"

  # ---- helpers
  cat > "$WORK/gtext.py" <<'PY'
import re, sys, xml.etree.ElementTree as ET
# gtext.py XML after "<question>"   -> the texts of every node below the (last) node whose text is the question
# gtext.py XML count "<needle>"     -> how many nodes' text contain the needle
# gtext.py XML rows                 -> "x y text" of every EditText whose text is HH:MM
try:
    nodes = list(ET.parse(sys.argv[1]).iter('node'))
except ET.ParseError:
    nodes = []
def box(n): return list(map(int, re.findall(r'\d+', n.get('bounds'))))
def cy(n): b = box(n); return (b[1] + b[3]) // 2
mode = sys.argv[2]
if mode == 'after':
    qs = [cy(n) for n in nodes if (n.get('text') or '') == sys.argv[3]]
    if qs:
        qy = max(qs)
        print(' ¶ '.join((n.get('text') or '').replace('\n', ' ') for n in sorted((n for n in nodes if n.get('text') and cy(n) > qy), key=cy)))
elif mode == 'count':
    print(sum(1 for n in nodes if sys.argv[3] in (n.get('text') or '')))
elif mode == 'rows':
    for n in nodes:
        t = n.get('text') or ''
        if n.get('class') == 'android.widget.EditText' and re.fullmatch(r'\d\d:\d\d', t):
            b = box(n); print((b[0] + b[2]) // 2, (b[1] + b[3]) // 2, t)
PY
  gstore() { curl -sf "http://127.0.0.1:$GP/_events"; }
  gctl() { curl -sf -X POST "http://127.0.0.1:$GP/_control" -d "$1" >/dev/null; }
  gapi() { curl -sf -X "$1" "http://127.0.0.1:$GP$2" -H "Authorization: Bearer $GTOK" -H 'Content-Type: application/json' -d "$3"; }
  # "id|summary|calendar|start|risime|has_attendees|status" for every RisiMe copy (id risi + 32 hex digits).
  gcopies() {
    gstore | python3 -I -c '
import json, re, sys
for e in json.load(sys.stdin)["events"]:
    if re.fullmatch(r"risi[0-9a-f]{32}", e["id"]):
        p = (e.get("extendedProperties") or {}).get("private") or {}
        print("|".join([e["id"], e.get("summary", ""), e["calendarId"], (e.get("start") or {}).get("dateTime", ""), p.get("risime", ""), str("attendees" in e).lower(), e["status"]]))'
  }
  gn_copies() { gcopies | grep -c '|confirmed$' || true; }
  # "METHOD path status sendUpdates" of every logged call, from the fake's request log.
  greq() {
    curl -sf "http://127.0.0.1:$GP/_requests" | python3 -I -c '
import json, sys
for r in json.load(sys.stdin):
    print(r["method"], r["path"], r["status"], "sendUpdates=" + ",".join(r["query"].get("sendUpdates", [])))'
  }
  greq_has() { greq | grep -q -- "$1"; }
  gwait() { local n=$1; shift; for _ in $(seq 1 "$n"); do "$@" >/dev/null 2>&1 && return 0; sleep 1; done; return 1; }
  gcopies_eq() { [ "$(gn_copies)" = "$1" ]; }
  seam() {  # $1 = connected | reauth_needed | none, on DEV (debug broadcast, protected by android.permission.DUMP)
    A shell am broadcast -a lk.codegen.risime.debug.GCAL_TEST -p "$PKG" --es base_url "http://127.0.0.1:$GP/" \
      --es access_token "$GTOK" --es account "$GACC" --es state "$1" >/dev/null
  }
  gsee() {  # the answer to the question $1 (on DEV), as the texts below that question: sets ANS
    ANS=""
    for _ in $(seq 1 "${2:-60}"); do
      dump; ANS="$(python3 -I "$WORK/gtext.py" "$WORK/ui-$DEV.xml" after "$1")"
      case "$ANS" in *"Checked:"*) return 0;; esac
      sleep 2
    done
    return 1
  }
  gask() {  # $1 = a UNIQUE question (typed in the Risi chat on DEV), $2 = wait seconds → ANS (has the "Checked:" line)
    open_risi_chat || fail "google: $DEV can't open its Risi chat"
    tap "Ask Risi…" || true; sleep 0.5
    A shell input text "$(printf '%s' "$1" | sed 's/ /%s/g')"; sleep 0.5
    tap "Send" || fail "google: $DEV: send '$1'"
    gsee "$1" "${2:-60}" || fail "google: $DEV: no answer with a 'Checked:' line to '$1' (got: ${ANS:-nothing})"
    echo "    [$DEV] answer: $ANS"
  }
  tap_last_text() {  # the lowest node with the exact text $1 (a sheet's confirm button under a same-named row)
    local xy; dump
    xy="$(python3 -I - "$WORK/ui-$DEV.xml" "$1" <<'PY'
import re, sys, xml.etree.ElementTree as ET
try: nodes = list(ET.parse(sys.argv[1]).iter('node'))
except ET.ParseError: nodes = []
hits = []
for n in nodes:
    if (n.get('text') or '') == sys.argv[2]:
        b = list(map(int, re.findall(r'\d+', n.get('bounds')))); hits.append(((b[1] + b[3]) // 2, (b[0] + b[2]) // 2))
if hits: y, x = max(hits); print(x, y)
PY
)"
    [ -n "$xy" ] || { echo "    [$DEV] no text node: $1"; return 1; }
    A shell input tap $xy
  }
  # Settings → Risi skills → Calendar → the "Google Calendar" section (§31.2), left on screen. TODO(android): the
  # section may sit on the Calendar card or behind [Details]; both are tried.
  gsec_any() { has 'text="Connect Google Calendar"' || has 'text="Reconnect Google Calendar"' || has 'Connected on ' || has 'Needs reconnecting' || has 'Paused: turn on the Calendar skill'; }
  gsec_open() {
    settings_open "Risi skills" || return 1
    reveal "Calendar skill" || return 1
    local i
    for i in 1 2 3 4 5 6; do gsec_any && return 0; A shell input swipe $((W / 2)) $((H * 70 / 100)) $((W / 2)) $((H * 45 / 100)) 700; sleep 1; done
    reveal "Calendar skill" || true
    tap_below "Calendar" "Details" || true; sleep 2
    for i in 1 2 3 4 5 6; do gsec_any && return 0; A shell input swipe $((W / 2)) $((H * 70 / 100)) $((W / 2)) $((H * 45 / 100)) 700; sleep 1; done
    return 1
  }
  gsec_wait() {  # $1 text fragment of the section, $2 s
    for _ in $(seq 1 "${2:-30}"); do has "$1" && return 0; sleep 1; done
    echo "    [$DEV] the Google Calendar section never showed: $1"; return 1
  }
  gevents_n() { ofx events A | grep -cF 'uientry: event Interview with Shenika|' || true; }
  gapps_restart() {
    local d
    for d in A C; do DEV=$d; A shell am force-stop "$PKG"; A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null 2>&1 || true; done
    for d in A C; do DEV=$d; wait_list 60 || fail "google: $d's app didn't come back to its chat list ($1)"; dismiss_prompts; done
    DEV=A
  }
  gswitch() {  # $1 = events (RISI_EVENTS, no Google) | gcal (RISI_EVENTS + RISI_GCAL)
    stop_server || fail "google: couldn't stop the temp server"
    printf 'RISI_EVENTS=on\nRISI_LEDGER=on\nRISI_TOOLS=on\nRISI_SKILLS=on\n' > "$WORK/phase.env"
    [ "$1" = gcal ] && echo 'RISI_GCAL=on' >> "$WORK/phase.env"
    start_server
    local cfg; cfg="$(curl -sf "http://127.0.0.1:$PORT/api/v1/auth/config" || true)"
    printf '%s' "$cfg" | grep -q '"risi_events":"on"' || fail "google: /auth/config doesn't say risi_events: on ($cfg)"
    if [ "$1" = gcal ]; then printf '%s' "$cfg" | grep -q '"google_calendar":"on"' || fail "google: /auth/config doesn't say google_calendar: on with RISI_GCAL=on ($cfg)"
    else printf '%s' "$cfg" | grep -q 'google_calendar' && fail "google: /auth/config has google_calendar while RISI_GCAL is unset ($cfg)"; fi
    return 0
  }

  # ---- dates (A's zone on the server): next Monday 14:00-15:00 (the busy Google event) and the Tuesday after
  stz="$(ofx tz | sed -n 's/^uientry: tz=//p')"; [ -n "$stz" ] || fail "google: fixture: A's zone"
  read -r GC_MON GC_TUE GMON_S GMON_E <<<"$(python3 -I - "$stz" <<'PY'
import sys, datetime as dt
from zoneinfo import ZoneInfo
z = ZoneInfo(sys.argv[1]); now = dt.datetime.now(z)
d = now.date() + dt.timedelta(days=(7 - now.weekday()) % 7 or 7)
s = dt.datetime(d.year, d.month, d.day, 14, 0, tzinfo=z)
print(d.isoformat(), (d + dt.timedelta(days=1)).isoformat(), s.isoformat(), (s + dt.timedelta(hours=1)).isoformat())
PY
)"
  export GC_MON GC_TUE GCAL_LIVE=1
  conv="$(fx conv | sed -n 's/^uientry: conv=//p')"
  write_script "2099-01-01T00:00:00.000Z" "${conv:-dm:none}"; start_llm

  # ---- fake-gcal: Work (primary, owner), Personal (owner), Holidays (reader, hidden); loopback; token for this run
  cat > "$WORK/gcal-seed.json" <<'JSON'
{"accounts": [{"email": "a@test", "calendars": [
  {"id": "work", "summary": "Work", "primary": true, "accessRole": "owner", "selected": true},
  {"id": "personal", "summary": "Personal", "accessRole": "owner", "selected": true},
  {"id": "holidays", "summary": "Holidays", "accessRole": "reader", "selected": false, "hidden": true}]}]}
JSON
  ss -ltnH "sport = :$GP" | grep -q . && { echo "fake-gcal port $GP busy (another ui-entry-test?): set UITEST_GCAL_PORT"; exit 1; }
  tmux kill-session -t "risime-uientry-gcal$SUF" 2>/dev/null || true
  tmux new -d -s "risime-uientry-gcal$SUF" "python3 -I '$REPO/scripts/fake-gcal' --port $GP --token '$GTOK' --record '$GREC' --seed '$WORK/gcal-seed.json' >> '$WORK/fake-gcal.out' 2>&1"
  for _ in $(seq 1 20); do curl -sf -o /dev/null "http://127.0.0.1:$GP/health" && break; sleep 0.5; done
  curl -sf -o /dev/null "http://127.0.0.1:$GP/health" || { echo "fake-gcal didn't start"; tail -5 "$WORK/fake-gcal.out"; exit 1; }
  for DEV in A C; do A reverse "tcp:$GP" "tcp:$GP" >/dev/null; done
  DEV=C; sign_in "+94770000981" "uientry81@example.com" || fail "google: A's second device (A2) couldn't sign in"
  DEV=A
  pass "google: fake-gcal on 127.0.0.1:$GP (Work, Personal, Holidays); A's second device (A2) signed in as A"

  # ---- 1. switch off: RISI_EVENTS on, RISI_GCAL unset → no Google section, the v1.30 "Checked:" line
  echo "==> the temp server with RISI_EVENTS=on and no RISI_GCAL (gate item 1)"
  gswitch events
  gapps_restart "gcal off"
  for DEV in A C; do wait_for 'content-desc="Calendar"' 60 || fail "google: $DEV's chat list has no Calendar tab"; done
  DEV=A
  cu=""; for _ in $(seq 1 30); do cu="$(ofx caluser)"; [ "$cu" = "uientry: caluser=true true" ] && break; sleep 2; done
  [ "$cu" = "uientry: caluser=true true" ] || fail "google: A and B aren't calendar users: $cu"
  settings_open "Risi skills" || fail "google: Settings → Risi skills (switch off)"
  reveal "Calendar skill" || fail "google: Risi skills has no Calendar"
  for _ in 1 2 3 4; do A shell input swipe $((W / 2)) $((H * 70 / 100)) $((W / 2)) $((H * 45 / 100)) 700; sleep 1; done
  dump
  has 'text="Connect Google Calendar"' && fail "google: the switch is off but Settings shows [Connect Google Calendar]"
  has 'text="Google Calendar"' && fail "google: the switch is off but Settings has a 'Google Calendar' section"
  pass "google: switch off (RISI_GCAL unset): /auth/config has no google_calendar and Settings → Risi skills → Calendar has no Google Calendar section"
  DEV=C; gask "Am I free Monday 2pm round one" 90
  case "$ANS" in *"Google Calendar (not connected)"*) ;; *) fail "google: switch off: the answer lacks 'Google Calendar (not connected)' (the v1.30 line): $ANS";; esac
  case "$ANS" in *"Google Calendar (2 calendar"*) fail "google: switch off: the answer names a connected Google Calendar: $ANS";; esac
  pass "google: switch off: 'Am I free Monday 2pm' → the v1.30 line ('Not checked: … Google Calendar (not connected)')"

  # ---- 2. switch on; connect on A1 through the seam; the picker; Work + Personal read, Work write
  echo "==> the temp server with RISI_EVENTS=on RISI_GCAL=on (gate item 2)"
  gswitch gcal
  gapps_restart "gcal on"
  DEV=A; seam connected
  gsec_open || fail "google: Settings → Risi skills → Calendar has no Google Calendar section (switch on)"
  has 'text="Connect Google Calendar"' || fail "google: the section has no [Connect Google Calendar]"
  has "Your Google sign-in stays on this phone" || fail "google: the section lacks the info line (§31.9)"
  shot "gcal-section-not-connected"
  tap "Connect Google Calendar" || fail "google: tap [Connect Google Calendar]"
  wait_for "Check for busy times" 60 || fail "google: no picker ('Check for busy times') after [Connect Google Calendar] (debug seam installed? $GACC/$GTOK)"
  has "Add my Risi events to" || fail "google: the picker lacks 'Add my Risi events to'"
  has "Copy my Risi Calendar events to Google" || fail "google: the picker lacks the copy switch"
  for c in Work Personal Holidays; do has "text=\"$c\"" || fail "google: the picker doesn't list the fake calendar '$c'"; done
  [ "$(checkbox_of Work | awk '{print $3}')" = true ] || fail "google: picker: Work isn't ticked by default (primary)"
  [ "$(checkbox_of Personal | awk '{print $3}')" = true ] || fail "google: picker: Personal isn't ticked by default (selected in Google)"
  [ "$(checkbox_of Holidays | awk '{print $3}')" = false ] || fail "google: picker: the hidden Holidays calendar is ticked"
  shot "gcal-picker"
  ok=""; for b in "$GPICK_OK" Save Done Connect Continue OK; do tap_exact "$b" && { ok="$b"; break; }; done
  [ -n "$ok" ] || fail "google: the picker has no confirm button (TODO(android): set UITEST_GCAL_PICK_OK)"
  gsec_wait "Connected on this phone" 90 || fail "google: after the picker the section isn't 'Connected on this phone'"
  gsec_wait "Checking 2 calendars" 20 || fail "google: the section lacks 'Checking 2 calendars'"
  gsec_wait "Adding events to Work" 20 || fail "google: the section lacks 'Adding events to Work'"
  shot "gcal-section-connected"
  link="$(ofx gcal_link)"
  case "$link" in "uientry: gcal_link=connected 2 true true "*) ;; *) fail "google: GET /risi/calendar/google: want 'connected 2 true true <device>', got: $link";; esac
  pass "google: seam → picker (Work+Personal read, Holidays off, write to Work) → connected on A1: server row '${link#uientry: gcal_link=}'"

  # ---- 3. a Google busy event Mon 14:00; "Am I free Monday 2pm" on A2 (not the Google device)
  gapi POST "/calendars/work/events?sendUpdates=none" "{\"id\":\"seedmon0001\",\"summary\":\"$GCANARY\",\"start\":{\"dateTime\":\"$GMON_S\"},\"end\":{\"dateTime\":\"$GMON_E\"}}" >/dev/null \
    || fail "google: couldn't seed the Google busy event"
  DEV=C; gask "Am I free Monday 2pm round two" 120
  case "$ANS" in *"1 busy time"*) ;; *) fail "google: A2: the answer doesn't say '1 busy time' (the Google event): $ANS";; esac
  case "$ANS" in *"Checked: Risi Calendar · Google Calendar (2 calendars)"*) ;; *) fail "google: A2: the Checked line isn't 'Checked: Risi Calendar · Google Calendar (2 calendars)': $ANS";; esac
  case "$ANS" in *"$GCANARY"*) fail "google: A2 shows the Google event title";; esac
  shot "gcal-checked-a2"
  DEV=A; open_risi_chat || fail "google: A1 can't open its Risi chat"
  scroll_until has "Google Calendar (Work, Personal)" || fail "google: A1: the same answer doesn't read 'Google Calendar (Work, Personal)' (names on the Google phone only)"
  shot "gcal-checked-a1"
  pass "google: 'Am I free Monday 2pm' on A2: not free (1 busy time), 'Checked: Risi Calendar · Google Calendar (2 calendars)'; on A1 the line reads '(Work, Personal)'"

  # ---- 4. the Google device doesn't answer: its app is stopped (no FCM here) → "phone didn't answer", never free
  DEV=A; A shell am force-stop "$PKG"
  DEV=C; gask "Am I free Monday at 2pm round three" 120
  case "$ANS" in *"Google Calendar (phone didn't answer)"*) ;; *) fail "google: A1 stopped: the answer lacks 'Google Calendar (phone didn't answer)': $ANS";; esac
  case "$ANS" in *"couldn't check Google Calendar"*) ;; *) fail "google: A1 stopped: no 'couldn't check Google Calendar' rewrite: $ANS";; esac
  case "$ANS" in *"You're free on Monday"*) fail "google: A1 stopped: the answer says free: $ANS";; esac
  shot "gcal-not-answered"
  DEV=A; A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null 2>&1 || true; wait_list 60 || fail "google: A1's app didn't come back"; dismiss_prompts
  pass "google: A1's app stopped → 'Not checked: Google Calendar (phone didn't answer)', never 'free'"

  # ---- 5. [Add] the Shenika-style interview on A1 → one copy in Work (a first insert that fails with 500 is retried)
  DEV=A; n_ev0="$(gevents_n)"
  gctl '{"mode":"error500"}'
  open_risi_chat || fail "google: A1 can't open its Risi chat (add)"
  tap "Ask Risi…" || true; sleep 0.5
  A shell input text "add%smy%sinterview%swith%sShenika%son%sTuesday%sat%s10am%sto%smy%scalendar"; sleep 0.5
  tap "Send" || fail "google: send the interview request"
  wait_text "Risi · Add to Risi Calendar" 120 || fail "google: no 'Risi · Add to Risi Calendar' card"
  tap_below "Risi · Add to Risi Calendar" "Add" || fail "google: tap [Add]"
  for _ in $(seq 1 60); do [ "$(gevents_n)" -gt "$n_ev0" ] && break; sleep 1; done
  ev="$(ofx events A | grep -F 'uientry: event Interview with Shenika|' | tail -1)"; [ -n "$ev" ] || fail "google: the interview isn't in A's Risi Calendar"
  EV_ID="$(printf '%s' "$ev" | awk -F'|' '{print $7}')"; GID="risi$(printf '%s' "$EV_ID" | tr -d '-' | tr 'A-F' 'a-f')"
  gwait 150 greq_has '^POST /calendars/work/events 500' || fail "google: no insert reached fake-gcal (the copy job never ran; error500 mode)"
  gctl '{"mode":"ok"}'
  gwait 240 gcopies_eq 1 || { gcopies | sed 's/^/    /'; greq | tail -8 | sed 's/^/    /'; fail "google: no copy in the write calendar after the failed insert was retried (WorkManager backoff)"; }
  cp="$(gcopies | grep '|confirmed$')"
  [ "$(printf '%s' "$cp" | wc -l)" = 0 ] || fail "google: more than one copy after the retry: $cp"
  IFS='|' read -r c_id c_sum c_cal c_start c_tag c_att c_st <<<"$cp"
  [ "$c_id" = "$GID" ] || fail "google: the copy id is $c_id, want risi + the event id's hex ($GID)"
  [ "$c_cal" = work ] || fail "google: the copy is in '$c_cal', want the write calendar 'work'"
  [ "$c_tag" = 1 ] || fail "google: the copy lacks the private property risime=1"
  [ "$c_att" = false ] || fail "google: the copy has attendees"
  case "$c_sum" in "Interview with Shenika") ;; *) fail "google: the copy's summary is '$c_sum'";; esac
  greq | grep -F "POST /calendars/work/events 200 " | grep -qF "sendUpdates=none" || fail "google: the insert wasn't sent with sendUpdates=none: $(greq | grep -F 'POST /calendars/work/events')"
  greq | grep -F "POST /calendars/work/events" | grep -v 'sendUpdates=none' | grep -q . && fail "google: an insert without sendUpdates=none" || true
  pass "google: [Add] → ONE copy $c_id in Work (risime=1, no attendees, sendUpdates=none); a first insert that failed with 500 was retried without a duplicate"

  # ---- 6. loop guard: with the copy in Google, "am I free Tuesday" counts the event once (the copy is skipped)
  DEV=C; gask "Am I free Tuesday 10am round four" 120
  case "$ANS" in *"1 busy time"*) ;; *) fail "google: loop guard: want '1 busy time' (the Risi event once, the Google copy skipped): $ANS";; esac
  case "$ANS" in *"2 busy"*) fail "google: loop guard: the event is counted twice: $ANS";; esac
  pass "google: loop guard: with the copy in Google, 'Am I free Tuesday 10am' counts ONE busy time"

  # ---- 5b. move it in RisiMe (Calendar tab → the event → Edit → a new start) → PATCH
  DEV=A; back_to_list || fail "google: A1 chat list (edit)"
  tap "Calendar" || fail "google: A1 has no Calendar tab"
  wait_text "Agenda" 20 || fail "google: the Calendar tab has no Agenda"
  gopen_event() {
    for _ in $(seq 1 12); do
      xy="$(node_xy "Interview with Shenika")"; [ -n "$xy" ] && { A shell input tap $xy; return 0; }
      A shell input swipe $((W / 2)) $((H * 70 / 100)) $((W / 2)) $((H * 40 / 100)) 600; sleep 1
    done
    return 1
  }
  gopen_event || fail "google: the Agenda doesn't list 'Interview with Shenika'"
  wait_for 'text="Edit"' 15 || fail "google: the event detail has no Edit"
  tap_exact "Edit" || fail "google: tap Edit"
  wait_for "Edit event" 15 || fail "google: no 'Edit event' dialog"
  dump; row="$(python3 -I "$WORK/gtext.py" "$WORK/ui-A.xml" rows | head -1)"
  [ -n "$row" ] || fail "google: the edit dialog has no HH:MM start field"
  read -r rx ry old_hm <<<"$row"; new_hm="$(printf '%02d:%s' $(( (10#${old_hm%%:*} + 1) % 24 )) "${old_hm##*:}")"
  A shell input tap "$rx" "$ry"; sleep 0.5; clear_field; A shell input text "$new_hm"; hide_keyboard
  tap_exact "Save" || fail "google: tap Save in the edit dialog"
  gwait 180 greq_has '^PATCH ' || fail "google: moving the event in RisiMe sent no PATCH to Google"
  gcopies | grep -F "|work|" | grep -qF "T${new_hm}:" || { gcopies | sed 's/^/    /'; fail "google: the copy didn't move to $new_hm"; }
  greq | grep '^PATCH' | grep -qF 'sendUpdates=none' || fail "google: the PATCH wasn't sent with sendUpdates=none"
  [ "$(gn_copies)" = 1 ] || fail "google: the move made a second copy"
  pass "google: moved the event in RisiMe ($old_hm → $new_hm) → PATCH (sendUpdates=none), still one copy"

  # ---- 5c. delete it in RisiMe → DELETE
  gopen_event || fail "google: the Agenda lost 'Interview with Shenika'"
  wait_for 'text="Delete"' 15 || fail "google: the event detail has no Delete"
  tap_exact "Delete" || fail "google: tap Delete"
  wait_for "Delete event" 15 || fail "google: no 'Delete event?' confirm"
  tap_last_text "Delete" || fail "google: confirm Delete"
  gwait 180 gcopies_eq 0 || { gcopies | sed 's/^/    /'; fail "google: deleting the event in RisiMe didn't delete the copy"; }
  greq | grep -q '^DELETE' || fail "google: no DELETE reached Google"
  pass "google: deleted the event in RisiMe → DELETE → no copy left in Google"
  back_to_list || true

  # ---- 5d. add it again (a new copy for the disconnect step)
  DEV=A; n_ev0="$(gevents_n)"
  open_risi_chat || fail "google: A1 can't open its Risi chat (re-add)"
  tap "Ask Risi…" || true; sleep 0.5
  A shell input text "add%smy%sinterview%swith%sShenika%sagain%son%sTuesday%sat%s10am%sto%smy%scalendar"; sleep 0.5
  tap "Send" || fail "google: send the second interview request"
  wait_text "Risi · Add to Risi Calendar" 120 || fail "google: no second 'Risi · Add to Risi Calendar' card"
  tap_below "Risi · Add to Risi Calendar" "Add" || fail "google: tap [Add] (second)"
  gwait 240 gcopies_eq 1 || fail "google: the second event wasn't copied"

  # ---- 7. revoked: "needs reconnecting", ONE google_reconnect card, the section shows [Reconnect], Reconnect works
  gctl '{"mode":"revoked"}'
  DEV=C; gask "Am I free Monday 2pm round five" 150
  case "$ANS" in *"Google Calendar (needs reconnecting)"*) ;; *) fail "google: revoked: the answer lacks 'Google Calendar (needs reconnecting)': $ANS";; esac
  for _ in $(seq 1 60); do case "$(ofx gcal_link)" in "uientry: gcal_link=reauth_needed "*) break;; esac; sleep 1; done
  case "$(ofx gcal_link)" in "uientry: gcal_link=reauth_needed "*) ;; *) fail "google: revoked: the link isn't reauth_needed: $(ofx gcal_link)";; esac
  DEV=C; wait_for "Google Calendar needs reconnecting" 90 || fail "google: revoked: no google_reconnect card in the Risi chat"
  shot "gcal-reconnect-card"
  DEV=C; gask "Am I free Monday 2pm round six" 90
  DEV=A; open_risi_chat || fail "google: A1 Risi chat (reconnect card)"
  scroll_to "Google Calendar needs reconnecting*" || fail "google: A1: no reconnect card"
  [ "$(python3 -I "$WORK/gtext.py" "$WORK/ui-A.xml" count "Google Calendar needs reconnecting")" = 1 ] || fail "google: more than one google_reconnect card after two reads (once per 24 h)"
  gsec_open || fail "google: A1: the section after revoke"
  has 'text="Reconnect Google Calendar"' || fail "google: revoked: the section has no [Reconnect Google Calendar]"
  gctl '{"mode":"ok"}'; seam connected
  tap "Reconnect Google Calendar" || fail "google: tap [Reconnect Google Calendar]"
  gsec_wait "Connected on this phone" 90 || fail "google: after Reconnect the section isn't 'Connected on this phone'"
  DEV=C; gask "Am I free Monday 2pm round seven" 120
  case "$ANS" in *"Google Calendar (2 calendars)"*) ;; *) fail "google: after Reconnect the answer doesn't read Google Calendar (2 calendars): $ANS";; esac
  pass "google: revoked → 'Google Calendar (needs reconnecting)', ONE google_reconnect card, the section shows [Reconnect]; after Reconnect reads work again"

  # ---- 8. Disconnect on A2 with [Remove them from Google]
  DEV=C; gsec_open || fail "google: A2: Settings → Risi skills → Calendar → Google Calendar section"
  has 'Connected on ' || fail "google: A2: the section doesn't say 'Connected on <device>'"
  has "Connected on this phone" && fail "google: A2's section says 'Connected on this phone' (A1 is the Google device)"
  tap "Disconnect" || fail "google: A2: tap [Disconnect]"
  wait_for "Disconnect Google Calendar?" 15 || fail "google: A2: no 'Disconnect Google Calendar?' sheet"
  tap_exact "Remove them from Google" || fail "google: A2: the sheet has no 'Remove them from Google'"
  tap_last_text "$GDISC_OK" || fail "google: A2: the Disconnect sheet's confirm button (TODO(android): UITEST_GCAL_DISCONNECT_OK)"
  for _ in $(seq 1 60); do [ "$(ofx gcal_link)" = "uientry: gcal_link=none" ] && break; sleep 1; done
  [ "$(ofx gcal_link)" = "uientry: gcal_link=none" ] || fail "google: after Disconnect the link isn't gone: $(ofx gcal_link)"
  gwait 180 gcopies_eq 0 || { gcopies | sed 's/^/    /'; fail "google: A1 didn't delete the copies after 'Remove them from Google'"; }
  DEV=A; gsec_open || fail "google: A1: the section after Disconnect"
  gsec_wait 'text="Connect Google Calendar"' 60 || fail "google: A1's section isn't 'Not connected' after the other device disconnected"
  pass "google: Disconnect on A2 with 'Remove them from Google' → copies gone from Google, link none, A1's section is Not connected"
  # TODO(android): the local gcal_* tables are empty after Disconnect (Room is encrypted: android's unit tests cover it).

  # ---- 9. canaries (§31.10): the Google event title, the token and the account in no log, dump or model request
  for d in A C; do
    DEV=$d; out="$(A logcat -d 2>/dev/null || true)"
    for n in "$GCANARY" "$GTOK" "$GACC"; do printf '%s' "$out" | grep -qF -- "$n" && fail "google: canary '${n:0:8}…' is in $d's logcat"; done
  done
  for f in "$WORK/server.log" "$WORK/llm-requests.jsonl"; do
    for n in "$GCANARY" "$GTOK" "$GACC"; do grep -aqF -- "$n" "$f" && fail "google: canary '${n:0:8}…' is in $(basename "$f")"; done
  done
  grep -aq '"Work"\|"Personal"' "$WORK/llm-requests.jsonl" && fail "google: a Google calendar name is in the model requests"
  grep -aq 'Work\b' "$WORK/server.log" && grep -aE '\b(Work|Personal)\b' "$WORK/server.log" | grep -aiq 'calendar' && fail "google: a Google calendar name is in the server log"
  scan="$(ofx pgscan '*' "$GCANARY" "$GTOK" "$GACC")"
  printf '%s' "$scan" | grep -q 'pgscan done' || fail "google: the Postgres canary scan didn't finish"
  printf '%s' "$scan" | grep -q 'canary' && { printf '%s\n' "$scan" | sed 's/^/    /'; fail "google: a canary is in a Postgres table"; }
  scan="$(ofx pgscan risi_gcal_links,risi_turn_steps Work Personal)"
  printf '%s' "$scan" | grep -q 'pgscan done' || fail "google: the Postgres name scan didn't finish"
  printf '%s' "$scan" | grep -q 'canary' && { printf '%s\n' "$scan" | sed 's/^/    /'; fail "google: a Google calendar name is in risi_gcal_links / risi_turn_steps"; }
  # TODO(root): the Cassandra dump (inbox_events) and the release-dex check (GCAL_TEST absent from the release APK,
  # android's Gradle check) are not covered here: the first needs the cql dump helper, the second a release build.
  pass "google: canaries (event title, token, account, calendar names) are in no logcat, server log, model request or Postgres row"
  DEV=A; logcat_ok "google"; DEV=C; logcat_ok "google"; DEV=A
fi

# ---------------------------------------------------------------- 18. UI batch 2026-10-10 (--ui-batch; v1.32), font scale 1.0 and 1.3
# Layout checks read the node bounds of `uiautomator dump` (taps stay by visible text / content description only).
# TODO(root): brief item 7 (Calendar Details "Sync is off for <account>" + "Open sync settings" + "Refresh") is not here: it
# needs a calendar account with calendar sync OFF and the Details screen (--calendar's step 12 fixtures seed a Google-type
# calendar through `content insert` with no registered Account, so the sync flag the app reads is the provider's default and
# not under this test's control; `ContentResolver.setSyncAutomatically` needs a real AccountManager account, which redroid
# has none of). Covered by the android Robolectric tests (CalendarBackend fake) until redroid can add an account.
uib_py() {  # $1 = check name, rest = args; reads $WORK/ui-$DEV.xml; prints the problem and exits 1
  python3 -I - "$WORK/ui-$DEV.xml" "$@" <<'PY'
import re, sys, xml.etree.ElementTree as ET
xml_path, check, args = sys.argv[1], sys.argv[2], sys.argv[3:]
try:
    nodes = list(ET.parse(xml_path).iter('node'))
except ET.ParseError:
    print("unreadable dump"); sys.exit(1)
def box(n): return list(map(int, re.findall(r'-?\d+', n.get('bounds'))))
def txt(n): return n.get('text') or ''
def desc(n): return n.get('content-desc') or ''
def h(n): b = box(n); return b[3] - b[1]
def bad(msg): print(msg); sys.exit(1)
if check == 'list':   # short_name long_prefix preview scale
    short, longp, preview, scale = args[0], args[1], args[2], float(args[3])
    if any('last seen' in (txt(n) + desc(n)).lower() for n in nodes): bad("the chat list shows 'last seen'")
    names = [n for n in nodes if txt(n) == short or txt(n).startswith(longp) or txt(n) == 'Risi']
    if len(names) < 2: bad("fewer than two name nodes to compare: %s" % [txt(n) for n in names])
    ref = min(h(n) for n in names)
    for n in names:
        if h(n) > ref * 1.4: bad("name %r is %d px high, a single line is %d: it wraps" % (txt(n), h(n), ref))
    # The short name's row: the smallest clickable node around it holds exactly two text lines (name+time, preview).
    nm = next(n for n in nodes if txt(n) == short)
    nb = box(nm)
    rows = [n for n in nodes if n.get('clickable') == 'true' and box(n)[0] <= nb[0] and box(n)[1] <= nb[1] and box(n)[2] >= nb[2] and box(n)[3] >= nb[3]]
    if not rows: bad("no clickable row around %r" % short)
    row = min(rows, key=lambda n: (box(n)[2] - box(n)[0]) * (box(n)[3] - box(n)[1])); rb = box(row)
    inside = [n for n in nodes if (txt(n) or desc(n)) and box(n)[0] >= rb[0] and box(n)[2] <= rb[2] and box(n)[1] >= rb[1] and box(n)[3] <= rb[3] and n is not row]
    centres = sorted((box(n)[1] + box(n)[3]) // 2 for n in inside if txt(n))
    bands = []
    for c in centres:
        if not bands or c - bands[-1] > ref * 0.7: bands.append(c)
    if len(bands) != 2: bad("row of %r has %d text lines (want 2): %s" % (short, len(bands), [txt(n) for n in inside if txt(n)]))
    pv = [n for n in inside if any(q in txt(n) for q in preview.split('|'))]
    if not pv: bad("row of %r has no preview containing %r: %s" % (short, preview, [txt(n) for n in inside if txt(n)]))
    if (box(pv[0])[1] + box(pv[0])[3]) // 2 <= (nb[1] + nb[3]) // 2: bad("the preview is not under the name")
    # The long name: one line, inside its row (not under the time at its end).
    lg = next((n for n in nodes if txt(n).startswith(longp)), None)
    if lg is None: bad("the long-named friend is not on the list")
    lrows = [n for n in nodes if n.get('clickable') == 'true' and box(n)[1] <= box(lg)[1] and box(n)[3] >= box(lg)[3] and box(n)[0] <= box(lg)[0]]
    lrow = min(lrows, key=lambda n: (box(n)[2] - box(n)[0]) * (box(n)[3] - box(n)[1]))
    if box(lg)[2] > box(lrow)[2]: bad("the long name runs outside its row")
    same = [n for n in nodes if txt(n) and n is not lg and box(n)[0] >= box(lrow)[0] and box(n)[2] <= box(lrow)[2] and abs((box(n)[1] + box(n)[3]) // 2 - (box(lg)[1] + box(lg)[3]) // 2) < ref * 0.7 and box(n)[0] >= box(lg)[2] - 2]
    for n in same:
        if box(lg)[2] > box(n)[0] + 2: bad("the long name overlaps %r" % txt(n))
    if (box(lg)[2] - box(lg)[0]) < (box(lrow)[2] - box(lrow)[0]) * 0.35: bad("the long name got only %d px of a %d px row" % (box(lg)[2] - box(lg)[0], box(lrow)[2] - box(lrow)[0]))
    print("ok: name line %d px, bands 2, long name %d..%d in row %d..%d" % (ref, box(lg)[0], box(lg)[2], box(lrow)[0], box(lrow)[2]))
elif check == 'tabs':
    hs = {}
    for lab in ('Chats', 'Calls', 'Requests', 'Calendar'):
        n = next((n for n in nodes if txt(n) == lab), None)
        if n is None: n = next((n for n in nodes if desc(n) == lab or desc(n).startswith(lab + ',')), None)
        if n is not None: hs[lab] = h(n)
    if 'Requests' not in hs or 'Chats' not in hs: bad("tab row without Chats/Requests: %s" % hs)
    base = min(hs.values())
    if hs['Requests'] > base * 1.3 or max(hs.values()) > base * 1.3: bad("tab heights differ (Requests wraps?): %s" % hs)
    print("ok: tab heights %s" % hs)
elif check == 'header':  # name : the peer's (prefix) name is in the top bar (top 15 %), one line
    name, H = args[0], int(args[1])
    n = next((n for n in nodes if txt(n).startswith(name) and box(n)[3] < H * 0.15), None)
    if n is None: bad("the chat header doesn't show %r (top bar texts: %s)" % (name, [txt(x) for x in nodes if txt(x) and box(x)[3] < H * 0.15]))
    for x in nodes:
        if desc(x) in ('Lock chat', 'Unlock chat', 'End-to-end encrypted') and box(x)[3] < H * 0.15: bad("a header icon %r is still there" % desc(x))
    print("ok: header %r" % txt(n))
elif check == 'official':  # "<name> · Risi" header: neither part clipped (the " · Risi" node is as high as the name's)
    name, H = args[0], int(args[1])
    top = [n for n in nodes if txt(n) and box(n)[3] < H * 0.15]
    nm = next((n for n in top if txt(n).startswith(name)), None)
    rs = next((n for n in top if txt(n).strip() in ('· Risi', '·Risi') or txt(n).endswith(' · Risi')), None)
    if nm is None or rs is None: bad("no '%s · Risi' header: %s" % (name, [txt(n) for n in top]))
    if nm is rs: print("ok: one title node %r (%d px)" % (txt(nm), h(nm))); sys.exit(0)
    if h(rs) < h(nm) - 2: bad("' · Risi' is clipped: %d px high vs the name's %d px" % (h(rs), h(nm)))
    if h(nm) < 20: bad("the title is only %d px high" % h(nm))
    print("ok: name %d px, ' · Risi' %d px" % (h(nm), h(rs)))
elif check == 'nochips':
    hit = [txt(n) for n in nodes if txt(n).startswith('UIB chip') or desc(n).startswith('UIB chip')]
    if hit: bad("next_steps are drawn as chips: %s" % hit)
    print("ok")
elif check == 'fab':   # exactly one node with the content description New
    k = [n for n in nodes if desc(n) == 'New']
    if len(k) != 1: bad("%d nodes with content-desc 'New' (want one)" % len(k))
    print("ok")
PY
}
uib_check() { local what="$1"; shift; local out; dump; out="$(uib_py "$what" "$@")" || fail "ui-batch [$UIB_SC] $what: $out"; echo "    $what [$UIB_SC]: $out"; }
uib_set_scale() {  # $1 = scale: both phones, apps restarted
  local d
  for d in A B; do DEV=$d; A shell settings put system font_scale "$1"; A shell am force-stop "$PKG"; done
  UIB_SCALE_SET=1; DEV=A
  A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null; sleep 2; dismiss_prompts
  back_to_list || fail "ui-batch [$1]: no chat list after the restart"
}
# Locks the chat open in the DM from its ⋮ (PIN prompt), checks that the ⋮ then says "Unlock chat", unlocks again.
uib_lock_cycle() {
  tap "More options" || fail "ui-batch [$UIB_SC]: the chat's ⋮"
  wait_text "Lock chat" 10 || fail "ui-batch [$UIB_SC]: the chat's ⋮ has no 'Lock chat'"
  has 'content-desc="Lock chat"' && fail "ui-batch [$UIB_SC]: 'Lock chat' is also a header icon"
  shot "50-uibatch-menu-$UIB_SC"
  mark_prompts; tap "Lock chat" || fail "ui-batch [$UIB_SC]: tap Lock chat"
  confirm_pin "ui-batch: Lock chat from the chat's ⋮"
  sleep 2
  if ! on_list; then   # still in the chat: the ⋮ now offers Unlock chat
    tap "More options" || fail "ui-batch [$UIB_SC]: the ⋮ after locking"
    wait_text "Unlock chat" 10 || fail "ui-batch [$UIB_SC]: after locking, the chat's ⋮ has no 'Unlock chat'"
    shot "50-uibatch-unlock-$UIB_SC"
    mark_prompts; tap "Unlock chat" || fail "ui-batch [$UIB_SC]: tap Unlock chat"
    sleep 1; [ "$(count 'RisiMe chat lock: prompt shown')" -gt "$PROMPTS0" ] && { enter_pin; sleep 1; }
    pass "ui-batch [$UIB_SC]: ⋮ → Lock chat → ⋮ → Unlock chat"
  else                  # the lock closes the chat: it is in the Locked chats folder
    wait_gone 'text="ZZ UI B"' 15 || fail "ui-batch [$UIB_SC]: the locked chat is still on the list"
    local found=0
    for _ in 1 2 3; do
      A shell input swipe $((W / 2)) $((H * 35 / 100)) $((W / 2)) $((H * 80 / 100)) 500; sleep 1
      has 'text="Locked chats"' && { found=1; break; }
    done
    [ "$found" = 1 ] || fail "ui-batch [$UIB_SC]: no 'Locked chats' row after locking"
    mark_prompts; tap "Locked chats" || fail "ui-batch: tap Locked chats"
    confirm_pin "ui-batch: Locked chats folder"
    wait_for 'text="ZZ UI B"' 15 || fail "ui-batch [$UIB_SC]: the folder doesn't hold the chat"
    tap "ZZ UI B"; sleep 2
    tap "More options" || fail "ui-batch [$UIB_SC]: the locked chat's ⋮"
    wait_text "Unlock chat" 10 || fail "ui-batch [$UIB_SC]: the locked chat's ⋮ has no 'Unlock chat'"
    shot "50-uibatch-unlock-$UIB_SC"
    mark_prompts; tap "Unlock chat" || fail "ui-batch [$UIB_SC]: tap Unlock chat"
    sleep 1
    [ "$(count 'RisiMe chat lock: prompt shown')" -gt "$PROMPTS0" ] && { enter_pin; sleep 1; }
    pass "ui-batch [$UIB_SC]: ⋮ → Lock chat (→ folder) → ⋮ → Unlock chat"
  fi
  back_to_list || fail "ui-batch [$UIB_SC]: back to the list after unlocking"
  wait_for 'text="ZZ UI B"' 15 || fail "ui-batch [$UIB_SC]: the unlocked chat didn't come back to the list"
}
# P0 (calendar "0 events"): a LOCAL calendar with four events seeded through the debug seam (android d073737); Calendar
# Details counts all 4, the diagnostics section and its Copy button exist, and Risi's week answer lists them.
ui_batch_calendar_prep() {
  DEV=A
  local out
  P=lk.codegen.risime.debug; SEED=lk.codegen.risime.debug.CALENDAR_SEED
  A shell pm grant "$PKG" android.permission.READ_CALENDAR 2>/dev/null || true
  A shell pm grant "$PKG" android.permission.WRITE_CALENDAR 2>/dev/null || true
  seed() { out="$(A shell am broadcast -a "$SEED" -p "$P" "$@" 2>&1 | tr -d '\r')"; printf '%s' "$out" | grep -q 'data="ok' || fail "ui-batch calendar: seed $*: $out"; }
  local d1 d2 d3 d6
  d1="$(date -u -d '+1 day' +%F)"; d2="$(date -u -d '+2 days' +%F)"; d3="$(date -u -d '+3 days' +%F)"; d6="$(date -u -d '+6 days' +%F)"
  seed --es op clear
  seed --es op calendar --es name "'RisiMe Seed'"
  seed --es op event --es title "UIBSingle" --es start "${d1}T09:00:00+00:00" --es end "${d1}T10:00:00+00:00" --es tz UTC
  seed --es op event --es title "UIBWeekly" --es start "${d2}T11:00:00+00:00" --es end "${d2}T11:30:00+00:00" --es tz UTC --es rrule "'FREQ=WEEKLY;COUNT=4'"
  seed --es op event --es title "UIBAllday" --ez all_day true --es date "$d3"
  seed --es op event --es title "UIBFar" --es start "${d6}T10:00:00+00:00" --es end "${d6}T11:00:00+00:00" --es tz UTC
  pass "ui-batch calendar: seeded a LOCAL calendar 'RisiMe Seed' with 4 events (single, weekly, all-day, 6 days out)"
  # Calendar skill on (READ/WRITE already granted).
  settings_open "Risi skills" || fail "ui-batch calendar: Settings → 'Risi skills' didn't open"
  reveal "Calendar skill" || fail "ui-batch calendar: Risi skills has no Calendar switch"
  wait_skill "Calendar" "Off" 3 && { tap "Calendar skill" || fail "ui-batch calendar: turn on Calendar"; sleep 3; }
  dismiss_prompts
}
uib_open_details() {  # Settings → Risi skills → Calendar → Details (the card expands in place)
  settings_open "Risi skills" || fail "ui-batch calendar: Settings → 'Risi skills' didn't open"
  reveal "Calendar skill" || fail "ui-batch calendar: Risi skills has no Calendar switch"
  local opened="" found=0
  local xy
  for _ in $(seq 1 12); do   # (every skill has a [Details], and an expanded card has bullets: the first one between the Calendar title and the next skill's)
    has 'text="What Risi can read"' && { opened=1; break; }  # (Details expands the card in place)
    xy="$(python3 -I - "$WORK/ui-$DEV.xml" <<'PY'
import re, sys, xml.etree.ElementTree as ET
try:
    nodes = list(ET.parse(sys.argv[1]).iter('node'))
except ET.ParseError:
    nodes = []
def c(n):
    x1, y1, x2, y2 = map(int, re.findall(r'\d+', n.get('bounds'))); return (x1 + x2) // 2, (y1 + y2) // 2
cal = [c(n)[1] for n in nodes if n.get('text') == 'Calendar']
if cal:
    top = cal[-1]
    nxt = [c(n)[1] for n in nodes if (n.get('text') or '') == 'Scheduled messages' and c(n)[1] > top]
    lim = min(nxt) if nxt else 10 ** 6
    hit = sorted((c(n)[1], c(n)[0]) for n in nodes if n.get('text') == 'Details' and top < c(n)[1] < lim)
    if hit and hit[0][0] < 1100: print(hit[0][1], hit[0][0])
PY
)"
    if [ -n "$xy" ]; then A shell input tap $xy; sleep 2; fi
    A shell input swipe $((W / 2)) $((H * 70 / 100)) $((W / 2)) $((H * 40 / 100)) 500; sleep 1
  done
  [ -n "$opened" ] || fail "ui-batch calendar: Calendar → [Details] didn't open"
}
ui_batch_calendar() {
  DEV=A
  ui_batch_calendar_prep
  # Details
  uib_open_details
  local found=0
  for _ in 1 2 3 4 5 6 7 8; do
    has 'RisiMe Seed · Phone only · 4 events in the next 7 days' && { found=1; break; }
    A shell input swipe $((W / 2)) $((H * 70 / 100)) $((W / 2)) $((H * 40 / 100)) 400; sleep 1
  done
  [ "$found" = 1 ] || { grep -o 'text="[^"]*event[^"]*"' "$WORK/ui-A.xml" | head -5; fail "ui-batch calendar: Details lacks 'RisiMe Seed · Phone only · 4 events in the next 7 days'"; }
  shot "51-uibatch-calendar-details"
  found=0
  for _ in 1 2 3 4 5 6 7 8; do
    has 'text="Calendar diagnostics"' && has 'Events (raw): 4 · Instances next 7 days: 4 · Counted: 4' && has 'Account type: LOCAL' && found=1
    [ "$found" = 1 ] && break
    A shell input swipe $((W / 2)) $((H * 70 / 100)) $((W / 2)) $((H * 40 / 100)) 400; sleep 1
  done
  [ "$found" = 1 ] || fail "ui-batch calendar: no 'Calendar diagnostics' with 'Events (raw): 4 · Instances next 7 days: 4 · Counted: 4' and 'Account type: LOCAL'"
  for _ in 1 2 3 4; do has 'text="Copy diagnostics"' && break; A shell input swipe $((W / 2)) $((H * 70 / 100)) $((W / 2)) $((H * 40 / 100)) 400; sleep 1; done
  has 'text="Copy diagnostics"' || fail "ui-batch calendar: no 'Copy diagnostics' button"
  shot "52-uibatch-calendar-diagnostics"
  pass "ui-batch calendar: Details 'RisiMe Seed · Phone only · 4 events in the next 7 days'; Calendar diagnostics (raw 4 / instances 4 / counted 4, LOCAL) and 'Copy diagnostics'"
  # Risi's answer
  back_to_list || fail "ui-batch calendar: back to the list"
  wait_text "Risi" 30 || fail "ui-batch calendar: no Risi entry"
  tap "Risi" || fail "ui-batch calendar: open the Risi chat"
  wait_for 'text="Ask Risi…"' 60 || fail "ui-batch calendar: the Risi chat didn't open"
  tap "Ask Risi…" || true; sleep 0.5
  A shell input text "what%ss%son%smy%scalendar%sthis%sweek"; sleep 0.5
  tap "Send" || fail "ui-batch calendar: send the week question"
  wait_for "UIBATCH week answer." 120 || fail "ui-batch calendar: no answer to 'what's on my calendar this week'"
  sleep 3; dump
  has "I couldn" && fail "ui-batch calendar: Risi says it couldn't read the calendar"
  has "0 events" && fail "ui-batch calendar: Risi's answer says '0 events'"
  shot "53-uibatch-calendar-answer"
  for t in "UIBSingle" "UIBWeekly" "UIBAllday" "UIBFar"; do
    has "$t" || { [ "$t" = "UIBSingle" ] && grep -o 'text="[^"]*"' "$WORK/ui-A.xml" | tail -15; fail "ui-batch calendar: the answer's 'Your events' list lacks '$t'"; }
  done
  has "Your events" || fail "ui-batch calendar: no 'Your events' header under Risi's answer"
  pass "ui-batch calendar: Risi's week answer lists the 4 seeded events under 'Your events'"
  # (The seeded calendar stays for ui_batch_actions, which clears it. UITEST_UIBATCH_CAL_ONLY=3 runs the add on a phone with NO calendar:
  # android finding, [Add] says "No writable Google calendar on this phone" instead of creating the local RisiMe calendar.)
  back_to_list || true
  logcat_ok "ui-batch calendar"
}
# ---- (a) (b) (c) (d) of the P0 hotfix: the add (card → [Add] → provider row, event card, Open in Calendar, honest failure),
# the chip gate (deep link / request, never plain text), Markdown, and a com.google-type calendar next to the LOCAL one.
uib_ask() {  # $1 = the sentence typed into the Risi chat
  tap "Ask Risi…" || true; sleep 0.5
  A shell input text "$(printf '%s' "$1" | sed 's/ /%s/g')"; sleep 0.5
  tap "Send" || fail "ui-batch: send '$1'"
}
uib_risi_chat() {
  back_to_list || fail "ui-batch: back to the list"
  wait_text "Risi" 30 || fail "ui-batch: no Risi entry"
  tap "Risi" || fail "ui-batch: open the Risi chat"
  wait_for 'text="Ask Risi…"' 60 || fail "ui-batch: the Risi chat didn't open"
}
uib_events() {  # $1 = exact title: the live rows "id calendar_id"
  A shell "content query --uri content://com.android.calendar/events --projection _id:calendar_id:title:deleted" 2>/dev/null | tr -d '\r' | grep "title=$1," | grep 'deleted=0' | sed 's/^Row: [0-9]* _id=\([0-9]*\), calendar_id=\([0-9]*\),.*/\1 \2/' || true
}
uib_focus() { A shell dumpsys activity activities 2>/dev/null | grep -E 'topResumedActivity|mResumedActivity' | head -1 | sed 's/^ *//'; }
uib_add_flow() {  # $1 = the sentence, $2 = the title, $3 = a label for messages: card → [Add] → (picker) → the row
  uib_ask "$1"
  wait_text "Add" 120 || fail "ui-batch add [$3]: no action card with [Add]"
  has "text=\"$2\"" || { for _ in 1 2 3; do A shell input swipe $((W / 2)) $((H * 35 / 100)) $((W / 2)) $((H * 55 / 100)) 300; sleep 1; has "text=\"$2\"" && break; done; }
  has "text=\"$2\"" || fail "ui-batch add [$3]: the card doesn't show '$2'"
  tap "Add" || fail "ui-batch add [$3]: tap Add"
  sleep 2
  if has 'text="Choose a calendar"'; then tap "Use this calendar" || fail "ui-batch add [$3]: pick the calendar"; fi
}
ui_batch_actions() {
  DEV=A; screen_wh
  local ev id cal before after l0 l1
  uib_risi_chat
  # (a) LOCAL calendar only (nothing else on the phone yet): the add → the provider row, the event card, Open in Calendar
  uib_add_flow "add meeting with Upali Monday 10am" "Meeting with Upali" local
  wait_text "Open in Calendar" 90 || { shot "55-uibatch-add-failed"; fail "ui-batch add [local]: no event card with 'Open in Calendar' after [Add]"; }
  has "Added to your" || has "added" || true
  ev="$(uib_events "Meeting with Upali")"
  [ -n "$ev" ] || fail "ui-batch add [local]: no 'Meeting with Upali' row in CalendarContract"
  [ "$(printf '%s\n' "$ev" | wc -l)" = 1 ] || fail "ui-batch add [local]: more than one row: $ev"
  id="${ev% *}"; cal="${ev#* }"
  A shell "content query --uri content://com.android.calendar/calendars --projection _id:calendar_access_level --where \"_id=$cal\"" | tr -d '\r' | grep -qE 'calendar_access_level=(500|600|700|800)' || fail "ui-batch add [local]: the event is in calendar $cal, which is not writable"
  has 'text="Meeting with Upali"' || fail "ui-batch add [local]: the event card shows no title"
  shot "55-uibatch-add-event-card"
  before="$(uib_focus)"; l0="$(A logcat -d 2>/dev/null | grep -c 'START u0 {act=android.intent.action.VIEW dat=content://com.android.calendar' || true)"
  tap "Open in Calendar" || fail "ui-batch add: tap Open in Calendar"
  sleep 4
  after="$(uib_focus)"
  echo "    focus before: $before"; echo "    focus after:  $after"
  # (Redroid's stock Calendar crashes on EventInfoActivity (ClassCastException in the AOSP app itself): the launch of the
  # VIEW intent for the event is then the proof, together with a changed resumed activity when it stays up.)
  l1="$(A logcat -d 2>/dev/null | grep -c 'START u0 {act=android.intent.action.VIEW dat=content://com.android.calendar' || true)"
  [ "$after" != "$before" ] || [ "${l1:-0}" -gt "${l0:-0}" ] || { shot "55-uibatch-open-calendar"; fail "ui-batch add: 'Open in Calendar' opened nothing (the resumed activity didn't change)"; }
  shot "55-uibatch-open-calendar"
  pass "ui-batch add [local]: card → [Add] → row $id in writable calendar $cal; event card with 'Open in Calendar'; it opened: ${after##* }"
  for _ in 1 2 3; do  # (the stock Calendar crashed or is on top: bring RisiMe back)
    A shell input keyevent KEYCODE_HOME; sleep 1
    A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null 2>&1 || true; sleep 3; dump
    grep -qF "package=\"$PKG\"" "$WORK/ui-$DEV.xml" && break
  done
  dismiss_prompts
  uib_risi_chat
  # honest failure: WRITE_CALENDAR revoked → never "added", and the failure is named
  A shell pm revoke "$PKG" android.permission.WRITE_CALENDAR 2>/dev/null || true
  sleep 8; A shell input keyevent KEYCODE_HOME; sleep 1; A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null 2>&1 || true; sleep 4; dismiss_prompts   # (a revoke kills the app, a moment later)
  uib_risi_chat
  uib_ask "add meeting with Upali Tuesday 10am"
  wait_text "Add" 120 || fail "ui-batch add [no write]: no action card with [Add]"
  tap "Add" || fail "ui-batch add [no write]: tap Add"
  sleep 3
  for _ in $(seq 1 6); do  # a system permission dialog, if the app asks: refuse it
    xy="$(python3 -I - "$WORK/ui-$DEV.xml" <<'PY'
import re, sys, xml.etree.ElementTree as ET
for n in ET.parse(sys.argv[1]).iter('node'):
    rid = n.get('resource-id') or ''
    if rid.endswith('permission_deny_button') or rid.endswith('permission_deny_and_dont_ask_again_button'):
        x1, y1, x2, y2 = map(int, re.findall(r'\d+', n.get('bounds'))); print((x1 + x2) // 2, (y1 + y2) // 2); break
PY
)"
    [ -n "$xy" ] && { A shell input tap $xy; sleep 2; }
    dump; has "Couldn't add" || has "couldn't add" || has "No permission" || has "access is off" || has "permission" && break; sleep 2
  done
  sleep 2; dump
  shot "55-uibatch-add-no-write"
  [ -z "$(uib_events "Meeting with Upali two")" ] || fail "ui-batch add [no write]: a row was written without WRITE_CALENDAR"
  has "Added to your" && fail "ui-batch add [no write]: the chat says it added the event"
  has "I've added" && fail "ui-batch add [no write]: the chat says it added the event"
  grep -qiE "couldn.t add|calendar access is off|permission|nothing was (added|changed)" "$WORK/ui-$DEV.xml" || fail "ui-batch add [no write]: the failure isn't named (see 55-uibatch-add-no-write)"
  pass "ui-batch add [no write]: with WRITE_CALENDAR revoked nothing is added and the failure is named"
  A shell pm grant "$PKG" android.permission.WRITE_CALENDAR 2>/dev/null || true
  sleep 8; A shell input keyevent KEYCODE_HOME; sleep 1; A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null 2>&1 || true; sleep 4; dismiss_prompts
  uib_risi_chat
  # (d) a com.google-type calendar (as in step 12): read and add against it as well
  local GA="uitest.risime@gmail.com" gid
  A shell "content insert --uri 'content://com.android.calendar/calendars?caller_is_syncadapter=true&account_name=$GA&account_type=com.google' --bind account_name:s:$GA --bind account_type:s:com.google --bind name:s:$GA --bind calendar_displayName:s:$GA --bind calendar_access_level:i:700 --bind visible:i:1 --bind sync_events:i:1 --bind ownerAccount:s:$GA --bind calendar_color:i:-14069085 --bind calendar_timezone:s:UTC" >/dev/null
  gid="$(A shell "content query --uri content://com.android.calendar/calendars --projection _id:account_type" | tr -d '\r' | sed -n 's/^Row: [0-9]* _id=\([0-9]*\), account_type=com.google.*/\1/p' | head -1)"
  [ -n "$gid" ] || fail "ui-batch google: could not seed the com.google calendar"
  local gs gd; gd="$(date -u -d '+2 days' +%F)"; gs="$(date -u -d "${gd}T08:00:00Z" +%s)000"
  A shell "content insert --uri 'content://com.android.calendar/events?caller_is_syncadapter=true&account_name=$GA&account_type=com.google' --bind calendar_id:i:$gid --bind title:s:UIBGoogleEv --bind dtstart:l:$gs --bind dtend:l:$((gs + 3600000)) --bind eventTimezone:s:UTC" >/dev/null
  pass "ui-batch google: seeded a com.google calendar ($GA, id $gid) with one event (UIBGoogleEv)"
  # Redroid has no real Account for com.google (no AccountManager): the account's calendar sync is off, so §29.7 (v1.32)
  # applies: every non-local account holding a visible calendar has sync off → "sync_off", NOT "0 events" and not "free".
  # That is also item 7: Details says "Sync is off for <account>" with "Open sync settings" and "Refresh".
  uib_ask "what s on my calendar this week"
  wait_for "sync is off" 120 || fail "ui-batch google: no 'sync is off' answer to the week question (a Google calendar whose sync is off)"
  sleep 2; dump
  has "I couldn't read your calendar on this phone (sync is off" || fail "ui-batch google: the answer isn't the v1.32 §29.7 sync-off text"
  has "0 events" && fail "ui-batch google: the answer says '0 events' for a calendar whose sync is off"
  has "you're free" && fail "ui-batch google: the answer claims free time although it couldn't read the calendar"
  shot "56-uibatch-google-sync-off-answer"
  pass "ui-batch google: with a com.google calendar whose sync is off the answer says it couldn't read (sync is off), not 0 events"
  uib_open_details
  for _ in 1 2 3 4 5 6 8; do has "Sync is off for $GA" && has 'text="Open sync settings"' && has 'text="Refresh"' && break; A shell input swipe $((W / 2)) $((H * 70 / 100)) $((W / 2)) $((H * 40 / 100)) 400; sleep 1; done
  has "Sync is off for $GA" || fail "ui-batch google: Details lacks 'Sync is off for $GA'"
  has 'text="Open sync settings"' || fail "ui-batch google: Details lacks 'Open sync settings'"
  has 'text="Refresh"' || fail "ui-batch google: Details lacks 'Refresh'"
  shot "56-uibatch-google-sync-off-details"
  pass "ui-batch google: Calendar Details: 'Sync is off for $GA' with 'Open sync settings' and 'Refresh' (brief item 7)"
  uib_risi_chat
  # (The first add above made the phone's own RisiMe calendar the remembered pick, so the Google calendar is chosen on the card.)
  uib_ask "add meeting with Upali Wednesday 10am"
  wait_text "Add" 120 || fail "ui-batch add [google]: no action card with [Add]"
  tap "Change" || fail "ui-batch add [google]: the card has no calendar [Change]"
  wait_text "Choose a calendar" 15 || fail "ui-batch add [google]: Change opened no picker"
  has "text=\"$GA · Google\"" || fail "ui-batch add [google]: the picker doesn't list '$GA · Google'"
  shot "56-uibatch-google-picker"
  tap "$GA · Google" || fail "ui-batch add [google]: pick the Google calendar"
  tap "Use this calendar" || fail "ui-batch add [google]: Use this calendar"
  sleep 2
  has 'text="Open in Calendar"' || { wait_text "Add" 20 && tap "Add" || true; }
  wait_text "Open in Calendar" 90 || { shot "56-uibatch-google-add-failed"; fail "ui-batch add [google]: no event card with 'Open in Calendar'"; }
  ev="$(uib_events "Meeting with Upali google")"
  [ -n "$ev" ] || fail "ui-batch add [google]: no row in CalendarContract"
  [ "${ev#* }" = "$gid" ] || fail "ui-batch add [google]: the event is in calendar ${ev#* }, not the Google calendar $gid"
  shot "56-uibatch-google-added"
  pass "ui-batch add [google]: the add went to the com.google calendar ($gid), event card shown"
  # (c) Markdown
  uib_ask "uibatch markdown"
  wait_text "item one" 90 || wait_for "item one" 60 || fail "ui-batch markdown: no answer"
  sleep 1; dump
  grep -qF '**' "$WORK/ui-$DEV.xml" && fail "ui-batch markdown: a raw ** is on screen"
  grep -qF '__' "$WORK/ui-$DEV.xml" && fail "ui-batch markdown: a raw __ is on screen"
  has "bold text" || fail "ui-batch markdown: the bold words aren't shown"
  has "item two" || fail "ui-batch markdown: the list isn't shown"
  shot "57-uibatch-markdown"
  pass "ui-batch markdown: bold and a list render with no raw ** or __"
  # (b) chip gate: a deep link, and a request
  uib_ask "uibatch actions"
  wait_text "Connect your calendar in Settings" 90 || fail "ui-batch chips: no 'Connect your calendar in Settings' chip"
  wait_text "Check if I'm free on Monday" 10 || fail "ui-batch chips: no 'Check if I'm free on Monday' chip"
  shot "57-uibatch-chips"
  tap "Connect your calendar in Settings" || fail "ui-batch chips: tap the first chip"
  sleep 3; dump
  has 'text="Risi skills"' || fail "ui-batch chips: the first chip didn't open Settings → Risi skills"
  has 'text="Calendar"' || fail "ui-batch chips: Risi skills shows no Calendar"
  shot "57-uibatch-chip-deeplink"
  grep -qE 'content-desc="You: Connect your calendar' "$WORK/ui-$DEV.xml" && fail "ui-batch chips: the chip text became a message"
  pass "ui-batch chips: 'Connect your calendar in Settings' opens Risi skills (Calendar)"
  uib_risi_chat
  grep -qE 'content-desc="You: Connect your calendar' "$WORK/ui-$DEV.xml" && fail "ui-batch chips: the first chip's text is a chat message"
  local m0 m1
  m0="$(grep -c "free on Monday" "$WORK/llm-requests.jsonl" 2>/dev/null || true)"
  wait_text "Check if I'm free on Monday" 30 || fail "ui-batch chips: the second chip is gone"
  tap "Check if I'm free on Monday" || fail "ui-batch chips: tap the second chip"
  wait_for "UIBATCH monday answer." 90 || fail "ui-batch chips: the second chip started no Risi turn"
  m1="$(grep -c "free on Monday" "$WORK/llm-requests.jsonl" 2>/dev/null || true)"
  [ "${m1:-0}" -gt "${m0:-0}" ] || fail "ui-batch chips: the fake-llm got no request with the chip's text"
  has 'text="Ask Risi…"' || fail "ui-batch chips: the composer isn't empty after the chip"
  pass "ui-batch chips: 'Check if I'm free on Monday' sends a Risi request (fake-llm saw it); no chip text pre-filled the composer"
  A shell am broadcast -a "$SEED" -p "$P" --es op clear >/dev/null 2>&1 || true
  back_to_list || true
  logcat_ok "ui-batch actions"
}
ui_batch_section() {
  DEV=A; screen_wh
  [ "${UITEST_UIBATCH_CAL_ONLY:-0}" = 3 ] && { ui_batch_calendar_prep; seed --es op clear; ui_batch_actions; return 0; }  # (no calendar on the phone at all)
  [ "${UITEST_UIBATCH_CAL_ONLY:-0}" = 2 ] && { ui_batch_calendar_prep; ui_batch_actions; return 0; }
  [ "${UITEST_UIBATCH_CAL_ONLY:-0}" = 1 ] && { ui_batch_calendar; return 0; }  # (quick iterations on the calendar part)
  A shell locksettings set-pin "$PIN" >/dev/null 2>&1 || true
  [ "$(fx longfriend)" = "uientry: longfriend ok" ] || fail "ui-batch: fixture longfriend"
  local LONGP="ZZ UI Cee With An Extremely"
  # A preview line for B's row, typed through the UI.
  open_chat "ZZ UI B" || fail "ui-batch: A can't open the DM"
  wait_for 'text="Encrypted message"' 20 || fail "ui-batch: no composer"
  tap "Encrypted message" || true; sleep 0.5
  A shell input text "uibatch%spreview"; sleep 0.5
  tap "Send" || fail "ui-batch: send the preview message"
  wait_for "uibatch preview" 20 || fail "ui-batch: the message didn't show"
  back_to_list || fail "ui-batch: back to the list"
  for UIB_SC in 1.0 1.3; do
    uib_set_scale "$UIB_SC"
    # The long-named friend arrives with a refresh.
    for _ in 1 2 3 4 5 6; do has "$LONGP" && break; tap "Refresh friends" || true; sleep 2; done
    has "$LONGP" || fail "ui-batch [$UIB_SC]: the long-named friend is not on the list"
    # 1. rows; 2. tab row
    # (From the second round on the Official started in round one is the newest line of the DM.)
    for _ in $(seq 1 15); do has "uibatch preview" || has "You started this chat" && break; sleep 1; done
    uib_check list "ZZ UI B" "$LONGP" "uibatch preview|You started this chat" "$UIB_SC"
    uib_check tabs
    shot "50-uibatch-list-$UIB_SC"
    pass "ui-batch [$UIB_SC]: rows have two lines, names stay on one line and inside the row, no 'last seen'; the Requests tab is one line"
    # 4. the round FAB and its sheet
    has 'text="Add friend"' && fail "ui-batch [$UIB_SC]: an 'Add friend' button is still on the list (extended FAB?)"
    uib_check fab
    tap "New" || fail "ui-batch [$UIB_SC]: tap the New FAB"
    wait_text "New chat" 10 || fail "ui-batch [$UIB_SC]: the FAB sheet has no 'New chat'"
    wait_text "New group" 5 || fail "ui-batch [$UIB_SC]: the FAB sheet has no 'New group'"
    wait_text "Add friend" 5 || fail "ui-batch [$UIB_SC]: the FAB sheet has no 'Add friend'"
    shot "50-uibatch-fab-sheet-$UIB_SC"
    A shell input keyevent KEYCODE_BACK; sleep 1
    wait_gone 'text="New group"' 8 || fail "ui-batch [$UIB_SC]: Back didn't dismiss the FAB sheet"
    on_list || fail "ui-batch [$UIB_SC]: not on the chat list after dismissing the sheet"
    pass "ui-batch [$UIB_SC]: one round FAB 'New' → New chat / New group / Add friend"
    # 3. chat header with the long name, then the lock cycle in the short-named DM
    tap "$LONGP*" || fail "ui-batch [$UIB_SC]: open the long-named chat"
    sleep 2; dump
    uib_check header "$LONGP" "$H"
    shot "50-uibatch-header-long-$UIB_SC"
    back_to_list || fail "ui-batch [$UIB_SC]: back to the list"
    tap "ZZ UI B" || fail "ui-batch [$UIB_SC]: open the DM"
    wait_for 'text="Encrypted message"' 20 || fail "ui-batch [$UIB_SC]: DM didn't open"
    uib_check header "ZZ UI B" "$H"
    shot "50-uibatch-header-$UIB_SC"
    # (b) the 1:1 Official header "<name> · Risi" is not clipped at this font scale.
    if has 'text="● Official"'; then
      tap "● Official" || fail "ui-batch [$UIB_SC]: tap Official"
      if wait_for 'text="Start Official"' 8; then tap "Start Official" || fail "ui-batch [$UIB_SC]: tap Start Official"; fi
      for _ in $(seq 1 60); do dump; grep -qE 'text="[ ]?· Risi"|· Risi"' "$WORK/ui-$DEV.xml" && break; sleep 1; done
      uib_check official "ZZ UI B" "$H"
      shot "50-uibatch-official-header-$UIB_SC"
      tap "🔒 Private" || true; sleep 1
    fi
    uib_lock_cycle
    pass "ui-batch [$UIB_SC]: the header always shows the name; Lock chat lives in the ⋮"
    # 6. no fake chips in the Risi chat
    wait_text "Risi" 30 || fail "ui-batch [$UIB_SC]: the chat list has no Risi entry"
    tap "Risi" || fail "ui-batch [$UIB_SC]: open the Risi chat"
    wait_for 'text="Ask Risi…"' 60 || fail "ui-batch [$UIB_SC]: the Risi chat didn't open"
    tap "Ask Risi…" || true; sleep 0.5
    A shell input text "uibatch%shello%s$UIB_SC"; sleep 0.5
    tap "Send" || fail "ui-batch [$UIB_SC]: send to Risi"
    wait_for "UIBATCH answer ready." 90 || fail "ui-batch [$UIB_SC]: Risi didn't answer the scripted question"
    sleep 2; dump
    # TODO(root, P0 addition (c)): android is bringing the suggestion chips back (a tap sends the request to Risi and a turn
    # runs). When that lands, replace this "no chips" check by: tap "UIB chip tell me more" → fake-llm's record
    # ($WORK/llm-requests.jsonl) holds a request with that text, the composer stays empty.
    # (c) the suggestion chips are back: a tap sends the request to Risi at once (a model call with the chip's text, an
    # answer), and the composer stays empty (no pre-fill).
    local n0 n1
    n0="$(grep -c 'UIB chip tell me more' "$WORK/llm-requests.jsonl" 2>/dev/null || true)"
    wait_text "UIB chip tell me more" 20 || fail "ui-batch [$UIB_SC]: Risi's answer has no 'UIB chip tell me more' chip"
    tap "UIB chip tell me more" || fail "ui-batch [$UIB_SC]: tap the chip"
    wait_for "UIBATCH chip answered." 90 || fail "ui-batch [$UIB_SC]: the chip tap started no Risi turn (no answer)"
    n1="$(grep -c 'UIB chip tell me more' "$WORK/llm-requests.jsonl" 2>/dev/null || true)"
    [ "${n1:-0}" -gt "${n0:-0}" ] || fail "ui-batch [$UIB_SC]: the fake-llm got no request containing the chip's text"
    has 'text="Ask Risi…"' || fail "ui-batch [$UIB_SC]: the composer isn't empty after the chip tap"
    echo "    chip tap [$UIB_SC]: fake-llm requests with the chip text $n0 -> $n1"
    shot "50-uibatch-risi-$UIB_SC"
    pass "ui-batch [$UIB_SC]: a next_steps chip tap runs a Risi turn and leaves the composer empty"
    back_to_list || fail "ui-batch [$UIB_SC]: back to the list"
    # 5. profile photo sheet
    if back_to_list && tap "More options" && wait_for 'text="Settings"' 10 && tap "Settings"; then
      sleep 2
      local ptxt=""; for _ in 1 2 3 4 5; do for t in "Set photo" "Change photo"; do has "text=\"$t\"" && ptxt="$t"; done; [ -n "$ptxt" ] && break; sleep 1; done
      [ -n "$ptxt" ] || fail "ui-batch [$UIB_SC]: Settings has no 'Set photo' / 'Change photo'"
      tap "$ptxt" || fail "ui-batch [$UIB_SC]: tap $ptxt"
      wait_text "Take photo" 10 || fail "ui-batch [$UIB_SC]: the photo sheet has no 'Take photo'"
      wait_text "Gallery" 5 || fail "ui-batch [$UIB_SC]: the photo sheet has no 'Gallery'"
      [ "$ptxt" = "Change photo" ] && { wait_text "Remove photo" 5 || fail "ui-batch [$UIB_SC]: a set photo's sheet has no 'Remove photo'"; }
      [ "$ptxt" = "Set photo" ] && [ -n "$(node_xy 'Remove photo')" ] && fail "ui-batch [$UIB_SC]: 'Remove photo' with no photo set"
      shot "50-uibatch-photo-sheet-$UIB_SC"
      A shell input keyevent KEYCODE_BACK; sleep 1
      wait_gone 'text="Take photo"' 8 || fail "ui-batch [$UIB_SC]: Back didn't dismiss the photo sheet"
      pass "ui-batch [$UIB_SC]: profile photo sheet: Take photo / Gallery$([ "$ptxt" = "Change photo" ] && echo ' / Remove photo')"
    else
      fail "ui-batch [$UIB_SC]: couldn't open Settings"
    fi
    back_to_list || fail "ui-batch [$UIB_SC]: back to the list"
    DEV=A; logcat_ok "ui-batch $UIB_SC"
  done
  uib_set_scale 1.0; UIB_SCALE_SET=0
  ui_batch_calendar
  ui_batch_actions
  pass "ui-batch: all checks at font scale 1.0 and 1.3; the scale is back at 1.0"
}
if [ "$UIBATCH" = 1 ] && { [ "$ONLY" = 00000 ] || [ "${UITEST_UIBATCH_ONLY:-0}" = 1 ]; }; then ui_batch_section; fi

DEV=A; logcat_ok "ui entry"
DEV=B; logcat_ok "ui entry"
echo "UI ENTRY OK"
