  wait_for 'text="Start Official"' 20 || fail "no 'Start Official'"
  tap "Start Official" || fail "tap Start Official"
  # The title is two text nodes since 30fa758 (the name ellipsizes, " · Risi" never does): match the
  # merged node or both parts.
  ok_t=""
  for _ in $(seq 1 90); do
    dump
    if grep -qF 'ZZ UI B · Risi' "$WORK/ui-$DEV.xml" || { grep -qF 'text="ZZ UI B"' "$WORK/ui-$DEV.xml" && grep -qE 'text="[ ]?· Risi"' "$WORK/ui-$DEV.xml"; }; then ok_t=1; break; fi
    sleep 1
  done
  [ -n "$ok_t" ] || fail "the 1:1 Official's header isn't 'ZZ UI B · Risi'"
  has ' members"' && fail "the 1:1 Official's header shows a member count"
  wait_for 'text="Message"' 30 || fail "the Official composer's placeholder isn't 'Message'"
  has 'text="Risi is listening"' || fail "the 'Risi is listening' strip is gone"
  shot "12-official-dm-header"
  pass "the 1:1 Official: header 'ZZ UI B · Risi', placeholder 'Message', 'Risi is listening' strip"
  # Something to answer from (an empty Official gets the error "nothing to summarise", which opens no follow-up).
  tap "Message" || true; sleep 0.5
  A shell input text "We%sagreed%sthe%sbudget%sreview%son%sTuesday"; sleep 0.5
  tap "Send" || fail "send a normal Official message"
  sleep 3
  tap "@Risi" || fail "tap the @Risi chip"
  wait_for 'text="Ask Risi…"' 10 || fail "the @Risi chip didn't switch the composer"
  tap "Ask Risi…" || true; sleep 0.5
  A shell input text "what%sdid%swe%sagree"; sleep 0.5
  tap "Send" || fail "send the ask"
  wait_text "Continuing with Risi" 120 || fail "after Risi's answer: no 'Continuing with Risi' chip"
  shot "13-risi-follow-up-chip"
  pass "Risi answered; the composer shows 'Continuing with Risi ×'"
fi

fi  # UITEST_SKILLS_ONLY

# ---------------------------------------------------------------- 10. (--skills) Risi skills: alarm, scheduled message, revoke
if [ "$SKILLS_STEP" = 1 ] && { [ "$ONLY" = 00000 ] || [ "${UITEST_SKILLS_ONLY:-0}" = 1 ]; }; then
  DEV=A
  size="$(A shell wm size | grep -oE '[0-9]+x[0-9]+' | tail -1)"; W="${size%x*}"; H="${size#*x}"
  conv="$(fx conv | sed -n 's/^uientry: conv=//p')"; [ -n "$conv" ] || fail "fixture: the DM's conversation id"
  # Android's "Alarms & reminders" page, granted the way a user would (redroid has no Settings UI for it).
  A shell appops set "$PKG" SCHEDULE_EXACT_ALARM allow >/dev/null 2>&1 || true
  A shell pm grant "$PKG" android.permission.POST_NOTIFICATIONS 2>/dev/null || true
  settings_open "Risi skills" || fail "Settings → 'Risi skills' (risi_skills on) didn't open"
  wait_for 'content-desc="Alarm skill"' 30 || fail "Risi skills: no Alarm switch"
  has 'Coming later' || true
  reveal "Alarm skill" && tap "Alarm skill" || fail "turn on Alarm"
  wait_skill "Alarm" "Ask me each time" 20 || fail "Alarm didn't turn on (Ask me each time)"
  pass "Settings → Risi skills: Alarm on (Ask me each time)"
  reveal "Scheduled messages skill" || fail "Risi skills: no Scheduled messages switch"
  tap "Scheduled messages skill" || fail "turn on Scheduled messages"
  wait_skill "Scheduled messages" "Ask me each time" 20 || fail "Scheduled messages didn't turn on (exact alarms granted)"
  A shell input swipe $((W / 2)) $((H * 30 / 100)) $((W / 2)) $((H * 80 / 100)) 300; sleep 1
  A shell input swipe $((W / 2)) $((H * 30 / 100)) $((W / 2)) $((H * 80 / 100)) 300; sleep 1
  shot "14-risi-skills"
  pass "Settings → Risi skills: Scheduled messages on"

  # -- "wake me up at 6" in the Risi chat → confirm card → Add → a real alarm in Clock
  back_to_list || fail "back to the chat list (Risi chat)"
  wait_text "Risi" 30 || fail "the chat list has no Risi entry"
  tap "Risi" || fail "open the Risi chat"
  wait_for 'text="Ask Risi…"' 60 || fail "the Risi chat didn't open"
  for _ in $(seq 1 60); do has 'Only you and Risi' && break; sleep 1; done
  tap "Ask Risi…" || true; sleep 0.5
  A shell input text "wake%sme%sup%sat%s6"; sleep 0.5
  tap "Send" || fail "send 'wake me up at 6'"
  wait_text "Add" 120 || fail "no confirm card with Add for the alarm"
  has '06:00' || fail "the alarm card doesn't show its time (args)"
  shot "15-confirm-alarm"
  pass "the alarm confirm card shows its exact args (06:00, Wake up) with Add / Cancel"
  tap "Add" || fail "tap Add (alarm)"
  # DeskClock's AlarmManager alarm-clock entry (an "Alarm clock:" alarm of com.android.deskclock) at 06:00 device time.
  ok_a=""
  for _ in $(seq 1 45); do
    for w in $(A shell dumpsys alarm 2>/dev/null | python3 -I -c '
import re, sys
lines = sys.stdin.read().splitlines()
for i, l in enumerate(lines):
    m = re.search(r"origWhen (\d+) .*com\.android\.deskclock\}", l)
    if m and any("Alarm clock:" in x for x in lines[i + 1:i + 7]):
        print(int(m.group(1)) // 1000)'); do
      [ "$(A shell date -d "@$w" +%H:%M 2>/dev/null | tr -d '\r')" = "06:00" ] && { ok_a=1; break; }
    done
    [ -n "$ok_a" ] && break
    sleep 1
  done
  [ -n "$ok_a" ] || fail "no 06:00 alarm in Redroid's Clock after Add (dumpsys alarm)"
  pass "a real 06:00 alarm is set in Redroid's Clock (DeskClock's alarm clock in dumpsys alarm)"
  A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null; sleep 2
  wait_text "Open Clock" 60 || fail "no skill_done card with 'Open Clock' after the alarm"
  pass "skill_done: 'Open Clock to remove it'"

  # -- "send ZZ UI B good morning at <+2 min>" → card → Add → the phone sends it at the time
  at_epoch=$(( $(date +%s) + 150 )); at_epoch=$(( at_epoch - at_epoch % 60 + 60 ))
  at_iso="$(date -u -d "@$at_epoch" +%Y-%m-%dT%H:%M:00.000Z)"; at_hm="$(date -u -d "@$at_epoch" +%H%M)"
  write_script "$at_iso" "$conv"; start_llm
  tap "Ask Risi…" || true; sleep 0.5
  A shell input text "send%sZZ%sUI%sB%sgood%smorning%sat%s$at_hm"; sleep 0.5
  tap "Send" || fail "send the schedule request"
  wait_for 'Good morning' 120 || fail "no schedule confirm card showing the text"
  for _ in $(seq 1 10); do [ -n "$(node_xy "Add")" ] && break; sleep 1; done
  tap "Add" || fail "tap Add (schedule)"
  for _ in $(seq 1 30); do [ "$(count 'scheduled message .*: armed')" -gt 0 ] && break; sleep 1; done
  [ "$(count 'scheduled message .*: armed')" -gt 0 ] || fail "the phone didn't store and arm the schedule"
  rl 'scheduled message' | tail -2 | sed 's/^/    /'
  pass "the phone stored the schedule and armed it (exact alarm)"
  open_chat "ZZ UI B" || fail "open A's DM (scheduled bubble)"
  tap "🔒 Private" || true
  wait_for 'Scheduled for' 30 || fail "no clock-icon 'Scheduled for …' bubble in A's DM"
  has 'content-desc="Scheduled"' || fail "the scheduled bubble has no clock icon"
  shot "16-scheduled-bubble"
  pass "A's DM shows the scheduled bubble with a clock icon"
  # The phone sends it at the time (A's app in the background: the exact alarm → the worker).
  A shell input keyevent KEYCODE_HOME
  now=$(date +%s); wait_s=$(( at_epoch - now + 90 )); [ "$wait_s" -lt 30 ] && wait_s=30
  for _ in $(seq 1 "$wait_s"); do [ "$(count 'scheduled message .*: queued')" -gt 0 ] && break; sleep 1; done
  [ "$(count 'scheduled message .*: queued')" -gt 0 ] || fail "the phone didn't send the scheduled message at $at_iso"
  pass "the phone queued the scheduled message at the time ($(rl 'scheduled message .*: queued' | tail -1 | grep -oE '\((on time|late)\)'))"
  DEV=B; open_chat "ZZ UI A" || fail "B: open the DM"
  tap "🔒 Private" || true
  wait_for "Good morning" 120 || fail "B didn't receive the scheduled message"
  pass "B received 'Good morning', sent by A's phone, as a normal message"
  DEV=A
  A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null; sleep 1

  # -- revoke Alarm → "wake me up at 7" → skill_needed
  settings_open "Risi skills" || fail "Settings → 'Risi skills' didn't open (revoke)"
  wait_for 'content-desc="Alarm skill"' 30 || fail "Risi skills: no Alarm switch (revoke)"
  reveal "Alarm skill" && tap "Alarm skill" || fail "turn off Alarm"
  wait_for 'text="Turn off"' 10 || fail "no revoke dialog"
  tap "Turn off" || fail "confirm Turn off"
  wait_skill "Alarm" "Off" 20 || fail "Alarm didn't turn off"
  pass "Alarm revoked in Settings → Risi skills"
  back_to_list || fail "back to the chat list (skill_needed)"
  tap "Risi" || fail "open the Risi chat (skill_needed)"
  wait_for 'text="Ask Risi…"' 60 || fail "the Risi chat didn't open (skill_needed)"
  tap "Ask Risi…" || true; sleep 0.5
  A shell input text "wake%sme%sup%sat%s7"; sleep 0.5
  tap "Send" || fail "send 'wake me up at 7'"
  wait_text "Open Risi skills" 120 || fail "no skill_needed card after the revoke"
  has 'no longer have access to your alarms' || fail "the skill_needed card doesn't say Risi lost access"
  shot "17-skill-needed"
  pass "after the revoke Risi says it has no access, with 'Open Risi skills'"
  tap "Open Risi skills" || fail "tap Open Risi skills"
  wait_for 'content-desc="Alarm skill"' 20 || fail "'Open Risi skills' didn't open Settings → Risi skills"
  pass "'Open Risi skills' opens Settings → Risi skills"
fi

# Helpers of steps 11-13.
# Read-only views of the server's store (Repo only, `mix run --no-start`: no second Oban or Risi here).
cat > "$WORK/offers_fx.exs" <<'EXS'
{:ok, _} = Application.ensure_all_started(:ecto_sql)
{:ok, _} = Application.ensure_all_started(:postgrex)
{:ok, _} = RisiMe.Repo.start_link(pool_size: 2)
import Ecto.Query
alias RisiMe.Repo
alias RisiMe.Accounts.User
alias RisiMe.Agent.{Commitment, Discussion, LedgerReminders, Offers, Rest}
a = Repo.get_by!(User, phone: "+94770000981")
case System.argv() do
  ["tz"] ->
    IO.puts("uientry: tz=#{RisiMe.Agent.Clock.user_tz(a.id)}")
  ["state"] ->
    for c <- Repo.all(from c in Commitment, order_by: [asc: c.inserted_at]) do
      {:ok, o} = Commitment.open(c)
      offers = for(f <- Offers.list(c.id), f.user_id == a.id, do: "#{f.kind}:#{f.state}") |> Enum.sort() |> Enum.join(",")
      owner = if c.owner_id == a.id, do: "A", else: "B"
      due = if c.due, do: DateTime.to_unix(c.due, :millisecond), else: ""
      IO.puts("uientry: item #{owner}|#{o.text}|#{c.item_state || c.state}|#{c.needs_clarification}|#{due}|#{offers}")
    end
    IO.puts("uientry: discussions=#{Repo.aggregate(Discussion, :count)}")
  ["totals"] ->
    # The personal digest's items and totals (§27.6, item 9: the query of GET /risi/commitments).
    items = LedgerReminders.digest_items(a.id)
    t = Rest.totals(items, a.id)
    IO.puts("uientry: totals=#{t["i_promised"]} #{t["promised_to_me"]} #{t["others"]} n=#{length(items)}")
  ["caluser"] ->
    # Steps 14-16: a calendar user = RISI_EVENTS on + a device advertising risi_events (§29.1).
    b = Repo.get_by!(User, phone: "+94770000982")
    IO.puts("uientry: caluser=#{RisiMe.Agent.Calendar.calendar_user?(a.id)} #{RisiMe.Agent.Calendar.calendar_user?(b.id)}")
  ["advertised"] ->
    # Step 16: how many of A's and B's devices still advertise risi_events / risi_notes.
    n = Enum.count(Repo.all(RisiMe.Devices.Device), &Enum.any?(&1.capabilities || [], fn c -> c in ~w(risi_events risi_notes) end))
    IO.puts("uientry: advertised=#{n}")
  ["gcal_link"] ->
    # Step 17: A's Google link row (§31.3 storage: state, read_calendars, write_calendar, mirror, device_id) or "none".
    rows = Repo.query!("select state, read_calendars, write_calendar, mirror, device_id::text from risi_gcal_links where user_id = $1", [Ecto.UUID.dump!(a.id)]).rows
    IO.puts("uientry: gcal_link=" <> (case rows do [] -> "none"; [[s, r, w, m, d] | _] -> "#{s} #{r} #{w} #{m} #{d}" end))
  ["pgscan", tables | needles] ->
    # Step 17 canaries (§31.10): the needles must be in no row of the listed tables ("*" = every public table).
    all = Repo.query!("select table_name from information_schema.tables where table_schema = 'public' and table_type = 'BASE TABLE'").rows |> List.flatten()
    ts = if tables == "*", do: all, else: String.split(tables, ",")
    for t <- ts, n <- needles do
      [[c]] = Repo.query!("select count(*) from \"#{t}\" x where x::text like $1", ["%" <> n <> "%"]).rows
      if c > 0, do: IO.puts("uientry: canary #{String.slice(n, 0, 6)}… in #{t}=#{c}")
    end
    IO.puts("uientry: pgscan done #{length(ts)} tables")
  ["events", who] ->
    # The caller's view of GET /risi/calendar/events (Calendar.list, the controller's call) from yesterday on.
    u = if who == "B", do: Repo.get_by!(User, phone: "+94770000982"), else: a
    now = DateTime.utc_now() |> DateTime.truncate(:second)
    {:ok, %{"events" => evs}} =
      RisiMe.Agent.Calendar.list(u.id, DateTime.to_iso8601(DateTime.add(now, -86_400)), DateTime.to_iso8601(DateTime.add(now, 80 * 86_400)))
    for e <- evs do
      st = e["participants"] |> Enum.map(& &1["status"]) |> Enum.sort() |> Enum.join(",")
      IO.puts("uientry: event #{e["title"]}|#{e["created_by"]}|#{e["my_status"]}|#{st}|#{e["state"]}|#{e["start"]}|#{e["event_id"]}")
    end
end
EXS
ofx() { (cd server && set -a && . "$WORK/risi.env" && . "$WORK/phase.env" && set +a && $M mix run --no-start "$WORK/offers_fx.exs" "$@" 2>/dev/null | grep '^uientry:' || true); }
# Taps the first node with the exact text $2 below the node $1 (exact text/content-desc, or "prefix*") and above
# the next card or item ("Risi · …" header, "• …" item line). Scrolls the chat to find them: the anchor not
# on screen → older; the target not yet on screen → a little newer.
# The "Risi · Invitation" card titled $1 (the header's next text): scroll to it (up first, then down, small
# steps) and tap its [Accept] (the first Accept below that header). A chat can hold several invitations.
# card_seen HEADER TITLE NEEDLE…: scroll to the card HEADER (e.g. "Risi · Meeting") whose title (next text) is
# TITLE, then read only that card (down to the next "Risi · " header) in small steps, remembering what was seen.
# Prints the needles found, one per line. A chat can hold several such cards; a card can be taller than the screen.
card_seen() {
  local hdr="$1" title="$2"; shift 2
  local i out found="" started=""
  for i in $(seq 1 30); do
    dump
    out="$(python3 -I - "$WORK/ui-$DEV.xml" "$hdr" "$title" "$started" "$@" <<'PY2'
import re, sys, xml.etree.ElementTree as ET
f, hdr, title, started, needles = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5:]
try:
    nodes = [n for n in ET.parse(f).iter('node') if (n.get('text') or n.get('content-desc') or '') not in ('', 'ⓘ')]
except ET.ParseError:
    nodes = []
txt = lambda n: n.get('text') or n.get('content-desc') or ''
start = None
for k, n in enumerate(nodes[:-1]):
    if txt(n) == hdr and txt(nodes[k + 1]) == title:
        start = k
        break
if start is None and not started:
    print("MISSING"); sys.exit()
seg, end = [], False
for n in nodes[(start if start is not None else 0) + (1 if start is not None else 0):]:
    if txt(n).startswith("Risi · "):
        end = True; break
    seg.append(txt(n))
for nd in needles:
    if any(nd in t for t in seg): print("SEEN " + nd)
print("START" if start is not None else "CONT")
print("END" if end else "MORE")
PY2
)"
    if [ "$out" = MISSING ]; then
      if [ "$i" -le 12 ]; then A shell input swipe $((W / 2)) $((H * 30 / 100)) $((W / 2)) $((H * 65 / 100)) 300
      else A shell input swipe $((W / 2)) $((H * 65 / 100)) $((W / 2)) $((H * 30 / 100)) 300; fi
      sleep 1; continue
    fi
    started=1
    found="$found
$(printf '%s\n' "$out" | sed -n 's/^SEEN //p')"
    printf '%s\n' "$out" | grep -qx END && break
    A shell input swipe $((W / 2)) $((H * 60 / 100)) $((W / 2)) $((H * 45 / 100)) 1200; sleep 1
  done
  printf '%s\n' "$found" | sed '/^$/d' | sort -u
}
invite_accept() {
  local i xy
  for i in $(seq 1 24); do
    dump
    xy="$(python3 -I - "$WORK/ui-$DEV.xml" "$1" "$H" <<'PY2'
import re, sys, xml.etree.ElementTree as ET
try:
    nodes = [n for n in ET.parse(sys.argv[1]).iter('node') if (n.get('text') or '') not in ('', 'ⓘ')]
except ET.ParseError:
    nodes = []
H = int(sys.argv[3])
box = lambda n: [int(v) for v in re.findall(r'\d+', n.get('bounds'))]
for k, n in enumerate(nodes[:-1]):
    if n.get('text') == 'Risi · Invitation' and nodes[k + 1].get('text') == sys.argv[2]:
        hy = box(n)[1]
        acc = [box(m) for m in nodes[k + 1:] if m.get('text') == 'Accept' and box(m)[1] > hy]
        if acc and acc[0][3] < H * 0.85:
            b = acc[0]; print((b[0] + b[2]) // 2, (b[1] + b[3]) // 2)
        else:
            print("below")
        break
PY2
)"
    case "$xy" in
      below) A shell input swipe $((W / 2)) $((H * 60 / 100)) $((W / 2)) $((H * 45 / 100)) 1200 ;;
      "") if [ "$i" -le 12 ]; then A shell input swipe $((W / 2)) $((H * 30 / 100)) $((W / 2)) $((H * 65 / 100)) 300
          else A shell input swipe $((W / 2)) $((H * 65 / 100)) $((W / 2)) $((H * 30 / 100)) 300; fi ;;
      *) A shell input tap $xy; return 0 ;;
    esac
    sleep 1
  done
  echo "    [$DEV] no invitation '$1' with Accept"; return 1
}
tap_below() {
  local r
  for _ in $(seq 1 16); do
    dump
    r="$(python3 -I - "$WORK/ui-$DEV.xml" "$1" "$2" <<'PY'
import re, sys, xml.etree.ElementTree as ET
want, target = sys.argv[2], sys.argv[3]
try:
    nodes = list(ET.parse(sys.argv[1]).iter('node'))
except ET.ParseError:
    nodes = []
def c(n):
    x1, y1, x2, y2 = map(int, re.findall(r'\d+', n.get('bounds'))); return (x1 + x2) // 2, (y1 + y2) // 2
def is_anchor(n):
    t, d = n.get('text') or '', n.get('content-desc') or ''
    return t == want or d == want or (want.endswith('*') and t.startswith(want[:-1]))
anchors = [n for n in nodes if is_anchor(n)]
if not anchors:
    print("noanchor"); sys.exit()
ay = c(anchors[-1])[1]
stops = [c(n)[1] for n in nodes if not is_anchor(n) and c(n)[1] > ay and ((n.get('text') or '').startswith('• ') or (n.get('text') or '').startswith('Risi · '))]
limit = min(stops) if stops else 10 ** 6
hits = sorted((c(n)[1], c(n)[0]) for n in nodes if (n.get('text') or '') == target and ay < c(n)[1] < limit)
print("%d %d" % (hits[0][1], hits[0][0]) if hits else ("notarget" if not stops else "blocked"))
PY
)"
    case "$r" in
      noanchor) A shell input swipe $((W / 2)) $((H * 30 / 100)) $((W / 2)) $((H * 65 / 100)) 300 ;;
      notarget) A shell input swipe $((W / 2)) $((H * 60 / 100)) $((W / 2)) $((H * 42 / 100)) 300 ;;
      blocked) echo "    [$DEV] no '$2' under '$1' (the next item/card follows)"; return 1 ;;
      *) A shell input tap $r; return 0 ;;
    esac
    sleep 1
  done
  echo "    [$DEV] no '$2' below '$1'"; return 1
}
# Scrolls the chat (older first, then back to the newest) until the text $1 ("prefix*" allowed) is on screen.
scroll_to() {
  local i
  for i in $(seq 1 24); do
    [ -n "$(node_xy "$1")" ] && return 0
    if [ "$i" -le 12 ]; then A shell input swipe $((W / 2)) $((H * 30 / 100)) $((W / 2)) $((H * 65 / 100)) 300
    else A shell input swipe $((W / 2)) $((H * 65 / 100)) $((W / 2)) $((H * 30 / 100)) 300; fi
    sleep 1
  done
  echo "    [$DEV] not in the chat: $1"; return 1
}
item_line() { ofx state | grep -F "|$1|" | head -1; }
# Material 3's date picker: the day cell whose content description names $1 (YYYY-MM-DD), paging months forward.
pick_day() {
  local xy
  for _ in 1 2 3 4; do
    dump
    xy="$(python3 -I - "$WORK/ui-$DEV.xml" "$1" <<'PY'
import datetime as dt, re, sys, xml.etree.ElementTree as ET
d = dt.date.fromisoformat(sys.argv[2])
full = "%s %d, %d" % (d.strftime("%B"), d.day, d.year)
for n in ET.parse(sys.argv[1]).iter('node'):
    if full in (n.get('content-desc') or '') or full in (n.get('text') or ''):
        x1, y1, x2, y2 = map(int, re.findall(r'\d+', n.get('bounds'))); print((x1 + x2) // 2, (y1 + y2) // 2); break
PY
)"
    [ -n "$xy" ] && { A shell input tap $xy; return 0; }
    tap "Change to next month" || return 1
    sleep 1
  done
  return 1
}
# ---------------------------------------------------------------- 11. (--ledger) a discussion → each Risi chat's summary
# The Official tab of the DM, with a usable composer ("Message"); starts Official the first time.
official_tab() {
  open_chat "ZZ UI ${1}" || return 1
  tap "● Official" || return 1
  for _ in $(seq 1 90); do
    has 'text="Start Official"' && { tap "Start Official" || true; sleep 2; }
    has 'text="Message"' && has 'Risi is listening' && return 0
    sleep 1
  done
  return 1
}
say() { tap "Message" || return 1; sleep 0.5; A shell input text "$(printf '%s' "$1" | sed 's/ /%s/g')"; sleep 0.5; tap "Send"; sleep 2; }
# The Risi chat from the chat list ("Risi", pinned first; created by the app at start on a risi_ledger phone).
open_risi_chat() {
  back_to_list || return 1
  wait_text "Risi" 60 || return 1
  tap "Risi" || return 1
  wait_for 'text="Ask Risi…"' 60
}
if [ "$LEDGER" = 1 ] && { [ "$ONLY" = 00000 ] || [ "${UITEST_LEDGER_ONLY:-0}" = 1 ]; }; then
  DEV=A; size="$(A shell wm size | grep -oE '[0-9]+x[0-9]+' | tail -1)"; W="${size%x*}"; H="${size#*x}"
  DEV=A; official_tab B || fail "ledger: A can't open the DM's Official tab"
  DEV=B; official_tab A || fail "ledger: B can't open the DM's Official tab"
  pass "ledger: both phones are in the 1:1 Official ('Risi is listening')"
  DEV=A; say "I will send the revised quote with the transport cost" || fail "ledger: A can't send in Official"
  DEV=B; say "Thanks. I will book the site visit transport" || fail "ledger: B can't send in Official"
  DEV=A; say "The site visit stays on Thursday" || fail "ledger: A message 3"
  DEV=B; say "Agreed, Thursday it is" || fail "ledger: B message 4"
  DEV=A; say "I will add the transport line to the quote" || fail "ledger: A message 5"
  DEV=B; say "Great, talk on Thursday" || fail "ledger: B message 6"
  pass "ledger: A and B discussed in Official (6 messages, both of them)"
  # The quiet rule (RISI_QUIET_S=$QUIET_S for this run) → discussion_summarise → each recipient's Risi chat.
  DEV=A; wait_text "Risi · Discussion summary" $(( QUIET_S + 120 )) || fail "ledger: no short discussion card in Official within $(( QUIET_S + 120 )) s (quiet rule)"
  has "Details in your Risi chat" || fail "ledger: the short card lacks 'N items · Details in your Risi chat'"
  pass "ledger: the Official chat has the short card ('… · Details in your Risi chat')"
  wait_text "Open Risi chat" 30 && tap "Open Risi chat" || fail "ledger: the short card has no [Open Risi chat]"
  wait_for "Summary of your discussion with ZZ UI B" 60 || fail "ledger: A's Risi chat has no 'Summary of your discussion with ZZ UI B'"
  has 'text="You agreed:"' || fail "ledger: A's summary has no 'You agreed:'"
  has 'text="ZZ UI B agreed:"' || fail "ledger: A's summary has no 'ZZ UI B agreed:'"
  n_ok="$(count_text "✓")"
  [ "$n_ok" = 1 ] || fail "ledger: A's summary shows $n_ok ✓ buttons (want exactly 1: only A's own item)"
  shot "27-discussion-summary"
  pass "ledger: A's Risi chat: 'Summary of your discussion with ZZ UI B', You agreed (✓ ✗ ✎ on A's item only), ZZ UI B agreed (read-only)"
  # §27.1: ⓘ → Made by.
  tap "ⓘ" || fail "ledger: no ⓘ on the summary card"
  wait_for "Made by: RisiMe model (risi-l1)" 15 || fail "ledger: the ⓘ sheet doesn't say 'Made by: RisiMe model (risi-l1) · …'"
  shot "26-made-by"
  pass "ledger: ⓘ → 'Made by: RisiMe model (risi-l1) · hh:mm'"
  A shell input keyevent KEYCODE_BACK; sleep 1
  wait_text "You agreed:" 15 || fail "ledger: the summary card is gone after the Made by sheet"
  mine="$(python3 -I - "$WORK/ui-A.xml" <<'PY'
import sys, xml.etree.ElementTree as ET
texts = [n.get('text') for n in ET.parse(sys.argv[1]).iter('node') if n.get('text')]
i = texts.index("You agreed:")
print(texts[i + 1].lstrip("• ").strip())
PY
)"
  [ -n "$mine" ] || fail "ledger: can't read A's own item"
  tap "✓" || fail "ledger: tap ✓ on A's item"
  wait_text "confirmed ✓" 60 || fail "ledger: A's item didn't become 'confirmed ✓' (item_update)"
  pass "ledger: A confirmed '$mine' (✓) → 'confirmed ✓' after Risi's item_update"
  DEV=B; open_risi_chat || fail "ledger: B can't open its Risi chat"
  # (The summary card is taller on B once A confirmed: its header may be scrolled off; the items are what matter.)
  # (Since server item 10 each undated item also gets a "When is it due?" card below the summary: scroll up to it.)
  wait_text "ZZ UI A agreed:" 30 || scroll_to "ZZ UI A agreed:" || fail "ledger: B's Risi chat has no summary with 'ZZ UI A agreed:'"
  wait_text "confirmed ✓" 60 || fail "ledger: B doesn't see A's item as 'confirmed ✓'"
  for _ in 1 2 3 4; do has 'text="You agreed:"' && break; A shell input swipe $((W / 2)) $((H * 35 / 100)) $((W / 2)) $((H * 55 / 100)) 300; sleep 1; done
  has 'text="You agreed:"' || fail "ledger: B's summary has no 'You agreed:'"
  n_ok="$(count_text "✓")"
  [ "$n_ok" = 1 ] || fail "ledger: B's summary shows $n_ok ✓ buttons (want 1: B's own item)"
  pass "ledger: B's Risi chat has the same summary; A's item shows 'confirmed ✓', B confirms only its own"
  DEV=A
  settings_open "My promises" || fail "ledger: Settings → 'My promises' didn't open"
  wait_for "$mine" 30 || fail "ledger: My promises doesn't list '$mine'"
  shot "28-my-promises"
  pass "ledger: Settings → My promises lists '$mine'"
  back_to_list || true
fi

# A's calendars and the Calendar skill (steps 12 and 13, once per run): $1 = the step's label.
CAL_READY=0
calendar_setup() {
  [ "$CAL_READY" = 1 ] && return 0
  DEV=A
  size="$(A shell wm size | grep -oE '[0-9]+x[0-9]+' | tail -1)"; W="${size%x*}"; H="${size#*x}"
  GACC="uitest.risime@gmail.com"
  # Redroid has no Google account (no Play services authenticator): the calendars are inserted the way
  # Google's sync adapter writes them (caller_is_syncadapter, account_type com.google). The app sees exactly
  # what a synced Google calendar looks like in CalendarContract; the sync to Google itself isn't covered.
  cal_insert() {  # $1 account name, $2 account type, $3 display name, $4 access level
    A shell "content insert --uri 'content://com.android.calendar/calendars?caller_is_syncadapter=true&account_name=$1&account_type=$2' --bind account_name:s:$1 --bind account_type:s:$2 --bind name:s:$3 --bind calendar_displayName:s:$3 --bind calendar_access_level:i:$4 --bind visible:i:1 --bind sync_events:i:1 --bind ownerAccount:s:$1 --bind calendar_color:i:-14069085 --bind calendar_timezone:s:UTC" >/dev/null
  }
  cal_insert "$GACC" com.google "$GACC" 700
  cal_insert "$GACC" com.google "Holidays" 200
  cal_insert Phone LOCAL Phone 700
  cal_rows() { A shell "content query --uri content://com.android.calendar/calendars --projection _id:account_name:account_type:calendar_access_level:calendar_displayName" 2>/dev/null | tr -d '\r'; }
  GCAL_ID="$(cal_rows | sed -n "s/^Row: [0-9]* _id=\([0-9]*\), account_name=$GACC, account_type=com.google, calendar_access_level=700,.*/\1/p" | head -1)"
  [ -n "$GCAL_ID" ] || { cal_rows | sed 's/^/    /'; fail "$1: could not seed the Google-type calendar"; }
  pass "$1: seeded a com.google calendar ($GACC, id $GCAL_ID), a read-only Google 'Holidays' and a local 'Phone' calendar"
  # -- Settings → Risi skills → Calendar on: the runtime READ/WRITE_CALENDAR prompt, answered Allow
  settings_open "Risi skills" || fail "$1: Settings → 'Risi skills' didn't open"
  reveal "Calendar skill" || fail "$1: Risi skills has no Calendar switch"
  tap "Calendar skill" || fail "$1: turn on Calendar"
  # The system's permission dialog (com.android.permissioncontroller): its Allow button by resource id.
  allow_xy() {
    dump
    python3 -I - "$WORK/ui-$DEV.xml" <<'PY'
import re, sys, xml.etree.ElementTree as ET
try:
    nodes = list(ET.parse(sys.argv[1]).iter('node'))
except ET.ParseError:
    nodes = []
for n in nodes:
    rid, t = n.get('resource-id') or '', (n.get('text') or '').lower()
    if rid.endswith('permission_allow_button') or (rid.startswith('com.android.permissioncontroller') and t == 'allow'):
        x1, y1, x2, y2 = map(int, re.findall(r'\d+', n.get('bounds'))); print((x1 + x2) // 2, (y1 + y2) // 2); break
PY
  }
  asked=0
  for _ in $(seq 1 20); do
    xy="$(allow_xy)"
    if [ -n "$xy" ]; then
      A shell input tap $xy; asked=$((asked + 1)); sleep 1.5; continue
    fi
    [ "$asked" -gt 0 ] && break
    sleep 1
  done
  [ "$asked" -gt 0 ] || { echo "    (no runtime prompt seen: granting READ/WRITE_CALENDAR with pm)"; A shell pm grant "$PKG" android.permission.READ_CALENDAR; A shell pm grant "$PKG" android.permission.WRITE_CALENDAR; }
  wait_skill "Calendar" "Ask me each time" 20 || fail "$1: Calendar didn't turn on (Ask me each time)"
  pass "$1: Settings → Risi skills → Calendar on (Ask me each time) after the calendar permission prompt ($asked tap(s) on Allow)"
  CAL_READY=1
}
reqs() { [ -f "$WORK/llm-requests.jsonl" ] && wc -l < "$WORK/llm-requests.jsonl" || echo 0; }

# ---------------------------------------------------------------- 12. (--calendar, P0) Harsha's calendar conversation
if [ "$CALENDAR" = 1 ] && { [ "$ONLY" = 00000 ] || [ "${UITEST_CALENDAR_ONLY:-0}" = 1 ]; }; then
  DEV=A
  calendar_setup calendar
  # Next Monday 14:00–15:00 on A's clock (Harsha's "Monday 12 Oct at 2pm"), and the card's expected texts.
  dtz="$(A shell getprop persist.sys.timezone | tr -d '\r')"; dtz="${dtz:-UTC}"
  read -r CAL_START CAL_END CAL_START_MS CAL_DATE <<<"$(python3 -I - "$dtz" <<'PY'
import sys, datetime as dt
from zoneinfo import ZoneInfo
z = ZoneInfo(sys.argv[1])
now = dt.datetime.now(z)
d = now.date() + dt.timedelta(days=(7 - now.weekday()) % 7 or 7)
s = dt.datetime(d.year, d.month, d.day, 14, 0, tzinfo=z)
e = s + dt.timedelta(hours=1)
iso = lambda t: t.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")
print(iso(s), iso(e), int(s.timestamp() * 1000), s.strftime("%a %-d %b"))
PY
)"
  export CAL_START CAL_END
  conv="$(fx conv | sed -n 's/^uientry: conv=//p')"
  write_script "2099-01-01T00:00:00.000Z" "${conv:-dm:none}"; start_llm

  # -- Harsha's request in the Risi chat → one action card in one turn
  back_to_list || fail "calendar: back to the chat list (Risi chat)"
  wait_text "Risi" 30 || fail "calendar: the chat list has no Risi entry"
  tap "Risi" || fail "calendar: open the Risi chat"
  wait_for 'text="Ask Risi…"' 60 || fail "calendar: the Risi chat didn't open"
  r0="$(reqs)"
  tap "Ask Risi…" || true; sleep 0.5
  A shell input text "add%smy%sinterview%swith%sShenika%son%sMonday%s12%sOct%sat%s2pm%sto%smy%scalendar"; sleep 0.5
  tap "Send" || fail "calendar: send Harsha's request"
  wait_text "2–3 PM" 120 || fail "calendar: no action card (2–3 PM)"
  wait_text "Add" 30 || fail "calendar: the action card has no [Add]"
  has 'text="Edit"' || fail "calendar: the action card has no [Edit]"
  has 'text="Cancel"' || fail "calendar: the action card has no [Cancel]"
  has 'text="Choose calendar"' || fail "calendar: first use: the card doesn't offer 'Choose calendar'"
  [ "$(count_text "2–3 PM")" = 1 ] || fail "calendar: want exactly one action card ($(count_text "2–3 PM") cards)"
  # (The server may drop the question/confirm chips itself; the app hides them in any case.)
  has 'Confirm to add the event' && fail "calendar: a confirm-phrase chip is shown ('Confirm to add the event')"
  has 'What else is on Monday?' && fail "calendar: a question chip is shown ('What else is on Monday?')"
  # The card's top (title, date) above the fold: scroll it into view for the check and the screenshot.
  for _ in 1 2 3 4; do has 'text="Interview with Shenika"' && break; A shell input swipe $((W / 2)) $((H * 35 / 100)) $((W / 2)) $((H * 55 / 100)) 300; sleep 1; done
  has 'text="Interview with Shenika"' || fail "calendar: the action card has no title"
  has "text=\"$CAL_DATE\"" || fail "calendar: the card doesn't show the date ($CAL_DATE)"
  [ "$(count_text "Interview with Shenika")" = 1 ] || fail "calendar: want exactly one action card title"
  shot "29-calendar-action-card"
  for _ in 1 2 3; do A shell input swipe $((W / 2)) $((H * 70 / 100)) $((W / 2)) $((H * 30 / 100)) 300; sleep 0.5; done
  wait_text "Remind me 30 min before" 30 || fail "calendar: the answer's usable chip is missing"
  pass "calendar: ONE action card (Interview with Shenika · $CAL_DATE · 2–3 PM · Choose calendar · Add/Edit/Cancel); no question/confirm chips"
  # A chip only fills the composer: no request goes out, and no "I don't see any event details".
  r1="$(reqs)"
  tap "Remind me 30 min before" || fail "calendar: tap the chip"
  sleep 8
  [ "$(reqs)" = "$r1" ] || fail "calendar: tapping a chip sent a request to Risi ($(reqs) vs $r1 model calls)"
  dump; [ "$(count_text "Remind me 30 min before")" -ge 2 ] || fail "calendar: the chip didn't fill the composer"
  has "see any event details" && fail "calendar: a chip produced \"I don't see any event details\""
  pass "calendar: the chip filled the composer and sent nothing (model calls unchanged: $r1)"
  # Empty the composer again (the EditText, not the chip).
  xy="$(python3 -I - "$WORK/ui-$DEV.xml" <<'PY'
import re, sys, xml.etree.ElementTree as ET
for n in ET.parse(sys.argv[1]).iter('node'):
    if n.get('class') == 'android.widget.EditText':
        x1, y1, x2, y2 = map(int, re.findall(r'\d+', n.get('bounds'))); print((x1 + x2) // 2, (y1 + y2) // 2); break
PY
)"
  [ -n "$xy" ] && { A shell input tap $xy; sleep 0.5; A shell input keyevent KEYCODE_MOVE_END; clear_field; hide_keyboard; }

  # -- [Add] → first use: the picker (only the writable Google calendar) → the event is on the calendar
  r2="$(reqs)"
  tap "Add" || fail "calendar: tap Add"
  wait_text "Choose a calendar" 15 || fail "calendar: first use: [Add] didn't open the calendar picker"
  has "text=\"$GACC · Google\"" || fail "calendar: the picker doesn't list '$GACC · Google'"
  has 'Holidays' && fail "calendar: the picker lists the read-only Holidays calendar"
  has 'Phone · Phone only' && fail "calendar: the picker lists the local Phone calendar although a Google calendar exists"
  shot "31-calendar-picker"
  pass "calendar: the picker lists only '$GACC · Google' (read-only and local calendars excluded)"
  tap "Use this calendar" || fail "calendar: pick the calendar"
  wait_text "Added to your Google Calendar: Interview with Shenika · $CAL_DATE, 2–3 PM" 90 || fail "calendar: no 'Added to your Google Calendar: …' on the card"
  wait_text "Open" 30 || fail "calendar: the success line has no [Open]"
  wait_text "Undo" 30 || fail "calendar: the success line has no [Undo]"
  shot "30-calendar-added"
  ev="$(A shell "content query --uri content://com.android.calendar/events --projection _id:calendar_id:title:dtstart:dtend:deleted" 2>/dev/null | tr -d '\r' | grep 'title=Interview with Shenika,' | grep 'deleted=0' || true)"
  [ -n "$ev" ] || fail "calendar: no 'Interview with Shenika' event in CalendarContract"
  [ "$(printf '%s\n' "$ev" | wc -l)" = 1 ] || fail "calendar: more than one event added: $ev"
  printf '%s\n' "$ev" | grep -q "calendar_id=$GCAL_ID," || fail "calendar: the event isn't in the Google calendar $GCAL_ID: $ev"
  printf '%s\n' "$ev" | grep -q "dtstart=$CAL_START_MS," || fail "calendar: the event's start isn't $CAL_START: $ev"
  printf '%s\n' "$ev" | grep -q "dtend=$((CAL_START_MS + 3600000))," || fail "calendar: the event's end isn't +1 h: $ev"
  [ "$(reqs)" = "$r2" ] || fail "calendar: [Add] cost a model call ($(reqs) vs $r2): it must run the tool directly"
  turns="$(( r2 - r0 ))"
  [ "$turns" -le 2 ] || fail "calendar: the card took $turns model calls (want one turn: ≤ 2 steps)"
  pass "calendar: on the Google calendar (id $GCAL_ID, $CAL_START, 1 h) after one card and one [Add]; model calls: $turns for the turn, 0 for [Add]"
  # -- Undo: the server's undo → calendar_remove on this phone → the event is gone
  tap "Undo" || fail "calendar: tap Undo"
  gone=""
  for _ in $(seq 1 45); do
    A shell "content query --uri content://com.android.calendar/events --projection _id:title:deleted" 2>/dev/null | tr -d '\r' | grep 'title=Interview with Shenika,' | grep -q 'deleted=0' || { gone=1; break; }
    sleep 1
  done
  [ -n "$gone" ] || fail "calendar: Undo didn't remove the event"
  has 'text="Undo"' && fail "calendar: [Undo] is still offered after the undo"
  pass "calendar: Undo removed the event (calendar_remove of this phone's own add)"
  has "see any event details" && fail "calendar: \"I don't see any event details\" appeared"

  # -- P0 calendar honesty (server 407606d/f063970, android 9c722e5/339bb36): a free/busy answer names what was
  # read. The scripted model says "You're free…" after calendar_check (risi_gate_script q3_free_busy); the match is
  # the server's own line "I checked: Phone calendar …", never the model's words.
  tap "Ask Risi…" || true; sleep 0.5
  A shell input text "Am%sI%sfree%sTuesday%s2pm?"; sleep 0.5
  tap "Send" || fail "calendar: send 'Am I free Tuesday 2pm?'"
  wait_for "I checked: Phone calendar" 120 || fail "calendar: the free/busy answer doesn't say 'I checked: Phone calendar …' (CalendarHonesty)"
  rc_line="$(python3 -I - "$WORK/ui-$DEV.xml" <<'PY'
import sys, xml.etree.ElementTree as ET
print(next((n.get('text') for n in ET.parse(sys.argv[1]).iter('node') if 'I checked: Phone calendar' in (n.get('text') or '')), '').replace('\n', ' '))
PY
)"
  echo "    answer: $rc_line"
  shot "39-calendar-i-checked"
  pass "calendar: 'Am I free Tuesday 2pm?' → the answer names what was read ('I checked: Phone calendar …')"

  # -- Settings → Risi skills → Calendar → Details: what Risi can read on this phone (android 9c722e5). The test tags
  # risi_calendar_sources / risi_calendar_source_row / risi_calendar_sources_permission aren't exported to
  # uiautomator (no testTagsAsResourceId), so their visible texts are matched: "What Risi can read" (the block),
  # "Phone calendar: permission on" (the permission line), "<calendar> · N events in the next 7 days" (a row).
  settings_open "Risi skills" || fail "calendar: Settings → 'Risi skills' didn't open (Details)"
  reveal "Calendar skill" || fail "calendar: Risi skills has no Calendar (Details)"
  # (A tap right after a swipe only stops the fling: tap again until the details are open.)
  # Bring the Calendar card's title to the upper quarter first ([Details] can sit behind the navigation bar).
  opened=""
  for _ in 1 2 3; do
    cy="$(node_xy "Calendar" | awk '{print $2}')"
    [ -n "$cy" ] && [ "$cy" -gt $((H * 30 / 100)) ] && { A shell input swipe $((W / 2)) "$cy" $((W / 2)) $((H * 20 / 100)) 800; }
    sleep 1.5
    tap_below "Calendar" "Details" || fail "calendar: Risi skills → Calendar has no [Details]"
    sleep 2
    { has 'text="What Risi can read"' || has 'text="Can"' || has 'text="Cannot"'; } && { opened=1; break; }
  done
  [ -n "$opened" ] || fail "calendar: Calendar → [Details] didn't open"
  found=0
  for _ in 1 2 3 4 5 6 7 8; do
    has 'text="What Risi can read"' && has 'text="Phone calendar: permission on"' && has 'events in the next 7 days' && { found=1; break; }
    A shell input swipe $((W / 2)) $((H * 70 / 100)) $((W / 2)) $((H * 40 / 100)) 400; sleep 1
  done
  [ "$found" = 1 ] || fail "calendar: Calendar → Details lacks 'What Risi can read' / 'Phone calendar: permission on' / a calendar row (risi_calendar_sources, _permission, _source_row)"
  shot "40-calendar-details-sources"
  pass "calendar: Settings → Risi skills → Calendar → Details shows what Risi can read (sources block, permission line, calendar rows)"
  back_to_list || true
  logcat_ok "calendar"
fi

# P0 calendar honesty, no read: calendar permission revoked → "Am I still free Tuesday 2pm?" (calendar_check is
# then not offered; the scripted model claims "free … clear" without a check) → the server's "I couldn't read your
# calendar on this phone (…)", never "free"/"clear". Run last (after step 13, which needs the permission).
calendar_revoke_check() {
  DEV=A
  A shell pm revoke "$PKG" android.permission.READ_CALENDAR 2>/dev/null || true
  A shell pm revoke "$PKG" android.permission.WRITE_CALENDAR 2>/dev/null || true
  sleep 2
  open_risi_chat || fail "calendar (revoked): A can't open its Risi chat"
  tap "Ask Risi…" || true; sleep 0.5
  A shell input text "Am%sI%sstill%sfree%sTuesday%s2pm?"; sleep 0.5
  tap "Send" || fail "calendar (revoked): send 'Am I still free Tuesday 2pm?'"
  local ok="" ans=""
  for _ in $(seq 1 120); do
    dump
    ans="$(python3 -I - "$WORK/ui-$DEV.xml" <<'PY'
import re, sys, xml.etree.ElementTree as ET
nodes = [(int(re.findall(r'\d+', n.get('bounds'))[1]), n.get('text') or '') for n in ET.parse(sys.argv[1]).iter('node')]
hits = sorted((y, t) for y, t in nodes if "couldn't read" in t)
print(hits[-1][1].replace('\n', ' ') if hits else '')
PY
)"
    [ -n "$ans" ] && { ok=1; break; }
    has 'Open Risi skills' && break
    sleep 1
  done
  [ -n "$ok" ] || { shot "41-calendar-revoked"; fail "calendar (revoked): the answer doesn't say it couldn't read the calendar"; }
  echo "    answer: $ans"
  printf '%s' "$ans" | grep -qiE '\b(free|clear)\b' && fail "calendar (revoked): the no-read answer still says free/clear: $ans"
  shot "41-calendar-revoked"
  pass "calendar (revoked): 'Am I still free Tuesday 2pm?' → \"couldn't read\", no free/clear (the model's claim discarded)"
  A shell pm grant "$PKG" android.permission.READ_CALENDAR 2>/dev/null || true
  A shell pm grant "$PKG" android.permission.WRITE_CALENDAR 2>/dev/null || true
}

# ---------------------------------------------------------------- 13. (--offers, server items 8-10) offers, clarify, My promises, dedupe
if [ "$OFFERS" = 1 ] && { [ "$ONLY" = 00000 ] || [ "${UITEST_OFFERS_ONLY:-0}" = 1 ]; }; then
  DEV=A
  calendar_setup offers
  size="$(A shell wm size | grep -oE '[0-9]+x[0-9]+' | tail -1)"; W="${size%x*}"; H="${size#*x}"
  # The timed item: 15:00 two days ahead in A's zone on the server (the model's due_local is read there); B's
  # all-day item that day; the repeat at 15:30 (same 24-h window); [New date] picks three days ahead, 10:00.
  stz="$(ofx tz | sed -n 's/^uientry: tz=//p')"; [ -n "$stz" ] || fail "offers: fixture: A's zone"
  dtz="$(A shell getprop persist.sys.timezone | tr -d '\r')"; dtz="${dtz:-UTC}"
  read -r OFF_T_DUE OFF_B_DUE OFF_R_DUE OFF_T_MS OFF_D2 <<<"$(python3 -I - "$stz" "$dtz" <<'PY'
import sys, datetime as dt
from zoneinfo import ZoneInfo
s, d = ZoneInfo(sys.argv[1]), ZoneInfo(sys.argv[2])
d1 = dt.datetime.now(s).date() + dt.timedelta(days=2)
t = dt.datetime(d1.year, d1.month, d1.day, 15, 0, tzinfo=s)
d2 = dt.datetime.now(d).date() + dt.timedelta(days=3)
print(t.strftime("%Y-%m-%dT%H:%M"), d1.isoformat(), t.strftime("%Y-%m-%dT15:30"), int(t.timestamp() * 1000), d2.isoformat())
PY
)"
  export OFF_T_DUE OFF_B_DUE OFF_R_DUE
  conv="$(fx conv | sed -n 's/^uientry: conv=//p')"
  write_script "2099-01-01T00:00:00.000Z" "${conv:-dm:none}"; start_llm
  T_TEXT="Call the supplier about the cement delivery"; V1_TEXT="Share the safety audit report"
  V2_TEXT="Check the crane hire quote"; B_TEXT="Send the site photos"

  # -- discussion 1 in the 1:1 Official → A's Risi chat: the offer and two questions
  DEV=A; official_tab B || fail "offers: A can't open the DM's Official tab"
  DEV=B; official_tab A || fail "offers: B can't open the DM's Official tab"
  DEV=A; say "I will call the supplier about the cement delivery" || fail "offers: A message 1"
  DEV=B; say "Good. I will send the site photos that day" || fail "offers: B message 2"
  DEV=A; say "I will share the safety audit report sometime next week" || fail "offers: A message 3"
  DEV=B; say "Thanks, the audit matters" || fail "offers: B message 4"
  DEV=A; say "I will check the crane hire quote soon" || fail "offers: A message 5"
  DEV=B; say "Perfect, talk then" || fail "offers: B message 6"
  pass "offers: A and B discussed in Official (6 messages)"
  DEV=A; open_risi_chat || fail "offers: A can't open its Risi chat"
  # The quiet rule, the extraction, then the cards (the server's record first: the newest cards push the offer up).
  t0=$(date +%s)
  until item_line "$T_TEXT" | grep -q '|calendar:offered'; do
    [ $(( $(date +%s) - t0 )) -gt $(( QUIET_S + 180 )) ] && { ofx state | sed 's/^/    /'; fail "offers: the server made no calendar offer of the timed item (quiet rule → extraction → offer)"; }
    sleep 3
  done
  wait_text "Risi · When is it due?" 60 || fail "offers: A's Risi chat shows no 'Risi · When is it due?' card (vague items)"
  scroll_to "Risi · Add to calendar?" || fail "offers: no 'Risi · Add to calendar?' card in A's Risi chat (timed item)"
  for _ in 1 2 3 4; do has "text=\"$T_TEXT\"" && has 'text="Edit"' && break; A shell input swipe $((W / 2)) $((H * 60 / 100)) $((W / 2)) $((H * 42 / 100)) 300; sleep 1; done
  has "text=\"$T_TEXT\"" || fail "offers: the offer card doesn't name the item ('$T_TEXT')"
  has 'text="Add"' || fail "offers: the offer card has no [Add]"
  has 'text="Edit"' || fail "offers: the offer card has no [Edit]"
  shot "32-offer-add-to-calendar"
  pass "offers (a): A's Risi chat: 'Risi · Add to calendar?' with '$T_TEXT' and Add / Edit / Cancel"

  # -- (a) [Add] → the event on A's Google calendar, with no model call
  r2="$(reqs)"
  tap_below "Risi · Add to calendar?" "Add" || fail "offers: tap Add on the offer"
  sleep 2
  if has "Choose a calendar"; then
    has "text=\"$GACC · Google\"" || fail "offers: the picker doesn't list '$GACC · Google'"
    tap "Use this calendar" || fail "offers: pick the calendar"
  fi
  wait_text "Added to your Google Calendar: $T_TEXT*" 90 || fail "offers: no 'Added to your Google Calendar: $T_TEXT …' after [Add]"
  ev="$(A shell "content query --uri content://com.android.calendar/events --projection _id:calendar_id:title:dtstart:dtend:deleted" 2>/dev/null | tr -d '\r' | grep "title=$T_TEXT," | grep 'deleted=0' || true)"
  [ -n "$ev" ] || fail "offers: no '$T_TEXT' event in CalendarContract"
  [ "$(printf '%s\n' "$ev" | wc -l)" = 1 ] || fail "offers: more than one event added: $ev"
  printf '%s\n' "$ev" | grep -q "calendar_id=$GCAL_ID," || fail "offers: the event isn't in the Google calendar $GCAL_ID: $ev"
  printf '%s\n' "$ev" | grep -q "dtstart=$OFF_T_MS," || fail "offers: the event's start isn't the item's due ($OFF_T_DUE $stz = $OFF_T_MS): $ev"
  printf '%s\n' "$ev" | grep -q "dtend=$((OFF_T_MS + 3600000))," || fail "offers: the event's end isn't +1 h: $ev"
  [ "$(reqs)" = "$r2" ] || fail "offers: [Add] cost a model call ($(reqs) vs $r2)"
  for _ in $(seq 1 20); do item_line "$T_TEXT" | grep -q '|calendar:added$' && break; sleep 1; done
  item_line "$T_TEXT" | grep -q '|calendar:added$' || fail "offers: the offer isn't recorded as added: $(item_line "$T_TEXT")"
  shot "33-offer-added"
  pass "offers (a): [Add] → '$T_TEXT' read back from the Google calendar (id $GCAL_ID, $OFF_T_DUE $stz, 1 h); 0 model calls"

  # -- (b) the vague item's question → [New date] → item_edit → its calendar offer
  scroll_to "When is \"$V1_TEXT\" due?*" || fail "offers: no 'When is \"$V1_TEXT\" due?' question"
  has 'text="Risi · When is it due?"' || fail "offers: the question card's header isn't 'Risi · When is it due?'"
  item_line "$V1_TEXT" | grep -q '|true|' || fail "offers: '$V1_TEXT' isn't marked needs_clarification: $(item_line "$V1_TEXT")"
  item_line "$V1_TEXT" | grep -q 'calendar:' && fail "offers: a vague item got a calendar offer: $(item_line "$V1_TEXT")"
  shot "34-clarify-when-due"
  pass "offers (b): '$V1_TEXT' (vague) → 'Risi · When is it due?', no calendar offer"
  tap_below "When is \"$V1_TEXT\" due?*" "New date" || fail "offers: no [New date] on the question"
  wait_text "Pick a date" 15 || fail "offers: [New date] didn't open the date form"
  tap "Pick a date" || fail "offers: tap Pick a date"
  sleep 1
  pick_day "$OFF_D2" || fail "offers: the date picker has no $OFF_D2"
  sleep 0.5; tap "OK" || fail "offers: confirm the date"
  wait_text "Pick a time" 10 || fail "offers: no 'Pick a time' after the date"
  tap "Pick a time" || fail "offers: tap Pick a time"
  sleep 1; tap "OK" || fail "offers: confirm the time (10:00)"
  wait_text "10:00 AM" 10 || fail "offers: the form doesn't show 10:00 AM"
  shot "35-clarify-new-date"
  tap "Save" || fail "offers: tap Save"
  for _ in $(seq 1 30); do item_line "$V1_TEXT" | grep -q '|calendar:offered' && break; sleep 2; done
  item_line "$V1_TEXT" | grep -q '|edited|false|' || fail "offers: item_edit didn't set the date: $(item_line "$V1_TEXT")"
  item_line "$V1_TEXT" | grep -q '|calendar:offered' || fail "offers: no calendar offer after the new date: $(item_line "$V1_TEXT")"
  for _ in 1 2 3; do A shell input swipe $((W / 2)) $((H * 65 / 100)) $((W / 2)) $((H * 25 / 100)) 300; sleep 0.5; done
  wait_text "$V1_TEXT" 60 || fail "offers: no offer card for '$V1_TEXT' after the new date"
  wait_text "10–11 AM" 30 || fail "offers: the new offer isn't 10–11 AM"
  d2_label="$(python3 -I -c 'import sys, datetime as dt; d = dt.date.fromisoformat(sys.argv[1]); print(d.strftime("%a ") + str(d.day) + d.strftime(" %b"))' "$OFF_D2")"
  has "text=\"$d2_label\"" || fail "offers: the new offer isn't on $d2_label"
  shot "36-clarify-then-offer"
  scroll_to "New date sent" || fail "offers: the question card doesn't say 'New date sent' after Save"
  pass "offers (b): [New date] → $OFF_D2 10:00 → item_edit ('New date sent') → 'Add to calendar?' for '$V1_TEXT' (10–11 AM)"

  # -- ✓ the timed item and the other vague one (A), B's item (B): My promises lists confirmed items only
  tap_below "• $V2_TEXT" "✓" || fail "offers: ✓ on '$V2_TEXT'"
  tap_below "• $T_TEXT" "✓" || fail "offers: ✓ on '$T_TEXT'"
  DEV=B; open_risi_chat || fail "offers: B can't open its Risi chat"
  sleep 2; scroll_to "• $B_TEXT" || fail "offers: B's Risi chat doesn't list '$B_TEXT'"
  tap_below "• $B_TEXT" "✓" || fail "offers: B's ✓ on '$B_TEXT'"
  DEV=A
  ok=""
  for _ in $(seq 1 30); do
    st="$(ofx state)"
    printf '%s\n' "$st" | grep -qF "A|$V2_TEXT|confirmed|true|" && printf '%s\n' "$st" | grep -qF "A|$T_TEXT|confirmed|" \
      && printf '%s\n' "$st" | grep -qF "B|$B_TEXT|confirmed|" && { ok=1; break; }
    sleep 1
  done
  [ -n "$ok" ] || { printf '%s\n' "$st" | sed 's/^/    /'; fail "offers: the ✓ didn't confirm the items"; }
  item_line "$T_TEXT" | grep -q '|calendar:added$' || fail "offers: ✓ changed the timed item's offers: $(item_line "$T_TEXT")"
  pass "offers: ✓ '$T_TEXT' and '$V2_TEXT' (A), ✓ '$B_TEXT' (B); still one offer of '$T_TEXT' (added)"

  # -- (d) discussion 2 repeats the timed promise in other words → merged, nothing new
  st0="$(ofx state)"; n0="$(printf '%s\n' "$st0" | grep -c '^uientry: item ')"; d0="$(printf '%s\n' "$st0" | sed -n 's/^uientry: discussions=//p')"
  DEV=A; official_tab B || fail "offers: A can't reopen the Official tab"
  DEV=B; official_tab A || fail "offers: B can't reopen the Official tab"
  DEV=A; say "Just a reminder about the supplier call" || fail "offers: A repeat 1"
  DEV=B; say "Yes, please call the cement supplier about the delivery" || fail "offers: B repeat 2"
  DEV=A; say "I will call the cement supplier about the delivery, same time" || fail "offers: A repeat 3"
  DEV=B; say "Great" || fail "offers: B repeat 4"
  DEV=A; say "Talk then" || fail "offers: A repeat 5"
  DEV=B; say "Bye for now" || fail "offers: B repeat 6"
  hits=0
  for _ in $(seq 1 $(( QUIET_S + 180 ))); do
    hits="$(curl -sf "http://127.0.0.1:$LLM_PORT/script/hits" | python3 -I -c 'import json,sys; h=json.load(sys.stdin); print(h.get("offers_repeat_u1",0)+h.get("offers_repeat_u2",0))' 2>/dev/null || echo 0)"
    [ "$hits" -gt 0 ] && break; sleep 1
  done
  [ "$hits" -gt 0 ] || fail "offers: the repeat discussion was never summarised (quiet rule)"
  sleep 8
  st1="$(ofx state)"; n1="$(printf '%s\n' "$st1" | grep -c '^uientry: item ')"; d1="$(printf '%s\n' "$st1" | sed -n 's/^uientry: discussions=//p')"
  [ "$n1" = "$n0" ] || { printf '%s\n' "$st1" | sed 's/^/    /'; fail "offers: the repeated promise became a new row ($n0 → $n1 items)"; }
  [ "$d1" = "$d0" ] || fail "offers: a summary of only repeats was stored/posted ($d0 → $d1 discussions)"
  printf '%s\n' "$st1" | grep -q '|Call the cement supplier about the delivery|' && fail "offers: the repeat is stored as its own item"
  [ "$(printf '%s\n' "$st1" | grep -cF "|$T_TEXT|")" = 1 ] || fail "offers: '$T_TEXT' isn't exactly one row"
  item_line "$T_TEXT" | grep -q '|calendar:added$' || fail "offers: the merge offered '$T_TEXT' again: $(item_line "$T_TEXT")"
  pass "offers (d): the same promise said again → merged into '$T_TEXT' (items $n0 → $n1, discussions $d0 → $d1, one offer)"

  # -- (c) Settings → My promises: the split, the digest's totals, "Needs a date", tap → the source chat
  read -r TI TP TO TN <<<"$(ofx totals | sed -n 's/^uientry: totals=\([0-9]*\) \([0-9]*\) \([0-9]*\) n=\([0-9]*\)/\1 \2 \3 \4/p')"
  [ -n "${TI:-}" ] || fail "offers: fixture: the digest totals"
  [ "$TI" -ge 3 ] && [ "$TP" -ge 1 ] || fail "offers: digest totals i_promised=$TI promised_to_me=$TP (want ≥ 3 and ≥ 1)"
  DEV=A; settings_open "My promises" || fail "offers: Settings → 'My promises' didn't open"
  wait_text "I promised ($TI)" 30 || fail "offers: My promises has no 'I promised ($TI)' (the digest's i_promised)"
  wait_text "Needs a date" 10 || fail "offers: My promises has no 'Needs a date' row"
  [ "$(count_text "$T_TEXT")" = 1 ] || fail "offers: My promises shows '$T_TEXT' $(count_text "$T_TEXT") times (want 1)"
  has "text=\"$V2_TEXT\"" || fail "offers: My promises doesn't list '$V2_TEXT'"
  for _ in 1 2 3 4; do has "text=\"Promised to me ($TP)\"" && break; A shell input swipe $((W / 2)) $((H * 70 / 100)) $((W / 2)) $((H * 40 / 100)) 300; sleep 1; done
  has "text=\"Promised to me ($TP)\"" || fail "offers: My promises has no 'Promised to me ($TP)' (the digest's promised_to_me)"
  has "text=\"$B_TEXT\"" || fail "offers: 'Promised to me' doesn't list '$B_TEXT'"
  shot "37-my-promises-split"
  pass "offers (c): My promises: 'I promised ($TI)', 'Promised to me ($TP)' (= the digest's totals), a 'Needs a date' row, '$T_TEXT' once"
  for _ in 1 2 3 4; do has "text=\"$V2_TEXT\"" && break; A shell input swipe $((W / 2)) $((H * 40 / 100)) $((W / 2)) $((H * 70 / 100)) 300; sleep 1; done
  tap "$V2_TEXT" || fail "offers: tap the '$V2_TEXT' row"
  wait_for 'Risi is listening' 30 || fail "offers: the row didn't open its source chat (the Official)"
  has 'ZZ UI B' || fail "offers: the opened chat isn't the one with ZZ UI B"
  shot "38-my-promises-opens-chat"
  pass "offers (c): tapping '$V2_TEXT' opens its source chat (the 1:1 Official with ZZ UI B)"
  back_to_list || true
  DEV=A; logcat_ok "offers"
  DEV=B; logcat_ok "offers"
  DEV=A
fi

if [ "$CALENDAR" = 1 ] && { [ "$ONLY" = 00000 ] || [ "${UITEST_CALENDAR_ONLY:-0}" = 1 ]; }; then calendar_revoke_check; fi

# ---------------------------------------------------------------- 14-16. (--risi-calendar, --risi-notes) Risi Calendar and Notes
# Taps the text/content-desc $2 nearest below a node with the exact text $1 (the lowest such anchor that has one within
# 600 px: an item's title can also be an invite card's title). No scrolling.
tap_near_below() {
  local xy
  dump
  xy="$(python3 -I - "$WORK/ui-$DEV.xml" "$1" "$2" <<'PY'
import re, sys, xml.etree.ElementTree as ET
try:
    nodes = list(ET.parse(sys.argv[1]).iter('node'))
except ET.ParseError:
    nodes = []
def c(n):
    x1, y1, x2, y2 = map(int, re.findall(r'\d+', n.get('bounds'))); return (x1 + x2) // 2, (y1 + y2) // 2
anchors = [c(n) for n in nodes if (n.get('text') or '') == sys.argv[2]]
targets = [c(n) for n in nodes if sys.argv[3] in ((n.get('text') or ''), (n.get('content-desc') or ''))]
for ax, ay in sorted(anchors, key=lambda p: -p[1]):
    below = sorted((ty, tx) for tx, ty in targets if ay < ty < ay + 600)
    if below:
        print(below[0][1], below[0][0]); break
PY
)"
  [ -n "$xy" ] || { echo "    [$DEV] no '$2' below '$1'"; return 1; }
  A shell input tap $xy
}
# Exact visible text only (as step 8b's tap_text, which isn't defined with UITEST_*_ONLY); dumps first.
tap_exact() {
  local xy
  dump
  xy="$(python3 -I - "$WORK/ui-$DEV.xml" "$1" <<'PY'
import re, sys, xml.etree.ElementTree as ET
try:
    nodes = list(ET.parse(sys.argv[1]).iter('node'))
except ET.ParseError:
    nodes = []
for n in nodes:
    if (n.get('text') or '') == sys.argv[2]:
        x1, y1, x2, y2 = map(int, re.findall(r'\d+', n.get('bounds')))
        print((x1 + x2) // 2, (y1 + y2) // 2); break
PY
)"
  [ -n "$xy" ] || { echo "    [$DEV] no text node: $1"; return 1; }
  A shell input tap $xy
}
# Runs "$@" until it succeeds, scrolling the chat a little older between tries (from the newest end), then newer.
scroll_until() {
  local i
  for i in $(seq 1 24); do
    "$@" >/dev/null 2>&1 && return 0
    if [ "$i" -le 14 ]; then A shell input swipe $((W / 2)) $((H * 35 / 100)) $((W / 2)) $((H * 55 / 100)) 300
    else A shell input swipe $((W / 2)) $((H * 55 / 100)) $((W / 2)) $((H * 35 / 100)) 300; fi
    sleep 1
  done
  echo "    [$DEV] not found while scrolling: $*"; return 1
}
has_checkbox() { [ -n "$(checkbox_of "$1")" ]; }
# The lowest node whose content-desc is $1 (a list row's ⋮ "More" below the top bar's).
tap_last_desc() {
  local xy
  dump
  xy="$(python3 -I - "$WORK/ui-$DEV.xml" "$1" <<'PY'
import re, sys, xml.etree.ElementTree as ET
try:
    nodes = list(ET.parse(sys.argv[1]).iter('node'))
except ET.ParseError:
    nodes = []
hits = []
for n in nodes:
    if (n.get('content-desc') or '') == sys.argv[2]:
        x1, y1, x2, y2 = map(int, re.findall(r'\d+', n.get('bounds'))); hits.append(((y1 + y2) // 2, (x1 + x2) // 2))
if hits:
    y, x = max(hits); print(x, y)
PY
)"
  [ -n "$xy" ] || { echo "    [$DEV] no node described '$1'"; return 1; }
  A shell input tap $xy
}
# "x y true|false": the tick-box on the row of the item titled $1 (a note's Agreed item; the lowest such row).
checkbox_of() {
  dump
  python3 -I - "$WORK/ui-$DEV.xml" "$1" <<'PY'
import re, sys, xml.etree.ElementTree as ET
try:
    nodes = list(ET.parse(sys.argv[1]).iter('node'))
except ET.ParseError:
    nodes = []
b = lambda n: list(map(int, re.findall(r'\d+', n.get('bounds'))))
texts = [b(n) for n in nodes if (n.get('text') or '') == sys.argv[2]]
boxes = [(b(n), n.get('checked')) for n in nodes if n.get('class') == 'android.widget.CheckBox']
for t in sorted(texts, key=lambda r: -r[1]):
    ty = (t[1] + t[3]) // 2
    near = [(abs((x[1] + x[3]) // 2 - ty), x, ch) for x, ch in boxes if x[2] <= t[0] + 10 and abs((x[1] + x[3]) // 2 - ty) < 110]
    if near:
        _, x, ch = min(near)
        print((x[0] + x[2]) // 2, (x[1] + x[3]) // 2, ch); break
PY
}
wait_checkbox() {  # $1 item title, $2 true|false, $3 s
  local r
  for _ in $(seq 1 "${3:-30}"); do r="$(checkbox_of "$1")"; [ "${r##* }" = "$2" ] && return 0; sleep 1; done
  echo "    [$DEV] the tick-box of '$1' isn't checked=$2 (${r:-no tick-box})"; return 1
}
wait_item() {  # $1 = a fixed string of `ofx state`'s item line ("A|text|state|"), $2 s
  local t0; t0=$(date +%s)
  until ofx state | grep -qF "$1"; do [ $(( $(date +%s) - t0 )) -gt "${2:-60}" ] && return 1; sleep 3; done
}
# Steps 14-15's times, in A's zone on the server: Shenika's interview tomorrow 14:00 (the earliest timed item: the
# backfill creates events by due, ≤ 3 Risi-made events per Official chat per day), the note's item +4 d 17:00 and
# its meeting +5 d 11:00 (a meeting at an item's time would be skipped).
rc_dates() {
  [ -n "${RC_SEED_DUE:-}" ] && return 0
  local stz; stz="$(ofx tz | sed -n 's/^uientry: tz=//p')"; [ -n "$stz" ] || fail "risi: fixture: A's zone"
  read -r RC_SEED_DUE RN_ITEM_DUE RN_MEET <<<"$(python3 -I - "$stz" <<'PY'
import sys, datetime as dt
from zoneinfo import ZoneInfo
d = dt.datetime.now(ZoneInfo(sys.argv[1])).date()
f = lambda n, hm: (d + dt.timedelta(days=n)).isoformat() + "T" + hm
print(f(1, "14:00"), f(4, "17:00"), f(5, "11:00"))
PY
)"
  RC_START="$RC_SEED_DUE"
  export RC_SEED_DUE RN_ITEM_DUE RN_MEET RC_START
}
SEED_TEXT="ZZ UI B: interview with ZZ UI A"; RN_TEXT="Book the interview room"
NOTE_A="ZZ UI A × ZZ UI B · interview planning"; NOTE_B="ZZ UI B × ZZ UI A · interview planning"
restart_apps() {
  local d
  for d in A B; do DEV=$d; A shell am force-stop "$PKG"; A shell am start -W -n "$PKG/$CLS.MainActivity" >/dev/null 2>&1 || true; done
  for d in A B; do DEV=$d; wait_list 60 || fail "$1: $d's app didn't come back to its chat list"; dismiss_prompts; done
  DEV=A
}
# Restarts this run's temp server (same store) with the §29/§30 switches on or off.
switch_server() {
  stop_server || fail "risi: couldn't stop the temp server"
  if [ "$1" = on ]; then printf 'RISI_EVENTS=on\nRISI_NOTES=on\nRISI_LEDGER=on\nRISI_TOOLS=on\nRISI_SKILLS=on\n' > "$WORK/phase.env"; else : > "$WORK/phase.env"; fi
  LOGMARK="$(wc -l < "$WORK/server.log")"
  start_server
  local cfg; cfg="$(curl -sf "http://127.0.0.1:$PORT/api/v1/auth/config" || true)"
  if [ "$1" = on ]; then
    printf '%s' "$cfg" | grep -q '"risi_events":"on"' || fail "risi: /auth/config doesn't say risi_events: on ($cfg)"
    printf '%s' "$cfg" | grep -q '"risi_notes":"on"' || fail "risi: /auth/config doesn't say risi_notes: on ($cfg)"
  else
    printf '%s' "$cfg" | grep -qE '"risi_(events|notes)":"on"' && fail "risi: /auth/config still has risi_events/risi_notes on ($cfg)"
  fi
  return 0
}
open_settings_row() { settings_open "$1"; }  # $1 = the row's text in Settings

# -- 14, before the switch: Shenika's real case, an item with a concrete time agreed in Official (B owns it, B ✓ it).
if [ "$RCAL" = 1 ] && { [ "$ONLY" = 00000 ] || [ "${UITEST_RISI_ONLY:-0}" = 1 ]; }; then
  DEV=A; size="$(A shell wm size | grep -oE '[0-9]+x[0-9]+' | tail -1)"; W="${size%x*}"; H="${size#*x}"
  rc_dates
  conv="$(fx conv | sed -n 's/^uientry: conv=//p')"
  write_script "2099-01-01T00:00:00.000Z" "${conv:-dm:none}"; start_llm
  DEV=A; official_tab B || fail "risi-calendar: A can't open the DM's Official tab"
  DEV=B; official_tab A || fail "risi-calendar: B can't open the DM's Official tab"
  DEV=A; say "ZZ UI B, can you sit on the interview panel with me tomorrow at 2pm" || fail "risi-calendar: A seed 1"
  DEV=B; say "Yes, I will do the interview panel with you tomorrow at 2pm" || fail "risi-calendar: B seed 2"
  DEV=A; say "Great, the interview panel starts at 2pm" || fail "risi-calendar: A seed 3"
  DEV=B; say "I will bring the candidate notes" || fail "risi-calendar: B seed 4"
  DEV=A; say "Thanks" || fail "risi-calendar: A seed 5"
  DEV=B; say "See you tomorrow" || fail "risi-calendar: B seed 6"
  wait_item "B|$SEED_TEXT|" $(( QUIET_S + 180 )) || { ofx state | sed 's/^/    /'; fail "risi-calendar: the seed discussion gave no '$SEED_TEXT' item (quiet rule)"; }
  DEV=B; open_risi_chat || fail "risi-calendar: B can't open its Risi chat (seed)"
  scroll_to "• $SEED_TEXT" || fail "risi-calendar: B's Risi chat doesn't list '$SEED_TEXT'"
  tap_below "• $SEED_TEXT" "✓" || fail "risi-calendar: B's ✓ on '$SEED_TEXT'"
  wait_item "B|$SEED_TEXT|confirmed|" 60 || { ofx state | sed 's/^/    /'; fail "risi-calendar: B's ✓ didn't confirm '$SEED_TEXT'"; }
  pass "risi-calendar: before the switch, B (Shenika) agreed '$SEED_TEXT' at $RC_SEED_DUE in the 1:1 Official and confirmed it"
  DEV=A
fi

if [ "$RISI2" = 1 ] && { [ "$ONLY" = 00000 ] || [ "${UITEST_RISI_ONLY:-0}" = 1 ]; }; then
  DEV=A; size="$(A shell wm size | grep -oE '[0-9]+x[0-9]+' | tail -1)"; W="${size%x*}"; H="${size#*x}"
  rc_dates
  echo "==> the temp server again with RISI_EVENTS=on RISI_NOTES=on RISI_LEDGER=on (steps 14-15)"
  switch_server on
  restart_apps "risi on"
  for DEV in A B; do wait_for 'content-desc="Calendar"' 60 || fail "risi on: $DEV's chat list has no Calendar tab"; done
  DEV=A
  cu=""; for _ in $(seq 1 30); do cu="$(ofx caluser)"; [ "$cu" = "uientry: caluser=true true" ] && break; sleep 2; done
  [ "$cu" = "uientry: caluser=true true" ] || fail "risi on: A and B aren't calendar users (a device advertising risi_events): $cu"
  pass "risi on: /auth/config says risi_events/risi_notes on; both phones show the Calendar tab and advertise risi_events"
  [ "$RCAL" = 1 ] && export RC_LIVE=1
  conv="$(fx conv | sed -n 's/^uientry: conv=//p')"
  write_script "2099-01-01T00:00:00.000Z" "${conv:-dm:none}"; start_llm
  RMARK="$(wc -l < "$WORK/server.log")"

  # ---- 14. Harsha's replay → one Risi Calendar card → [Add] → the event; the Calendar tab's four views
  if [ "$RCAL" = 1 ]; then
    DEV=A
    A shell pm revoke "$PKG" android.permission.READ_CALENDAR 2>/dev/null || true
    A shell pm revoke "$PKG" android.permission.WRITE_CALENDAR 2>/dev/null || true
    A shell dumpsys package "$PKG" 2>/dev/null | grep -q 'android.permission.READ_CALENDAR: granted=true' && fail "risi-calendar: couldn't revoke READ_CALENDAR"
    open_risi_chat || fail "risi-calendar: A can't open its Risi chat"
    r0="$(reqs)"
    tap "Ask Risi…" || true; sleep 0.5
    A shell input text "add%smy%sinterview%swith%sShenika%son%sMonday%s12%sOct%sat%s2pm%sto%smy%scalendar"; sleep 0.5
    tap "Send" || fail "risi-calendar: send Harsha's request"
    wait_text "Risi · Add to Risi Calendar" 120 || fail "risi-calendar: no 'Risi · Add to Risi Calendar' card"
    for _ in $(seq 1 30); do [ $(( $(reqs) - r0 )) -ge 2 ] && break; sleep 1; done
    sleep 3
    turns=$(( $(reqs) - r0 ))
    [ "$turns" -le 2 ] || fail "risi-calendar: the card took $turns model calls (want ≤ 2: one turn)"
    dump
    [ "$(count_text "Risi · Add to Risi Calendar")" = 1 ] || fail "risi-calendar: want exactly one action card ($(count_text "Risi · Add to Risi Calendar"))"
    has 'text="Choose calendar"' && fail "risi-calendar: the card asks to choose a phone calendar (Risi Calendar needs no device calendar)"
    has 'text="Interview"' || fail "risi-calendar: the card has no title 'Interview'"
    shot "risi-calendar-action-card"
    pass "risi-calendar: Harsha's request → ONE 'Risi · Add to Risi Calendar' card in $turns model calls, with the calendar permission revoked"
    r2="$(reqs)"
    tap_below "Risi · Add to Risi Calendar" "Add" || fail "risi-calendar: tap Add"
    wait_text "Risi · Added to your Risi Calendar" 60 || fail "risi-calendar: no 'Risi · Added to your Risi Calendar' after [Add]"
    sleep 3
    [ "$(reqs)" = "$r2" ] || fail "risi-calendar: [Add] cost a model call ($(reqs) vs $r2)"
    ev=""; for _ in $(seq 1 20); do ev="$(ofx events A | grep -F 'uientry: event Interview|' | grep -v '|risi|' || true)"; [ -n "$ev" ] && break; sleep 1; done
    [ -n "$ev" ] || { ofx events A | sed 's/^/    /'; fail "risi-calendar: GET /risi/calendar/events (Calendar.list) has no 'Interview' for A"; }
    echo "    $ev"
    printf '%s\n' "$ev" | grep -q '|accepted|' || fail "risi-calendar: A's own event isn't accepted: $ev"
    pass "risi-calendar: [Add] → 'Added to your Risi Calendar', 0 model calls; the event is in A's Risi Calendar (server)"
    back_to_list || fail "risi-calendar: back to the chat list (Calendar tab)"
    tap "Calendar" || fail "risi-calendar: no Calendar tab"
    wait_text "Agenda" 20 || fail "risi-calendar: the Calendar tab has no Agenda"
    wait_text "Interview" 30 || fail "risi-calendar: the Agenda doesn't show 'Interview'"
    shot "calendar-agenda"
    tap "Day" || fail "risi-calendar: no Day view"; sleep 1
    tap "›" || fail "risi-calendar: Day: no ›"
    wait_text "Interview" 20 || fail "risi-calendar: the Day view (tomorrow) doesn't show 'Interview'"
    shot "calendar-day"
    tap "Week" || fail "risi-calendar: no Week view"
    # The event is tomorrow: late in this week (below the screen, e.g. on a Saturday) or, on a
    # Sunday, in next week's view. Scroll down in small steps; then page to the next week once.
    sleep 2; wk=""
    for pg in 1 2; do
      for _ in 1 2 3 4 5 6 7; do
        [ -n "$(node_xy "Interview")" ] && { wk=1; break; }
        A shell input swipe $((W / 2)) $((H * 70 / 100)) $((W / 2)) $((H * 45 / 100)) 1200; sleep 1
      done
      [ -n "$wk" ] && break
      [ "$pg" = 1 ] && { tap "›" || fail "risi-calendar: Week: no ›"; sleep 2; }
    done
    [ -n "$wk" ] || fail "risi-calendar: the Week view doesn't show 'Interview'"
    shot "calendar-week"
    tap "Month" || fail "risi-calendar: no Month view"; sleep 2
    shot "calendar-month"
    tap "Agenda" || true
    pass "risi-calendar: the Calendar tab shows the event in Agenda, Day and Week; Month renders"
    back_to_list || true
  fi

  # ---- 15. a note after a test discussion
  if [ "$RNOTES" = 1 ]; then
    DEV=A; official_tab B || fail "risi-notes: A can't open the DM's Official tab"
    DEV=B; official_tab A || fail "risi-notes: B can't open the DM's Official tab"
    DEV=A; say "We need a quiet interview room for the panel day" || fail "risi-notes: A message 1"
    DEV=B; say "I will lead the room walkthrough the day before" || fail "risi-notes: B message 2"
    DEV=A; say "I will book the interview room by Tuesday 5pm" || fail "risi-notes: A message 3"
    DEV=B; say "Good, let us walk through the room on Wednesday at 11" || fail "risi-notes: B message 4"
    DEV=A; say "Agreed" || fail "risi-notes: A message 5"
    DEV=B; say "Thanks, see you then" || fail "risi-notes: B message 6"
    pass "risi-notes: A and B discussed the interview room in Official (6 messages)"
    wait_item "A|$RN_TEXT|" $(( QUIET_S + 180 )) || { ofx state | sed 's/^/    /'; fail "risi-notes: no note item '$RN_TEXT' (quiet rule → note)"; }
    DEV=A; open_risi_chat || fail "risi-notes: A can't open its Risi chat"
    scroll_to "$NOTE_A*" || fail "risi-notes: A's Risi chat has no note card '$NOTE_A …'"
    # No §27 discussion summary was posted for this discussion: none below the note card.
    below="$(python3 -I - "$WORK/ui-A.xml" "$NOTE_A" <<'PY'
import re, sys, xml.etree.ElementTree as ET
nodes = [(int(re.findall(r'\d+', n.get('bounds'))[1]), n.get('text') or '') for n in ET.parse(sys.argv[1]).iter('node')]
ty = max((y for y, t in nodes if t.startswith(sys.argv[2])), default=None)
print(sum(1 for y, t in nodes if ty is not None and y > ty and t.startswith("Summary of your discussion")))
PY
)"
    [ "$below" = 0 ] || fail "risi-notes: a 'Summary of your discussion' card was posted with the note (want the note only)"
    # The card can be taller than the screen: remember each part once seen while scrolling down
    # from its title in small steps (a part may scroll off the top before the last one shows).
    s_ag=; s_it=; s_mt=; s_rw=
    for _ in 1 2 3 4 5; do
      has 'text="Agreed"' && s_ag=1; has "text=\"$RN_TEXT\"" && s_it=1
      has 'text="Meetings"' && s_mt=1; has '• Room walkthrough' && s_rw=1
      [ -n "$s_ag$s_it$s_mt$s_rw" ] && [ "$s_ag$s_it$s_mt$s_rw" = 1111 ] && break
      A shell input swipe $((W / 2)) $((H * 60 / 100)) $((W / 2)) $((H * 45 / 100)) 1200; sleep 1
    done
    [ -n "$s_ag" ] || fail "risi-notes: A's note card has no 'Agreed'"
    [ -n "$s_it" ] || fail "risi-notes: A's note card doesn't list '$RN_TEXT'"
    [ -n "$s_mt" ] || fail "risi-notes: A's note card has no 'Meetings'"
    [ -n "$s_rw" ] || fail "risi-notes: A's note card has no meeting 'Room walkthrough'"
    shot "note-card"
    pass "risi-notes: A's Risi chat: the note card '$NOTE_A …' with Agreed ($RN_TEXT, owner + due) and Meetings (Room walkthrough); no discussion summary"
    DEV=B; open_risi_chat || fail "risi-notes: B can't open its Risi chat"
    scroll_to "$NOTE_B*" || fail "risi-notes: B's Risi chat has no note card '$NOTE_B …' (her name first)"
    pass "risi-notes: B's Risi chat has the same note ('$NOTE_B …')"
    DEV=A; official_tab B || fail "risi-notes: A can't reopen Official"
    scroll_to "Risi · Notes saved" || fail "risi-notes: no 'Risi · Notes saved' card in Official"
    for _ in 1 2 3; do has 'text="Notes saved · open"' && break; A shell input swipe $((W / 2)) $((H * 60 / 100)) $((W / 2)) $((H * 45 / 100)) 300; sleep 1; done
    has 'text="Notes saved · open"' || fail "risi-notes: the Official card has no [Notes saved · open]"
    shot "notes-saved-official"
    pass "risi-notes: Official has 'Risi · Notes saved' with [Notes saved · open]"
    back_to_list || true
  fi

  # ---- 14. Shenika backfill: the release task inside the test server → invites in both Risi chats → both accept
  if [ "$RCAL" = 1 ]; then
    DEV=A
    out="$(cd server && timeout 120 $M elixir --sname "uientry_rpc_$$" --cookie "$COOKIE" --erl '-kernel inet_dist_use_interface {127,0,0,1}' --rpc-eval "$NODE@$(hostname -s)" 'RisiMe.Release.risi_calendar_backfill(dry_run: false)' 2>&1 || true)"
    printf '%s\n' "$out" | tail -2 | sed 's/^/    release task: /'
    ev=""; for _ in $(seq 1 45); do ev="$(ofx events B | grep -F 'uientry: event Interview|risi|' || true)"; [ -n "$ev" ] && break; sleep 2; done
    [ -n "$ev" ] || { grep -a 'calendar backfill' "$WORK/server.log" | tail -3 | sed 's/^/    /'; fail "risi-calendar: the backfill made no 'Interview' event for B (Shenika)"; }
    echo "    $ev"
    printf '%s\n' "$ev" | grep -q '|proposed|proposed,proposed|active|' || fail "risi-calendar: the backfilled event isn't proposed for both: $ev"
    pass "risi-calendar: RisiMe.Release.risi_calendar_backfill(dry_run: false) in the test server → one proposed 'Interview' for A and B"
    DEV=B; open_risi_chat || fail "risi-calendar: B can't open its Risi chat (invite)"
