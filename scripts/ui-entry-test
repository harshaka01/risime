start_llm() {
  tmux kill-session -t "risime-uientry-llm$SUF" 2>/dev/null || true
  for _ in $(seq 1 20); do ss -ltnH "sport = :$LLM_PORT" | grep -q . || break; sleep 0.5; done
  local extra=""
  if [ "$SKILLS" = 1 ] || [ "$LEDGER_ON" = 1 ]; then [ -f "$WORK/llm-script.json" ] || write_script; extra="--script '$WORK/llm-script.json'"; fi
  tmux new -d -s "risime-uientry-llm$SUF" "python3 -I '$REPO/scripts/fake-llm' --port $LLM_PORT --record '$WORK/llm-requests.jsonl' $extra >> '$WORK/fake-llm.out' 2>&1"
  for _ in $(seq 1 20); do curl -sf -o /dev/null "http://127.0.0.1:$LLM_PORT/health" && break; sleep 0.5; done
  curl -sf -o /dev/null "http://127.0.0.1:$LLM_PORT/health" || { echo "fake-llm didn't start"; tail -5 "$WORK/fake-llm.out"; exit 1; }
}

