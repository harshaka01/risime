# The folder is FLAG_SECURE (black in screenshots, recordings and screen shares); uiautomator still reads it.
A exec-out screencap -p > "$WORK/folder.png" 2>/dev/null || fail "screencap of the folder"
lum="$(python3 -I - "$WORK/folder.png" <<'PY'
import sys
from PIL import Image, ImageStat
try:
    im = Image.open(sys.argv[1]).convert("L")
except Exception:
    print("refused"); sys.exit(0)  # screencap refuses a screen with a secure window (Android 14): also secure
w, h = im.size
# The app's area (the status bar is drawn by the system, not by the secure window).
print(int(ImageStat.Stat(im.crop((0, h // 10, w, h * 9 // 10))).mean[0]))
PY
)"
[ "$lum" = refused ] || [ "${lum:-255}" -le 16 ] || fail "the Locked chats folder is not FLAG_SECURE (screenshot mean luminance $lum, want black)"
pass "PIN → the Locked chats folder holds the chat; its window is secure (screenshot: $lum)"
