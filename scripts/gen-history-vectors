#!/usr/bin/env python3
"""Writes the history-sharing test vectors (PROTOCOL §17.3) to stdout, or checks them.

An independent Python reference for contract/v1/history_vectors.json, written from PROTOCOL §17.3,
§14.3 and RFC 9180 only (not from the Rust core). HPKE base mode for MLS ciphersuite 0x0001
(DHKEM(X25519, HKDF-SHA256), HKDF-SHA256, AES-128-GCM) is implemented here on top of the
`cryptography` package's X25519, HKDF-Extract/Expand (via HMAC) and AESGCM primitives: the KEM
(DeriveKeyPair, Encap, Decap), the key schedule (with §17.3's `info`) and single-shot seal/open.
The case list and the seeded inputs mirror the crypto core's generator (`cargo test -p risime-mls
history_vectors_write -- --ignored`), so both must produce the same JSON value.

Every positive case is regenerated byte for byte and opened again; every negative case is run
(the base case with `change` applied) and must fail with its `expect`; every `aad_h` case is
parsed with a canonical 'H' parser.

Needs python3-cryptography (the system package on spark2; no venv needed).

Usage: scripts/gen-history-vectors > contract/v1/history_vectors.json
       scripts/gen-history-vectors --check     # compare with the committed file, non-zero on a diff
"""
import hashlib
import hmac
import json
import os
import sys
import uuid

from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey, X25519PublicKey
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
from cryptography.exceptions import InvalidTag

LABEL = "risime-history-v1"
MEDIA_LABEL = "risime-media-v1"
SEG, TAG = 65536, 16
CSEG = SEG + TAG

RID_1 = "6f1c2a7e-3b4d-4e8f-9a0b-1c2d3e4f5a6b"
RID_2 = "0b9e8d7c-6f5a-4b3c-8d2e-1f0a9b8c7d6e"
RID_OTHER = "d3c2b1a0-9f8e-4d7c-ab6a-594837261504"
CONV_DM = "7a3e1c52-9d04-4b6f-8e21-5c0f3a9b7d18"
CONV_GRP = "grp:2c7d9e41-6a3b-4f58-9c0e-1b2a3d4c5e6f"


class Fail(Exception):
    """A failure class from the vectors: OpenFailed, SealRefused or Malformed (stage noted)."""

    def __init__(self, kind, stage):
        super().__init__(f"{kind} ({stage})")
        self.kind, self.stage = kind, stage


# ---------------------------------------------------------------- RFC 9180 (base mode, 0x0020/1/1)

def i2osp(n, w):
    return n.to_bytes(w, "big")


KEM_ID, KDF_ID, AEAD_ID = 0x0020, 0x0001, 0x0001
KEM_SUITE = b"KEM" + i2osp(KEM_ID, 2)
HPKE_SUITE = b"HPKE" + i2osp(KEM_ID, 2) + i2osp(KDF_ID, 2) + i2osp(AEAD_ID, 2)
NSECRET, NH, NK, NN, NPK, NSK = 32, 32, 16, 12, 32, 32
MODE_BASE = 0x00


def hkdf_extract(salt, ikm):
    return hmac.new(salt if salt else b"\x00" * NH, ikm, hashlib.sha256).digest()


def hkdf_expand(prk, info, n):
    out, t, i = b"", b"", 1
    while len(out) < n:
        t = hmac.new(prk, t + info + bytes([i]), hashlib.sha256).digest()
        out += t
        i += 1
    return out[:n]


def labeled_extract(suite, salt, label, ikm):
    return hkdf_extract(salt, b"HPKE-v1" + suite + label + ikm)


def labeled_expand(suite, prk, label, info, n):
    return hkdf_expand(prk, i2osp(n, 2) + b"HPKE-v1" + suite + label + info, n)


def x25519(sk, pk):
    """DH(sk, pk); an all-zero output (low-order pk) is an error (RFC 9180 §7.1.4)."""
    if len(sk) != NSK or len(pk) != NPK:
        raise ValueError("bad length")
    try:
        dh = X25519PrivateKey.from_private_bytes(sk).exchange(X25519PublicKey.from_public_bytes(pk))
    except ValueError:  # OpenSSL refuses the all-zero output itself
        raise ValueError("all-zero DH")
    if dh == b"\x00" * 32:
        raise ValueError("all-zero DH")
    return dh


def pk_of(sk):
    return X25519PrivateKey.from_private_bytes(sk).public_key().public_bytes_raw()


def derive_key_pair(ikm):
    """RFC 9180 §7.1.3 DeriveKeyPair for X25519: sk is the 32 expanded bytes (clamped by DH)."""
    prk = labeled_extract(KEM_SUITE, b"", b"dkp_prk", ikm)
    sk = labeled_expand(KEM_SUITE, prk, b"sk", b"", NSK)
    return sk, pk_of(sk)


def extract_and_expand(dh, kem_context):
    prk = labeled_extract(KEM_SUITE, b"", b"eae_prk", dh)
    return labeled_expand(KEM_SUITE, prk, b"shared_secret", kem_context, NSECRET)


def encap(pk_r, ikm_e):
    sk_e, enc = derive_key_pair(ikm_e)
    dh = x25519(sk_e, pk_r)
    return extract_and_expand(dh, enc + pk_r), enc


def decap(enc, sk_r):
    dh = x25519(sk_r, enc)
    return extract_and_expand(dh, enc + pk_of(sk_r))


def key_schedule_base(shared_secret, info):
    psk, psk_id = b"", b""
    psk_id_hash = labeled_extract(HPKE_SUITE, b"", b"psk_id_hash", psk_id)
    info_hash = labeled_extract(HPKE_SUITE, b"", b"info_hash", info)
    ctx = bytes([MODE_BASE]) + psk_id_hash + info_hash
    secret = labeled_extract(HPKE_SUITE, shared_secret, b"secret", psk)
    key = labeled_expand(HPKE_SUITE, secret, b"key", ctx, NK)
    base_nonce = labeled_expand(HPKE_SUITE, secret, b"base_nonce", ctx, NN)
    return key, base_nonce  # seq 0: nonce = base_nonce XOR 0


def hpke_seal(pk_r, info, aad, pt, ikm_e):
    if len(pk_r) != NPK:
        raise Fail("Malformed", "rpk length")
    try:
        ss, enc = encap(pk_r, ikm_e)
    except ValueError:
        raise Fail("SealRefused", "hpke encap")
    key, nonce = key_schedule_base(ss, info)
    return enc, AESGCM(key).encrypt(nonce, pt, aad)


def hpke_open(enc, sk_r, info, aad, ct):
    try:
        ss = decap(enc, sk_r)
        key, nonce = key_schedule_base(ss, info)
        return AESGCM(key).decrypt(nonce, ct, aad)
    except (ValueError, InvalidTag):
        raise Fail("OpenFailed", "hpke")


# ---------------------------------------------------------------- §17.3 info and aad, 'H' AAD

def u16(n):
    return i2osp(n, 2)


def lp(s):
    b = s.encode("utf-8")
    return u16(len(b)) + b


def info_bytes(c):
    return (LABEL.encode() + uuid.UUID(c["request_id"]).bytes + lp(c["conversation_id"])
            + lp(c["requester"]) + lp(c["provider"]))


def aad_bytes(c):
    return u16(c["part"]) + u16(c["parts"]) + bytes.fromhex(c["sha256"]) + i2osp(c["plain_size"], 8)


def h_aad_encode(request_id):
    return b"\x01H" + uuid.UUID(request_id).bytes


def h_aad_decode(b):
    if len(b) != 18 or b[:2] != b"\x01H":
        raise Fail("Malformed", "aad_h")
    return str(uuid.UUID(bytes=b[2:]))


# ---------------------------------------------------------------- §14.3 blob with a label

def padme(n):
    if n < 2:
        return n
    e = n.bit_length() - 1
    s = e.bit_length()
    mask = (1 << (e - s)) - 1
    return (n + mask) & ~mask


def payload_key(k, label):
    prk = hkdf_extract(b"", k)
    return hkdf_expand(prk, f"{label} A256GCM-S64K".encode(), 32)


def nonce(i, last):
    return b"\x00" * 7 + i.to_bytes(4, "big") + (b"\x01" if last else b"\x00")


def blob_seal(k, plain, label=LABEL):
    padded = plain + b"\x00" * (padme(len(plain)) - len(plain))
    g = AESGCM(payload_key(k, label))
    chunks = [padded[i:i + SEG] for i in range(0, len(padded), SEG)]
    return b"".join(g.encrypt(nonce(i, i == len(chunks) - 1), c, label.encode())
                    for i, c in enumerate(chunks))


def blob_open(k, cipher, plain_size, label=LABEL):
    n = -(-len(cipher) // CSEG)
    if n == 0 or len(cipher) - (n - 1) * CSEG < 17:
        raise Fail("OpenFailed", "blob format")
    g = AESGCM(payload_key(k, label))
    out = b""
    for i in range(n):
        try:
            out += g.decrypt(nonce(i, i == n - 1), cipher[i * CSEG:(i + 1) * CSEG], label.encode())
        except InvalidTag:
            raise Fail("OpenFailed", "blob integrity")
    if len(out) != padme(plain_size) or any(out[plain_size:]):
        raise Fail("OpenFailed", "blob format")
    return out[:plain_size]


# ---------------------------------------------------------------- seeded inputs (test only)

def seeded(label, n):
    """SHA-256 in counter mode over a label (test-only deterministic bytes)."""
    out, ctr = b"", 0
    while len(out) < n:
        out += hashlib.sha256(label.encode() + ctr.to_bytes(8, "big")).digest()
        ctr += 1
    return out[:n]


BUNDLE = (
    '{"v":1,"type":"history_bundle","request_id":"6f1c2a7e-3b4d-4e8f-9a0b-1c2d3e4f5a6b",'
    '"conversation_id":"7a3e1c52-9d04-4b6f-8e21-5c0f3a9b7d18","provider":"u-alice/d-old",'
    '"part":1,"parts":1,"count":1}\n'
    '{"message_id":"c1a2b3e1-a0b1-11f0-8000-0242ac120002",'
    '"client_msg_id":"5e4d3c2b-1a09-4f8e-8d7c-6b5a49382716","from":"u-bob",'
    '"from_device":"d-bob","server_ts":"2026-10-01T09:30:00.000000Z",'
    '"payload":{"v":1,"type":"text","body":"see you at 10"}}\n'
)

CASES = [
    dict(name="own_single_part", request_id=RID_1, conversation_id=CONV_DM,
         requester="u-alice/d-new", provider="u-alice/d-old", part=1, parts=1,
         plain=BUNDLE.encode()),
    dict(name="member_part_1_of_2", request_id=RID_2, conversation_id=CONV_GRP,
         requester="u-alice/d-new", provider="u-carol/d-phone", part=1, parts=2,
         plain=seeded("risime-history-vector plain member_part_1_of_2", 100)),
    dict(name="member_part_2_of_2", request_id=RID_2, conversation_id=CONV_GRP,
         requester="u-alice/d-new", provider="u-carol/d-phone", part=2, parts=2,
         plain=seeded("risime-history-vector plain member_part_2_of_2", 1)),
]


def positive(c):
    name = c["name"]
    ikm_r = seeded(f"risime-history-vector ikm_r {c['request_id']}", 32)  # one key pair per request
    ikm_e = seeded(f"risime-history-vector ikm_e {name}", 32)
    k = seeded(f"risime-history-vector k {name}", 32)
    rsk, rpk = derive_key_pair(ikm_r)
    cipher = blob_seal(k, c["plain"])
    p = {"name": name, "ikm_r": ikm_r.hex(), "rsk": rsk.hex(), "rpk": rpk.hex(), "ikm_e": ikm_e.hex(),
         "request_id": c["request_id"], "conversation_id": c["conversation_id"],
         "requester": c["requester"], "provider": c["provider"], "part": c["part"],
         "parts": c["parts"], "plain_size": len(c["plain"]),
         "sha256": hashlib.sha256(cipher).hexdigest(), "k": k.hex(),
         "plain": c["plain"].hex(), "cipher": cipher.hex()}
    info, aad = info_bytes(p), aad_bytes(p)
    enc, sealed = hpke_seal(rpk, info, aad, k, ikm_e)
    assert len(enc) == 32 and len(sealed) == 48
    p.update(info=info.hex(), aad=aad.hex(), hpke_enc=enc.hex(), sealed_key=sealed.hex())
    return p


def run_case(case):
    """Seal (when `change` sets rpk) or open a case; returns the plaintext or raises Fail."""
    if case.get("_seal"):
        return hpke_seal(bytes.fromhex(case["rpk"]), info_bytes(case), aad_bytes(case),
                         bytes.fromhex(case["k"]), bytes.fromhex(case["ikm_e"]))
    enc, sealed = bytes.fromhex(case["hpke_enc"]), bytes.fromhex(case["sealed_key"])
    if len(enc) != 32 or len(sealed) != 48 or len(bytes.fromhex(case["rsk"])) != 32:
        raise Fail("Malformed", "lengths")
    k = hpke_open(enc, bytes.fromhex(case["rsk"]), info_bytes(case), aad_bytes(case), sealed)
    if len(k) != 32:
        raise Fail("OpenFailed", "hpke key length")
    cipher = bytes.fromhex(case["cipher"])
    if hashlib.sha256(cipher).hexdigest() != case["sha256"]:  # sha256 before any AEAD (§17.3)
        raise Fail("OpenFailed", "blob integrity")
    return blob_open(k, cipher, case["plain_size"], case.get("label", LABEL))


def neg(name, base, change, expect, why):
    return {"name": name, "base": base, "change": change, "expect": expect, "why": why}


# The failing stage each negative must reach (stronger than the class alone).
STAGES = {"media_label": "blob integrity", "tampered_cipher": "blob integrity",
          "truncated_sealed_key": "lengths", "long_hpke_enc": "lengths",
          "low_order_rpk": "hpke encap"}


def rfc9180_kat():
    """RFC 9180 A.1.1 (DHKEM(X25519), HKDF-SHA256, AES-128-GCM, base mode), sequence 0."""
    h = bytes.fromhex
    _, pk_r = derive_key_pair(h("6db9df30aa07dd42ee5e8181afdb977e538f5e1fec8a06223f33f7013e525037"))
    enc, ct = hpke_seal(pk_r, h("4f6465206f6e2061204772656369616e2055726e"), h("436f756e742d30"),
                        h("4265617574792069732074727574682c20747275746820626561757479"),
                        h("7268600d403fce431561aef583ee1613527cff655c1343f29812e66706df3234"))
    assert enc.hex() == "37fda3567bdbd628e88668c3c8d7e97d1d1253b6d4ea6d44c150f741f1bf4431"
    assert ct.hex() == ("f938558b5d72f1a23810b4be2ab4f84331acc02fc97babc53a52ae8218a355a9"
                        "6d8770ac83d07bea87e13c512a"), "RFC 9180 A.1.1 known answer"


def build():
    rfc9180_kat()
    pos =[positive(c) for c in CASES]
    for p in pos:  # every positive opens back to its plaintext
        assert run_case(p).hex() == p["plain"], p["name"]
    h = h_aad_encode(RID_1)
    aad_h = [("ok", RID_1, h, "ok"), ("ok_second", RID_2, h_aad_encode(RID_2), "ok"),
             ("17_bytes", RID_1, h[:17], "Malformed"), ("19_bytes", RID_1, h + b"\x00", "Malformed"),
             ("delete_prefix", RID_1, b"\x01D" + h[2:], "Malformed"),
             ("wrong_version", RID_1, b"\x02" + h[1:], "Malformed"),
             ("prefix_only", RID_1, h[:2], "Malformed"), ("empty", RID_1, b"", "Malformed")]
    other_sha = bytearray(bytes.fromhex(pos[0]["sha256"]))
    other_sha[0] ^= 0x01
    tampered = bytearray(bytes.fromhex(pos[2]["cipher"]))
    tampered[-1] ^= 0x01
    negs = [
        neg("wrong_request_id", "own_single_part", {"request_id": RID_OTHER}, "OpenFailed",
            "info carries another request_id"),
        neg("wrong_provider", "member_part_1_of_2", {"provider": "u-mallory/d-phone"}, "OpenFailed",
            "info carries another provider identity (a member copying an honest provider's sealed key)"),
        neg("wrong_requester", "own_single_part", {"requester": "u-alice/d-other"}, "OpenFailed",
            "info carries another requester identity"),
        neg("wrong_conversation", "own_single_part", {"conversation_id": CONV_GRP}, "OpenFailed",
            "info carries another conversation_id"),
        neg("wrong_part_in_aad", "member_part_1_of_2", {"part": 2}, "OpenFailed",
            "aad says part 2 of 2 for part 1's sealed key"),
        neg("wrong_parts_in_aad", "member_part_2_of_2", {"parts": 3}, "OpenFailed",
            "aad says part 2 of 3"),
        neg("wrong_sha256_in_aad", "own_single_part", {"sha256": bytes(other_sha).hex()}, "OpenFailed",
            "aad carries another ciphertext digest (one bit flipped)"),
        neg("wrong_plain_size_in_aad", "member_part_1_of_2", {"plain_size": 101}, "OpenFailed",
            "aad carries another plain_size (same Padmé bucket, same blob size)"),
        neg("swapped_hpke_enc", "member_part_1_of_2", {"hpke_enc": pos[2]["hpke_enc"]}, "OpenFailed",
            "hpke_enc of member_part_2_of_2"),
        neg("swapped_sealed_key", "member_part_1_of_2", {"sealed_key": pos[2]["sealed_key"]},
            "OpenFailed", "sealed_key of member_part_2_of_2 (same request, same rpk)"),
        neg("truncated_sealed_key", "own_single_part", {"sealed_key": pos[0]["sealed_key"][:94]},
            "Malformed", "sealed_key of 47 bytes (must be 48)"),
        neg("long_hpke_enc", "own_single_part", {"hpke_enc": pos[0]["hpke_enc"] + "00"}, "Malformed",
            "hpke_enc of 33 bytes (must be 32)"),
        neg("low_order_rpk", "own_single_part", {"rpk": "00" * 32}, "SealRefused",
            "seal plain to the all-zero X25519 point: the DH output is all zero (RFC 9180 §7.1.4)"),
        neg("low_order_hpke_enc", "own_single_part", {"hpke_enc": "00" * 32}, "OpenFailed",
            "open with the all-zero X25519 point as hpke_enc: the DH output is all zero"),
        neg("wrong_rsk", "own_single_part", {"rsk": pos[1]["rsk"]}, "OpenFailed",
            "rsk of member_part_1_of_2"),
        neg("media_label", "own_single_part", {"label": MEDIA_LABEL}, "OpenFailed",
            "the right K, but the blob opened with the risime-media-v1 label (HKDF info and segment AAD)"),
        neg("tampered_cipher", "member_part_2_of_2", {"cipher": bytes(tampered).hex()}, "OpenFailed",
            "one tag bit flipped (sha256 still the original's: the blob check fails)"),
    ]
    doc = {
        "v": 1,
        "comment": "History-sharing vectors (contract v1.15 §17.3, crypto review R1). Generated by "
                   "`cargo test -p risime-mls history_vectors_write -- --ignored` with seeded inputs; "
                   "ikm_e makes the HPKE ephemeral key deterministic (RFC 9180 DeriveKeyPair; test "
                   "builds only). All binary fields are lowercase hex. Positive: (rsk, rpk) = "
                   "DeriveKeyPair(ikm_r), one key pair per request_id; hpke_enc = the public key of DeriveKeyPair(ikm_e); info and "
                   "aad as §17.3 from the case's fields; sealed_key = HPKE base-mode seal of k; cipher "
                   "= A256GCM-S64K of plain under k with the label. Negative: the base case with "
                   "`change` applied must fail with `expect`: a seal of `plain` to `rpk` when `change` "
                   "sets rpk, otherwise an open (rsk, hpke_enc, sealed_key, info/aad fields, then the "
                   "blob; `label` overrides the blob label).",
        "suite": {"mode": "base", "kem": KEM_ID, "kdf": KDF_ID, "aead": AEAD_ID},
        "label": LABEL,
        "aad_h": [{"name": n, "request_id": r, "bytes": b.hex(), "expect": e} for n, r, b, e in aad_h],
        "positive": pos,
        "negative": negs,
    }
    verify(doc)
    return doc


def verify(doc):
    """Runs every aad_h and negative case of `doc`; raises AssertionError on any mismatch."""
    for a in doc["aad_h"]:
        try:
            got = "ok" if h_aad_decode(bytes.fromhex(a["bytes"])) == a["request_id"] else "Malformed"
        except Fail as f:
            got = f.kind
        assert got == a["expect"], f"aad_h {a['name']}: got {got}, want {a['expect']}"
    by_name = {p["name"]: p for p in doc["positive"]}
    for p in doc["positive"]:
        assert run_case(p).hex() == p["plain"], f"positive {p['name']} does not open"
    for n in doc["negative"]:
        case = dict(by_name[n["base"]], **n["change"])
        case["_seal"] = "rpk" in n["change"]
        try:
            run_case(case)
            got, stage = "ok", None
        except Fail as f:
            got, stage = f.kind, f.stage
        assert got == n["expect"], f"negative {n['name']}: got {got} ({stage}), want {n['expect']}"
        want_stage = STAGES.get(n["name"], "hpke")
        assert stage == want_stage, f"negative {n['name']}: failed at {stage}, want {want_stage}"


def dump(doc):
    return json.dumps(doc, indent=2, sort_keys=True, ensure_ascii=False) + "\n"


if __name__ == "__main__":
    out = dump(build())
    if sys.argv[1:] == ["--check"]:
        path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "contract", "v1",
                            "history_vectors.json")
        with open(path, encoding="utf-8") as f:
            have = f.read()
        committed = json.loads(have)
        verify(committed)  # the committed negatives fail as specified under this implementation
        if json.loads(out) != committed:
            mine = json.loads(out)
            for key in sorted(set(mine) | set(committed)):
                if mine.get(key) != committed.get(key):
                    sys.stderr.write(f"differs: {key}\n")
                    if isinstance(mine.get(key), list):
                        for a, b in zip(mine[key], committed.get(key) or []):
                            for f in sorted(set(a) | set(b)):
                                if a.get(f) != b.get(f):
                                    sys.stderr.write(f"  {a.get('name')}.{f}: mine {a.get(f)!r} "
                                                     f"committed {b.get(f)!r}\n")
            sys.exit(1)
        if out != have:
            sys.stderr.write("same JSON value, different formatting\n")
            sys.exit(1)
        print(f"history_vectors.json agrees: {len(committed['positive'])} positive, "
              f"{len(committed['negative'])} negative, {len(committed['aad_h'])} aad_h")
    elif sys.argv[1:]:
        sys.exit(__doc__)
    else:
        sys.stdout.write(out)
