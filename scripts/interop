#!/usr/bin/env bash
# Live interop gate (RULES: before every release). Starts a temporary server from THIS checkout on
# 127.0.0.1:4100 (dev env, its own DB and keyspace risime_interop, migrated each run; never the pilot's risime_dev) with a local stand-in OIDC issuer (127.0.0.1:4799),
# creates throwaway users/tokens, runs the Android LiveInteropTest (real ApiClient +
# PhoenixRealtimeClient) against it, and always cleans up. Never touches :4000 / risime.service.
#   scripts/interop
#   RISI=1 scripts/interop   # then the Risi canary (scripts/risi-canary, §24.14) after INTEROP OK
set -euo pipefail
cd "$(dirname "$0")/.."
REPO="$PWD"; M="$HOME/.local/bin/mise exec --"
# Own store: the pilot release runs on risime_dev, which is only migrated by run-server after a backup.
# INTEROP_INSTANCE (e.g. _rel for the release gate) isolates a run from other sessions' interop:
# its own ports, tmux sessions, DB/keyspace and build dir.
SUF="${INTEROP_INSTANCE:-}"; IPORT="${INTEROP_PORT:-4100}"; JPORT="${INTEROP_JWKS_PORT:-4799}"
export INTEROP_PORT="$IPORT" INTEROP_JWKS_PORT="$JPORT"
export RISIME_DEV_DB="risime_interop$SUF" RISIME_DEV_KEYSPACE="risime_interop$SUF"
# Own build dir and no code reloading: other sessions compiling server/ can't stall the temp server.
export MIX_BUILD_PATH="$REPO/server/_build/interop$SUF" RISIME_CODE_RELOADER=false
DIR="$(mktemp -d "${TMPDIR:-/tmp}/risime-interop.XXXXXX")"
cleanup() {
  [ -f "$DIR/gradle.log" ] && cp "$DIR/gradle.log" "$HOME/risime-logs/interop-last.log" 2>/dev/null || true
  [ -f "$DIR/server.log" ] && cp "$DIR/server.log" "$HOME/risime-logs/interop-last-server.log" 2>/dev/null || true
  tmux kill-session -t "risime-interop$SUF" 2>/dev/null || true
  tmux kill-session -t "risime-interop-jwks$SUF" 2>/dev/null || true
  (cd "$REPO/server" && $M mix run "$REPO/scripts/interop-fixtures.exs" cleanup "$DIR" 2>/dev/null | grep 'interop cleanup' || true)
  rm -rf -- "${DIR:?}"
}
trap cleanup EXIT
trap 'exit 130' INT TERM   # make interrupts run the EXIT cleanup too
for p in $IPORT $JPORT; do ss -ltnH "sport = :$p" | grep -q . && { echo "port $p busy"; exit 1; }; done

cat > "$DIR/jwks.py" <<'PY'
import http.server, sys
root = sys.argv[1]
class H(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *a, **k): super().__init__(*a, directory=root, **k)
    def guess_type(self, path): return "application/json"
    def log_message(self, *a): pass
http.server.ThreadingHTTPServer(("127.0.0.1", int(sys.argv[2])), H).serve_forever()
PY
echo "==> interop store: $RISIME_DEV_DB / $RISIME_DEV_KEYSPACE (create + migrate)"
(cd server && $M mix ecto.create --quiet >/dev/null && $M mix ecto.migrate --quiet >/dev/null && $M mix risime.cql.migrate --quiet >/dev/null) \
  || { echo "could not create/migrate the interop store"; exit 1; }
(cd server && $M mix run "$REPO/scripts/interop-fixtures.exs" keys "$DIR" 2>/dev/null | grep 'interop keys')
# A per-run E2EE attestation key: the temp server runs with E2EE ON (never the pilot's key).
(cd server && $M mix risime.attestation.gen "$DIR/attest.jwk" 2>/dev/null | grep -o 'attestation key created' || true)
[ -f "$DIR/attest.jwk" ] || { echo "could not create a temp attestation key"; exit 1; }
tmux new -d -s "risime-interop-jwks$SUF" "python3 '$DIR/jwks.py' '$DIR/www' $JPORT"
tmux new -d -s "risime-interop$SUF" "cd '$REPO/server' && MIX_BUILD_PATH='$MIX_BUILD_PATH' RISIME_CODE_RELOADER=false RISIME_DEV_DB=$RISIME_DEV_DB RISIME_DEV_KEYSPACE=$RISIME_DEV_KEYSPACE PORT=$IPORT DEV_LOCAL_AUTH=true OIDC_ENABLED=true \
  OIDC_ISSUER=http://127.0.0.1:$JPORT/realms/itest \
  OIDC_JWKS_URL=http://127.0.0.1:$JPORT/realms/itest/protocol/openid-connect/certs \
  PHONE_VERIFICATION=off FCM_ENABLED=false RISIME_AUTH_LOG='$DIR/auth.log' ATTESTATION_KEY_FILE='$DIR/attest.jwk' \
  $M mix phx.server > '$DIR/server.log' 2>&1"
for _ in $(seq 1 120); do curl -sf -o /dev/null http://127.0.0.1:$IPORT/health && break; sleep 1; done
curl -sf -o /dev/null http://127.0.0.1:$IPORT/health || { echo "interop server didn't start"; tail -20 "$DIR/server.log"; exit 1; }
# Compile the tests BEFORE setup mints the 60-s Bshort token (decision 054: the longer call checks and
# a cold compile used to eat its lifetime). Without a config every live test skips at once.
read -r -a EXTRA_GRADLE <<< "${RISIME_GRADLE_ARGS:-}"
(cd android && $M ./gradlew --no-configuration-cache "${EXTRA_GRADLE[@]}" testDebugUnitTest --tests 'lk.codegen.risime.live.LiveInteropTest' -q > "$DIR/precompile.log" 2>&1) \
  || { echo "interop: test compile failed"; tail -20 "$DIR/precompile.log"; exit 1; }
(cd server && $M mix run "$REPO/scripts/interop-fixtures.exs" setup "$DIR" 2>/dev/null | grep 'interop setup')

echo "==> LiveInteropTest + LiveE2eeInteropTest + LiveGroupInteropTest against 127.0.0.1:$IPORT (E2EE on with a temp key)"
set +e
# Extra Gradle args from the caller (nightly-release passes the pinned attestation key, so the
# release outputs it regenerates keep the pin).
# LiveInteropTest first, on its own (its Bshort check needs the token minted just before); then the rest.
(cd android && RISIME_INTEROP_CONFIG="$DIR/interop.json" $M ./gradlew --no-configuration-cache "${EXTRA_GRADLE[@]}" \
  testDebugUnitTest --tests 'lk.codegen.risime.live.LiveInteropTest' -i 2>&1) > "$DIR/gradle.log"
rc=$?
(cd android && RISIME_INTEROP_CONFIG="$DIR/interop.json" $M ./gradlew --no-configuration-cache "${EXTRA_GRADLE[@]}" \
  testDebugUnitTest --tests 'lk.codegen.risime.live.LiveE2eeInteropTest' --tests 'lk.codegen.risime.live.LiveGroupInteropTest' -i 2>&1) >> "$DIR/gradle.log"
rc2=$?
[ "$rc" = 0 ] && rc=$rc2
set -e
grep -E '^\s{4}\S' "$DIR/gradle.log" | grep -vE 'isLoggable|^\s+at |Exception in|\.kt:' | sed 's/^ *//' | grep -vE '^(Kotlin|Input|Calculating|Watching|Task|Starting)' | head -100
grep -qE "Live(E2ee|Group)?InteropTest > .* SKIPPED" "$DIR/gradle.log" && { echo "INTEROP SKIPPED (config not picked up)"; exit 1; }
[ "$rc" = 0 ] || { echo "INTEROP FAILED"; grep -E "FAILED|AssertionError|expected" "$DIR/gradle.log" | head -10; exit 1; }
echo "INTEROP OK"
if [ "${RISI:-}" = 1 ]; then
  # Its own temp server, store and ports (CANARY_*): stop this run's server first.
  cleanup; trap - EXIT
  CANARY_INSTANCE="${CANARY_INSTANCE:-$SUF}" scripts/risi-canary
fi
