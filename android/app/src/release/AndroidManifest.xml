<?xml version="1.0" encoding="utf-8"?>
<!-- Release only (decision 016): the in-app updater installs signed RisiMe releases. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: lets the self-update skip the confirmation when the system allows it (decision 027). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <receiver
            android:name="lk.codegen.risime.update.InstallResultReceiver"
            android:exported="false" />
        <!-- P0-1: after a (silent) self-update, "RisiMe updated to X — tap to open". -->
        <receiver
            android:name="lk.codegen.risime.update.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
