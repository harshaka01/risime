<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only (v1.31 §31.11): the Google Calendar test seam. The release manifest and dex contain none of this. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Protected by android.permission.DUMP: only `adb shell am broadcast` can send it. -->
        <receiver
            android:name="ai.risicloud.risime.debug.GcalTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="ai.risicloud.risime.debug.GCAL_TEST" />
            </intent-filter>
        </receiver>
        <!-- P0 2026-10-10: the calendar seam (a local calendar + events in CalendarContract, for redroid). Same protection. -->
        <receiver
            android:name="ai.risicloud.risime.debug.CalendarSeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="ai.risicloud.risime.debug.CALENDAR_SEED" />
            </intent-filter>
        </receiver>
        <!-- v1.39 §36: the microphone seam for the call-transcribe gate (redroid has no microphone). Same protection. -->
        <receiver
            android:name="ai.risicloud.risime.debug.MicInjectReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="ai.risicloud.risime.debug.MIC_INJECT" />
            </intent-filter>
        </receiver>
        <!-- v1.41 §37: the voice-note microphone seam for the voice-note gate (redroid has no microphone). Same protection. -->
        <receiver
            android:name="ai.risicloud.risime.debug.VoiceInjectReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="ai.risicloud.risime.debug.VOICE_INJECT" />
            </intent-filter>
        </receiver>
        <!-- v1.44 §39.3: the link-preview test route (one test host → a 127.0.0.1 Open Graph page). Same protection. -->
        <receiver
            android:name="ai.risicloud.risime.debug.LinkPreviewTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="ai.risicloud.risime.debug.LINK_PREVIEW_TEST" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
