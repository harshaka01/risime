<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only (v1.31 §31.11): the Google Calendar test seam. The release manifest and dex contain none of this. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Protected by android.permission.DUMP: only `adb shell am broadcast` can send it. -->
        <receiver
            android:name="lk.codegen.risime.debug.GcalTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="lk.codegen.risime.debug.GCAL_TEST" />
            </intent-filter>
        </receiver>
        <!-- P0 2026-10-10: the calendar seam (a local calendar + events in CalendarContract, for redroid). Same protection. -->
        <receiver
            android:name="lk.codegen.risime.debug.CalendarSeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="lk.codegen.risime.debug.CALENDAR_SEED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
