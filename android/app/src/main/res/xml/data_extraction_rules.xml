<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the device by cloud backup or device-to-device transfer: the
     databases (messages + sealed MLS state), DataStore, the token vault and the MLS DB key
     (contract §10.4, decision 033). MLS state restored elsewhere would be unsafe. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
