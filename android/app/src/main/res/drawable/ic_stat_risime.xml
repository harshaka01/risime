<?xml version="1.0" encoding="utf-8"?>
<!-- Notification small icon: the RisiMe robot speech bubble (design/brand/risime-logo.png) as a
     one-colour glyph: head with a speech tail, eyes cut out, antenna and the spark. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <group android:translateX="-1.5" android:translateY="0.25">
        <path android:fillColor="#FFFFFF" android:fillType="evenOdd"
            android:pathData="@string/risime_glyph_head" />
        <path android:fillColor="#FFFFFF"
            android:pathData="@string/risime_glyph_extras" />
    </group>
</vector>
