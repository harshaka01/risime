# /etc/caddy/Caddyfile on spark2 — public front of the RisiMe pilot (docs/decisions/023).
# Works on Caddy 2.6.2 (Ubuntu) and 2.11 (official repo); validated against both.
# Caddy terminates TLS (automatic HTTPS via Let's Encrypt: needs DNS A risime.risicloud.ai ->
# 203.115.26.139 and inbound 80+443 reaching spark2) and proxies to Phoenix on 127.0.0.1:4000.
# Phoenix never listens on a public interface. Install: see docs/PROD.md "Pilot on spark2".
{
	# No admin API on the network; local only (default 127.0.0.1:2019, kept explicit).
	admin 127.0.0.1:2019
}

risime.risicloud.ai {
	encode zstd gzip

	# The bare domain sends people to the download page.
	redir / https://risicloud.ai/app/risime/ 302

	# Dev-only paths never reach Phoenix (the prod release has none anyway).
	handle /dev/* {
		respond 404
	}

	# LiveKit SFU signalling for group calls (PROTOCOL §16.15; infra/livekit). Clients use the URL
	# wss://risime.risicloud.ai/livekit (no trailing slash); the SDKs append /rtc (Android),
	# /rtc/v1 (newer SDKs) and, after a failed connect, /rtc/validate or /rtc/v1/validate.
	# handle_path strips /livekit, and only those paths reach LiveKit on 127.0.0.1:7880: its
	# server API (/twirp/*) stays loopback-only, for Phoenix. WebSocket upgrades pass through.
	handle_path /livekit/* {
		@rtc path /rtc /rtc/*
		handle @rtc {
			reverse_proxy 127.0.0.1:7880
		}
		handle {
			respond "Not found" 404
		}
	}

	# Only the app's paths are proxied; everything else is 404 at the edge.
	@app path /api/* /socket/* /health
	handle @app {
		# Caddy replaces X-Forwarded-For with the real client IP (it trusts no incoming XFF by
		# default); Phoenix trusts XFF only from loopback. WebSocket upgrades
		# (/socket/websocket) pass through with no idle timeout. Compatible with Caddy 2.6+
		# (stream_timeout/stream_close_delay need 2.7, so they're left out: on a Caddy reload,
		# open sockets drop and the app reconnects with `since`).
		reverse_proxy 127.0.0.1:4000
	}
	handle {
		respond "Not found" 404
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		-Server
	}

	log {
		output file /var/log/caddy/risime-access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format filter {
			wrap json
			fields {
				# Tokens travel in Authorization (never logged by Caddy); strip legacy ?token=,
				# and LiveKit's ?access_token= (its SDKs put the join token in the URL).
				request>uri query {
					delete token
					delete access_token
				}
			}
		}
	}
}
