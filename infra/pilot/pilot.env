# Non-secret settings for the public pilot release on spark2 (docs/decisions/023).
# Secrets (POSTGRES_PASSWORD, SECRET_KEY_BASE, NOTIFYLK_*, SMTP_*) come from the repo .env only.
# Loaded by scripts/run-server after .env; values here override nothing secret.
PHX_HOST=risime.risicloud.ai
PHX_PATH=/
PHX_ORIGINS=https://risime.risicloud.ai
PHX_BIND=127.0.0.1
PORT=4000
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=risime
POSTGRES_DB=risime_dev
CASSANDRA_NODES=127.0.0.1:9042
CASSANDRA_KEYSPACE=risime_dev
LOG_FORMAT=json
RISIME_AUTH_LOG=/home/harsha/risime-logs/auth.log
# Keycloak (realm aoa, client risime) is live since 2026-10-06: OIDC on. Dev login stays for debug
# builds and tooling until Harsha turns it off; codes only in the server log.
DEV_LOCAL_AUTH=true
OTP_DEV_LOG=true
OIDC_ENABLED=true
# SMS phone verification (decision 020/022): off until the "RisiMe" sender ID is approved.
PHONE_VERIFICATION=off
SMS_MODE=log
RELEASE_DISTRIBUTION=none
# v1.9 blobs (§12.6, later encrypted images): encrypted bytes only, outside the repo. Backed up
# with the databases by scripts/run-server (scripts/backup --blobs).
BLOB_DIR=/home/harsha/risime-blobs/prod
# Push (decision 026/028, contract §8): content-free FCM wake-ups only (data {"type":"inbox","v":"1"},
# high priority, collapse_key inbox). The key file stays outside git (mode 600) and is never logged.
FCM_ENABLED=true
FCM_SERVICE_ACCOUNT_FILE=/home/harsha/risime-keys/fcm-service-account.json
# v1.13 §16.7 (decision 046): coturn on 10.20.20.15 (external 203.115.26.139), ports open since 2026-10-07.
# REST credentials from TURN_SECRET in .env (= coturn static-auth-secret). No turns: until TLS.
TURN_URLS=turn:203.115.26.139:3478?transport=udp,turn:203.115.26.139:3478?transport=tcp
# Group calls (PROTOCOL §20, decision 056): the public LiveKit URL clients connect to. Switched on
# once Caddy serves /livekit (Harsha's sudo step); without it POST /calls/rooms answers 503.
# LIVEKIT_API_URL defaults to http://127.0.0.1:7880; the key and secret come from .env.
#LIVEKIT_URL=wss://risime.risicloud.ai/livekit
# Open sign-up (PROTOCOL §21, decision 058; Harsha 2026-10-08): any verified Keycloak email can create
# an account; phones stay unconfirmed until SMS verification is live. Close again: false + restart.
OPEN_SIGNUP=true

# §24 two tabs and Risi stage 1 (decisions 065, 066): on since 2026-10-08 (nightly.39, RISI CANARY OK)

TABS=on
RISI=on

# §25/§26 Risi tools + skills (Harsha: turn skills on, 2026-10-09)
RISI_TOOLS=on
RISI_SKILLS=on

RISI_EVENTS=on
