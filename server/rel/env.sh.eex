#!/bin/sh
# RisiMe release environment (decision 024).
#
# No Erlang distribution: the release never starts epmd or listens on a distribution port
# (an earlier host release left epmd on 0.0.0.0:4369). `bin/risime remote` is therefore
# unavailable; use `bin/risime eval` / `rpc`-free tooling instead. Override only deliberately.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"

# Even if distribution is turned on deliberately, keep epmd and the node on loopback.
export ERL_EPMD_ADDRESS="${ERL_EPMD_ADDRESS:-127.0.0.1}"
