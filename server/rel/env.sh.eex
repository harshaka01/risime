#!/bin/sh
# RisiMe release environment (decision 024, amended by decision 075).
#
# Default: no Erlang distribution. The release never starts epmd or listens on a distribution
# port (an earlier host release left epmd on 0.0.0.0:4369), so `bin/risime remote` is
# unavailable; use `bin/risime eval` instead.
#
# For diagnostics (decision 075) set RELEASE_DISTRIBUTION=name in .env: the node is then
# risime@127.0.0.1 (override RELEASE_NODE only deliberately), epmd and the distribution
# listener bind to 127.0.0.1, on the single fixed port 4370. Nothing listens beyond loopback.
# The cookie (RELEASE_COOKIE) comes from .env.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"

# Even if distribution is turned on deliberately, keep epmd and the node on loopback.
export ERL_EPMD_ADDRESS="${ERL_EPMD_ADDRESS:-127.0.0.1}"

if [ "$RELEASE_DISTRIBUTION" = "name" ] || [ "$RELEASE_DISTRIBUTION" = "sname" ]; then
  export RELEASE_NODE="${RELEASE_NODE:-risime@127.0.0.1}"
  export ERL_AFLAGS="${ERL_AFLAGS:+$ERL_AFLAGS }-kernel inet_dist_use_interface {127,0,0,1} -kernel inet_dist_listen_min 4370 -kernel inet_dist_listen_max 4370"
fi
