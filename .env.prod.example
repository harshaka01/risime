# RisiMe PROD secrets. Copy to .env.prod (gitignored, chmod 600) and fill in. Never commit .env.prod.
# Used as: docker compose --env-file .env.prod -f infra/docker-compose.prod.yml ...
# Generate random values with:  openssl rand -hex 32
# (hex only: POSTGRES_PASSWORD goes into DATABASE_URL unescaped)

# Image tag to run: risime-server:<RISIME_VERSION>, built from the tag v<RISIME_VERSION>.
RISIME_VERSION=0.2.0

POSTGRES_PASSWORD=change-me-hex-only
# mix phx.gen.secret, or: openssl rand -hex 64
SECRET_KEY_BASE=change-me-at-least-64-chars-0000000000000000000000000000000000000000
# Public hostname the app is reached at (Tailscale MagicDNS name or a real domain).
PHX_HOST=risime.example.ts.net
# Erlang distribution cookie (remote console: docker exec -it risime-prod-server-1 bin/risime remote)
RELEASE_COOKIE=change-me
POOL_SIZE=10

# OTP mail. Prod must use SMTP: the dev "Local" mailbox is disabled in prod.
RISIME_MAILER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=RisiMe <no-reply@example.com>

# Backups (scripts/backup --env prod, the risime-backup systemd timer)
# Off-box target: user@host:/path (rsync over ssh) or a local directory.
BACKUP_DEST=/srv/backups/risime
BACKUP_KEEP=14
